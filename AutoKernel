        # ── UNSCHEMA TRIAGE ──────────────────────────────────────────────────
        # Scan for files Qwen invented outside the named schema.  Runs before
        # intake so any redistributed content is immediately available in context.
        # Named schema files are never affected — only unrecognised filenames.
        _triage_scan()
        ingested_text = process_intake_files()
        if any(Path(NPU_DIR).iterdir()): # Only run if there are actual files in the NPU
            disk_orchestrator.evaluate_files(NPU_DIR)
        npu_text = process_npu_queue()
        combined_ingest = ingested_text + npu_text

        if combined_ingest:
            session_history += combined_ingest
            append_memory_file(
                CHAT_LOG,
                combined_ingest,
                what="chronological intake event",
                why="journal.txt records when new intake entered the active session"
            )
            mark_wake_consolidation_if_needed()

        try:
            last_activity_time = time.time()
            if use_pinned_terminal:
                _, rows = _term_size()
                _real_stdout.write(
                    f"\033[{rows};1H\033[K"
                    f"{TERM_USER_LIGHT_BROWN}[Terminal] > "
                )
                _real_stdout.flush()
                user_input = input("")
                _real_stdout.write(TERM_RESET)
                _real_stdout.write(f"\033[{_scroll_bot()};1H")
                _real_stdout.flush()
            else:
                sys.stdout.write("\n" + TERM_USER_LIGHT_BROWN + "You: ")
                sys.stdout.flush()
                user_input = input("")
                sys.stdout.write(TERM_RESET)
                sys.stdout.flush()

            if user_input.strip() == "m": # --- MULTI-LINE MODE ---
                print("[System] Multi-Line Mode active. Paste your text below. Type 'END' on a new line to submit.")
                lines = []
                while True:
                    sys.stdout.write(TERM_USER_LIGHT_BROWN)
                    sys.stdout.flush()
                    line = input()
                    sys.stdout.write(TERM_RESET)
                    sys.stdout.flush()
                    if line.strip() == "END":
                        break
                    lines.append(line)
                user_input = "\n".join(lines)
            last_activity_time = time.time()
        except (EOFError, KeyboardInterrupt):
            break
    
        clean_input = user_input.strip()
        user_declared_provenance = detect_user_declared_provenance(clean_input)
        chat_governance = detect_chat_governance(clean_input)
        record_context_event(
            "USER_CHAT", clean_input,
            {"declared_provenance": user_declared_provenance, "governance": chat_governance}
        )
        # One computation = one user prompt through the terminal front end.
        # Ticked here, at the single point every submitted prompt passes through,
        # so commands and conversation both count as thinking that has happened.
        try:
            computation_tick()
        except Exception:
            pass
        update_gui_chat("YOU", clean_input) # placed right after capture & clean of user input.
        cmd = clean_input.lower()

        if programmer_mode_enabled and active_programmer_project and clean_input:
            _prog_record_text_tokens(active_programmer_project,clean_input,"user_input","programmer-mode user input")

        # PROGRAMMER/PROG mode and staged project commands.
        if cmd in ("prog","programmer","prog on","programmer on"):
            programmer_mode_enabled=True
            current_mode="programmer"
            mode_history.append("programmer")
            print(f"[PROGRAMMER/PROG] ON | root={CODE_DIR}")
            print("  prog new <project> <language> | prog start/resume/pause/stop <project> | prog prompt <request>")
            print("  write = commit latest candidate | rewrite <instructions> = revise latest candidate against current project")
            print("  configure<file> | compile<file> | build<file> | test<file> | list<folder> (list origin = code/)")
            print("  prog build/run [project] | prog status [project] | prog comment <project> <filetype> <note> | prog comments [project]")
            print("  prog value/tokens [project] | prog active/inactive <project> | prog prefs | prog list | prog off")
            update_gui_chat("SYS","PROGRAMMER/PROG mode activated")
            continue
        if cmd in ("prog off","programmer off"):
            if active_programmer_project and _prog_project_open(active_programmer_project):
                _prog_session_update(active_programmer_project,status="paused",last_operation="prog off",progress=0,progress_label="PAUSED")
                _prog_gui_update(active_programmer_project,0,"PAUSED")
            programmer_mode_enabled=False
            active_programmer_project=None
            if current_mode=="programmer":
                current_mode=mode_history[-2] if len(mode_history)>1 else "normal"
            print("[PROGRAMMER/PROG] OFF (running project, if any, was paused)")
            continue
        if cmd=="prog list":
            projects=_prog_list_projects()
            print("[PROGRAMMER/PROG] Projects: "+(", ".join(projects) if projects else "(none)"))
            continue
        prog_start=re.match(r"^prog\s+(start|resume|pause|stop)\s+([A-Za-z0-9._-]+)$",clean_input,re.I)
        if prog_start:
            action=prog_start.group(1).lower()
            target=_prog_safe_name(prog_start.group(2))
            if action=="start":
                ok,msg=_prog_start_project(target,False)
            elif action=="resume":
                ok,msg=_prog_start_project(target,True)
            elif action=="pause":
                ok,msg=_prog_pause_project(target)
            else:
                ok,msg=_prog_stop_project(target)
            if ok:
                state=msg
                print(f"[PROGRAMMER/PROG] {target}: {action.upper()} -> {state.get('status')}")
                print(f"  language={state.get('language')} | last={state.get('last_updated_file') or '(none)'} @ {state.get('last_updated_time') or '(none)'}")
            else:
                print(f"[PROGRAMMER/PROG] {msg}")
            continue
        prog_prompt=re.match(r"^prog\s+prompt(?:\s+(.+))?$",clean_input,re.I|re.S)
        if prog_prompt:
            if not active_programmer_project:
                print("[PROGRAMMER/PROG] No open project. Use prog start <project> or prog resume <project>.")
                continue
            request=(prog_prompt.group(1) or "").strip()
            ok,msg=_prog_generate_request(active_programmer_project,request)
            if ok:
                print(f"[PROGRAMMER/PROG] Generation applied to {active_programmer_project}.")
                for detail in msg.get("details",[]): print(f"  {detail}")
            else:
                print(f"[PROGRAMMER/PROG] Generation failed: {msg}")
            continue
        if cmd=="write":
            if not active_programmer_project:
                print("[PROGRAMMER/PROG] No open project. Use prog start <project>.")
            else:
                ok,msg=_prog_write_candidate(active_programmer_project)
                if not ok and isinstance(msg,dict) and msg.get("need_filename"):
                    print(f"[PROGRAMMER/PROG] {msg.get('message')}")
                    print(f"  language={msg.get('language')} layout={msg.get('layout')}")
                    try:
                        chosen=input("Filename: ").strip()
                    except (EOFError,KeyboardInterrupt):
                        chosen=""
                    if not chosen:
                        print("[PROGRAMMER/PROG] write cancelled; pending candidate preserved.")
                    else:
                        ok,msg=_prog_write_candidate(active_programmer_project,chosen)
                        print(f"[PROGRAMMER/PROG] write {'OK' if ok else 'FAILED'}: {msg}")
                else:
                    print(f"[PROGRAMMER/PROG] write {'OK' if ok else 'FAILED'}: {msg}")
            continue
        prog_rewrite=re.match(r"^rewrite(?:\s+(.+))?$",clean_input,re.I|re.S)
        if prog_rewrite:
            if not active_programmer_project:
                print("[PROGRAMMER/PROG] No open project. Use prog start <project>.")
            else:
                instructions=(prog_rewrite.group(1) or "").strip()
                ok,msg=_prog_rewrite_candidate(active_programmer_project,instructions)
                if ok:
                    print(f"[PROGRAMMER/PROG] Rewritten candidate ready for {active_programmer_project}. Review it, then type write to commit.")
                    print(msg)
                else:
                    print(f"[PROGRAMMER/PROG] rewrite FAILED: {msg}")
            continue
        prog_value=re.match(r"^prog\s+(?:value|tokens)(?:\s+([A-Za-z0-9._-]+))?$",clean_input,re.I)
        if prog_value:
            target=_prog_safe_name(prog_value.group(1)) if prog_value.group(1) else active_programmer_project
            if not target:
                print("[PROGRAMMER/PROG] No active project. Use prog value <project>.")
            else:
                ledger=_prog_load_token_ledger(target)
                print(f"[PROGRAMMER/PROG] {target}: processed_tokens={ledger.get('processed_tokens',0)} events={ledger.get('events',0)}")
                print(f"  valuation={json.dumps(ledger.get('valuation',{}),ensure_ascii=False)}")
                print(f"  by_activity={json.dumps(ledger.get('by_activity',{}),ensure_ascii=False)}")
            continue
        prog_comment=re.match(r"^prog\s+comment\s+([A-Za-z0-9._-]+)\s+([A-Za-z0-9._+-]+)\s+(.+)$",clean_input,re.I|re.S)
        if prog_comment:
            target=_prog_safe_name(prog_comment.group(1))
            filetype=prog_comment.group(2)
            body=prog_comment.group(3).strip()
            ok,msg=_prog_add_comment(target,filetype,body)
            if ok:
                _prog_record_text_tokens(target,body,"comment_context",f"comment:{filetype}")
            print(f"[PROGRAMMER/PROG] comment {'saved' if ok else 'FAILED'}: {msg}")
            if ok:
                active_programmer_project=target
                meta=_prog_read_metadata(target)
                if meta: _set_programmer_project_active(target,meta.get("language"),True)
            continue
        prog_comments=re.match(r"^prog\s+comments(?:\s+([A-Za-z0-9._-]+))?$",clean_input,re.I)
        if prog_comments:
            target=_prog_safe_name(prog_comments.group(1)) if prog_comments.group(1) else active_programmer_project
            if not target:
                print("[PROGRAMMER/PROG] No active project. Use prog comments <project>.")
            else:
                body=_prog_read_comments(target,24000)
                print(body.strip() if body.strip() else f"[PROGRAMMER/PROG] No comments recorded for {target}.")
            continue
        if cmd in ("prog prefs","programmer prefs"):
            _ensure_programmer_prefs()
            print(f"[PROGRAMMER/PROG] prefs: {PROGRAMMER_PREFS}")
            try: print(Path(PROGRAMMER_PREFS).read_text(encoding="utf-8",errors="ignore").rstrip())
            except OSError as exc: print(f"[PROGRAMMER/PROG] Could not read prefs: {exc}")
            continue
        prog_active=re.match(r"^prog\s+active\s+([A-Za-z0-9._-]+)$",clean_input,re.I)
        if prog_active:
            target=_prog_safe_name(prog_active.group(1)); meta=_prog_read_metadata(target)
            if not meta:
                print(f"[PROGRAMMER/PROG] No project metadata found for {target}.")
            else:
                ok,msg=_set_programmer_project_active(target,meta.get("language"),True)
                if ok: active_programmer_project=target
                print(f"[PROGRAMMER/PROG] {target}: {msg}")
            continue
        prog_inactive=re.match(r"^prog\s+inactive\s+([A-Za-z0-9._-]+)$",clean_input,re.I)
        if prog_inactive:
            target=_prog_safe_name(prog_inactive.group(1)); meta=_prog_read_metadata(target)
            if not meta:
                print(f"[PROGRAMMER/PROG] No project metadata found for {target}.")
            else:
                ok,msg=_set_programmer_project_active(target,meta.get("language"),False)
                if active_programmer_project==target: active_programmer_project=None
                print(f"[PROGRAMMER/PROG] {target}: {msg}")
            continue
        prog_new=re.match(r"^prog\s+new\s+([A-Za-z0-9._-]+)\s+([A-Za-z0-9._+-]+)$",clean_input,re.I)
        if prog_new:
            active_programmer_project=_prog_safe_name(prog_new.group(1))
            try:
                meta=_prog_scaffold(active_programmer_project,prog_new.group(2))
            except ValueError as exc:
                active_programmer_project=None
                print(f"[PROGRAMMER/PROG] {exc}")
                continue
            ok,state=_prog_start_project(active_programmer_project,False)
            print(f"[PROGRAMMER/PROG] Created and STARTED {active_programmer_project} ({meta.get('language')})")
            for stage,path in _prog_paths(active_programmer_project).items(): print(f"  {stage}: {path}")
            update_gui_chat("SYS",f"Programmer project created/started: {active_programmer_project} ({meta.get('language')})")
            continue
        prog_build=re.match(r"^prog\s+build(?:\s+([A-Za-z0-9._-]+))?$",clean_input,re.I)
        if prog_build:
            target=_prog_safe_name(prog_build.group(1)) if prog_build.group(1) else active_programmer_project
            if not target:
                print("[PROGRAMMER/PROG] No open project. Use prog start <project>.")
                continue
            if active_programmer_project and target!=active_programmer_project:
                print(f"[PROGRAMMER/PROG] {active_programmer_project} is the bound project. Use prog start {target} before building another project.")
                continue
            active_programmer_project=target
            _prog_record_text_tokens(target,clean_input,"build_command","prog build")
            ok,msg=_prog_build(target)
            print(f"[PROGRAMMER/PROG] build {'OK' if ok else 'FAILED'}: {msg}")
            continue
        prog_run=re.match(r"^prog\s+run(?:\s+([A-Za-z0-9._-]+))?$",clean_input,re.I)
        if prog_run:
            target=_prog_safe_name(prog_run.group(1)) if prog_run.group(1) else active_programmer_project
            if not target:
                print("[PROGRAMMER/PROG] No open project. Use prog start <project>.")
                continue
            if active_programmer_project and target!=active_programmer_project:
                print(f"[PROGRAMMER/PROG] {active_programmer_project} is the bound project. Use prog start {target} before running another project.")
                continue
            active_programmer_project=target
            _prog_record_text_tokens(target,clean_input,"run_command","prog run")
            ok,msg=_prog_run(target)
            print(f"[PROGRAMMER/PROG] run {'OK' if ok else 'FAILED'}: {msg}")
            continue
        prog_status=re.match(r"^prog\s+status(?:\s+([A-Za-z0-9._-]+))?$",clean_input,re.I)
        if prog_status:
            target=_prog_safe_name(prog_status.group(1)) if prog_status.group(1) else active_programmer_project
            print(f"[PROGRAMMER/PROG] {'ON' if programmer_mode_enabled else 'OFF'} | active={active_programmer_project or '(none)'}")
            if target:
                meta=_prog_read_metadata(target)
                print(json.dumps(meta,indent=2) if meta else f"No metadata for {target}")
                session=_prog_session_load(target)
                print(f"  session: status={session.get('status')} operation={session.get('last_operation')} progress={session.get('progress')}% label={session.get('progress_label')}")
                print(f"  last_updated: {session.get('last_updated_file') or '(none)'} @ {session.get('last_updated_time') or '(none)'}")
                print(f"  last_error: {session.get('last_error') or 'none'}")
                ledger=_prog_load_token_ledger(target)
                print(f"  token_ledger: processed_tokens={ledger.get('processed_tokens',0)} events={ledger.get('events',0)} valuation={ledger.get('valuation',{})}")
                for stage,path in _prog_paths(target).items():
                    try: files=[x for x in os.listdir(path) if x!="aitech_project.json"]
                    except OSError: files=[]
                    print(f"  {stage}: {files}")
            else:
                print("  projects: "+(", ".join(_prog_list_projects()) if _prog_list_projects() else "(none)"))
            continue

        shorthand=None
        for action in ("configure","compile","build","test","list"):
            m=re.match(rf"^{action}(?:\s+|<)([^>]+)>?$",clean_input,re.I)
            if m:
                shorthand=(action,m.group(1).strip())
                break
        if shorthand:
            action,arg=shorthand
            if not programmer_mode_enabled:
                print("[PROGRAMMER/PROG] Enter prog mode first.")
                continue
            if action=="list":
                ok,msg=_prog_list_code_folder(arg)
                print(msg if ok else f"[PROGRAMMER/PROG] list FAILED: {msg}")
                continue
            if not active_programmer_project:
                print(f"[PROGRAMMER/PROG] No open project for {action}. Use prog start <project>.")
                continue
            if action=="configure":
                ok,msg=_prog_configure_file(active_programmer_project,arg)
            elif action=="compile":
                ok,msg=_prog_compile_file(active_programmer_project,arg)
            elif action=="build":
                ok,msg=_prog_build_file(active_programmer_project,arg)
            else:
                ok,msg=_prog_test_file(active_programmer_project,arg)
            print(f"[PROGRAMMER/PROG] {action} {'OK' if ok else 'FAILED'}: {msg}")
            continue

        # While a project session is RUNNING, ordinary developer text is
        # project-bound by default. This is the key anti-drift rule: the model
        # receives the active project name, exact language, five stage paths,
        # programmer.prefs layout, language-specific Qwen prompt, and comments.
        _prog_reserved={
            "stop","go","o","eb","ec","wake","wake: qwen","be","ce","auto","cnsl","storeit",
            "history","h","?","menu","help","exit","quit","write"
        }
        if programmer_mode_enabled and active_programmer_project and _prog_project_open(active_programmer_project) and cmd not in _prog_reserved and not cmd.startswith(("stan","standard","gui:","spkr ","mic ","eyes ","img ","vid ","qwen:","define:","run:")):
            ok,msg=_prog_generate_request(active_programmer_project,clean_input)
            if ok:
                print(f"[PROGRAMMER/PROG] Applied developer request to bound project {active_programmer_project}.")
                for detail in msg.get("details",[]): print(f"  {detail}")
            else:
                print(f"[PROGRAMMER/PROG] Bound request failed: {msg}")
            continue

        if programmer_mode_enabled and active_programmer_project and not _prog_project_open(active_programmer_project) and cmd not in _prog_reserved and not cmd.startswith("prog "):
            state=_prog_session_load(active_programmer_project)
            print(f"[PROGRAMMER/PROG] Project {active_programmer_project} is {state.get('status')}. Use prog resume {active_programmer_project} before project-directed model work.")
            continue

        if cmd in ("stan","standard","stan on","standard on","stan retry","standard retry"):
            standard_mode_enabled=True
            _persist_standard_mode(True)
            print("[STANDARD/STAN] ON — checking configured dependencies...")
            _stan_dependency_health(offer_install=True)
            update_gui_chat("SYS","STANDARD/STAN enabled/rechecked")
            continue
        if cmd in ("stan off","standard off"):
            standard_mode_enabled=False
            _persist_standard_mode(False)
            standard_disabled_programs.clear()
            print("[STANDARD/STAN] OFF")
            continue
        if cmd in ("stan status","standard status"):
            print(f"[STANDARD/STAN] {'ON' if standard_mode_enabled else 'OFF'}")
            states=_read_standard_dependency_states(_standard_required_programs())
            for info in states.values():
                print(f"  {info['program']}: installed={info['state']}")
            print(f"  image={STANDARD_IMAGE_PROGRAM_CFG} command={'configured' if STANDARD_IMAGE_COMMAND_CFG else 'blank'} endpoint={STANDARD_IMAGE_ENDPOINT_CFG}")
            print(f"  video={STANDARD_VIDEO_PROGRAM_CFG} command={'configured' if STANDARD_VIDEO_COMMAND_CFG else 'blank'} endpoint={STANDARD_VIDEO_ENDPOINT_CFG}")
            print(f"  audio={STANDARD_AUDIO_PROGRAM_CFG} command={'configured' if STANDARD_AUDIO_COMMAND_CFG else 'blank'} endpoint={STANDARD_AUDIO_ENDPOINT_CFG}")
            print(f"  installer={_standard_installer_path()}")
            continue

        if cmd in ["?", "menu", "help"]:
            header_expanded = not header_expanded
            if use_pinned_terminal:
                clear_and_init_ui()
            else:
                print("Commands: storeit, analyze, wake, cnsl, weights rebuild, be, ce, auto, eb, ec, o, stop, go")
                print("Stances: rest, stand, sit, walk, jog, run, sprint")
                print(
                    f"Sensory: TCP {SENSORY_LEFT_EAR_TCP_IP_CFG}:{SENSORY_LEFT_EAR_TCP_PORT_CFG}, "
                    f"UDP {SENSORY_RIGHT_EAR_UDP_IP_CFG}:{SENSORY_RIGHT_EAR_UDP_PORT_CFG}, "
                    f"HTTP {SENSORY_MOUTH_HTTP_IP_CFG}:{SENSORY_MOUTH_HTTP_PORT_CFG}"
                )
                print("Headset emulator: spkr -u/-d inputs | mic -u/-d HTTP output")
            continue

        speed_map = {
            "rest": 1.0,
            "stand": 1.7,
            "sit": 2.0,
            "walk": 2.5,
            "jog": 2.7,
            "run": 2.9,
            "sprint": 3.6,
        }
        if cmd in speed_map:
            idle_speed_multiplier = speed_map[cmd]
            update_gui_chat("SYS", f"Stance: {cmd.upper()} ({idle_speed_multiplier}x)")
            print(
                f"\n[Master Clock] Stance changed to {cmd.upper()}. "
                f"Background rhythm: {idle_speed_multiplier}x."
            )
            continue

        # --- TRAINING MODE, IN THIS TERMINAL ---
        # AItech already switches mode on a short keyword: prog, stan. Training
        # joins that set rather than opening a window. run_training_mode is an
        # ordinary in-process function that prints and prompts, so it runs on the
        # display already in use -- output scrolls above, the input box stays
        # pinned at the bottom, and the user keeps typing where they were.
        #
        # A self-tool with mode = mode queues the same switch, so <aitech
        # tool="train_base"> and typing "train base" arrive at exactly one place.
        _mode_request = None
        if cmd in ("train", "train base", "train_base", "training"):
            _mode_request = "train base"
        elif cmd in ("train knowledge", "train_knowledge", "train k"):
            _mode_request = "train knowledge"
        else:
            try:
                _queued = take_pending_mode_request()
            except Exception:
                _queued = None
            if _queued:
                _mode_request = _queued[0]

        if _mode_request:
            _prev_mode = current_mode
            current_mode = "training"
            mode_history.append("training")
            gui_self_tool_note(f"mode: {_mode_request}")
            print(f"\n[Mode] {_mode_request} — running here in this terminal. "
                  f"Output scrolls above; your input box stays put.")
            print("[Mode] Everything about what and how to train is yours to choose below.\n")
            try:
                if _mode_request == "train knowledge":
                    print("[Mode] Knowledge-model training is owned by the knowledge engine.")
                    print("       Start it from the AItech menu, or run the knowledge engine and")
                    print("       choose training there. Nothing was changed.")
                else:
                    run_training_mode()
            except SystemExit as exc:
                # Training exits the process on failure. In chat that would end
                # the session, so it is caught and reported instead.
                print(f"\n[Mode] Training ended early (exit {exc.code}). Returning to chat.")
            except KeyboardInterrupt:
                print("\n[Mode] Training interrupted. Returning to chat.")
            except Exception as exc:
                print(f"\n[Mode] Training failed: {type(exc).__name__}: {exc}")
            current_mode = _prev_mode
            mode_history.append(_prev_mode)
            gui_self_tool_note(f"mode: returned to {_prev_mode}")
            print("\n[Mode] Back in chat.")
            try:
                _move_to_scroll()
            except Exception:
                pass
            continue

        # --- GUI TELEMETRY / EXPANSION COMMANDS ---
        # `gui: telemetry` is the historical toggle used by the Swing/textart HUD.
        # `gui: on` / `gui: hud` explicitly enable it and `gui: off` disables it,
        # which avoids an "off" command accidentally turning telemetry back on.
        if cmd.startswith("gui:"):
            target = cmd[4:].strip()
            if target == "telemetry":
                gui_telemetry_active = not gui_telemetry_active
            elif target in ("selftools", "self-tools", "tools"):
                # A pane rather than a window: the GUI already scrolls between
                # panes with the arrow keys, so a new view belongs there.
                gui_selftools_active = not gui_selftools_active
                print(f"\n[System] Self-tools pane "
                      f"{'shown' if gui_selftools_active else 'hidden'}. "
                      f"Arrow keys scroll between panes.")
            elif target in ["on", "hud"]:
                gui_telemetry_active = True
            elif target == "off":
                gui_telemetry_active = False
            else:
                print("\n[System] Unknown GUI command. Try 'gui: telemetry', "
                      "'gui: selftools', 'gui: on', or 'gui: off'.")
                continue

            state_str = "ONLINE" if gui_telemetry_active else "OFFLINE"
            print(f"\n[System] GUI Telemetry HUD is now {state_str}.")
            print("         Click into the GUI window and use the Left/Right Arrow keys to cycle views.")
            update_gui_chat("SYS", f"Telemetry HUD {state_str}")

            # Force an immediate textart refresh so the telemetry view appears or
