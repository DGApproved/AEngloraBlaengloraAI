def ping_qwen(prompt_text, as_archivist=False, explicit=False):
    """Scan Qwen/gateway endpoints unless developer STOP has frozen autonomous flow."""
    if developer_flow_paused and not explicit:
        return "[Qwen paused by developer STOP]"
    map_reference = get_qwen_map_reference()
    runtime_reference = get_qwen_runtime_config_reference()
    self_source_reference = get_aitech_self_source_reference(prompt_text, max_chars=16000)
    if runtime_reference:
        map_reference = (map_reference + "\n\n" + runtime_reference).strip()
    if self_source_reference:
        map_reference = (map_reference + "\n\n" + self_source_reference).strip()
    if as_archivist:
        prompt = prompt_text
        if map_reference:
            prompt += f"\n\n<AItechCapabilityReference>\n{map_reference}\n</AItechCapabilityReference>\n"
    else:
        system_header = _prompt_header(
            "QWEN_CORTEX",
            "You are Qwen, the logical Prefrontal Cortex of a dual-engine AI. Interpret the trainable model's abstract data and help manage semantic memory. "
            "Preserve source identity. If you relay or consult an online LLM, append an <AItechRemoteSource> block containing REMOTE_PROVIDER, REMOTE_MODEL, "
            "REMOTE_VERSION and REMOTE_RESPONSE_ID when known. Do not invent unknown identifiers."
        )
        system_context = system_header + "\n" + get_semantic_schema_prompt()
        if map_reference:
            system_context += f"\n\n<AItechCapabilityReference>\n{map_reference}\n</AItechCapabilityReference>"
        prompt = (
            f"<|im_start|>system\n{system_context}<|im_end|>\n"
            f"<|im_start|>user\n{prompt_text}<|im_end|>\n"
            "<|im_start|>assistant\n"
        )

    max_tokens = QWEN_ARCHIVIST_MAX_CFG if as_archivist else QWEN_RESPONSE_MAX_CFG
    daemons = [
        {
            "name": "KoboldCpp", "protocol": "http",
            "host": QWEN_KOBOLDCPP_IP_CFG, "port": QWEN_KOBOLDCPP_PORT_CFG,
            "path": "/api/v1/generate",
            "payload": {"prompt": prompt, "max_length": max_tokens, "temperature": QWEN_TEMPERATURE_CFG, "stop_sequence": ["<|im_end|>"]},
            "extract": lambda r: r["results"][0]["text"].strip(),
        },
        {
            "name": "Ollama", "protocol": "http",
            "host": QWEN_OLLAMA_IP_CFG, "port": QWEN_OLLAMA_PORT_CFG,
            "path": "/api/generate",
            "payload": {"model": QWEN_MODEL_NAME_CFG, "prompt": prompt, "stream": False, "raw": True, "options": {"temperature": QWEN_TEMPERATURE_CFG, "num_predict": max_tokens}},
            "extract": lambda r: r.get("response", "").strip(),
        },
        {
            "name": "LM Studio", "protocol": "http",
            "host": QWEN_LMSTUDIO_IP_CFG, "port": QWEN_LMSTUDIO_PORT_CFG,
            "path": "/v1/completions",
            "payload": {"prompt": prompt, "max_tokens": max_tokens, "temperature": QWEN_TEMPERATURE_CFG, "stop": ["<|im_end|>"]},
            "extract": lambda r: r["choices"][0]["text"].strip(),
        },
        {
            # SillyTavern is a gateway/front-end, so an open port alone does not
            # guarantee generation. This common backend route is attempted and
            # cleanly skipped if the user's SillyTavern setup expects another API.
            "name": "SillyTavern", "protocol": "http",
            "host": QWEN_SILLYTAVERN_IP_CFG, "port": QWEN_SILLYTAVERN_PORT_CFG,
            "path": "/api/backends/chat-completions/generate",
            "payload": {
                "messages": [
                    {"role": "system", "content": (
                        _prompt_header("QWEN_CORTEX", "You are Qwen, the logical Prefrontal Cortex of a dual-engine AI.")
                        + ("\n\n" + map_reference if map_reference else "")
                    )},
                    {"role": "user", "content": prompt_text},
                ],
                "model": QWEN_MODEL_NAME_CFG,
                "stream": False,
                "temperature": QWEN_TEMPERATURE_CFG,
                "max_tokens": max_tokens,
            },
            "extract": lambda r: (
                (r.get("choices") or [{}])[0].get("message", {}).get("content")
                or (r.get("choices") or [{}])[0].get("text")
                or r.get("response", "")
            ).strip(),
        },
        {
            # AItech's 5678 roommate is deliberately last: it is a raw TCP local
            # model fallback, not an external Qwen HTTP backend.
            "name": "AItech Local", "protocol": "tcp-query",
            "host": QWEN_LOCAL_IP_CFG, "port": QWEN_LOCAL_PORT_CFG,
        },
    ]

    scanned = []
    for daemon in daemons:
        host, port = daemon["host"], daemon["port"]
        scanned.append(f"{daemon['name']}={host}:{port}")
        with socket.socket(socket.AF_INET, socket.SOCK_STREAM) as probe:
            probe.settimeout(QWEN_PORT_SCAN_TIMEOUT_CFG)
            if probe.connect_ex((host, port)) != 0:
                continue
        try:
            if daemon["protocol"] == "tcp-query":
                with socket.create_connection((host, port), timeout=QWEN_HTTP_TIMEOUT_CFG) as sock:
                    sock.sendall(("QUERY:" + prompt_text).encode("utf-8"))
                    sock.settimeout(QWEN_HTTP_TIMEOUT_CFG)
                    chunks = []
                    while True:
                        try:
                            part = sock.recv(4096)
                        except socket.timeout:
                            break
                        if not part:
                            break
                        chunks.append(part)
                        if sum(map(len, chunks)) >= 262144:
                            break
                    result = b"".join(chunks).decode("utf-8", errors="ignore").strip()
                    if result:
                        identity = ensure_qwen_source_identity(daemon)
                        clean_result, remote = _extract_remote_model_provenance(result)
                        record_qwen_observation(identity, clean_result, remote)
                        return clean_result
                continue

            url = f"http://{host}:{port}{daemon['path']}"
            req = urllib.request.Request(
                url,
                data=json.dumps(daemon["payload"]).encode("utf-8"),
                headers={"Content-Type": "application/json"},
            )
            with urllib.request.urlopen(req, timeout=QWEN_HTTP_TIMEOUT_CFG) as response:
                result = json.loads(response.read().decode("utf-8"))
                text = daemon["extract"](result).replace("<|im_end|>", "").strip()
                if text:
                    identity = ensure_qwen_source_identity(daemon, result)
                    clean_text, remote = _extract_remote_model_provenance(text)
                    record_qwen_observation(identity, clean_text, remote)
                    return clean_text
        except Exception as exc:
            print(f"  [Bridge Debug] {daemon['name']} at {host}:{port} is reachable but generation failed: {exc}")
            continue

    return "[Cloud/local agent unavailable on configured scan list: " + "; ".join(scanned) + "]"

def peek_oldest_swap_chunk(lines_to_read=None):
    if lines_to_read is None:
        lines_to_read = QWEN_SWAP_LINES_CFG
    """Reads the oldest N lines from the swap file without deleting them."""
    if not os.path.exists(SWAP_FILE):
        return None, None
    try:
        with open(SWAP_FILE, "r", encoding="utf-8") as f:
            lines = f.readlines()
        if not lines:
            return None, None
            
        chunk = lines[:lines_to_read]
        remaining = lines[lines_to_read:]
        
        # Clean the raw swap tokens back into readable text for Qwen
        cleaned_chunk = "".join(chunk).replace("[", "").replace("] ", "").replace("]\n", " ").replace("↵", "\n").strip()
        return (cleaned_chunk if cleaned_chunk else None), remaining
    except Exception:
        return None, None

def commit_swap_removal(remaining_lines):
    """Physically removes the processed lines from the swap file."""
    try:
        with open(SWAP_FILE, "w", encoding="utf-8") as f:
            f.writelines(remaining_lines)
    except Exception:
        pass

def process_swap_with_qwen():
    if developer_flow_paused or is_ponder_paused:
        return False
    oldest_data, remaining_lines = peek_oldest_swap_chunk()
    if not oldest_data:
        return False
        
    sys.stdout.write(f"\r\033[K[Archivist] Processing oldest swap data losslessly...\n")
    schema_str = "\n".join([f"- {f}: {s.get('role')} (Accepts: {s.get('accepts')})" for f, s in MEMORY_SEMANTICS.items()])
    
    # The prompt forces Qwen to "train" the text files losslessly. The role/header
    # itself is user-editable in dgapi/prompts.txt; dynamic schema and source data
    # remain assembled here so edits cannot accidentally erase the routing payload.
    archivist_header = _prompt_header(
        "SEMANTIC_ARCHIVIST",
        "You are the Semantic Archivist. Losslessly convert raw memory into human-readable semantic text records."
    )
    prompt = (
        f"<|im_start|>system\n{archivist_header}\n"
        "I will provide a chunk of raw, chaotic memory from the swap drive.\n"
        "Extract any coherent facts, decisions, definitions, or lore, and route them to the correct text 'model' using XML.\n\n"
        "Available Models:\n"
        f"{schema_str}\n"
        "- trash.xtx: UNRESOLVED ENTROPY (Accepts: Abstract mathematical noise or unresolved data that cannot be categorized. NEVER DELETE DATA. Route 'garbage' here.)\n\n"
        "Output format example:\n"
        '<file path="session.noq/dgapi/datas/facts_2.txt">The UMA limit is 8192 tokens.</file>\n'
        '<file path="session.noq/data/memory/trash.xtx">Uncategorizable noise: [eng] [D] to [Silicon]</file>\n'
        "You MUST encapsulate 100% of the input data into <file> tags. Lossless conversion is mandatory.<|im_end|>\n"
        f"<|im_start|>user\nAnalyze this raw swap data losslessly:\n{oldest_data}<|im_end|>\n"
        "<|im_start|>assistant\n"
    )
    
    qwen_reply = ping_qwen(prompt, as_archivist=True)
    
    sys.stdout.write(f"\r\033[K[Qwen -> Archivist] Routing data losslessly to Semantic Text Models:\n{qwen_reply[:150]}...\n")
    sys.stdout.flush()
    
    parse_and_render_response(qwen_reply)
    
    # Commit removal ONLY AFTER successful processing and writing
    commit_swap_removal(remaining_lines)
        
    return True

