def _ensure_programmer_prefs():
    os.makedirs(CODE_DIR,exist_ok=True)
    if not os.path.isfile(PROGRAMMER_PREFS):
        Path(PROGRAMMER_PREFS).write_text(PROGRAMMER_PREFS_DEFAULT,encoding="utf-8")

def _prefs_split_list(value,left="[",right="]"):
    value=str(value or "").strip()
    if value.startswith(left) and value.endswith(right):
        value=value[1:-1]
    if not value.strip():
        return []
    return [x.strip() for x in value.split(",") if x.strip()]

def _read_programmer_prefs():
    """Parse programmer.prefs while allowing developer-added language sections."""
    _ensure_programmer_prefs()
    result={}; current=None
    try:
        for raw in Path(PROGRAMMER_PREFS).read_text(encoding="utf-8",errors="ignore").splitlines():
            line=raw.strip()
            if not line or line.startswith("#"): continue
            if line.startswith("[") and line.endswith("]"):
                current=line[1:-1].strip().lower()
                if current:
                    result.setdefault(current,{"source":[],"configure":[],"build":[],"program":[],"comments":[],"qwen prompt":"","active projects":[]})
                continue
            if current and "=" in line:
                key,val=[x.strip() for x in line.split("=",1)]
                key=key.lower()
                if key in ("source","configure","build","program","comments"):
                    result[current][key]=_prefs_split_list(val,"[","]")
                elif key=="qwen prompt":
                    result[current][key]=val.strip().strip('"').strip("'")
                elif key=="active projects":
                    result[current][key]=_prefs_split_list(val,"{","}")
    except OSError:
        pass
    return result

def _write_programmer_active_projects(language,projects):
    """Rewrite only one language's active-project line; preserve all other prefs text."""
    _ensure_programmer_prefs()
    language=str(language or "").lower().strip()
    safe=[]; seen=set()
    for project in projects:
        project=_prog_safe_name(project)
        if project and project not in seen:
            seen.add(project); safe.append(project)
    lines=Path(PROGRAMMER_PREFS).read_text(encoding="utf-8",errors="ignore").splitlines()
    inside=False; found=False
    for i,line in enumerate(lines):
        stripped=line.strip()
        if stripped.startswith("[") and stripped.endswith("]"):
            section=stripped[1:-1].strip().lower()
            if inside and section!=language: break
            inside=(section==language)
            continue
        if inside and stripped.lower().startswith("active projects") and "=" in stripped:
            lines[i]="active projects = {"+", ".join(safe)+"}"
            found=True
            break
    if found:
        Path(PROGRAMMER_PREFS).write_text("\n".join(lines)+"\n",encoding="utf-8")
    return found

def _set_programmer_project_active(project,language=None,active=True):
    project=_prog_safe_name(project)
    if language is None:
        language=_prog_read_metadata(project).get("language","")
    language=_prog_language(language)
    prefs=_read_programmer_prefs()
    if language not in prefs:
        return False,f"Language [{language}] is not present in programmer.prefs."
    projects=list(prefs[language].get("active projects",[]))
    if active and project not in projects:
        projects.append(project)
    if not active:
        projects=[x for x in projects if x!=project]
    if not _write_programmer_active_projects(language,projects):
        return False,f"Could not update active projects for [{language}]."
    return True,("activated" if active else "deactivated")

def _programmer_layout(language):
    language=_prog_language(language)
    return _read_programmer_prefs().get(language)

