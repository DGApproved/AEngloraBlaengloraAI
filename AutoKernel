def _log_write_to_ledger(file_path, content, source="knowledge_engine"):
    import hashlib
    entry = {
        "file":         str(file_path),
        "content_head": content[:300],
        "content_hash": hashlib.md5(
            content.encode("utf-8", errors="ignore")
        ).hexdigest()[:12],
        "source":       source,
        "timestamp":    time.time(),
        "resolved":     False,
    }
    try:
        existing = []
        if os.path.exists(COLLISION_LEDGER):
            with open(COLLISION_LEDGER, "r", encoding="utf-8") as f:
                existing = json.load(f)
        cutoff = time.time() - 60.0
        existing = [e for e in existing if e.get("timestamp", 0) > cutoff]
        existing.append(entry)
        tmp = COLLISION_LEDGER + ".ke_tmp"
        with open(tmp, "w", encoding="utf-8") as f:
            json.dump(existing, f)
        os.replace(tmp, COLLISION_LEDGER)
    except Exception:
        pass

