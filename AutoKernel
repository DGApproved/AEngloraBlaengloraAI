TRAINING_CONTINUITY_DIR = os.path.join(SYSTEM_DIR, "training_continuity")
TRAINING_CONTINUITY_SESSIONS = os.path.join(TRAINING_CONTINUITY_DIR, "sessions.jsonl")
TRAINING_CONTINUITY_EVENTS = os.path.join(TRAINING_CONTINUITY_DIR, "events.jsonl")
try:
    os.makedirs(TRAINING_CONTINUITY_DIR, exist_ok=True)
except OSError:
    pass


def _continuity_append(path, obj):
    try:
        os.makedirs(os.path.dirname(path), exist_ok=True)
        with open(path, "a", encoding="utf-8") as fh:
            fh.write(json.dumps(obj, ensure_ascii=False, sort_keys=True) + "\n")
    except OSError:
        pass


def _continuity_token_ids(tokenizer, text):
    """Measurement/segmentation tokenizer path: no model forward pass occurs here."""
    try:
        return tokenizer(
            str(text), add_special_tokens=False, truncation=False,
            padding=False, verbose=False
        )["input_ids"]
    except TypeError:
        return tokenizer.encode(str(text), add_special_tokens=False)


def _continuity_decode(tokenizer, ids):
    try:
        return tokenizer.decode(
            list(ids), skip_special_tokens=False,
            clean_up_tokenization_spaces=False
        )
    except TypeError:
        return tokenizer.decode(list(ids), skip_special_tokens=False)


def _continuity_terms(text, limit=32):
    stop = {
        "this","that","with","from","have","what","when","then","they","their",
        "there","would","could","should","about","because","which","while","into",
        "user","assistant","system","text","file","source","window","training"
    }
    counts = {}
    for word in re.findall(r"[A-Za-z0-9_]{4,}", str(text).lower()):
        if word in stop:
            continue
        counts[word] = counts.get(word, 0) + 1
    return [w for w,_ in sorted(counts.items(), key=lambda kv: (-kv[1], kv[0]))[:limit]]


def _continuity_source_label(record_text, index):
    m = re.search(r"\[FILE:\s*([^\]]+)\]", str(record_text))
    if m:
        return m.group(1).strip()
    m = re.search(r"User:\s*Analyze\s+([^\n]+)", str(record_text))
    if m:
        return m.group(1).strip()[:180]
    return f"record-{index:06d}"


def _load_recent_training_sessions(limit=8):
    rows = []
    try:
        with open(TRAINING_CONTINUITY_SESSIONS, "r", encoding="utf-8", errors="ignore") as fh:
            for raw in fh:
                try:
                    item = json.loads(raw)
                except Exception:
                    continue
                if item.get("event") in {"SESSION_PREPARED", "SESSION_COMPLETE"}:
                    rows.append(item)
    except OSError:
        pass
    latest = {}
    order = []
    for item in rows:
        sid = item.get("session_id")
        if not sid:
            continue
        if sid not in latest:
            order.append(sid)
        latest[sid] = item
    return [latest[sid] for sid in order[-limit:]]


def _bounded_training_record(tokenizer, header, body_ids, max_tokens):
    """Serialize one observation window and guarantee it fits max_tokens."""
    header_ids = _continuity_token_ids(tokenizer, header)
    reserve = max(16, min(192, max_tokens // 8))
    body_budget = max(16, int(max_tokens) - len(header_ids) - reserve)
    chosen = list(body_ids[:body_budget])
    body = _continuity_decode(tokenizer, chosen)
    record = header + body + "\n[/SOURCE_WINDOW]"
    while len(chosen) > 16 and len(_continuity_token_ids(tokenizer, record)) > max_tokens:
        chosen = chosen[:-max(8, len(chosen)//32)]
        body = _continuity_decode(tokenizer, chosen)
        record = header + body + "\n[/SOURCE_WINDOW]"
    return record, len(chosen)


def _hierarchical_source_records(
    record_text, tokenizer, record_index, logical_window_tokens,
    batch_window_tokens, overlap_tokens=96
):
    ids = _continuity_token_ids(tokenizer, record_text)
    total = len(ids)
    if total <= batch_window_tokens:
        return [record_text], {
            "oversized": False, "source_tokens": total,
            "logical_parents": 1, "neural_windows": 1
        }

    source_label = _continuity_source_label(record_text, record_index)
    source_hash = hashlib.sha256(
        str(record_text).encode("utf-8", errors="ignore")
    ).hexdigest()
    logical_window_tokens = max(batch_window_tokens, int(logical_window_tokens))
    logical_payload = max(64, logical_window_tokens - 256)
    batch_window_tokens = max(64, int(batch_window_tokens))
    overlap_tokens = max(0, min(int(overlap_tokens), max(0, batch_window_tokens // 8)))

    parent_ranges = []
    pstart = 0
    while pstart < total:
        pend = min(total, pstart + logical_payload)
        parent_ranges.append((pstart, pend))
        pstart = pend

    out = [
        "[SOURCE_PRELUDE]\n"
        f"SOURCE_ID=sha256:{source_hash}\n"
        f"SOURCE_LABEL={source_label}\n"
        f"ORIGINAL_TOKEN_COUNT={total}\n"
        f"LOGICAL_PARENT_LIMIT={logical_window_tokens}\n"
        f"NEURAL_BATCH_LIMIT={batch_window_tokens}\n"
        f"LOGICAL_PARENT_COUNT={len(parent_ranges)}\n"
        "RULE=Every SOURCE_WINDOW belongs to the same original record. "
        "Window boundaries are navigation boundaries unless source semantics "
        "independently show completion. Bridges are derived navigation.\n"
        "[/SOURCE_PRELUDE]"
    ]

    neural_index = 0
    previous_global_end = None
    total_neural = 0
    for parent_index, (parent_start, parent_end) in enumerate(parent_ranges, 1):
        parent_ids = ids[parent_start:parent_end]
        local_cursor = 0
        local_window_no = 0
        while local_cursor < len(parent_ids):
            neural_index += 1
            local_window_no += 1
            global_start = parent_start + local_cursor
            header = (
                "[SOURCE_WINDOW]\n"
                f"SOURCE_ID=sha256:{source_hash}\n"
                f"SOURCE_LABEL={source_label}\n"
                f"LOGICAL_PARENT={parent_index}/{len(parent_ranges)}\n"
                f"NEURAL_WINDOW_INDEX={neural_index}\n"
                f"SOURCE_TOKEN_START={global_start}\n"
                "WINDOW_ROLE=OBSERVATION\n"
                "CONTENT_START\n"
            )
            rec, consumed = _bounded_training_record(
                tokenizer, header, parent_ids[local_cursor:], batch_window_tokens
            )
            if consumed <= 0:
                break
            global_end = min(parent_end, global_start + consumed)
            rec = rec.replace(
                "WINDOW_ROLE=OBSERVATION\n",
                f"SOURCE_TOKEN_END={global_end}\nWINDOW_ROLE=OBSERVATION\n"
            )
            if previous_global_end is not None:
                bridge_name = (
                    "PARENT_BRIDGE"
                    if local_window_no == 1 and parent_index > 1
                    else "SUBWINDOW_BRIDGE"
                )
                out.append(
                    f"[{bridge_name}]\n"
                    f"SOURCE_ID=sha256:{source_hash}\n"
                    f"FROM_SOURCE_TOKEN={previous_global_end}\n"
                    f"TO_SOURCE_TOKEN={global_start}\n"
                    f"FROM_WINDOW={neural_index-1}\n"
                    f"TO_WINDOW={neural_index}\n"
                    "RELATION=ordered continuation of the same original source; "
                    "the next observation may continue, qualify, contrast, or "
                    "complete the previous observation.\n"
                    "INTERPRETATION_STATUS=DERIVED_NAVIGATION\n"
                    f"[/{bridge_name}]"
                )
            out.append(rec)
            total_neural += 1
            previous_global_end = global_end
            if global_end >= parent_end:
                break
            local_cursor += max(1, consumed - overlap_tokens)

    out.append(
        "[SOURCE_END]\n"
        f"SOURCE_ID=sha256:{source_hash}\n"
        f"SOURCE_LABEL={source_label}\n"
        f"ORIGINAL_TOKEN_COUNT={total}\n"
        f"LOGICAL_PARENT_COUNT={len(parent_ranges)}\n"
        f"NEURAL_WINDOW_COUNT={total_neural}\n"
        "RELATION=All preceding windows and bridges belong to one original "
        "record. Intermediate boundaries were navigation boundaries; this marks "
        "the prepared end of the original record.\n"
        "[/SOURCE_END]"
    )
    return out, {
        "oversized": True,
        "source_tokens": total,
        "logical_parents": len(parent_ranges),
        "neural_windows": total_neural,
        "source_hash": source_hash,
        "source_label": source_label,
    }


def prepare_hierarchical_training_corpus(
    corpus, tokenizer, engine_name, logical_window_tokens, batch_window_tokens,
    decay_mode="", prior_session_limit=4
):
    """Translate oversized records and prepend cross-session navigation."""
    now = time.time()
    corpus_digest = hashlib.sha256()
    labels = []
    term_counts = {}
    for idx, record in enumerate(corpus):
        raw = str(record)
        corpus_digest.update(raw.encode("utf-8", errors="ignore"))
        corpus_digest.update(b"\0")
        labels.append(_continuity_source_label(raw, idx))
        for term in _continuity_terms(raw, 24):
            term_counts[term] = term_counts.get(term, 0) + 1

    unique_labels = sorted(set(labels))
    top_terms = [w for w,_ in sorted(term_counts.items(), key=lambda kv: (-kv[1], kv[0]))[:64]]
    seed = (
        f"{engine_name}|{now}|{os.getpid()}|{corpus_digest.hexdigest()}|"
        f"{logical_window_tokens}|{batch_window_tokens}"
    )
    session_id = (
        time.strftime("TS-%Y%m%d-%H%M%S") + "-" +
        hashlib.sha256(seed.encode("utf-8")).hexdigest()[:10]
    )

    prior = _load_recent_training_sessions(prior_session_limit)
    linked_prior = []
    translated = [
        "[SESSION_PRELUDE]\n"
        f"TRAINING_SESSION_ID={session_id}\n"
        f"ENGINE={str(engine_name).upper()}\n"
        f"ORIGINAL_RECORD_COUNT={len(corpus)}\n"
        f"CORPUS_DIGEST=sha256:{corpus_digest.hexdigest()}\n"
        f"LOGICAL_WINDOW_TOKENS={int(logical_window_tokens)}\n"
        f"NEURAL_BATCH_TOKENS={int(batch_window_tokens)}\n"
        f"DECAY_MODE={decay_mode or 'unspecified'}\n"
        "RULE=This run is one historical training session. It may continue or "
        "revise earlier sessions without replacing their records.\n"
        "[/SESSION_PRELUDE]"
    ]

    current_labels = set(unique_labels)
    current_terms = set(top_terms)
    for old in prior:
        old_id = old.get("session_id")
        if not old_id or old_id == session_id:
            continue
        shared_labels = sorted(current_labels & set(old.get("source_labels", [])))[:16]
        shared_terms = sorted(current_terms & set(old.get("semantic_terms", [])))[:24]
        if shared_labels or shared_terms or not linked_prior:
            linked_prior.append(old_id)
            translated.append(
                "[SESSION_BRIDGE]\n"
                f"FROM_SESSION={old_id}\n"
                f"TO_SESSION={session_id}\n"
                f"FROM_ENGINE={old.get('engine','UNKNOWN')}\n"
                f"TO_ENGINE={str(engine_name).upper()}\n"
                f"SHARED_SOURCE_LABELS={json.dumps(shared_labels, ensure_ascii=False)}\n"
                f"SHARED_SEMANTIC_TERMS={json.dumps(shared_terms, ensure_ascii=False)}\n"
                "RELATION=historical continuity candidate. Shared material may "
                "be continued, revised, contradicted, specialized, or unused.\n"
                "INTERPRETATION_STATUS=DERIVED_NAVIGATION\n"
                "[/SESSION_BRIDGE]"
            )

    oversized_count = 0
    logical_parent_count = 0
    neural_window_count = 0
    for idx, record in enumerate(corpus):
        prepared, info = _hierarchical_source_records(
            str(record), tokenizer, idx,
            logical_window_tokens=logical_window_tokens,
            batch_window_tokens=batch_window_tokens,
        )
        translated.extend(prepared)
        oversized_count += int(bool(info.get("oversized")))
        logical_parent_count += int(info.get("logical_parents", 0) or 0)
        neural_window_count += int(info.get("neural_windows", 0) or 0)

    translated.append(
        "[SESSION_END]\n"
        f"TRAINING_SESSION_ID={session_id}\n"
        f"ORIGINAL_RECORD_COUNT={len(corpus)}\n"
        f"PREPARED_RECORD_COUNT={len(translated)+1}\n"
        f"OVERSIZED_RECORDS_TRANSLATED={oversized_count}\n"
        f"LOGICAL_PARENT_COUNT={logical_parent_count}\n"
        f"NEURAL_WINDOW_COUNT={neural_window_count}\n"
        f"LINKED_PRIOR_SESSIONS={json.dumps(linked_prior)}\n"
        "RELATION=This ends the prepared corpus for this run, not the wider "
        "training history. Future sessions may bridge back to this session.\n"
        "[/SESSION_END]"
    )

    summary = {
        "event": "SESSION_PREPARED",
        "status": "PREPARED",
        "time": time.strftime("%Y-%m-%dT%H:%M:%S"),
        "epoch": now,
        "session_id": session_id,
        "engine": str(engine_name).upper(),
        "decay_mode": decay_mode,
        "corpus_digest": corpus_digest.hexdigest(),
        "original_record_count": len(corpus),
        "prepared_record_count": len(translated),
        "oversized_records_translated": oversized_count,
        "logical_parent_count": logical_parent_count,
        "neural_window_count": neural_window_count,
        "logical_window_tokens": int(logical_window_tokens),
        "batch_window_tokens": int(batch_window_tokens),
        "linked_prior_sessions": linked_prior,
        "source_labels": unique_labels[:512],
        "semantic_terms": top_terms,
    }
    _continuity_append(TRAINING_CONTINUITY_SESSIONS, summary)
    _continuity_append(TRAINING_CONTINUITY_EVENTS, summary)
    return translated, summary


def finalize_training_continuity_session(session_summary, status="COMPLETE", metrics=None):
    if not session_summary:
        return
    final = dict(session_summary)
    final.update({
        "event": "SESSION_COMPLETE" if status == "COMPLETE" else "SESSION_FINISHED",
        "status": status,
        "completed_time": time.strftime("%Y-%m-%dT%H:%M:%S"),
        "metrics": metrics or {},
    })
    _continuity_append(TRAINING_CONTINUITY_SESSIONS, final)
    _continuity_append(TRAINING_CONTINUITY_EVENTS, final)



