# ---------------------------------------------------------------------------
# PYTHON PREREQUISITE RESOLVER
# ---------------------------------------------------------------------------
# Pillow is a hard dependency of the multimodal/image-decay path.  Keep this
# requirement outside the first-run versions.prefs template as well, because an
# existing installation may already have an older prefs file that predates it.
#
# Dependencies are checked locally *before* pip is invoked.  A satisfied
# requirement is left untouched, so setup does not redownload/reinstall packages
# merely because the generator was run again.  Versioned requirements such as
# transformers>=5 are also checked against installed distribution metadata.
REQUIRED_ML_PACKAGES="torch transformers>=5 datasets pillow numpy psutil gguf"

python_requirement_satisfied() {
    local py="$1" spec="$2"
    "$py" - "$spec" <<'PYCHECK' >/dev/null 2>&1
import importlib.metadata as md
import re
import sys

spec = sys.argv[1].strip()
m = re.fullmatch(r"([A-Za-z0-9_.-]+)\s*(?:(>=|<=|==|>|<)\s*([^\s]+))?", spec)
if not m:
    raise SystemExit(1)

name, op, wanted = m.groups()
try:
    installed = md.version(name)
except md.PackageNotFoundError:
    raise SystemExit(1)

if not op:
    raise SystemExit(0)

def version_key(value):
    # Numeric release components are sufficient for AItech's current prefs
    # (for example transformers>=5).  Non-numeric suffixes are ignored here;
    # pip remains the final authority if a future requirement is more complex.
    nums = [int(x) for x in re.findall(r"\d+", value)]
    return tuple(nums or [0])

a = version_key(installed)
b = version_key(wanted)
ops = {
    ">=": a >= b,
    "<=": a <= b,
    "==": a == b,
    ">":  a > b,
    "<":  a < b,
}
raise SystemExit(0 if ops[op] else 1)
PYCHECK
}

ensure_python_dependencies() {
    local py="$1"; shift
    local spec
    local -a missing=()

    echo -e "${CYAN}[+] Checking Python dependencies before installation...${NC}"
    for spec in "$@"; do
        [[ -n "$spec" ]] || continue
        if python_requirement_satisfied "$py" "$spec"; then
            local installed_version
            installed_version=$("$py" - "$spec" <<'PYVER' 2>/dev/null
import importlib.metadata as md, re, sys
name = re.split(r'[<>=!~ ]', sys.argv[1], 1)[0]
try:
    print(md.version(name))
except Exception:
    print("present")
PYVER
)
            echo -e "${GREEN}[✓] $spec already satisfied (${installed_version:-present})${NC}"
        else
            echo -e "${YELLOW}[+] $spec missing or below requested version.${NC}"
            missing+=("$spec")
        fi
    done

    if (( ${#missing[@]} == 0 )); then
        echo -e "${GREEN}[✓] Python dependency set already satisfied; no download required.${NC}"
        return 0
    fi

    echo -e "${CYAN}[+] Installing/updating only: ${missing[*]}${NC}"
    "$py" -m pip install --quiet "${missing[@]}"
}

collect_ml_requirements() {
    local configured="$1" overrides="${2:-}" spec existing
    local -a result=()

    # Preserve the selected OS section's normal requirements first.
    # Never merge requirements from another OS section here: Linux, macOS/Unix,
    # and Windows are deliberately independent compatibility lanes.
    for spec in $configured; do
        result+=("$spec")
    done

    # Add project-core requirements only when that distribution is absent from
    # this OS's prefs. This preserves a user's stronger constraint (for example
    # pillow>=11) instead of appending a second, weaker requirement.
    for spec in $REQUIRED_ML_PACKAGES; do
        local base="${spec%%[<>=!~]*}"
        existing=0
        local configured_spec
        for configured_spec in "${result[@]}"; do
            if [[ "${configured_spec%%[<>=!~]*}" == "$base" ]]; then
                existing=1
                break
            fi
        done
        (( existing )) || result+=("$spec")
    done

    # Apply compatibility overrides LAST and only for the currently selected OS.
    # This is specifically intended for cases where macOS must temporarily use an
    # older/pinned package or implementation while Linux can continue using newer
    # packages/methods. An override replaces only the same package name; it does
    # not weaken another OS's requirements.
    for spec in $overrides; do
        local override_base="${spec%%[<>=!~]*}"
        local -a replaced=()
        local current
        existing=0
        for current in "${result[@]}"; do
            if [[ "${current%%[<>=!~]*}" == "$override_base" ]]; then
                if (( ! existing )); then
                    replaced+=("$spec")
                    existing=1
                fi
            else
                replaced+=("$current")
            fi
        done
        (( existing )) || replaced+=("$spec")
        result=("${replaced[@]}")
    done

    printf '%s\n' "${result[@]}"
}

