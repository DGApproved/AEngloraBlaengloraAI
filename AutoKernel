def run_standing_tasks():
    """Advance ongoing work the user asked to have formed.

    Standing tasks are the administrator making up for capability a training model
    does not have: work that persists across processing loops instead of being
    answered once. Each line is `NAME | KIND | TARGET | NOTE`. Recognised kinds are
    deterministic measurements over a target file, so a task can run unattended
    without inventing anything.
    """
    if not STANDING_TASKS.is_file():
        return []
    rows = []
    try:
        lines = STANDING_TASKS.read_text(encoding="utf-8", errors="ignore").splitlines()
    except OSError:
        return rows
    for raw in lines:
        line = raw.strip()
        if not line or line.startswith("#"):
            continue
        parts = [p.strip() for p in line.split("|")]
        if len(parts) < 3:
            continue
        name, kind, target = parts[0], parts[1].lower(), parts[2]
        tpath = Path(target)
        if not tpath.is_absolute():
            tpath = SESSION_ROOT / target
        if not tpath.is_file():
            _admin_note(rows, "STANDING_TASK", f"{name}: target not found ({target})")
            continue
        try:
            body = tpath.read_text(encoding="utf-8", errors="ignore")
        except OSError:
            continue
        if kind == "mass":
            _admin_note(rows, "STANDING_TASK",
                        f"{name}: typographic mass of {tpath.name} = {len(body)}")
        elif kind == "growth":
            prev_key = f"__growth__{tpath.name}"
            prev = _admin_state_get(prev_key)
            now_mass = len(body)
            delta = "n/a" if prev is None else f"{now_mass - prev:+d}"
            _admin_state_set(prev_key, now_mass)
            _admin_note(rows, "STANDING_TASK",
                        f"{name}: {tpath.name} mass={now_mass} delta_since_last_loop={delta}")
        elif kind == "count":
            needle = parts[3] if len(parts) > 3 else ""
            if needle:
                _admin_note(rows, "STANDING_TASK",
                            f"{name}: '{needle}' occurs {body.count(needle)} time(s) in {tpath.name}")
        elif kind == "lines":
            _admin_note(rows, "STANDING_TASK",
                        f"{name}: {tpath.name} has {body.count(chr(10)) + 1} line(s)")
        else:
            _admin_note(rows, "STANDING_TASK", f"{name}: unrecognised kind '{kind}'")
    return rows


def _admin_state_path():
    return SYSTEM_DIR / "admin_state.txt"


def _admin_state_get(key):
    path = _admin_state_path()
    if not path.is_file():
        return None
    for line in path.read_text(encoding="utf-8", errors="ignore").splitlines():
        if line.startswith(key + "="):
            try:
                return int(line.split("=", 1)[1])
            except ValueError:
                return None
    return None


def _admin_state_set(key, value):
    path = _admin_state_path()
    lines = []
    if path.is_file():
        lines = [l for l in path.read_text(encoding="utf-8", errors="ignore").splitlines()
                 if not l.startswith(key + "=")]
    lines.append(f"{key}={value}")
    try:
        path.parent.mkdir(parents=True, exist_ok=True)
        path.write_text("\n".join(lines) + "\n", encoding="utf-8")
    except OSError:
        pass


WEIGHTS_LEDGER = SESSION_ROOT / "data" / "memory" / "weights.txt"


def survey_flock():
    """Report how much of the ledger has been sheared. Read-only by design.

    Weights grow like a sheep's hair and are trimmed when an entry settles: its
    creation date is replaced by <computed>. The engines own the ledger and do
    the trimming inside their own atomic saves, so the administrator counts the
    flock and reports it rather than writing here and racing them.
    """
    rows = []
    if not WEIGHTS_LEDGER.is_file():
        return rows
    section = None
    tracked = sheared = 0
    total = runs = None
    try:
        for raw in WEIGHTS_LEDGER.read_text(encoding="utf-8", errors="ignore").splitlines():
            line = raw.strip()
            if not line or line.startswith("#"):
                continue
            if line.startswith("[") and line.endswith("]"):
                section = line[1:-1]
                continue
            if "\t" not in line:
                continue
            key, value = line.split("\t", 1)
            value = value.strip()
            if section == "@borndate":
                tracked += 1
                if value == "<computed>":
                    sheared += 1
            elif section == "@computations":
                if key == "total":
                    total = value
                elif key == "runs":
                    runs = value
    except OSError:
        return rows
    if total is not None:
        _admin_note(rows, "COMPUTATIONS",
                    f"{total} total across {runs or '?'} program initialization(s)")
    if tracked:
        _admin_note(rows, "FLOCK",
                    f"{sheared}/{tracked} tracked key(s) sheared to <computed>; "
                    f"{tracked - sheared} still growing")
    return rows


def administration_pass():
    """One full administrative round. Writes the administration ledger."""
    rows = []
    overflow_rows, overflow_total = survey_overflow()
    rows += overflow_rows
    rows += survey_catalog()
    rows += survey_book_drop()
    rows += survey_pending_writes()
    rows += survey_flock()
    rows += run_standing_tasks()

    header = [
