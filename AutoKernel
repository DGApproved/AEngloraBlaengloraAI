# TRAINING MODE — Data decay and knowledge engine build
# =============================================================================
def generate_decay_variants(text, decay_unit, decay_value, is_percentage):
    if not text.strip():
        return []
    if decay_unit == 'single':
        return [text]
    if decay_unit == 'char':
        total = len(text)
        step  = max(1, int(total * (decay_value / 100.0))) if is_percentage else decay_value
        return [text[:l] for l in range(total, 0, -step)]
    if decay_unit == 'word':
        words = text.split()
        total = len(words)
        if total == 0:
            return [text]
        step = max(1, int(total * (decay_value / 100.0))) if is_percentage else decay_value
        return [" ".join(words[:l]) for l in range(total, 0, -step)]
    return [text]

class DecayDataset(Dataset):
    def __init__(self, text_list, tokenizer, max_length, decay_unit, decay_value, is_percentage):
        self.inputs = []
        for raw_text in text_list:
            variants = generate_decay_variants(raw_text, decay_unit, decay_value, is_percentage)
            for variant in variants:
                enc = tokenizer(variant, truncation=True, max_length=max_length,
                                padding="max_length", return_tensors="pt")
                self.inputs.append(enc['input_ids'].squeeze(0))

    def __len__(self):
        return len(self.inputs)

    def __getitem__(self, idx):
        return self.inputs[idx]

def run_base_training_mode():
    """
    Train the Llama 4M or 15M base model across all 7 multimodal directories.

    Ported from train_base_multimodal_decayv2.py:
      - LlamaForCausalLM architecture (not GPT2)
      - 4M (128-hidden) or 15M (256-hidden) model size
      - Multimodal ingestion: text, hex dump decoding, pixel decay for images
      - HuggingFace Dataset API with attention_mask and -100 padding masking
      - Native PyTorch training loop (CUDA > MPS > CPU)
      - Optional Accelerate fallback (AITECH_ACCELERATE_FALLBACK=1)
      - Exit code 42 signals AItech.sh that Accelerate should be offered
      - Saves to hf_4m_model or hf_base_model in session.noq/models/
    """
    print("\n" + "="*55)
    print("  GODDESS MATRIX — BASE MODEL TRAINING")
    print("="*55)
    print("  4m  : ~4M development preset | 128-hidden | faster iteration")
    print("  15m : ~15M base preset        | 256-hidden | deeper training")
    print("  c N : fit a specific parameter target, e.g. c 500k, c 12.5m")
    print("  ~   : profile post-decay training data and choose a workload-sized model")
    print("="*55)
    size_choice = input("Model size [4m/15m/c <number>/~, default=4m]: ").strip().lower() or "4m"

    # Keep preset architectures stable; custom sizing is a separate lane so a
    # future compatibility change for one preset does not silently alter custom
    # models (or vice versa). Plain custom numbers are interpreted as millions.
    def _parse_custom_target(choice):
        m = re.match(r"^c\s*([0-9]+(?:\.[0-9]+)?)\s*([kmb]?)$", choice)
        if not m:
            return None
        value = float(m.group(1)); suffix = m.group(2)
        multiplier = {"": 1_000_000, "k": 1_000, "m": 1_000_000, "b": 1_000_000_000}[suffix]
        return max(100_000, int(value * multiplier))

    def _custom_llama_dims(target_params, vocab_size=50257):
        """Fit the current Llama architecture as closely as safely possible.

        A numeric `c` request is a parameter target rather than an approximate
        preset.  The fitter uses every parameter-count lever currently safe for
        the generated runtime: hidden width, SwiGLU/MLP width, layer count,
        attention-head layout, grouped-query KV heads, and tied/untied output
        embeddings.  The GPT-2 tokenizer vocabulary is not truncated because
        doing that without a persistent token-ID remapper would make saved
        models unsafe for later inference.  That vocabulary therefore creates
        a real lower bound for very small requested models.
        """
        target_params = max(1, int(target_params))
        if target_params < 5_000_000:
            hidden_max = 256
        elif target_params < 100_000_000:
            hidden_max = 1024
        elif target_params < 1_000_000_000:
            hidden_max = 2048
        else:
            hidden_max = 4096
        best = None
        head_options = (1, 2, 4, 8, 16, 32, 64)
        for hidden in range(4, hidden_max + 1, 4):
            valid_heads = [h for h in head_options if h <= hidden and hidden % h == 0]
            for heads in valid_heads:
                kv_options = [k for k in valid_heads if k <= heads and heads % k == 0]
                for kv_heads in kv_options:
                    kv_dim = hidden * kv_heads // heads
                    for tied in (True, False):
                        embedding_params = vocab_size * hidden * (1 if tied else 2)
                        for layers in range(1, 65):
                            base = embedding_params + hidden
                            per_without_mlp = ((2 * hidden * hidden) +
                                               (2 * hidden * kv_dim) +
                                               (2 * hidden))
                            remaining = target_params - base - layers * per_without_mlp
                            ideal_i = remaining / max(1, (3 * hidden * layers))
                            # Keep the MLP dimension in a useful transformer range.
                            # Without this guard an exact arithmetic fit could choose
                            # hidden=4 plus an enormous MLP, matching the number while
                            # producing a badly unbalanced language model.
                            min_i = max(8, hidden)
                            max_i = max(min_i, hidden * 8)
                            center = int(round(ideal_i / 4.0)) * 4
                            center = min(max_i, max(min_i, center))
                            candidates_i = {center}
                            for ratio in (1.0, 1.5, 2.0, 2.5, 3.0, 4.0, 6.0, 8.0):
                                candidates_i.add(min(max_i, max(min_i, int(round((hidden * ratio) / 4.0)) * 4)))
                            for delta in range(-32, 33, 4):
                                candidates_i.add(min(max_i, max(min_i, center + delta)))
                            for intermediate in candidates_i:
                                estimate = base + layers * (per_without_mlp + 3 * hidden * intermediate)
                                error = abs(estimate - target_params)
                                # Parameter error is always primary. For equally
                                # close fits prefer balanced MLP ratios and modest
                                # depth rather than pathological exact-size shapes.
                                shape_penalty = abs(intermediate - (2 * hidden))
                                depth_penalty = abs(layers - 6)
                                candidate = (error, shape_penalty, depth_penalty,
                                             estimate > target_params, estimate,
                                             hidden, layers, intermediate, heads,
                                             kv_heads, tied)
                                if best is None or candidate < best:
                                    best = candidate
        _, _, _, _, estimate, hidden, layers, intermediate, heads, kv_heads, tied = best
        return hidden, intermediate, layers, heads, kv_heads, tied, estimate

    def _profile_corpus_for_size(corpus, tokenizer_obj):
        """Profile the actual post-decay workload for `~` auto sizing.

        This happens after text decay and image-to-record expansion, so the
        sizing decision reflects what will really be tokenized and trained.
        The current reproducible heuristic aims near 20 effective training
        tokens per parameter and includes planned epoch exposure.  It is a
        workload-sizing policy, not a claim of a universal optimum, and is kept
        isolated so future research can revise it without changing presets or
        explicit `c` target-fitting behavior.
        """
        total_tokens = 0
        unique_ids = set()
        batch_size = 128
        for start in range(0, len(corpus), batch_size):
            batch = corpus[start:start + batch_size]
            enc = tokenizer_obj(
                batch, add_special_tokens=False,
                truncation=False, padding=False, verbose=False
            )["input_ids"]
            for ids in enc:
                total_tokens += len(ids)
                unique_ids.update(ids)
        total_tokens = max(1, total_tokens)
        epochs_for_sizing = 5
        target = max(100_000, int((total_tokens * epochs_for_sizing) / 20.0))
        if target > 8_000_000:
            epochs_for_sizing = 20
            target = max(100_000, int((total_tokens * epochs_for_sizing) / 20.0))
        return target, total_tokens, len(unique_ids), epochs_for_sizing

    custom_target = _parse_custom_target(size_choice)
    adaptive_size = (size_choice == "~")
    if custom_target is not None:
        (MODEL_HIDDEN, MODEL_INTERMEDIATE, MODEL_LAYERS, MODEL_HEADS,
         MODEL_KV_HEADS, MODEL_TIE_EMBEDDINGS, estimated_params) = _custom_llama_dims(custom_target)
        target_m = custom_target / 1_000_000
        MODEL_SIZE_LABEL = f"CUSTOM {target_m:g}M"
        custom_slug = (f"{target_m:g}").replace(".", "p")
        out_dir = os.path.join(MODELS_DIR, f"hf_custom_{custom_slug}m_model")
        MAX_LENGTH = 512 if custom_target <= 8_000_000 else (1536 if custom_target <= 40_000_000 else 2048)
        EPOCHS = 5 if custom_target <= 8_000_000 else 20
        BATCH_SIZE = 4 if custom_target <= 8_000_000 else (2 if custom_target <= 40_000_000 else 1)
        LR = 5e-4 if custom_target <= 8_000_000 else 1e-4
        DEFAULT_MODE = "10%w" if custom_target <= 8_000_000 else "allw"
        diff = estimated_params - custom_target
        pct = abs(diff) / custom_target * 100.0
        print(f"  Custom target: {custom_target:,} parameters")
        print(f"  Fitted config: {estimated_params:,} params ({diff:+,}, {pct:.4f}% error)")
        print(f"  hidden={MODEL_HIDDEN} | mlp={MODEL_INTERMEDIATE} | layers={MODEL_LAYERS} | heads={MODEL_HEADS} | kv={MODEL_KV_HEADS} | tied={MODEL_TIE_EMBEDDINGS}")
    elif adaptive_size:
        # Final dimensions are deliberately deferred until corpus creation.
        MODEL_HIDDEN=128; MODEL_INTERMEDIATE=256; MODEL_LAYERS=4; MODEL_HEADS=4
        MODEL_KV_HEADS=4; MODEL_TIE_EMBEDDINGS=False
        MAX_LENGTH=512; EPOCHS=5; BATCH_SIZE=4; LR=5e-4
        out_dir=os.path.join(MODELS_DIR, "hf_auto_model")
        DEFAULT_MODE="10%w"; MODEL_SIZE_LABEL="AUTO (~ pending corpus profile)"
    elif size_choice == "15m":
        MODEL_HIDDEN=256; MODEL_INTERMEDIATE=512; MODEL_LAYERS=6; MODEL_HEADS=8
        MODEL_KV_HEADS=8; MODEL_TIE_EMBEDDINGS=False
        MAX_LENGTH=1536; EPOCHS=20; BATCH_SIZE=2; LR=1e-4
        out_dir=os.path.join(MODELS_DIR, "hf_base_model")
        DEFAULT_MODE="allw"; MODEL_SIZE_LABEL="15M"
    else:
        if size_choice not in ("4m", "4"):
            print(f"[!] Unrecognized model size '{size_choice}'. Using 4m preset.")
        MODEL_HIDDEN=128; MODEL_INTERMEDIATE=256; MODEL_LAYERS=4; MODEL_HEADS=4
        MODEL_KV_HEADS=4; MODEL_TIE_EMBEDDINGS=False
        MAX_LENGTH=512; EPOCHS=5; BATCH_SIZE=4; LR=5e-4
        out_dir=os.path.join(MODELS_DIR, "hf_4m_model")
        DEFAULT_MODE="10%w"; MODEL_SIZE_LABEL="4M"

    # A B-created blank model owns its requested checkpoint path. Size presets,
    # `c`, and `~` describe architecture, not identity, so they must not rename
    # a user-named model behind the selector's back.
    if MODEL_SEED_ID is not None:
        out_dir = MODEL_PATH
        print(f"  Named model output: {out_dir}")

    MODEL_CONTEXT_TOKENS = TRAINING_MODEL_CONTEXT_CFG

    write_text_view(
        "training", "BASE MODEL CONFIG",
        f"Size      : {MODEL_SIZE_LABEL}",
        f"Output    : {out_dir}",
        f"Max length: {MAX_LENGTH}",
        f"Epochs    : {EPOCHS}",
        f"LR        : {LR}",
        "Configuring decay mode...",
    )
    write_progress(2, "CONFIGURING")
    update_gui_chat("SYS", f"base training: {MODEL_SIZE_LABEL}")

    # ── Decay config ──────────────────────────────────────────────────────────
    print("\n" + "="*55)
    print("  CONFIGURE DATA DECAY INGESTION")
    print("="*55)
    print("  s / allc / allw / [N]c / [N]%c / [N]w / [N]%w")
    print("="*55)
    user_mode   = input(f"Decay mode [default: {DEFAULT_MODE}]: ").strip().lower() or DEFAULT_MODE
    decay_unit  = "single"; decay_value = 1; is_percentage = False
    m = re.match(r"^(\d+)(%?)(c|w)$", user_mode)
    if user_mode == "allc":
        decay_unit, decay_value, is_percentage = "char", 1, False
    elif user_mode == "allw":
        decay_unit, decay_value, is_percentage = "word", 1, False
    elif user_mode in ["s", "single"]:
        decay_unit = "single"
    elif m:
        v, pct, u  = m.groups()
        decay_value = int(v); is_percentage = (pct == "%")
        decay_unit  = "char" if u == "c" else "word"
    else:
        print("[!] Invalid. Defaulting to single scan.")

    # ── Corpus build ──────────────────────────────────────────────────────────
    corpus = semantic_memory_training_records()
    update_gui_chat("SYS", f"semantic records seeded: {len(corpus)}")

    seen = set()
    for folder in BASE_DATA_DIRS:
        if not os.path.isdir(folder):
            continue
        for fname in sorted(os.listdir(folder)):
            fpath = os.path.join(folder, fname)
            real  = os.path.realpath(fpath)
            if real in seen:
                continue
            seen.add(real)
            policy = classify_source_use(fpath, os.path.relpath(fpath, NOQ_DIR))
            source_rec = register_source_provenance(
                fpath, policy, logical_name=fname, source_origin="gpt2_base_training_scan"
            )
            if policy.get("mode") != "TRAIN":
                _write_reference_index(fpath, os.path.relpath(fpath, NOQ_DIR), policy)
                continue
            if fname.endswith((".txt", ".sh", ".py", ".cpp")):
                corpus.extend(generate_text_decay_records(
                    fpath, fname, decay_unit, decay_value, is_percentage))
            elif fname.lower().endswith((".png", ".jpg", ".jpeg", ".bmp")):
                corpus.extend(generate_pixel_decay_records(
                    fpath, fname, decay_unit, decay_value, is_percentage))

    if not corpus:
        corpus = ["User: Hello\nAssistant: System ready."]

    update_gui_chat("SYS", f"corpus: {len(corpus)} training records")
    print(f"\n  Total training records: {len(corpus)}")

    # ── Tokenizer ─────────────────────────────────────────────────────────────
    tokenizer_base = GPT2Tokenizer.from_pretrained("gpt2")
    tokenizer_base.pad_token        = tokenizer_base.eos_token
    tokenizer_base.model_max_length = MODEL_CONTEXT_TOKENS

    if custom_target is not None:
        # Refit against the tokenizer's FINAL vocabulary. Special-token additions
        # change embedding size, so this second pass is what makes `c <size>` a
        # real target rather than an estimate based on the stock GPT-2 vocab.
        (MODEL_HIDDEN, MODEL_INTERMEDIATE, MODEL_LAYERS, MODEL_HEADS,
         MODEL_KV_HEADS, MODEL_TIE_EMBEDDINGS, estimated_params) = _custom_llama_dims(custom_target, len(tokenizer_base))
        diff = estimated_params - custom_target
        pct = abs(diff) / custom_target * 100.0
        print(f"  Final tokenizer-aware fit: {estimated_params:,} params ({diff:+,}, {pct:.4f}% error) | vocab={len(tokenizer_base):,}")


    if adaptive_size:
        auto_target, workload_tokens, unique_token_ids, suggested_epochs = _profile_corpus_for_size(corpus, tokenizer_base)
        (MODEL_HIDDEN, MODEL_INTERMEDIATE, MODEL_LAYERS, MODEL_HEADS,
         MODEL_KV_HEADS, MODEL_TIE_EMBEDDINGS, estimated_params) = _custom_llama_dims(auto_target, len(tokenizer_base))
        EPOCHS = suggested_epochs
        MAX_LENGTH = 512 if auto_target <= 8_000_000 else (1536 if auto_target <= 40_000_000 else 2048)
        BATCH_SIZE = 4 if auto_target <= 8_000_000 else (2 if auto_target <= 40_000_000 else 1)
        LR = 5e-4 if auto_target <= 8_000_000 else 1e-4
        MODEL_SIZE_LABEL = f"AUTO ~ {auto_target/1_000_000:g}M target"
        if MODEL_SEED_ID is None:
            out_dir = os.path.join(MODELS_DIR, f"hf_auto_{auto_target}_model")
        diff = estimated_params - auto_target
        pct = abs(diff) / auto_target * 100.0
        print("\n  [~] Workload sizing complete")
        print(f"  Post-decay records: {len(corpus):,}")
        print(f"  Post-decay tokens : {workload_tokens:,} | unique token IDs: {unique_token_ids:,}")
        print(f"  Derived target    : {auto_target:,} parameters ({suggested_epochs} planned epochs / ~20 effective tokens per parameter)")
        print(f"  Fitted config     : {estimated_params:,} params ({diff:+,}, {pct:.4f}% error)")
        print(f"  hidden={MODEL_HIDDEN} | mlp={MODEL_INTERMEDIATE} | layers={MODEL_LAYERS} | heads={MODEL_HEADS} | kv={MODEL_KV_HEADS} | tied={MODEL_TIE_EMBEDDINGS}")


    decay_mode_label = (
        "allc" if decay_unit == "char" and decay_value == 1 and not is_percentage else
        "allw" if decay_unit == "word" and decay_value == 1 and not is_percentage else
        (f"{decay_value}{'%' if is_percentage else ''}{'c' if decay_unit == 'char' else 'w'}"
         if decay_unit in ("char", "word") else "single")
    )
    corpus, training_continuity_session = prepare_hierarchical_training_corpus(
        corpus, tokenizer_base, "GPT21_BASE",
        logical_window_tokens=MODEL_CONTEXT_TOKENS,
        batch_window_tokens=MAX_LENGTH,
        decay_mode=decay_mode_label,
    )
    print(
        f"  [Continuity] prepared={len(corpus):,} | "
        f"oversized={training_continuity_session.get('oversized_records_translated',0)} | "
        f"parents={training_continuity_session.get('logical_parent_count',0)} | "
        f"windows={training_continuity_session.get('neural_window_count',0)}"
    )


    def tokenize_fn(examples):
        tok = tokenizer_base(
            examples["text"], truncation=True,
            max_length=MAX_LENGTH, padding="max_length", verbose=False
        )
        tok["labels"] = [ids.copy() for ids in tok["input_ids"]]
        return tok

    if HF_DATASETS_AVAILABLE:
        ds = HFDataset.from_dict({"text": corpus}).map(
            tokenize_fn, batched=True, remove_columns=["text"]
        )
        ds.set_format(type="torch", columns=["input_ids", "attention_mask", "labels"])
        train_loader = DataLoader(ds, batch_size=BATCH_SIZE, shuffle=True)
    else:
        # Fallback: simple Dataset wrapper when HF datasets not installed
        class _SimpleDS(Dataset):
            def __init__(self, texts, tok, ml):
                self.data = []
                for t in texts:
                    enc = tok(t, truncation=True, max_length=ml,
                              padding="max_length", return_tensors="pt", verbose=False)
                    ids = enc["input_ids"].squeeze(0)
                    msk = enc["attention_mask"].squeeze(0)
                    self.data.append({"input_ids": ids, "attention_mask": msk,
                                      "labels": ids.clone()})
            def __len__(self):  return len(self.data)
            def __getitem__(self, i): return self.data[i]
        train_loader = DataLoader(
            _SimpleDS(corpus, tokenizer_base, MAX_LENGTH),
            batch_size=BATCH_SIZE, shuffle=True
        )

    # ── Model ─────────────────────────────────────────────────────────────────
    cfg = LlamaConfig(
        vocab_size             = len(tokenizer_base),
        hidden_size            = MODEL_HIDDEN,
        intermediate_size      = MODEL_INTERMEDIATE,
        num_hidden_layers      = MODEL_LAYERS,
        num_attention_heads    = MODEL_HEADS,
        num_key_value_heads    = MODEL_KV_HEADS,
        tie_word_embeddings    = MODEL_TIE_EMBEDDINGS,
        pad_token_id           = tokenizer_base.eos_token_id,
        bos_token_id           = tokenizer_base.eos_token_id,
        eos_token_id           = tokenizer_base.eos_token_id,
        max_position_embeddings = MODEL_CONTEXT_TOKENS,
    )
    if MODEL_RANDOM_SEED is not None:
        random.seed(MODEL_RANDOM_SEED)
        torch.manual_seed(MODEL_RANDOM_SEED)
        if torch.cuda.is_available():
            torch.cuda.manual_seed_all(MODEL_RANDOM_SEED)
        print(f"  Applying model seed/ID before initialization: {MODEL_SEED_ID} ({MODEL_RANDOM_SEED})")
    llama_model = LlamaForCausalLM(cfg)
    actual_params = sum(p.numel() for p in llama_model.parameters())
    print(f"  Instantiated parameters: {actual_params:,}")
    update_gui_chat("SYS", f"model parameters: {actual_params:,}")

    def _run_native():
        dev, backend = select_native_device()
        print(f"  Backend: {backend}")
        llama_model.to(dev)
        opt = torch.optim.AdamW(llama_model.parameters(), lr=LR)
        llama_model.train()
        for epoch in range(EPOCHS):
            total = 0.0; cnt = 0
            for batch in train_loader:
                ids  = batch["input_ids"].to(dev)
                msk  = batch["attention_mask"].to(dev)
                lbls = ids.clone()
                lbls[msk == 0] = -100          # mask padding from loss
                opt.zero_grad(set_to_none=True)
                loss = llama_model(input_ids=ids, attention_mask=msk, labels=lbls).loss
                loss.backward(); opt.step()
                total += loss.item(); cnt += 1
            avg  = total / max(1, cnt)
            pct  = int(((epoch + 1) / EPOCHS) * 95)
            print(f"  Epoch {epoch+1}/{EPOCHS} | Loss: {avg:.4f}")
            write_progress(pct, f"EPOCH {epoch+1}/{EPOCHS}")
            write_art(f"BASE {MODEL_SIZE_LABEL} TRAINING",
                      f"epoch: {epoch+1}/{EPOCHS}", f"loss: {avg:.4f}",
                      f"backend: {backend}", f"{pct}%")
        os.makedirs(out_dir, exist_ok=True)
        llama_model.save_pretrained(out_dir)
        tokenizer_base.save_pretrained(out_dir)
        _save_model_identity(out_dir)
        _verify_chat_discoverable_checkpoint(out_dir)
        finalize_training_continuity_session(
            training_continuity_session, "COMPLETE",
            {"backend": backend, "output_dir": out_dir}
        )
        write_progress(100, f"SAVED — {out_dir}")
        update_gui_chat("SYS", f"base model saved: {out_dir}")
        write_text_view("training", "TRAINING COMPLETE",
                        f"Model: {MODEL_SIZE_LABEL}", f"Saved: {out_dir}",
                        "Native PyTorch: primary path.",
                        "Accelerate: only when explicitly enabled.")
        print(f"\n[✓] Base model saved to '{out_dir}'")

    def _run_accelerate():
        try:
            from accelerate import Accelerator
        except ImportError:
            print("[!] Accelerate requested but not installed."); return False
        print("  [Accelerate fallback enabled]")
        acc  = Accelerator()
        opt  = torch.optim.AdamW(llama_model.parameters(), lr=LR)
        pm, po, pl = acc.prepare(llama_model, opt, train_loader)
        pm.train()
        for epoch in range(EPOCHS):
            total = 0.0; cnt = 0
            for batch in pl:
                ids  = batch["input_ids"]; msk = batch["attention_mask"]
                lbls = ids.clone(); lbls[msk == 0] = -100
                po.zero_grad(set_to_none=True)
                loss = pm(input_ids=ids, attention_mask=msk, labels=lbls).loss
                acc.backward(loss); po.step()
                total += loss.detach().float().item(); cnt += 1
            if acc.is_main_process:
                avg = total / max(1, cnt)
                print(f"  Epoch {epoch+1}/{EPOCHS} | Loss: {avg:.4f}")
                write_progress(int(((epoch+1)/EPOCHS)*95), f"ACCELERATE {epoch+1}/{EPOCHS}")
        if acc.is_main_process:
            os.makedirs(out_dir, exist_ok=True)
            acc.unwrap_model(pm).save_pretrained(out_dir)
            tokenizer_base.save_pretrained(out_dir)
            _save_model_identity(out_dir)
            _verify_chat_discoverable_checkpoint(out_dir)
            finalize_training_continuity_session(
                training_continuity_session, "COMPLETE",
                {"backend": "accelerate", "output_dir": out_dir}
            )
        acc.wait_for_everyone()
        return True

    if USE_ACCELERATE_FALLBACK:
        if not _run_accelerate():
            sys.exit(1)
    else:
        try:
            _run_native()
        except (KeyboardInterrupt, SystemExit):
            raise
        except Exception as exc:
            print(f"\n[!] Native training failed: {type(exc).__name__}: {exc}")
            print("[!] Exiting with code 42 so AItech.sh can offer Accelerate fallback.")
            sys.exit(NATIVE_FALLBACK_EXIT_CODE)


def run_training_mode():
    """
    Original knowledge engine training pipeline, unchanged.
    Runs a decay-configured GPT2 training pass over session.noq/data/alphabet/
    and saves the result to session.noq/models/hf_knowledge_model.
    """
    DEFAULT_MODE = "10%w"
    print("\n" + "="*55)
    print(" CONFIGURE DATA DECAY INGESTION (KNOWLEDGE ENGINE)")
    print("="*55)
    print("  s      : Single scan")
    print("  allc   : Character decay (step 1)")
    print("  [N]c   : Absolute character step")
    print("  [N]%c  : Percentage character step")
    print("  allw   : Word decay (step 1)")
    print("  [N]w   : Absolute word step")
    print("  [N]%w  : Percentage word step")
