                    import threading as _th
                    mins = int(_re_m_cmd.match(cmd).group(1))
                    if auto_stop_timer is not None:
                        try: auto_stop_timer.cancel()
                        except Exception: pass
                    idle_daemon_running = True
                    daemon_status = "IDLE"
                    draw_pinned_header()
                    def _auto_stop():
                        global idle_daemon_running, daemon_status, auto_stop_timer
                        idle_daemon_running = False
                        daemon_status = "STOPPED"
                        auto_stop_timer = None
                        draw_pinned_header()
