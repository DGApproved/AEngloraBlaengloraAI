def _load_gentext_schema_safe():
    """Load gentext_schema.json without raising on missing/corrupt file."""
    if not os.path.exists(GENTEXT_SCHEMA_PATH):
        return {"version": 1, "files": {}}
    try:
        with open(GENTEXT_SCHEMA_PATH, "r", encoding="utf-8") as f:
            data = json.load(f)
        data.setdefault("files", {})
        return data
    except Exception:
        return {"version": 1, "files": {}}

def _save_gentext_schema_safe(data):
    """Write gentext_schema.json atomically."""
    tmp = GENTEXT_SCHEMA_PATH + ".tmp"
    os.makedirs(os.path.dirname(GENTEXT_SCHEMA_PATH), exist_ok=True)
    with open(tmp, "w", encoding="utf-8") as f: json.dump(data, f, indent=2, ensure_ascii=False)
    os.replace(tmp, GENTEXT_SCHEMA_PATH)

def _gentext_tokenize(text):
    """Extract lowercase alpha tokens ≥4 chars for keyword weighting."""
    return [w.lower() for w in re.findall(r"[a-zA-Z]{4,}", text)]

def _update_gentext_kw_weights(existing, new_tokens, max_kw=60):
    """Merge new_tokens into keyword weight dict, keeping top max_kw."""
    for t in new_tokens: existing[t] = existing.get(t, 0) + 1
    if len(existing) > max_kw:
        trimmed = sorted(existing.items(), key=lambda kv: kv[1], reverse=True)
        existing = dict(trimmed[:max_kw])
    return existing

# ── FILENAME UTILITY EVALUATOR ───────────────────────────────────────────

_GENERIC_SINGLE = {"file","data","output","input","log","temp","test",
                   "misc","other","stuff","thing","text","note","info",
                   "new","old","tmp","backup","copy","draft"}

def _evaluate_filename_utility(fname):
    """
    Decide if an invented filename represents a useful new semantic category.
    Returns (is_useful, role, purpose, initial_keywords).
    Permissive by design — the ecosystem should grow naturally.
    Schema files (in _SCHEMA_BASENAMES) are never considered here.
    """
    stem = re.sub(r"\.(txt|json|md)$", "", fname, flags=re.I)
    parts = re.split(r"[_\-\s]+", stem)
    expanded = []
    for p in parts:
        expanded.extend(re.sub(r"(?<=[a-z])(?=[A-Z])", "_", p).split("_"))
    parts = [p.lower() for p in expanded if p]
    real = [p for p in parts if len(p) >= 3]
    if not real: return False, None, None, []
    digit_ratio = sum(c.isdigit() for c in stem) / max(len(stem), 1)
    if digit_ratio > 0.4: return False, None, None, []
    if len(real) == 1 and real[0] in _GENERIC_SINGLE: return False, None, None, []
    role = "_".join(p.upper() for p in real)
    purpose = (f"Dynamically discovered semantic store. "
               f"Inferred concept: {' '.join(real)}. "
               f"Use terms evolve from writes.")
    seen = set(); kw = []
    for k in real + [stem.lower()]:
        if k not in seen: seen.add(k); kw.append(k)
    return True, role, purpose, kw

# ── GENTEXT FILE MANAGEMENT ──────────────────────────────────────────────

def _register_gentext_file(fname, role, purpose, kw, initial_content=""):
    """
    Formally register a gentext file and optionally seed with content.
    Returns the absolute path to the gentext file.
    """
    os.makedirs(GENTEXT_DIR, exist_ok=True)
    file_path = os.path.join(GENTEXT_DIR, fname)
    stamp = time.strftime("%Y-%m-%dT%H:%M:%S")
    schema = _load_gentext_schema_safe()
    if fname not in schema["files"]:
        kw_weights = {k: 1 for k in kw}
        if initial_content:
            kw_weights = _update_gentext_kw_weights(kw_weights, _gentext_tokenize(initial_content))
        schema["files"][fname] = {
            "role": role, "purpose": purpose, "accepts": kw[:],
            "rejects": [], "created": stamp, "last_written": stamp,
            "write_count": 0, "total_chars": 0, "keyword_weights": kw_weights,
        }
    else:
        entry = schema["files"][fname]
        if initial_content:
            entry["keyword_weights"] = _update_gentext_kw_weights(
                entry.get("keyword_weights", {}), _gentext_tokenize(initial_content))
        top = sorted(entry["keyword_weights"].items(), key=lambda kv: kv[1], reverse=True)[:8]
        entry["accepts"] = [k for k,_ in top]
    _save_gentext_schema_safe(schema)
    if not os.path.exists(file_path):
        with open(file_path, "w", encoding="utf-8") as f:
            f.write(f"# {fname} — Dynamic semantic store\n# Role: {role}\n"
                    f"# Purpose: {purpose}\n# Created: {stamp}\n\n")
    if initial_content:
        _append_to_gentext(fname, initial_content)
    return file_path

def _append_to_gentext(fname, content):
    """
    Append content to a gentext file and evolve its keyword weights.
    Auto-registers the file if not yet known.
    """
    file_path = os.path.join(GENTEXT_DIR, fname)
    stamp = time.strftime("%Y-%m-%dT%H:%M:%S")
    schema = _load_gentext_schema_safe()
    if fname not in schema["files"]:
        is_useful, role, purpose, kw = _evaluate_filename_utility(fname)
        if not is_useful:
            role    = fname.replace(".txt", "").upper()
            purpose = f"Auto-registered gentext file: {fname}"
            kw      = []
        _register_gentext_file(fname, role, purpose, kw)
        schema = _load_gentext_schema_safe()
    entry = schema["files"][fname]
    entry["keyword_weights"] = _update_gentext_kw_weights(
        entry.get("keyword_weights", {}), _gentext_tokenize(content))
    top = sorted(entry["keyword_weights"].items(), key=lambda kv: kv[1], reverse=True)[:8]
    entry["accepts"]      = [k for k,_ in top]
    entry["last_written"] = stamp
    entry["write_count"]  = entry.get("write_count", 0) + 1
    entry["total_chars"]  = entry.get("total_chars", 0) + len(content)
    _save_gentext_schema_safe(schema)
    os.makedirs(GENTEXT_DIR, exist_ok=True)
    with open(file_path, "a", encoding="utf-8") as f:
        f.write(f"\n[GENTEXT_ENTRY | {stamp}]\n{content}\n[/GENTEXT_ENTRY]\n")

def _get_gentext_context_for_prompt(max_chars=4000):
    """
    Load gentext file content for inclusion in the local model context.
    Most-frequently-written files load first.  Never displaces named schema content.
    """
    schema = _load_gentext_schema_safe()
    if not schema.get("files"): return ""
    entries = sorted(schema["files"].items(),
                     key=lambda kv: kv[1].get("write_count", 0), reverse=True)
    sections = []; used = 0
    for fname, entry in entries:
        file_path = os.path.join(GENTEXT_DIR, fname)
        if not os.path.exists(file_path): continue
        try:
            raw = Path(file_path).read_text(encoding="utf-8", errors="ignore").strip()
        except OSError: continue
        if not raw: continue
        budget = min(max_chars - used, 2000)
        if budget <= 0: break
        snippet = raw[-budget:] if len(raw) > budget else raw
        role = entry.get("role", "GENTEXT")
        sections.append(f"\n[GENTEXT_MEMORY role={role} file={fname}]\n{snippet}\n[/GENTEXT_MEMORY]\n")
        used += len(snippet)
    return "".join(sections)

# ── TRIAGE-TO-GENTEXT BRIDGE ─────────────────────────────────────────────

def _triage_or_promote(filepath):
    """
    Decision point for each unschema file:
      - Useful filename → register in gentext/, write content there,
        record provenance in definitions.txt
      - Not useful       → redistribute tokens into schema files
    Returns result dict.
    """
    fname = os.path.basename(filepath)
    stamp = time.strftime("%Y-%m-%dT%H:%M:%S")
    try:
        content = Path(filepath).read_text(encoding="utf-8", errors="ignore").strip()
    except Exception as exc:
        return {"file": fname, "handled": False, "error": str(exc)}
    is_useful, role, purpose, kw = _evaluate_filename_utility(fname)
    if is_useful:
        gentext_path = _register_gentext_file(fname, role, purpose, kw, content)
        excerpt = content[:200].replace("\n", " ") if content else "(empty)"
        _triage_append(DEFINITIONS_TXT,
            f"\n[GENTEXT_CREATED]\ntimestamp: {stamp}\nsource_file: {fname}\n"
            f"gentext_path: {gentext_path}\nrole: {role}\npurpose: {purpose}\n"
            f"initial_keywords: {', '.join(kw)}\ncontent_excerpt: {excerpt}\n"
            f"description: Useful filename promoted to dynamic gentext store.\n"
            f"[/GENTEXT_CREATED]\n")
        _triage_move_to_processed(filepath, fname, stamp)
        update_gui_chat("SYS", f"Gentext created: {fname} [{role}]")
        return {"file": fname, "handled": True, "role": role, "path": gentext_path}
    else:
        result = _triage_unschema_file(filepath)
        result["handled"] = False
        update_gui_chat("SYS", f"Triaged: {fname} → {len(result.get('routed',{}))} dests")
        return result

# ── MAIN TRIAGE SCAN ─────────────────────────────────────────────────────

def _triage_scan():
    """
    Scan TRIAGE_SCAN_DIRS for .txt files not in _SCHEMA_BASENAMES.
    Called once per main loop iteration before process_intake_files().
    Named schema files are never touched.
    """
    schema_path_set = {os.path.abspath(s["path"]) for s in GODDESS_MEMORY_FILES}
    for d in TRIAGE_SCAN_DIRS:
        if not os.path.isdir(d): continue
        for fname in list(os.listdir(d)):
            if not fname.endswith(".txt"): continue
            if fname in _SCHEMA_BASENAMES: continue
            # Case-variant of a schema file — rename silently, do not triage
            if fname.lower() in {b.lower() for b in _SCHEMA_BASENAMES}:
                fpath = os.path.join(d, fname)
                correct = os.path.join(d, fname.lower())
                try:
                    if not os.path.exists(correct): shutil.move(fpath, correct)
                    else: _triage_move_to_processed(fpath, fname, time.strftime("%Y-%m-%dT%H:%M:%S"))
                except Exception: pass
                continue
            fpath = os.path.abspath(os.path.join(d, fname))
            if fpath in schema_path_set: continue
            _triage_or_promote(fpath)

