reset_model_prefs() {
    local tmp="$MODEL_PREFS.tmp"
    cat > "$tmp" <<'PREFEOF'
# AItech AIDev model-selection preferences
MODEL_DEFAULT=
MODEL_LAST=
MODEL_DEFAULT_DELAY=1.0
MODEL_ACTIVE_ORIGINAL=
MODEL_ACTIVE_NAME=
MODEL_LAST_EVENT=
MODEL_LAST_SELECTION=Continue
KOBOLDCPP_PATH=
KOBOLDCPP_PORT=5001
KOBOLDCPP_CONTEXT=8192
KOBOLDCPP_AUTOSTART=1
SILLYTAVERN_PATH=
SILLYTAVERN_PORT=8000
SILLYTAVERN_AUTOSTART=0
PREFEOF
    mv "$tmp" "$MODEL_PREFS"

    MODEL_DEFAULT=""
    MODEL_LAST=""
    MODEL_DEFAULT_DELAY="1.0"
    MODEL_ACTIVE_ORIGINAL=""
    MODEL_ACTIVE_NAME=""
    MODEL_LAST_EVENT=""
}

read_pref_value() {
    local key="$1"
    [[ -f "$MODEL_PREFS" ]] || return 0
    sed -n "s/^${key}=//p" "$MODEL_PREFS" 2>/dev/null | tail -n 1
}

load_model_prefs() {
    [[ -f "$MODEL_PREFS" ]] || reset_model_prefs

    MODEL_DEFAULT="$(read_pref_value MODEL_DEFAULT)"
    MODEL_LAST="$(read_pref_value MODEL_LAST)"
    MODEL_DEFAULT_DELAY="$(read_pref_value MODEL_DEFAULT_DELAY)"
    MODEL_ACTIVE_ORIGINAL="$(read_pref_value MODEL_ACTIVE_ORIGINAL)"
    MODEL_ACTIVE_NAME="$(read_pref_value MODEL_ACTIVE_NAME)"
    MODEL_LAST_EVENT="$(read_pref_value MODEL_LAST_EVENT)"
    MODEL_LAST_SELECTION="$(read_pref_value MODEL_LAST_SELECTION)"
    KOBOLDCPP_PATH="$(read_pref_value KOBOLDCPP_PATH)"
    KOBOLDCPP_PORT="$(read_pref_value KOBOLDCPP_PORT)"
    KOBOLDCPP_CONTEXT="$(read_pref_value KOBOLDCPP_CONTEXT)"
    KOBOLDCPP_AUTOSTART="$(read_pref_value KOBOLDCPP_AUTOSTART)"
    SILLYTAVERN_PATH="$(read_pref_value SILLYTAVERN_PATH)"
    SILLYTAVERN_PORT="$(read_pref_value SILLYTAVERN_PORT)"
    SILLYTAVERN_AUTOSTART="$(read_pref_value SILLYTAVERN_AUTOSTART)"

    [[ "$MODEL_DEFAULT_DELAY" =~ ^[0-9]+([.][0-9]+)?$ ]] || MODEL_DEFAULT_DELAY="1.0"
    [[ -n "$MODEL_LAST_SELECTION" ]] || MODEL_LAST_SELECTION="Continue"
    [[ "$KOBOLDCPP_PORT" =~ ^[0-9]+$ ]] || KOBOLDCPP_PORT="5001"
    [[ "$KOBOLDCPP_CONTEXT" =~ ^[0-9]+$ ]] || KOBOLDCPP_CONTEXT="8192"
    [[ "$KOBOLDCPP_AUTOSTART" =~ ^[01]$ ]] || KOBOLDCPP_AUTOSTART="1"
    [[ "$SILLYTAVERN_PORT" =~ ^[0-9]+$ ]] || SILLYTAVERN_PORT="8000"
    [[ "$SILLYTAVERN_AUTOSTART" =~ ^[01]$ ]] || SILLYTAVERN_AUTOSTART="0"
}

write_model_prefs() {
    local tmp="$MODEL_PREFS.tmp"
    cat > "$tmp" <<PREFEOF
# AItech AIDev model-selection preferences
MODEL_DEFAULT=$MODEL_DEFAULT
MODEL_LAST=$MODEL_LAST
MODEL_DEFAULT_DELAY=$MODEL_DEFAULT_DELAY
MODEL_ACTIVE_ORIGINAL=$MODEL_ACTIVE_ORIGINAL
MODEL_ACTIVE_NAME=$MODEL_ACTIVE_NAME
MODEL_LAST_EVENT=$MODEL_LAST_EVENT
MODEL_LAST_SELECTION=$MODEL_LAST_SELECTION
KOBOLDCPP_PATH=$KOBOLDCPP_PATH
KOBOLDCPP_PORT=$KOBOLDCPP_PORT
KOBOLDCPP_CONTEXT=$KOBOLDCPP_CONTEXT
KOBOLDCPP_AUTOSTART=$KOBOLDCPP_AUTOSTART
SILLYTAVERN_PATH=$SILLYTAVERN_PATH
SILLYTAVERN_PORT=$SILLYTAVERN_PORT
SILLYTAVERN_AUTOSTART=$SILLYTAVERN_AUTOSTART
PREFEOF
    mv "$tmp" "$MODEL_PREFS"
}

load_model_prefs

# ---------------------------------------------------------------------------
# ACTIVE GGUF LIFECYCLE
# ---------------------------------------------------------------------------
# FILESYSTEM CONTRACT:
#   name.gguf          = available/inactive model
#   name(Active).gguf  = model assigned to the current running AIDev session
#
# The * shown by the selector is UI-only and marks MODEL_LAST. It is never added
# to a filename.
normalize_stale_active_models() {
    local active name base target stamp
    local recovered_any=0

    shopt -s nullglob
    local active_files=("$AIDEV_MODELS_DIR"/*"(Active).gguf")
    shopt -u nullglob

    for active in "${active_files[@]}"; do
        [[ -f "$active" ]] || continue
        name="$(basename "$active")"
        base="${name%(Active).gguf}"
        target="$AIDEV_MODELS_DIR/${base}.gguf"

        # A previous unclean stop can leave the marker behind. Since (Active)
        # means "owned by a currently running session", normalize it on next boot.
        #
        # Never overwrite another GGUF. If the ordinary name already exists,
        # preserve both by assigning the recovered file a timestamped name.
        if [[ -e "$target" ]]; then
            stamp="$(date '+%Y%m%d_%H%M%S')"
            target="$AIDEV_MODELS_DIR/${base}(Recovered-${stamp}).gguf"
        fi

        mv "$active" "$target"
        MODEL_LAST="$(basename "$target")"
        MODEL_LAST_EVENT="boot:removed-Active:${name}->$(basename "$target")"
        recovered_any=1
        echo -e "\033[1;33m[GGUF] Recovered stale Active marker: $name -> $(basename "$target")\033[0m"
    done

    if (( recovered_any )); then
        MODEL_ACTIVE_ORIGINAL=""
        MODEL_ACTIVE_NAME=""
        write_model_prefs
    fi
}

normalize_stale_active_models

ACTIVE_GGUF_PATH=""
ACTIVE_GGUF_ORIGINAL=""

activate_gguf() {
    local selected="$1"
    local selected_path="$AIDEV_MODELS_DIR/$selected"
    local stem active_name active_path

    [[ -f "$selected_path" ]] || {
        echo -e "\033[0;31m[!] GGUF not found: $selected_path\033[0m"
        return 1
    }

    stem="${selected%.gguf}"
    active_name="${stem}(Active).gguf"
    active_path="$AIDEV_MODELS_DIR/$active_name"

    if [[ "$selected" != *"(Active).gguf" ]]; then
        mv "$selected_path" "$active_path" || return 1
    else
        active_name="$selected"
        active_path="$selected_path"
        selected="${selected%(Active).gguf}.gguf"
    fi

    ACTIVE_GGUF_ORIGINAL="$selected"
    ACTIVE_GGUF_PATH="$active_path"

    MODEL_ACTIVE_ORIGINAL="$ACTIVE_GGUF_ORIGINAL"
    MODEL_ACTIVE_NAME="$active_name"
    MODEL_LAST_EVENT="startup:added-Active:${ACTIVE_GGUF_ORIGINAL}->${active_name}"
    MODEL_LAST_SELECTION="$ACTIVE_GGUF_ORIGINAL"
    write_model_prefs

    export AITECH_ACTIVE_GGUF="$ACTIVE_GGUF_PATH"
    export AITECH_ACTIVE_GGUF_ORIGINAL="$ACTIVE_GGUF_ORIGINAL"

    # MODEL MEMORY CAPABILITY HINT:
    # Presence of the shared schema/weights files tells orchestrator_core that
    # the surrounding AItech environment supports semantic-memory conventions.
    [[ -f "$MEMORY_SCHEMA" ]] && export AITECH_SEMANTIC_MEMORY=1 || export AITECH_SEMANTIC_MEMORY=0

    echo -e "\033[0;32m[GGUF] Active model: $active_name\033[0m"
    return 0
}

release_active_gguf() {
    # SHUTDOWN NOTE:
    # Release only the model claimed by this orchestrator process.
    # No other GGUF or user data is touched.
    [[ -n "$ACTIVE_GGUF_PATH" ]] || return 0
    [[ -e "$ACTIVE_GGUF_PATH" ]] || return 0

    local original_path="$AIDEV_MODELS_DIR/$ACTIVE_GGUF_ORIGINAL"
    local active_name
    active_name="$(basename "$ACTIVE_GGUF_PATH")"

    if [[ -e "$original_path" ]]; then
        local stamp="$(date '+%Y%m%d_%H%M%S')"
        original_path="$AIDEV_MODELS_DIR/${ACTIVE_GGUF_ORIGINAL%.gguf}(Released-${stamp}).gguf"
    fi

    mv "$ACTIVE_GGUF_PATH" "$original_path" 2>/dev/null || return 0

    MODEL_LAST="$(basename "$original_path")"
    MODEL_ACTIVE_ORIGINAL=""
    MODEL_ACTIVE_NAME=""
    MODEL_LAST_EVENT="shutdown:removed-Active:${active_name}->${MODEL_LAST}"
    write_model_prefs

    echo -e "\033[0;36m[GGUF] Released Active marker: $active_name -> $MODEL_LAST\033[0m"
    ACTIVE_GGUF_PATH=""
}

# ---------------------------------------------------------------------------
# MODEL INTAKE: URL DOWNLOAD / LOCAL FILE IMPORT
# ---------------------------------------------------------------------------
add_model_to_aidev() {
    local input_path=""
    local source_path=""
    local filename=""
    local destination=""
    local tmp=""

    echo
    read -r -p "url= " input_path

    # Empty input simply returns to the model menu.
    [[ -n "$input_path" ]] || return 0

    # Strip drag-and-drop quoting.
    input_path="${input_path%\"}"
    input_path="${input_path#\"}"
    input_path="${input_path%\'}"
    input_path="${input_path#\'}"

    if [[ "$input_path" =~ ^https?:// ]]; then
        filename="${input_path##*/}"
        filename="${filename%%\?*}"

        # URL endpoints do not always contain a useful filename.
        [[ -n "$filename" ]] || filename="downloaded_model.gguf"

        if [[ "$filename" != *.gguf ]]; then 
            filename="${filename}.gguf"
        fi

        destination="$AIDEV_MODELS_DIR/$filename"
        tmp="${destination}.part"

        echo "[GGUF] Downloading: $input_path"

        if command -v curl >/dev/null 2>&1; then
            if ! curl -L --fail --progress-bar "$input_path" -o "$tmp"; then
                echo "[!] Download failed." 
                rm -f "$tmp"
                return 1
            fi
        elif command -v wget >/dev/null 2>&1; then
            if ! wget --show-progress -O "$tmp" "$input_path"; then
                echo "[!] Download failed."
                rm -f "$tmp"
                return 1
            fi
        else
            echo "[!] Neither curl nor wget is available." 
            return 1
        fi

        mv "$tmp" "$destination"
        echo "[GGUF] Added: $destination"
        return 0
    fi

    # Otherwise treat input as a local path.
    source_path="$input_path"

    if [[ ! -f "$source_path" ]]; then 
        echo "[!] File not found: $source_path"
        return 1
    fi

    filename="$(basename "$source_path")"

    if [[ "$filename" != *.gguf ]]; then 
        echo "[!] Selected file is not a .gguf: $filename"
        return 1
    fi
    
    destination="$AIDEV_MODELS_DIR/$filename"

    # If already in the model directory, nothing needs to move.
    if [[ "$(realpath "$source_path" 2>/dev/null)" == "$(realpath -m "$destination" 2>/dev/null)" ]]; then
        echo "[GGUF] Model is already in AIDev/models."
        return 0
    fi

    # Do not silently overwrite an existing model.
    if [[ -e "$destination" ]]; then
        local stem="${filename%.gguf}" 
        local stamp
        stamp="$(date '+%Y%m%d_%H%M%S')"
        destination="$AIDEV_MODELS_DIR/${stem}(Imported-${stamp}).gguf"
    fi

    mv "$source_path" "$destination"
    echo "[GGUF] Moved into model library: $destination"
    return 0
}

# ---------------------------------------------------------------------------
# MODEL RENAME
# ---------------------------------------------------------------------------
rename_highlighted_model() {
    local old_name="$1"
    local old_path="$AIDEV_MODELS_DIR/$old_name"
    local suffix=".gguf"
    local stem=""
    local new_stem=""
    local new_name=""
    local new_path=""

    [[ -f "$old_path" ]] || { 
        echo "[!] Model not found: $old_name"
        return 1; 
    }

    # Preserve the semantic/runtime suffix exactly.
    if [[ "$old_name" == *"(Active).gguf" ]]; then
        suffix="(Active).gguf"
        stem="${old_name%(Active).gguf}"
    else
        suffix=".gguf"
        stem="${old_name%.gguf}"
    fi

    echo
    read -r -p "rename= " new_stem
    [[ -n "$new_stem" ]] || return 0

    # Strip drag/drop style quoting and any accidental extensions the user typed.
    new_stem="${new_stem%\"}"
    new_stem="${new_stem#\"}"
    new_stem="${new_stem%\'}"
    new_stem="${new_stem#\'}"
    new_stem="${new_stem%(Active).gguf}"
    new_stem="${new_stem%.gguf}"
    
    [[ -n "$new_stem" ]] || return 0

    new_name="${new_stem}${suffix}"
    new_path="$AIDEV_MODELS_DIR/$new_name"

    if [[ -e "$new_path" ]]; then 
        echo "[!] A model already uses that name: $new_name"
        return 1
    fi

    mv "$old_path" "$new_path" || return 1

    # Keep prefs coherent if the renamed model was referenced there.
    if [[ "$MODEL_DEFAULT" == "$old_name" ]]
        then MODEL_DEFAULT="$new_name"
    fi
    if [[ "$MODEL_LAST" == "$old_name" ]]; then 
        MODEL_LAST="$new_name"
    fi
    if [[ "$MODEL_ACTIVE_NAME" == "$old_name" ]]; then 
        MODEL_ACTIVE_NAME="$new_name"
    fi
    if [[ "$MODEL_ACTIVE_ORIGINAL" == "$old_name" ]]; then 
        MODEL_ACTIVE_ORIGINAL="$new_name"
    fi

    MODEL_LAST_EVENT="rename:${old_name}->${new_name}"
    write_model_prefs

    echo "[GGUF] Renamed: $old_name -> $new_name"
    return 0
}

# ---------------------------------------------------------------------------
# INSTALL DIRECTORY
# ---------------------------------------------------------------------------
run_install_directory() {
    mkdir -p "$AIDEV_INSTALL_DIR"

    echo -e "\nAIDev Install Directory:"
    echo -e "$AIDEV_INSTALL_DIR\n"

    shopt -s nullglob
    local scripts=("$AIDEV_INSTALL_DIR"/*)
    shopt -u nullglob

    if (( ${#scripts[@]} == 0 )); then
        echo "[Install] No scripts found."
        read -r -p "Press Enter to return to model menu..."
        return 0
    fi

    local script name status
    for script in "${scripts[@]}"; do
        [[ -f "$script" ]] || continue
        name="$(basename "$script")"

        case "$name" in
            *.sh) 
                echo "[Install] bash $name"
                chmod +x "$script" 2>/dev/null || true
                bash "$script"
                status=$? 
                ;;
            *.py) 
                echo "[Install] python $name"
                python3 "$script"
                status=$? 
                ;;
            *.command) 
                echo "[Install] bash $name"
                chmod +x "$script" 2>/dev/null || true
                bash "$script"
                status=$?
                ;;
            *)  
                # Executable files without a recognized script extension may 
                # still be intentional user-provided installers.
                if [[ -x "$script" ]]; then 
                    echo "[Install] execute $name"
                    "$script"
                    status=$?
                else 
                    echo "[Install] skip unsupported/non-executable file: $name"
                    continue; 
                fi
                ;;
        esac

        if (( status != 0 )); then 
            echo "[Install] $name exited with status $status"
        else 
            echo "[Install] $name complete."
        fi
        echo
    done

    read -r -p "Press Enter to return to model menu..."
    return 0
}

# ---------------------------------------------------------------------------
# INTERACTIVE MODEL SELECTOR
# ---------------------------------------------------------------------------
scan_ggufs() {
    GGUF_MODELS=()
    shopt -s nullglob
    local f
    for f in "$AIDEV_MODELS_DIR"/*.gguf; do
        [[ -f "$f" ]] || continue
        [[ "$(basename "$f")" == *"(Active).gguf" ]] && continue
        GGUF_MODELS+=("$(basename "$f")")
    done
    shopt -u nullglob
}

draw_model_selector() {
    local selected_index="$1" 
    local arm_default="$2" 
    local launch_note="${3:-}"
    local i model cursor last_mark default_mark
    local download_index="${#GGUF_MODELS[@]}"
    local install_index=$((download_index + 1))
    local continue_index=$((download_index + 2))

    printf '\033[2J\033[H'
    echo "AIDev GGUF Model Selector"
    echo "Directory: $AIDEV_MODELS_DIR"
    [[ -n "$launch_note" ]] && echo "$launch_note"
    echo
    echo "  ↑/↓       select"
    echo "  Enter     load selected model / open selected action"
    echo "  D+Enter   load selected model and set it as Default"
    echo "  R         rename highlighted GGUF, preserving its suffix"
    echo "  C         rewrite prefs with a clean configuration"
    echo "  Q         cancel launch"
    echo

    for i in "${!GGUF_MODELS[@]}"
    do
        model="${GGUF_MODELS[$i]}"
        cursor=" "
        last_mark=" "
        default_mark=""

        (( i == selected_index )) && cursor=">"
        [[ "$model" == "$MODEL_LAST" ]] && last_mark="*"
        [[ "$model" == "$MODEL_DEFAULT" ]] && default_mark=" [DEFAULT]"

        printf ' %s %s %s%s\n' "$cursor" "$last_mark" "$model" "$default_mark"
    done

    cursor=" "
    (( selected_index == download_index )) && cursor=">"
    printf ' %s   Download\n' "$cursor"

    cursor=" "
    (( selected_index == install_index )) && cursor=">"
    printf ' %s   Install\n' "$cursor"

    cursor=" "
    (( selected_index == continue_index )) && cursor=">"
    printf ' %s   Continue\n' "$cursor"

    if (( arm_default )); then
        echo
        echo -e "[D+] Default is armed. Press Enter now to SET Default."
    fi
}

choose_model_interactively() {
    local idx="${1:-0}" 
    local key="" k2="" k3="" default_arm=0 
    local first_pass=1

    while true
    do
        # Every action that can change the model library returns through here,
        # so downloads/installers/renames are visible immediately.
        scan_ggufs
        local model_count=${#GGUF_MODELS[@]}
        local download_index=$model_count
        local install_index=$((model_count + 1))
        local continue_index=$((model_count + 2))
        local item_count=$((model_count + 3))

        (( idx >= item_count )) && idx=$((item_count - 1))
        (( idx < 0 )) && idx=0

        # First pass: prefer the last-loaded model unless caller supplied
        # a meaningful selection index.
        if (( first_pass )) && (( idx == 0 )); then
            local i
            for i in "${!GGUF_MODELS[@]}"; do
                if [[ "${GGUF_MODELS[$i]}" == "$MODEL_LAST" ]]; then
                    idx=$i
                    break
                fi
            done
            first_pass=0
        fi

        while true; do
            draw_model_selector "$idx" "$default_arm"

            key=""
            IFS= read -rsn1 key || true

            case "$key" in
                $'\x1b')
                    default_arm=0
                    k2=""; k3=""
                    IFS= read -rsn1 -t 0.05 k2 2>/dev/null || true
                    if [[ "$k2" == "[" ]]; then
                        IFS= read -rsn1 -t 0.05 k3 2>/dev/null || true
                        case "$k3" in
                            A) idx=$(( (idx - 1 + item_count) % item_count )) ;;
                            B) idx=$(( (idx + 1) % item_count )) ;;
                        esac
                    fi
                    ;;
                d|D) 
                    if (( idx < model_count )); then 
                        default_arm=1
                    else 
                        default_arm=0
                    fi 
                    ;;
                r|R)
                    default_arm=0
                    if (( idx < model_count )); then 
                        rename_highlighted_model "${GGUF_MODELS[$idx]}" || true
                        break
                    fi
                    ;;
                c|C)
                    reset_model_prefs
                    load_model_prefs
                    default_arm=0
                    echo "[Prefs] Clean configuration written."
                    sleep 0.4
                    ;;
                q|Q) 
                    return 2 
                    ;;
                "")
                    if (( idx == download_index )); then
                        default_arm=0
                        MODEL_LAST_SELECTION="Download"
                        write_model_prefs
                        add_model_to_aidev || true
                        idx=0
                        break
                    fi

                    if (( idx == install_index )); then
                        default_arm=0
                        MODEL_LAST_SELECTION="Install"
                        write_model_prefs
                        run_install_directory
                        idx=0
                        break
                    fi

                    if (( idx == continue_index )); then
                        default_arm=0; MODEL_LAST_SELECTION="Continue"
                        export AITECH_ACTIVE_GGUF=""
                        export AITECH_ACTIVE_GGUF_ORIGINAL=""
                        export AITECH_DIRECT_GGUF=1
                        MODEL_LAST_EVENT="startup:continued-without-model"
                        write_model_prefs
                        echo "[GGUF] Continuing without an active model."
                        return 0
                    fi

                    local selected="${GGUF_MODELS[$idx]}"
                    if (( default_arm )); then
                        MODEL_DEFAULT="$selected"
                        write_model_prefs
                        echo "[Prefs] Default set: $selected"
                    fi

                    activate_gguf "$selected"
                    return $?
                    ;;
                *) 
                    default_arm=0
                    ;;
            esac
        done
    done
}

startup_model_selection() {
    scan_ggufs
    local count=${#GGUF_MODELS[@]}
    local download_index=$count
    local install_index=$((count + 1))
    local continue_index=$((count + 2))
    local idx=$continue_index
    local auto_action="$MODEL_LAST_SELECTION" 
    local i #USB_Portability_Compatibility_Note

    # LAST-SELECTION CONTRACT:
    # The first visible menu highlights what was selected last boot and, after
    # the configurable delay, executes it if no input arrives.
    #
    # SAFETY:
    # Install is never auto-executed. If Install was selected last boot, the
    # unattended next boot highlights/executes Continue instead.
    [[ "$auto_action" == "Install" ]] && auto_action="Continue"

    case "$auto_action" in
        Download) idx=$download_index ;;
        Continue) idx=$continue_index ;;
        *)
            for i in "${!GGUF_MODELS[@]}"
            do
                if [[ "${GGUF_MODELS[$i]}" == "$auto_action" ]]
                then 
                    idx=$i
                    break
                fi
            done
            ;;
    esac

    # If the remembered model no longer exists, fall back to Continue.
    if (( idx < count )) && [[ "${GGUF_MODELS[$idx]}" != "$auto_action" ]]
    then
        idx=$continue_index; auto_action="Continue"
    fi

    draw_model_selector \
    "$idx" \
    0 \
    "Last selection: $MODEL_LAST_SELECTION | auto in ${MODEL_DEFAULT_DELAY}s"
    
    local boot_key=""
    IFS= read -rsn1 -t "$MODEL_DEFAULT_DELAY" boot_key 2>/dev/null || true

    case "$boot_key" in
        d|D)
            # Existing D startup behavior still controls Default.
            MODEL_DEFAULT=""
            MODEL_LAST_EVENT="startup:Default-unset-by-D"
            write_model_prefs
            choose_model_interactively "$idx"
            return $? 
            ;;
        c|C)
            reset_model_prefs
            echo "[Prefs] Configuration rebuilt from clean template."
            choose_model_interactively "$continue_index"
            return $? 
            ;;
        "")
            # No input: then hmm do the remembered action.
            if [[ "$auto_action" == "Download" ]]; then
                MODEL_LAST_SELECTION="Download"
                write_model_prefs
                add_model_to_aidev || true
                choose_model_interactively 0
                return $?
            fi

            if [[ "$auto_action" == "Continue" ]]; then
                MODEL_LAST_SELECTION="Continue"
                export AITECH_ACTIVE_GGUF=""
                export AITECH_ACTIVE_GGUF_ORIGINAL=""
                export AITECH_DIRECT_GGUF=1
                MODEL_LAST_EVENT="startup:auto-continued-without-model"
                write_model_prefs
                echo "[GGUF] Auto-continuing without an active model."
                return 0
            fi

            if [[ -f "$AIDEV_MODELS_DIR/$auto_action" ]]
            then
                activate_gguf "$auto_action"
                return $?
            fi

            # then, if the remembered item disappeared between the locate and run or execute and draw stages.
            MODEL_LAST_SELECTION="Continue" 
            write_model_prefs
            return 0 
            ;;
        *)
            # Any key other than D/C cancels unattended execution and opens the
            # normal selector at the remembered row.
            choose_model_interactively "$idx"
            return $? 
            ;;
    esac
}

# ---------------------------------------------------------------------------
# LOCAL INFERENCE / FRONTEND DAEMON MANAGEMENT
# ---------------------------------------------------------------------------
find_koboldcpp() {
    if [[ -n "$KOBOLDCPP_PATH" && -f "$KOBOLDCPP_PATH" ]]
    then 
        printf '%s\n' "$KOBOLDCPP_PATH"
        return 0
    fi

    local candidates=(
        "$AIDEV_ROOT/KoboldCpp/koboldcpp" 
        "$AIDEV_ROOT/KoboldCpp/koboldcpp.py" 
        "$AIDEV_ROOT/koboldcpp/koboldcpp" 
        "$AIDEV_ROOT/koboldcpp/koboldcpp.py"
    )
    local c
    for c in "${candidates[@]}"
    do
        [[ -f "$c" ]] && { printf '%s\n' "$c"; return 0; }
    done

    command -v koboldcpp 2>/dev/null && return 0
    command -v koboldcpp.py 2>/dev/null && return 0
    return 1
}

find_sillytavern() {
