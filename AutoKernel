# ── WORLD BOUNDARY ────────────────────────────────────────────────────────────
# session.noq is the world. Ordinary file operations belong inside it. A write
# outside it is not an error and not forbidden — the user may legitimately direct
# one — but it must be explicit: the full resolved path and the reason are shown
# and confirmed first. The external dgapi book drop is the one declared port and
# is exempt by design. Non-interactive contexts refuse rather than block, and the
# request is recorded for the disk orchestrator to surface for later approval.
def _boundary_pending_path():
    try:
        return os.path.join(DGAPI_DIR, "system", "pending_external_writes.txt")
    except Exception:
        return None


def confirm_external_write(target_path, reason, interactive=True):
    """Return True if writing target_path is permitted.

    Inside session.noq  -> allowed silently.
    External dgapi port -> allowed silently (sanctioned boundary port).
    Anywhere else       -> requires explicit confirmation stating path + reason.
    """
    try:
        target = os.path.realpath(str(target_path))
        world = os.path.realpath(NOQ_DIR)
        port = os.path.realpath(EXT_DGAPI_DIR)
    except Exception:
        return False

    if target == world or target.startswith(world + os.sep):
        return True
    if target == port or target.startswith(port + os.sep):
        return True

    # Record the request regardless of outcome so the orchestrator can surface it.
    try:
        pending = _boundary_pending_path()
        if pending:
            os.makedirs(os.path.dirname(pending), exist_ok=True)
            with open(pending, "a", encoding="utf-8") as fh:
                fh.write(f"{int(time.time())} | {target} | {reason}\n")
    except Exception:
        pass

    if not interactive or not sys.stdin.isatty():
        print(f"\n[BOUNDARY] Refused write outside session.noq (no user present to confirm)."
              f"\n           path   : {target}"
              f"\n           reason : {reason}"
              f"\n           Recorded for review.")
        return False

    print(f"\n\033[1;33m[BOUNDARY]\033[0m This write leaves session.noq, the model's world."
          f"\n           path   : {target}"
          f"\n           reason : {reason}")
    try:
        answer = input("           Allow this write? [y/N] ").strip().lower()
    except (EOFError, KeyboardInterrupt):
        print()
        return False
    return answer in ("y", "yes")


