    class DaemonEngine(threading.Thread):
        def __init__(self, host=QWEN_LOCAL_IP_CFG, port=QWEN_LOCAL_PORT_CFG):
            super().__init__(daemon=True)
            self.host = host
            self.port = port

        def run(self):
            srv = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
            srv.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)
            try:
                srv.bind((self.host, self.port))
                srv.listen(5)
                while True:
                    client, _ = srv.accept()
                    threading.Thread(target=self.handle,
                                     args=(client,), daemon=True).start()
            except Exception:
                pass

        def handle(self, client):
            nonlocal session_history
            try:
                data = client.recv(4096).decode('utf-8').strip()
                if data.startswith("QUERY:"):
                    query   = data[6:].strip()
                    inputs = encode_chat_generation_prompt(
                        f"User: {query}\nAssistant:", 80
                    )
                    model.eval()
                    with torch.no_grad():
                        out = model.generate(**inputs, max_new_tokens=80,
                                             pad_token_id=tokenizer.eos_token_id,
                                             do_sample=True, temperature=0.7)
                    response = tokenizer.decode(
                        out[0][inputs['input_ids'].shape[1]:], skip_special_tokens=True
                    ).strip()
                    client.sendall(response.encode('utf-8'))
                    session_history += f"\n[IPC] {query}\nKE: {response}\n"
                elif data.startswith("CMD:wake"):
                    ponder_thread.wake_mode = True
                    client.sendall(b"ACK: WAKE")
                else:
                    client.sendall(b"ERR: PROTOCOL_MISMATCH")
            except Exception:
                pass
            finally:
                client.close()

    # ── CNSL ─────────────────────────────────────────────────────────────────
    cnsl_lock = threading.Lock()

    def cnsl(reason="manual"):
        nonlocal session_history
        if not cnsl_lock.acquire(blocking=False):
            return "[CNSL] Already running."
        timestamp = time.strftime("%Y%m%d_%H%M%S")
        snapshot  = session_history
        try:
            if not snapshot.strip():
                return "[CNSL] Nothing to consolidate."
            encoded  = tokenizer(snapshot, return_tensors="pt",
                                 add_special_tokens=False, truncation=False)["input_ids"][0]
            total    = int(encoded.shape[0])
            chunk_sz = 256 if reason == "manual" else 128

            train_path = os.path.join(TRAIN_DIR, f"cnsl_{timestamp}.txt")
            with open(train_path, "w", encoding="utf-8") as f:
                f.write(snapshot)

            model.train()
            losses = []
            for start in range(0, total, chunk_sz):
                chunk = encoded[start:start + chunk_sz]
                if chunk.shape[0] < 2:
                    continue
                ids    = chunk.unsqueeze(0).to(device)
                labels = ids.clone()
                optimizer.zero_grad(set_to_none=True)
                loss   = model(input_ids=ids, attention_mask=torch.ones_like(ids),
                                labels=labels).loss
                loss.backward(); optimizer.step()
                losses.append(loss.item())

            model.save_pretrained(MODEL_DIR)
            tokenizer.save_pretrained(MODEL_DIR)

            avg_loss        = sum(losses) / max(1, len(losses))
            session_history = f"[CNSL:{timestamp}] Consolidated {total} tokens. Loss:{avg_loss:.4f}\n"
            update_gui_chat("SYS", f"CNSL complete | {total} tokens | Loss:{avg_loss:.4f}")
            return f"[CNSL] {total} tokens | {len(losses)} chunks | Avg Loss:{avg_loss:.4f}"
        finally:
            cnsl_lock.release()

