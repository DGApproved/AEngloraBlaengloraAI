def _scan_local_models(models_root=_MODELS_ROOT):
    """
    Return detected HuggingFace checkpoints plus engine compatibility.

    This engine loads with LlamaForCausalLM, so a checkpoint is COMPATIBLE only
    when config.json identifies the Llama architecture. Other checkpoints remain
    visible in the selector but are labelled rather than silently attempted.
    """
    found = []
    if not os.path.isdir(models_root):
        return found
    for entry in sorted(os.listdir(models_root)):
        full = os.path.join(models_root, entry)
        if not os.path.isdir(full):
            continue
        cfg_path = os.path.join(full, "config.json")
        if not os.path.exists(cfg_path):
            continue
        info = {"path": full, "name": entry,
                "hidden_size": "?", "num_layers": "?",
                "param_estimate": None, "size_label": "?",
                "compatibility": "UNKNOWN", "compat_reason": "config unreadable"}
        try:
            with open(cfg_path, "r", encoding="utf-8") as f:
                cfg = json.load(f)
            h  = cfg.get("hidden_size", cfg.get("n_embd", 0))
            l  = cfg.get("num_hidden_layers", cfg.get("n_layer", 0))
            v  = cfg.get("vocab_size", 50257)
            ff = cfg.get("intermediate_size", h * 4 if h else 0)
            model_type = str(cfg.get("model_type", "") or "").lower()
            architectures = [str(x) for x in cfg.get("architectures", [])]
            exact_llama = (
                model_type == "llama"
                or "LlamaForCausalLM" in architectures
            )
            if exact_llama:
                info["compatibility"] = "COMPATIBLE"
                info["compat_reason"] = "LlamaForCausalLM"
            else:
                detected = model_type or (architectures[0] if architectures else "unknown architecture")
                info["compatibility"] = "INCOMPATIBLE"
                info["compat_reason"] = detected
            if h and l:
                params = v * h + l * (4 * h * h + 3 * h * ff + 2 * h) + v * h
                info["param_estimate"] = params
                if params < 8_000_000:
                    info["size_label"] = f"{params/1e6:.1f}M"
                elif params < 1_000_000_000:
                    info["size_label"] = f"{params/1e6:.0f}M"
                else:
                    info["size_label"] = f"{params/1e9:.1f}B"
            info["hidden_size"] = h or "?"
            info["num_layers"]  = l or "?"
        except Exception as exc:
            info["compat_reason"] = type(exc).__name__
        found.append(info)
    return found

def _select_model_interactive(models):
    """
    Present detected models as a numbered list and return the selected MODEL_PATH.
    Returns None to start with a blank model slate.
    Defaults to the first model containing 'hf_base_model' in its name, or
    model index 0 if none found, pressing Enter accepts the default.
    """
    print("\n" + "="*60)
    print("  SESSION.NOQ MODEL SELECTOR")
    print("="*60)

    if not models:
        print("  No trained models found in session.noq/models/")
        print("  Starting with BLANK model slate.")
        print("="*60)
        return None

    # Find default: prefer hf_base_model, else first entry
    default_idx = 0
    for i, m in enumerate(models):
        if "hf_base_model" in m["name"] or "4m" in m["name"].lower():
            default_idx = i
            break

    for i, m in enumerate(models):
        marker = " [default]" if i == default_idx else ""
        params = f"  ~{m['size_label']}" if m["size_label"] != "?" else ""
        layers = f"  layers={m['num_layers']}" if m["num_layers"] != "?" else ""
        hidden = f"  hidden={m['hidden_size']}" if m["hidden_size"] != "?" else ""
        compat = (
            "[COMPATIBLE]"
