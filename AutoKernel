# THREE DIRECTIVE FILE TYPES, three levels of reach. All share the @@ AITECH_*
# grammar; they differ only in where an anchor is allowed to resolve.
#   update.txt / update.sh  UNSCOPED. Anchors match anywhere in the launched
#                           source, including the header, the changelog, and any
#                           generated body. The escape hatch: full reach when the
#                           right tags are used, and the only way to edit lines
#                           that live outside a generated body.
#   datamod.txt             SCOPED to COMPONENT bodies (write_if_changed sites):
#                           the engines, the map generator, plugins, GUI.sh.
#                           Requires @@ AITECH_TARGET; refuses env bodies.
#   envmod.txt              SCOPED to ENVIRONMENT bodies (bare `cat >` sites):
#                           prompts.txt, programmer.prefs, .installer_v32.template.
#                           Requires @@ AITECH_TARGET; refuses component bodies;
#                           requires a paired migration for seed-once files; and
#                           skips any target the user has hand-edited since the
#                           last AItech write.
scan_update_scripts() {                                  # unscoped directives; .txt preferred, .sh kept for compatibility
    local f
    for f in "$UPDATE_DIR/update.txt" "$UPDATE_DIR/update.sh"; do
        [[ -f "$f" ]] && printf '%s\n' "$f"
    done
}
scan_datamods() { [[ -f "$UPDATE_DIR/datamod.txt" ]] && printf '%s\n' "$UPDATE_DIR/datamod.txt"; }   # component-body scoped
