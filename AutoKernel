# ============================================================================
# AUTOKERNEL SELF UPDATE
# ============================================================================
update_autokernel() {
    local target update_file user_home backup stamp target_dir tmp
    if [[ "${AUTOKERNEL_ORIGIN_WRITABLE:-0}" == "1" ]]; then
        target="$AUTOKERNEL_PATH"
        update_file="$(dirname "$AUTOKERNEL_PATH")/update.bin"
    else
        target="$(autokernel_latest_install_target 2>/dev/null || true)"
        if [[ -z "$target" ]]; then
            echo "[AutoKernel] No successful installed target is recorded."
            echo "[AutoKernel] Run Option 32: (Re)Install / Repair AutoKernel first."
            autokernel_install_log "UPDATE" "FAILED" "" "" "no installed target recorded"
            return 1
        fi
        user_home="$(_autokernel_user_home)"
        update_file="$user_home/Downloads/update.bin"
    fi
    echo "AutoKernel update source : $update_file"
    echo "AutoKernel update target : $target"
    if [[ ! -f "$update_file" ]]; then
        echo "[AutoKernel] update.bin not found."
        autokernel_install_log "UPDATE" "FAILED" "$update_file" "$target" "update.bin not found"
        return 1
    fi
    if [[ ! -f "$target" ]]; then
        echo "[AutoKernel] Recorded update target does not exist: $target"
        autokernel_install_log "UPDATE" "FAILED" "$update_file" "$target" "target missing"
        return 1
    fi
    if ! bash -n "$update_file" 2>/dev/null; then
        echo "[AutoKernel] update.bin failed Bash syntax validation; update cancelled."
        autokernel_install_log "UPDATE" "FAILED" "$update_file" "$target" "bash syntax validation failed"
        return 1
    fi
    target_dir="$(dirname "$target")"
    [[ -w "$target_dir" || -w "$target" ]] || {
        echo "[AutoKernel] Update target is not writable: $target"
        autokernel_install_log "UPDATE" "FAILED" "$update_file" "$target" "target not writable"
        return 1
    }
    stamp="$(date '+%Y%m%d_%H%M%S')"
    backup="${target}.bak.${stamp}"
    tmp="${target}.update.$$"
    cp -p "$target" "$backup" || {
        autokernel_install_log "UPDATE" "FAILED" "$update_file" "$target" "backup creation failed"
        return 1
    }
    cp "$update_file" "$tmp" || {
        rm -f "$tmp"
        autokernel_install_log "UPDATE" "FAILED" "$update_file" "$target" "staging copy failed"
        return 1
    }
    chmod +x "$tmp" 2>/dev/null || true
    if mv -f "$tmp" "$target"; then
        chmod +x "$target" 2>/dev/null || true
        echo "[AutoKernel] Update successful."
        echo "[AutoKernel] Backup retained at: $backup"
        autokernel_install_log "UPDATE" "SUCCESS" "$update_file" "$target" "backup=$backup"
        return 0
    fi
    rm -f "$tmp"
    autokernel_install_log "UPDATE" "FAILED" "$update_file" "$target" "replacement failed; backup=$backup"
    return 1
}

