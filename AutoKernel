    def _oc_prog_latest_file(project):
        latest=None; latest_mt=0.0
        for stage,path in _oc_prog_paths(project).items():
            if not path.is_dir(): continue
            for candidate in path.rglob("*"):
                if not candidate.is_file() or candidate.name in ("aitech_project.json","token_ledger.json","project_session.json"):
                    continue
                try: mt=candidate.stat().st_mtime
                except OSError: continue
                if mt>latest_mt:
                    latest_mt=mt; latest=candidate
        if latest is None: return "",""
        try: rel=str(latest.relative_to(CODE_ROOT))
        except Exception: rel=str(latest)
        return rel,time.strftime("%Y-%m-%d %H:%M:%S",time.localtime(latest_mt))

