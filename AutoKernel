clamp_int() {
    local n="${1:-0}" min="${2:-0}" max="${3:-100}"
    [[ "$n" =~ ^-?[0-9]+$ ]] || n=0
    (( n < min )) && n=$min; (( n > max )) && n=$max; printf '%d' "$n"
}

repeat_char() {
    local char="$1" count="$2"
    (( count <= 0 )) && return
    printf '%*s' "$count" '' | tr ' ' "$char"
}

calculate_layout() {
    COLS=$(tput cols 2>/dev/null || echo 80); ROWS=$(tput lines 2>/dev/null || echo 24)
    (( COLS < 40 )) && COLS=40; (( ROWS < 12 )) && ROWS=12
