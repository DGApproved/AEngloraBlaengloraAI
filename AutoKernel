def build_training_continuity_graph():
    """Map how oversized sources and separate training sessions stay connected."""
    lines = [
        "<|system|> AItech hierarchical training-continuity map. A source can be larger than one neural window, and training history can be larger than one training run. Preserve identity, order, boundaries and links without pretending any one window/session is the whole. <|endoftext|>",
        _qa("What happens when one trainable record is larger than the active neural sequence?","Preserve source identity, divide the observation into legal windows, and add separate derived continuity records before, between and after those windows. Source windows are observations; bridge records are navigation interpretations."),
        _qa("Why preserve an 8192-token logical parent when the training batch may be smaller?","The configured context represents the larger relationship horizon. A smaller batch sequence can divide that parent into neural subwindows while retaining parent identity, so local training remains legal without losing the larger structural neighborhood."),
        _qa("What comes before the first source window?","SOURCE_PRELUDE records source identity, original token count, logical horizon, neural batch horizon and the rule that no one window automatically represents the entire source."),
        _qa("What belongs between windows?","SUBWINDOW_BRIDGE links adjacent neural windows inside one logical parent. PARENT_BRIDGE links neighboring logical parents of the same original source. Each says continuation may continue, qualify, contrast or complete earlier material without inventing which relation is true."),
        _qa("What comes after the final source window?","SOURCE_END records that all preceding source windows belong to one original record and that intermediate window boundaries were navigation boundaries rather than semantic conclusions."),
        _qa("How can separate training sessions interlink?","Each run receives a TRAINING_SESSION_ID and durable summary. A later SESSION_PRELUDE can reference earlier runs; SESSION_BRIDGE records shared source labels or semantic terms while preserving every session as a separate historical event."),
        _qa("Does a session bridge force the new run to agree with an old run?","No. It marks a continuity candidate. The later session may continue, revise, contradict, specialize or leave unused material from the earlier session."),
        _qa("What if a source contains 59074 tokens while the configured logical window is 8192?","Measure all 59074 as the source extent, divide them into ordered logical parents, subdivide those parents when the actual neural batch is smaller, and preserve bridge metadata. Tokens beyond the first window become trainable observations instead of an invisible truncated tail."),
        _qa("What is the continuity invariant?","SOURCE_SIZE greater than MODEL_WINDOW means SEGMENT AND LINK, not DISCARD. SESSION_DISTANCE greater than one run means REFERENCE AND LINK, not FORGET."),
        _qa("Should SOURCE_WINDOW and bridge vocabulary dominate normal conversation?","No. Those labels preserve training navigation. Their relational meaning can support an answer, but ordinary response language should normally describe the subject unless the user is specifically asking about the continuity machinery."),
    ]
    history_path = os.path.join(
        os.environ.get("SESSION_NOQ_PATH", "session.noq"),
        "dgapi", "system", "training_continuity", "sessions.jsonl"
    )
    recent = []
    try:
        with open(history_path, "r", encoding="utf-8", errors="ignore") as fh:
            for raw in fh:
                try:
                    row = json.loads(raw)
                except Exception:
                    continue
                if row.get("event") in {"SESSION_PREPARED", "SESSION_COMPLETE"}:
                    recent.append(row)
    except OSError:
        pass
    if recent:
        lines.append("RECENT_TRAINING_SESSION_HISTORY:")
        latest = {}
        order = []
        for row in recent:
            sid = row.get("session_id")
            if not sid:
                continue
            if sid not in latest:
                order.append(sid)
            latest[sid] = row
        for sid in order[-8:]:
            row = latest[sid]
            lines.append(
                "  session_id={sid} engine={engine} status={status} "
                "records={records} logical_window={logical} batch_window={batch} prior={prior}".format(
                    sid=sid,
                    engine=row.get("engine", "UNKNOWN"),
                    status=row.get("status", row.get("event", "UNKNOWN")),
                    records=row.get("prepared_record_count", row.get("original_record_count", "?")),
                    logical=row.get("logical_window_tokens", "?"),
                    batch=row.get("batch_window_tokens", "?"),
                    prior=",".join(row.get("linked_prior_sessions", [])[:4]) or "none",
                )
            )
    else:
        lines.append("RECENT_TRAINING_SESSION_HISTORY: none recorded yet; the bridge framework is ready for later runs.")
    return "\n".join(lines)


