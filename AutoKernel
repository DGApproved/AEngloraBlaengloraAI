        historyTabs.setPreferredSize(new Dimension(800, 375)); // - set initial size to match scrollPane

        // Existing chat surface: no renderer, listener, persistence, or scroll behavior is replaced.
        historyTabs.addTab("CHAT", scrollPane);

        addObservationTab("OVERVIEW", "manager");
        addObservationTab("AItech", "aitech");
        addObservationTab("BUILD", "build");
        addObservationTab("GAME", "engine");
        addObservationTab("KERNEL", "kernel");
        addObservationTab("PROJECT", "project");
        addObservationTab("SYSTEM", "system");
        addObservationTab("LOGS", "logs");
        addObservationTab("PERSPECTIVE", "perspective");
        addObservationTab("RELATIONS", "relationships");
        addObservationTab("INTEGRATION", "integration");

        // Tab 13: UPDATE is always structurally present. It starts "shy": the
        // custom tab painter blends it into the strip until [Update] reveals it.
        buildUpdateSurface();
        historyTabs.addTab("UPDATE", null, updatePane,
                "Plugin update inbox / URL downloader");

        updateTabColors();
        historyTabs.addChangeListener(e -> {
            updateTabColors();
            refreshObservationViews();
        });

        // Low-frequency observer only. It never rewrites the chat document or typing buffer.
        observationRefreshTimer = new Timer(2000, e -> refreshObservationViews());
        observationRefreshTimer.setRepeats(true);
        observationRefreshTimer.start();
        refreshObservationViews();
    }

