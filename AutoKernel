            continue
            
        is_dead = line.startswith("0x0")
        if track_target == "active" and not is_dead:
            return line.split(" -> ")
            
    return None

def binary_to_wave(state, base_freq, tension, sample_rate, duration=0.25):
    """Translates the NPN/PNP binary into a waveform frame."""
    if tension == 0: return [0] * int(sample_rate * duration)
    if tension >= 10: return [0] * int(sample_rate * duration) # Snapped string
    
    frames = []
    # Tension 1-9 acts as an amplitude modifier
    amplitude = (tension / 9.0) * 32767.0
    
    for i in range(int(sample_rate * duration)):
        t = float(i) / sample_rate
        
        # State Machine Logic
        if state == "00": # Baseline / Decay
            val = 0
        elif state == "11": # Upward square stacked on sine
            sine = math.sin(2.0 * math.pi * base_freq * t)
            square = 1 if sine > 0 else -1
            val = (sine + square) / 2.0
        elif state == "10": # Downward sine (Inverted)
            val = -math.sin(2.0 * math.pi * base_freq * t)
        elif state == "01": # Self-canceling alternating (Reverb math)
            val = abs(math.sin(2.0 * math.pi * base_freq * t)) * -1
        else:
            val = 0
            
        frames.append(int(val * amplitude * 0.2)) # 0.2 scaling to prevent clipping across 6 strings
    return frames

def synthesize_track(sequence):
    """Builds the final .wav file from the sequence blocks."""
    if not sequence:
        print("[playguitar.code] No valid track found to play.")
        sys.exit(1)
        
    print(f"[playguitar.code] Synthesizing {len(sequence)} frames...")
    sample_rate = 44100
    final_audio = []

    for step in sequence:
        step_audio = [0] * int(sample_rate * 0.25) # 250ms per transition
        strings = step.split()
        
        for string_data in strings:
            if len(string_data) < 4: continue
            
            # e.g., '5E11' -> tension=5, note=E, binary=11
            tension = int(string_data[0])
            note = string_data[1]
            binary_state = string_data[2:4]
            
            freq = TUNING_MAP.get(note, 0)
            if freq > 0:
                wave_data = binary_to_wave(binary_state, freq, tension, sample_rate)
                # Additively mix the 6 strings together
                for i in range(len(step_audio)):
                    step_audio[i] += wave_data[i]
                    
        final_audio.extend(step_audio)

    # Export to ALPHABET_DIR
    os.makedirs(OUTPUT_DIR, exist_ok=True)
