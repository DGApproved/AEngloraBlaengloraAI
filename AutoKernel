def _source_prefix_text(path, max_bytes=32768):
    try:
        with open(path, "rb") as f:
            raw = f.read(max_bytes)
        if raw.count(b"\0") > max(8, len(raw)//20):
            return ""
        return raw.decode("utf-8", errors="ignore")
    except OSError:
        return ""


def _source_binary_probe(path, max_bytes=262144):
    try:
        with open(path, "rb") as f:
            raw = f.read(max_bytes)
    except OSError:
        return {"protected_marker": "", "sampled_bytes": 0}
    low = raw.lower()
    marker = next((m.decode("ascii", errors="ignore") for m in _PROTECTED_MEDIA_MARKERS if m in low), "")
    return {"protected_marker": marker, "sampled_bytes": len(raw)}


def _ancestor_policy_dirs(path):
    here = os.path.realpath(os.path.dirname(path))
    root = TRAINING_TERRITORY_ROOT
    while True:
        if here == root or here.startswith(root + os.sep):
            yield here
        if here == root:
            break
        parent = os.path.dirname(here)
        if parent == here or not parent.startswith(root):
            break
        here = parent


def _read_policy_overrides(path):
    flags = {}
    for directory in _ancestor_policy_dirs(path):
        for name in _POLICY_FILENAMES:
            p = os.path.join(directory, name)
            if not os.path.isfile(p):
                continue
            try:
                for raw in Path(p).read_text(encoding="utf-8", errors="ignore").splitlines():
                    line = raw.strip()
                    if not line or line.startswith("#") or "=" not in line:
                        continue
                    k, v = line.split("=", 1)
                    flags[k.strip().upper()] = v.strip()
            except OSError:
                pass
    return flags


def _nearby_license_text(path):
    for directory in _ancestor_policy_dirs(path):
        for name in ("LICENSE", "LICENSE.txt", "LICENSE.md", "COPYING", "COPYRIGHT", "NOTICE", "NOTICE.txt"):
            p = os.path.join(directory, name)
            if os.path.isfile(p):
                body = _source_prefix_text(p, 65536)
                if body:
                    return name, body
    return "", ""


def _detect_license(text):
    for license_id, pattern in _LICENSE_PATTERNS:
        if re.search(pattern, text or "", re.I | re.M):
            return license_id
    spdx = re.search(r"SPDX-License-Identifier\s*:\s*([A-Za-z0-9.+_-]+)", text or "", re.I)
    return spdx.group(1).strip() if spdx else ""


def _sha256_file(path):
    h = hashlib.sha256()
    try:
        with open(path, "rb") as f:
            while True:
                chunk = f.read(1024 * 1024)
                if not chunk:
                    break
                h.update(chunk)
        return h.hexdigest()
    except OSError:
        return ""


def _body_fingerprints(path, max_bytes=4_000_000, max_items=4096):
    """
    Bounded normalized body fingerprints.  These are deliberately independent
    of a title/license header so a later complete copy can match an earlier copy
    whose provenance header was accidentally stripped.
    """
    text = _source_prefix_text(path, max_bytes)
    if not text:
        return []
    # Drop obvious provenance/header lines from body matching only.  They remain
    # available to the classifier itself.
    kept = []
    for line in text.splitlines():
        low = line.strip().lower()
        if any(x in low for x in ("copyright", "license", "spdx-license-identifier",
                                  "all rights reserved", "author:", "publisher:")):
            continue
        kept.append(re.sub(r"\s+", " ", line).strip())
    normalized = "\n".join(x for x in kept if x)
    if not normalized:
        return []
    out = []
    # Stable overlapping chunks tolerate inserted/removed headers and modest
    # formatting differences without claiming semantic similarity is identity.
    for i in range(0, len(normalized), 128):
        chunk = normalized[i:i+256]
        if len(chunk) < 32:
            continue
        out.append(hashlib.sha256(chunk.encode("utf-8", errors="ignore")).hexdigest())
        if len(out) >= max_items:
            break
    return out


def classify_source_use(path, relpath=None, chat_rule=None):
    """
    Evidence-driven classification shared by intake and training.

    LEGACY_NORMAL is the compatibility state: no meaningful rights/governance
    signal was detected, so ordinary user-curated material keeps the existing
    behavior.  This state does NOT claim that copyright does not exist; it says
    only that no special source-policy signal was supplied or detected.
    """
    relpath = relpath if relpath is not None else os.path.basename(path)
    name = os.path.basename(path).lower()
    prefix = _source_prefix_text(path, 65536)
    low = (name + "\n" + prefix).lower()
    overrides = _read_policy_overrides(path)
    license_file, license_text = _nearby_license_text(path)
    combined_license_text = prefix + "\n" + license_text
    license_id = _detect_license(combined_license_text)
    binary = _source_binary_probe(path)

    raw = (
        overrides.get("TRAINING_ALLOWED")
        or overrides.get("ALLOW_TRAINING")
        or overrides.get("AI_TRAINING")
        or ""
    ).strip().lower()
    explicit_allow = raw in {"1", "yes", "true", "allow", "allowed"}
    explicit_deny = raw in {"0", "no", "false", "deny", "denied", "reference-only", "reference_only"}
    no_ai = next((p for p in _NO_AI_PATTERNS if p in low), "")
    copyright_signal = next((p for p in _COPYRIGHT_HINTS if p in low or p in license_text.lower()), "")
    protected_marker = binary.get("protected_marker", "")

    state = "LEGACY_NORMAL"
    mode = "TRAIN"
    evidence_class = "NONE"
    evidence_value = ""
    certainty = "UNKNOWN"
    reason = "no explicit source-policy signal detected; preserve ordinary user-curated behavior"
    policy_source = "DEFAULT_LEGACY_COMPATIBILITY"

    if no_ai:
        state, mode = "REFERENCE_ONLY", "REFERENCE_ONLY"
        evidence_class, evidence_value, certainty = "NO_AI_DECLARATION", no_ai, "DECLARED"
        reason = f"explicit source restriction: {no_ai}"
        policy_source = "SOURCE_TEXT"
    elif explicit_deny:
        state, mode = "REFERENCE_ONLY", "REFERENCE_ONLY"
        evidence_class, evidence_value, certainty = "LOCAL_POLICY", raw, "DECLARED"
        reason = "local interpretation policy denies training"
        policy_source = "INTERPRET_FILE"
    elif protected_marker:
        state, mode = "PROTECTED_MEDIA", "REFERENCE_ONLY"
        evidence_class, evidence_value, certainty = "MEDIA_PROTECTION_MARKER", protected_marker, "STRONGLY_DETECTED"
        reason = f"protected-media/container marker detected: {protected_marker}"
        policy_source = "BINARY_METADATA"
    elif explicit_allow:
        state, mode = "LICENSED_OR_USER_ALLOWED", "TRAIN"
        evidence_class, evidence_value, certainty = "LOCAL_POLICY", raw, "DECLARED"
        reason = "local interpretation policy explicitly allows training"
        policy_source = "INTERPRET_FILE"
    elif license_id:
        state = "LICENSED"
        evidence_class, evidence_value, certainty = "DECLARED_LICENSE", license_id, "DECLARED"
        policy_source = license_file or "SOURCE_TEXT"
        if license_id in _DEFAULT_TRAINABLE_LICENSES:
            mode = "TRAIN"
            reason = f"recognized permissive/public-domain declaration: {license_id}"
        else:
            mode = "REFERENCE_ONLY"
            reason = (
                f"recognized license {license_id}; no local training permission rule "
                "has been supplied for this license family"
            )
    elif copyright_signal:
        state, mode = "COPYRIGHT_DECLARED", "REFERENCE_ONLY"
        evidence_class, evidence_value, certainty = "COPYRIGHT_NOTICE", copyright_signal, "DECLARED"
        reason = f"explicit copyright signal without resolved training permission: {copyright_signal}"
        policy_source = license_file or "SOURCE_TEXT"

    # A direct chat-facing rule may narrow one operation without pretending to
    # rewrite the source's underlying legal/license state.
    if chat_rule and chat_rule.get("training_allowed") is False:
        mode = "REFERENCE_ONLY"
        reason = chat_rule.get("reason") or "user chat rule disabled training"
        policy_source = "USER_CHAT_RULE"

    return {
        "mode": mode,
        "source_state": state,
        "reason": reason,
        "path": relpath,
        "license_file": license_file,
        "license_id": license_id,
        "media_extension": Path(path).suffix.lower() or "<none>",
        "evidence_class": evidence_class,
        "evidence_value": evidence_value,
        "evidence_certainty": certainty,
        "policy_source": policy_source,
        "chat_use_allowed": True,
        "training_allowed": mode == "TRAIN",
        "reference_allowed": True,
        "direct_reuse_policy": "SOURCE_RULES_APPLY" if evidence_class != "NONE" else "NORMAL_USER_CONTEXT",
        "protected_marker": protected_marker,
    }


def classify_training_source(path, relpath):
    """Backward-compatible name used by the existing batch trainer."""
    return classify_source_use(path, relpath)


def _load_source_registry():
    try:
        data = json.loads(Path(SOURCE_REGISTRY_PATH).read_text(encoding="utf-8"))
        return data if isinstance(data, dict) else {"records": {}}
    except Exception:
        return {"records": {}}


def _save_source_registry(registry):
    try:
        os.makedirs(SOURCE_PROVENANCE_DIR, exist_ok=True)
        tmp = SOURCE_REGISTRY_PATH + ".tmp"
        Path(tmp).write_text(json.dumps(registry, indent=2, sort_keys=True), encoding="utf-8")
        os.replace(tmp, SOURCE_REGISTRY_PATH)
