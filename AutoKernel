COMMENTS={paths['comments']}
LAYOUT={layout}
LANGUAGE_QWEN_PROMPT={_oc_prog_language_prompt(project)}
HARD CONTRACT:
- This request concerns only PROJECT={project} and LANGUAGE={lang}.
- Never silently substitute Python or any other language for {lang}.
- Return editable files only with <progfile stage="source|configure|build|program|comments" path="relative_filename">CONTENT</progfile>.
- Never use absolute paths or .. and never write outside this project's five folders.
- Respect programmer.prefs stage/file-type placement.
- Build artifacts should be produced by the build pipeline, not fabricated as text.
PROJECT COMMENTS:
{''.join(comments)[:8000]}
</AItechProgrammerProject>
<DeveloperRequest>{request}<${DEV_KERNEL}eloperRequest>"""

    def _oc_prog_allowed(stage,name,layout):
        allowed=layout.get(stage,[]) or []
        if not allowed: return stage=="comments"
        for item in allowed:
            item=str(item)
            if item.startswith(".") and name.lower().endswith(item.lower()): return True
            if name==item: return True
            if item.lower() in ("binary","executable") and "." not in name: return True
        return stage=="configure" and name.endswith((".sh",".txt",".md",".json",".toml",".mk",".cmake",".mf",".env"))

    def _oc_prog_candidate_path(project):
        return _oc_prog_paths(project)["comments"]/"pending_generation.json"

    def _oc_prog_save_candidate(project,response,request="",status="pending",source="generation"):
        project=_oc_prog_safe(project)
        data={
            "project":project,
            "language":_oc_prog_meta(project).get("language",""),
            "response":str(response or ""),
            "request":str(request or ""),
            "status":status,
            "source":source,
            "updated_at":time.strftime("%Y-%m-%dT%H:%M:%S"),
        }
        path=_oc_prog_candidate_path(project); path.parent.mkdir(parents=True,exist_ok=True)
        try: path.write_text(json.dumps(data,indent=2)+"\n",encoding="utf-8")
        except OSError: pass
        return data

    def _oc_prog_load_candidate(project):
        try:
            path=_oc_prog_candidate_path(project)
            if path.is_file():
                data=json.loads(path.read_text(encoding="utf-8",errors="ignore"))
                if isinstance(data,dict): return data
        except Exception: pass
        return {}

    def _oc_prog_primary_target(project):
        project=_oc_prog_safe(project); meta=_oc_prog_meta(project); lang=str(meta.get("language","")).lower(); art=meta.get("artifacts") or {}
        if lang=="asm": return "source",str(art.get("source") or ("main.s" if meta.get("host_os")=="darwin" and meta.get("host_arch") in ("arm64","aarch64") else "main.asm"))
        if lang=="c": return "source",str(art.get("source") or "main.c")
        if lang=="java": return "build",str(art.get("build") or "Main.java")
        if lang=="bash": return "program",str(art.get("program") or (project+".sh"))
        if lang=="python": return "program",str(art.get("program") or (project+".py"))
        layout=_oc_prog_prefs().get(lang,{})
        for stage in ("source","build","program"):
            for item in layout.get(stage,[]) or []:
                if str(item).startswith("."): return stage,"main"+str(item)
        return "source","main.txt"

    def _oc_prog_candidate_code(text):
        raw=str(text or "").strip()
        fenced=re.findall(r"```(?:[A-Za-z0-9_+.-]+)?\s*\n(.*?)```",raw,re.S)
        if fenced: return max(fenced,key=len).strip()
        return raw

    def _oc_prog_existing_files(project):
        project=_oc_prog_safe(project); lang=str(_oc_prog_meta(project).get("language","")).lower(); layout=_oc_prog_prefs().get(lang,{})
        found=[]; ignored={"aitech_project.json","token_ledger.json","project_session.json","pending_generation.json","README.txt"}
        for stage,path in _oc_prog_paths(project).items():
            if not path.is_dir(): continue
            for fp in sorted(path.rglob("*")):
                if fp.is_file() and fp.name not in ignored and _oc_prog_allowed(stage,fp.name,layout):
                    try: rel=str(fp.relative_to(path))
                    except Exception: rel=fp.name
                    found.append((stage,rel))
        return found

    def _oc_prog_candidate_target(project,candidate):
        response=str(candidate.get("response","") or "")
        records=re.findall(r'<progfile\s+stage="([^"]+)"\s+path="([^"]+)">(.*?)</progfile>',response,re.S|re.I)
        if records:
            stage,rel,_=records[0]
            return stage.strip().lower(),rel.strip().replace("\\","/"),False
        if str(candidate.get("source","")).lower()=="rewrite":
            stage,rel=_oc_prog_primary_target(project)
            return stage,rel,False
        request=str(candidate.get("request","") or "").lower()
        matches=[]
        for stage,rel in _oc_prog_existing_files(project):
            if Path(rel).name.lower() in request or rel.lower() in request:
                matches.append((stage,rel))
        if len(matches)==1:
            return matches[0][0],matches[0][1],False
        if any(word in request for word in ("modify","update","fix","debug","repair","change","edit","refactor","rewrite")):
            stage,rel=_oc_prog_primary_target(project)
            if (_oc_prog_paths(project)[stage]/rel).is_file():
                return stage,rel,False
        return None,None,True

    def _oc_prog_stage_for_filename(project,filename):
        filename=Path(str(filename or "").strip()).name
        if not filename: return None,"Filename is empty."
        if filename in (".","..") or "/" in filename or "\\" in filename:
            return None,"Use a filename only, not a path."
        lang=str(_oc_prog_meta(project).get("language","")).lower(); layout=_oc_prog_prefs().get(lang,{})
        matches=[stage for stage in ("source","configure","build","program","comments") if _oc_prog_allowed(stage,filename,layout)]
        preferred=[s for s in ("source","build","program") if s in matches]
        if len(preferred)==1: return preferred[0],None
        if len(matches)==1: return matches[0],None
        if not matches: return None,f"Filename {filename} does not match [{lang}] programmer.prefs."
        return None,f"Filename {filename} is ambiguous across stages: {', '.join(matches)}."

    def _oc_prog_inject_wrapper(stage,rel,response):
        body=_oc_prog_candidate_code(response)
        if not body: return ""
        return f'<progfile stage="{stage}" path="{rel}">\n{body.rstrip()}\n</progfile>'

    def _oc_prog_write_candidate(project,filename=None):
        project=_oc_prog_safe(project)
        if not _oc_prog_open(project): return False,f"Project {project} is not running. Use prog resume {project}."
        candidate=_oc_prog_load_candidate(project)
        response=str(candidate.get("response","") or "")
        if not response: return False,"No pending generation candidate exists."

        stage,rel,needs_filename=_oc_prog_candidate_target(project,candidate)
        if needs_filename:
            if not filename:
                return False,{
                    "need_filename":True,
                    "message":"Pending candidate is an unnamed new file. Enter the filename to commit it.",
                    "language":_oc_prog_meta(project).get("language",""),
                    "layout":_oc_prog_prefs().get(str(_oc_prog_meta(project).get("language","")).lower(),{}),
                }
            rel=Path(str(filename).strip()).name
            stage,error=_oc_prog_stage_for_filename(project,rel)
            if error: return False,error

        lang=str(_oc_prog_meta(project).get("language","")).lower(); layout=_oc_prog_prefs().get(lang,{})
        if stage not in ("source","configure","build","program","comments"):
            return False,f"Unknown project stage: {stage}"
        if rel.startswith("/") or ".." in Path(rel).parts:
            return False,f"Unsafe project filename/path: {rel}"
        if not _oc_prog_allowed(stage,Path(rel).name,layout):
            return False,f"{stage}/{rel} conflicts with programmer.prefs."

        records=re.findall(r'<progfile\s+stage="([^"]+)"\s+path="([^"]+)">(.*?)</progfile>',response,re.S|re.I)
        if records:
            wrapped=response
        else:
            wrapped=_oc_prog_inject_wrapper(stage,rel,response)
            if not wrapped: return False,"Pending candidate contains no writable code."
            candidate["response"]=wrapped
            candidate["wrapper_injected"]=True
            candidate["wrapper_injected_at"]=time.strftime("%Y-%m-%dT%H:%M:%S")
            candidate["resolved_stage"]=stage
            candidate["resolved_filename"]=rel
            try: _oc_prog_candidate_path(project).write_text(json.dumps(candidate,indent=2)+"\n",encoding="utf-8")
            except OSError: pass

        _oc_prog_gui(project,25,f"VALIDATING WRITE {stage}/{rel}")
        ok,details=_oc_prog_apply_generation(project,wrapped)
        if not ok: return False,"; ".join(str(x) for x in details)

        candidate=_oc_prog_load_candidate(project) or candidate
        candidate["status"]="written"
        candidate["written_to"]=f"{stage}/{project}/{rel}"
        candidate["written_at"]=time.strftime("%Y-%m-%dT%H:%M:%S")
        try: _oc_prog_candidate_path(project).write_text(json.dumps(candidate,indent=2)+"\n",encoding="utf-8")
        except OSError: pass
        _oc_prog_session_update(project,last_operation="candidate write",last_error="",progress=100,progress_label="WRITE COMPLETE")
        _oc_prog_gui(project,100,"WRITE COMPLETE",output=f"Wrote candidate -> {candidate['written_to']}")
        return True,candidate["written_to"]

    def _oc_prog_file_context(project,max_chars=18000):
        chunks=[]; used=0; ignored={"aitech_project.json","token_ledger.json","project_session.json","pending_generation.json"}
        for stage,path in _oc_prog_paths(project).items():
            if not path.is_dir(): continue
            for fp in sorted(path.rglob("*")):
                if not fp.is_file() or fp.name in ignored: continue
                try: body=fp.read_text(encoding="utf-8",errors="ignore")
                except Exception: continue
                try: rel=str(fp.relative_to(CODE_ROOT))
                except Exception: rel=str(fp)
                block=f"\n--- EXISTING {rel} ---\n{body}\n"
                if used+len(block)>max_chars:
                    return "".join(chunks)+(block[:max(0,max_chars-used)] if max_chars-used>200 else "")
                chunks.append(block); used+=len(block)
        return "".join(chunks)

    def _oc_prog_rewrite_candidate(project,instructions):
        project=_oc_prog_safe(project)
        if not _oc_prog_open(project): return False,f"Project {project} is not running. Use prog resume {project}."
        cand=_oc_prog_load_candidate(project); previous=str(cand.get("response","") or "")
