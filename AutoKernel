def _seed_topic_once(filename, text):
    """Create a starting topic notebook without overwriting later learning."""
    os.makedirs(TOPICS_DIR_PATH, exist_ok=True)
    path = os.path.join(TOPICS_DIR_PATH, filename)
    if os.path.exists(path):
        return path
    with open(path, "w", encoding="utf-8") as f:
        f.write(text.rstrip() + "\n")
    return path


