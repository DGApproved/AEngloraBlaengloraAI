# ── COMPUTATION-BASED AGING (read side) ───────────────────────────────────────
# The knowledge engine shares one clock with the base engine and the
# orchestrator. It advances the counter for its own prompts and can read the age
# of any tracked file, entry or token, but the ledger itself is written by
# whichever process owns the memory write.
COMPUTATION_COUNTER_PATH = os.path.join(SYSTEM_DIR, "computations.txt")
AGE_META_SECTION = "@computations"
AGE_BORN_SECTION = "@born"
AGE_DATE_SECTION = "@borndate"
AGE_SEEN_SECTION = "@seen"
AGE_USES_SECTION = "@uses"


def computation_now():
    try:
        with open(COMPUTATION_COUNTER_PATH, "r", encoding="utf-8", errors="ignore") as f:
            for line in f:
                line = line.strip()
                if line and not line.startswith("#"):
                    return int(float(line.split()[0]))
    except Exception:
        pass
    return 0


def computation_tick():
    n = computation_now() + 1
    try:
        os.makedirs(os.path.dirname(COMPUTATION_COUNTER_PATH), exist_ok=True)
        tmp = f"{COMPUTATION_COUNTER_PATH}.{os.getpid()}.tmp"
        with open(tmp, "w", encoding="utf-8") as f:
            f.write(f"{n}\n")
            f.write("# AItech computation counter.\n")
            f.write("# One computation = one user prompt processed through the terminal front end.\n")
        os.replace(tmp, COMPUTATION_COUNTER_PATH)
    except Exception:
        return n
    return n


def _age_key(filename, key=None):
    return filename if key is None else f"{filename}::{key}"


def _load_age_sections():
    """Read only the @-prefixed aging sections out of weights.txt."""
    out = {}
    current = None
    try:
        with open(MEMORY_WEIGHTS_PATH, "r", encoding="utf-8", errors="ignore") as f:
            for raw in f:
                line = raw.strip()
                if not line or line.startswith("#"):
                    continue
                if line.startswith("[") and line.endswith("]"):
                    current = line[1:-1]
                    if current.startswith("@"):
                        out.setdefault(current, {})
                    continue
                if current and current.startswith("@") and "\t" in line:
                    k, v = line.split("\t", 1)
                    try:
                        out[current][k] = float(v)
                    except ValueError:
                        pass
    except Exception:
        return {}
    return out


def age_in_computations(filename, key=None):
    born = _load_age_sections().get(AGE_BORN_SECTION, {}).get(_age_key(filename, key))
    return None if born is None else max(0, computation_now() - int(born))


def computations_since_access(filename, key=None):
    seen = _load_age_sections().get(AGE_SEEN_SECTION, {}).get(_age_key(filename, key))
    return None if seen is None else max(0, computation_now() - int(seen))
