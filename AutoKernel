                        )
                        if res.usage:
                            bg_tokens_total += res.usage.total_tokens
                        update_gui_chat("SYS", f"Wake:Qwen result ingested.")
                except Exception:
                    pass

            # ── NOTEBOOK ARCHIVIST TICK (original orchestrator function) ──────
            # Processes raw notebook files into the Reference Manual whenever
            # 45 seconds of user inactivity have elapsed or a manual trigger fires.
            time_elapsed = time.time() - last_user_activity
