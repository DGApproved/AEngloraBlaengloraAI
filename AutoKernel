# -------------------------------------------------------------------------------------------
# 8) Drag and Drop New Training Data Assistant (5)
# -------------------------------------------------------------------------------------------
fn_legacy_drag_and_drop_assistant() {
     echo -e "${BLUE}=== Drag & Drop File Routing Assistant ===${NC}"
     echo "Drag/drop a file or folder, paste an update URL/IP:port, or press ENTER blank to scan session.noq/update (Type 'back' to exit):"

     read -r raw_path
     # Strip quotes added by drag-and-drop
     clean_path="$(echo "$raw_path" | sed -e 's/^"//' -e 's/"$//' -e "s/^'//" -e "s/'$//")"
     updater_path="$UPDATE_DIR/updater.sh"

     if [ "$clean_path" == "back" ]; then
         echo "[!] Operation cancelled."
         return
     fi

     # Blank input means: use the maintenance inbox.
     if [ -z "$clean_path" ]; then
         if [ ! -f "$updater_path" ]; then
             echo -e "${RED}[!] updater.sh is not generated yet. Run environment setup first.${NC}"
             return
         fi
         echo -e "${CYAN}[+] Blank update source: scanning $UPDATE_DIR${NC}"
         "$updater_path" --interactive
         return
     fi

     # Is it a remote URL or raw network endpoint?
     remote_source=0
     case "$clean_path" in
         http://*|https://*|tcp://*) remote_source=1 ;;
         *)
             if [[ "$clean_path" =~ ^([A-Za-z0-9._-]+|\[[0-9A-Fa-f:]+\]):[0-9]{1,5}(/.*)?$ ]]; then
                 remote_source=1
             fi
             ;;
     esac

     # Determine if the input (remote or local) is a training/media artifact or a system update
     filename="$(basename "${clean_path%%\?*}")"
     ext="${filename##*.}"
     ext_lc=$(echo "$ext" | tr '[:upper:]' '[:lower:]')
     
     is_update=0
     case "$filename" in
         update.sh|AItech*.sh|updater.sh|*.catfile.txt) is_update=1 ;;
     esac
     
     # If a remote source has no explicit extension, assume it's a raw TCP system update payload
     if [ "$remote_source" -eq 1 ] && [ "$filename" == "$ext" ] && [ "$is_update" -eq 0 ]; then
         is_update=1
     fi

     if [ "$remote_source" -eq 1 ]; then
         if [ "$is_update" -eq 1 ]; then
             if [ ! -f "$updater_path" ]; then
                 echo -e "${RED}[!] updater.sh is not generated yet. Run environment setup first.${NC}"
                 return
             fi
             echo -e "${CYAN}[+] Remote update source detected: $clean_path${NC}"
             "$updater_path" --interactive "$clean_path"
             return
         else
             # It's a remote media/training file! Route to the external Book Drop.
             case "$ext_lc" in
                 mp3|flac|wav|aac|ogg) DEST="$EXT_DGAPI_DIR/audio" ;;
                 mp4|mov|avi|mkv|png|jpg|jpeg|bmp|gif) DEST="$EXT_DGAPI_DIR/images" ;;
                 sh|py|cpp|txt|md|json|csv|pdf|*) DEST="$EXT_DGAPI_DIR/books" ;;
             esac
             
             echo -e "${CYAN}[+] Remote training artifact detected. Downloading into Book Drop: $DEST${NC}"
             mkdir -p "$DEST"
             tmp_dl="${DEST}/dl_$$.${ext_lc}"
             
             if command -v curl >/dev/null 2>&1; then
                 curl -L --fail --progress-bar "$clean_path" -o "$tmp_dl" || { echo -e "${RED}[!] Download failed.${NC}"; rm -f "$tmp_dl"; return; }
             elif command -v wget >/dev/null 2>&1; then
                 wget --show-progress -O "$tmp_dl" "$clean_path" || { echo -e "${RED}[!] Download failed.${NC}"; rm -f "$tmp_dl"; return; }
             else
                 echo -e "${RED}[!] curl or wget is required to download remote training files.${NC}"
                 return
             fi
             
             final_dest="$DEST/$filename"
             # Avoid overwriting existing files with the same name
             if [ -e "$final_dest" ]; then
                 final_dest="$DEST/$(date '+%Y%m%d_%H%M%S')_$filename"
             fi
             mv "$tmp_dl" "$final_dest"
             echo -e "${GREEN}[✓] Successfully routed $filename to $final_dest${NC}"
             return
         fi
     fi

     if [ ! -e "$clean_path" ]; then
         echo "[!] Invalid path. Supply a local path, http(s) URL, or HOST:PORT/IP:PORT update source."
         return
     fi

     # Local files: Update check
     if [ "$is_update" -eq 1 ] || { [ -x "$updater_path" ] && "$updater_path" --scan >/dev/null 2>&1 && python3 -c "import os,re,sys; s=open(sys.argv[1],encoding='utf-8',errors='replace').read(); name=sys.argv[2]; sys.exit(0 if re.search(r'^[ \t]*write_if_changed[ \t]+([\"\'])(.*?'+re.escape(name)+r')\1', s, re.M) else 1)" "$AITECH_LAUNCH_SCRIPT" "$filename"; }; then
         if [ ! -f "$updater_path" ]; then
             echo -e "${RED}[!] updater.sh is not generated yet. Run environment setup first.${NC}"
             return
         fi
         echo -e "${CYAN}[+] Update-capable artifact detected: $filename${NC}"
         "$updater_path" --interactive "$clean_path"
         return
     fi

     # Local files: Training routing (Route to External Book Drop!)
     case "$ext_lc" in
         mp3|flac|wav|aac|ogg) DEST="$EXT_DGAPI_DIR/audio" ;;
         mp4|mov|avi|mkv|png|jpg|jpeg|bmp|gif) DEST="$EXT_DGAPI_DIR/images" ;;
         sh|py|cpp|txt|md|json|csv|pdf|*) DEST="$EXT_DGAPI_DIR/books" ;;
     esac

     mkdir -p "$DEST"
     cp -r "$clean_path" "$DEST"
     echo -e "${GREEN}[✓] Routed $(basename "$clean_path") to $DEST${NC}"
}

