# ── MANAGED-FILE MANIFEST ─────────────────────────────────────────────────────
# Records the SHA-256 of every file AItech generates, at the moment AItech writes
# it. The updater compares a file's current hash against this record to tell an
# AItech-authored file from one the user has since hand-edited, so an envmod can
# skip a target the user has made their own. Rows are: sha256<TAB>absolute-path.
# Defined here, immediately after NOQ_DIR, because the earliest generated file
# (programmer.prefs) is written long before the general helper section.
AITECH_MANIFEST="$NOQ_DIR/dgapi/system/managed_manifest.txt"

# Self-contained on purpose: this runs before py() is defined.
aitech_file_sha256() {
    [[ -f "$1" ]] || return 1
    local _py=""
    command -v python3 >/dev/null 2>&1 && _py=python3 || { command -v python >/dev/null 2>&1 && _py=python; }
    if [[ -n "$_py" ]]; then
        "$_py" - "$1" <<'PY_AITECH_SHA' 2>/dev/null
import hashlib,sys
h=hashlib.sha256()
with open(sys.argv[1],'rb') as fh:
    for chunk in iter(lambda: fh.read(65536), b""):
        h.update(chunk)
print(h.hexdigest())
PY_AITECH_SHA
    elif command -v sha256sum >/dev/null 2>&1; then
        sha256sum "$1" 2>/dev/null | awk '{print $1}'
    elif command -v shasum >/dev/null 2>&1; then
        shasum -a 256 "$1" 2>/dev/null | awk '{print $1}'
    else
        return 1
    fi
}

record_managed() {
    local target="$1" sum abs
    sum="$(aitech_file_sha256 "$target")" || return 0
    [[ -n "$sum" ]] || return 0
    abs="$(cd "$(dirname "$target")" 2>/dev/null && pwd)/$(basename "$target")" || return 0
    mkdir -p "$(dirname "$AITECH_MANIFEST")" 2>/dev/null || return 0
    if [[ -f "$AITECH_MANIFEST" ]]; then
        grep -v -F "    $abs" "$AITECH_MANIFEST" > "$AITECH_MANIFEST.tmp" 2>/dev/null || : > "$AITECH_MANIFEST.tmp"
        mv "$AITECH_MANIFEST.tmp" "$AITECH_MANIFEST"
    fi
    printf '%s\t%s\n' "$sum" "$abs" >> "$AITECH_MANIFEST"
}

