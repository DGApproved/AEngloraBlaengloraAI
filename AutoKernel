fn_setup_env() {
     write_art "INITIALIZING AITECH..." "Generating runtime structure and Python source files"
     write_text "setup" "SETUP IN PROGRESS" "Initializing AItech runtime..." "Target: $SET_DIR" "OS: $TARGET_OS"
     write_progress 5 "INITIALIZING"
     write_chat "SYS" "AItech environment setup started ($TARGET_OS)"
     echo -e "${CYAN}[+] Initializing AItech2 workspace and building taxonomy for $TARGET_OS...${NC}"
     
     AIDEV_DIR="$SET_DIR/AIDev"             # AIDev belongs inside AItech. It contains orchestrator-owned development
     AIDEV_MODELS_DIR="$AIDEV_DIR/models"   # resources that are not part of session.noq's local model body.
     AIDEV_INSTALL_DIR="$AIDEV_DIR/Install"
     mkdir -p "$NOQ_DIR" "$DATA_DIR"/{num,hex,hexabet,alphabet,memory,text,plugins/tools,plugins/Instruments,plugins/self-tools} "$MODELS_DIR" "$ARCHIVE_DIR" "$SRC_DIR" "$AIDEV_MODELS_DIR" "$AIDEV_INSTALL_DIR" "$NOQ_DIR/dgapi/system" "$NOQ_DIR/dgapi/datas" "$NOQ_DIR/dgapi/virtual" "$NOQ_DIR/dgapi/overflow"

     # EXTERNAL DGAPI — the book drop. This is the one sanctioned boundary port:
     # a user-facing file surface deliberately placed BESIDE session.noq rather
     # than inside it. Writes here are pre-authorized by design and do not go
     # through the outside-write confirmation. Every other path outside
     # session.noq still requires explicit user confirmation. See the generated
     # world_boundary.txt and dgapi_duality.txt maps.
     # EXTERNAL: four input folders for the four main media types, a processed
     # folder for input that has been dealt with, and an output folder for
     # anything generated for the user.
     EXT_DGAPI_DIR="$SET_DIR/dgapi"
     export AITECH_EXT_DGAPI_DIR="$EXT_DGAPI_DIR"
     mkdir -p "$EXT_DGAPI_DIR"/{books,images,audio,video,processed,output}

     # INTERNAL: the same four media types mirrored inward, plus the model's own
     # processing and intake folders. TXT files move between these three areas
     # during reflection, transduction, modulation, refinement and revision of a
     # user-presented file interpreted from the external side.
     mkdir -p "$NOQ_DIR/dgapi"/{books,images,audio,video,processed,intake/generated}

     # ----------------------------------------------------------------------
     # SELF-UPDATE / DOWNGRADE ASSISTANT
     # ----------------------------------------------------------------------
     # session.noq/update is AItech's maintenance inbox. updater.sh lives inside it,
     # while pending component files, update.sh directives, and complete revisions may
     # be placed beside it for automatic discovery after a blank update-source entry.
     # It accepts local/drop, HTTP(S), and raw HOST:PORT/IP:PORT update sources,
     # then modifies only the launched AItech script after an apt-style preview,
     # confirmation, syntax validation, and exupdate archival snapshot.
     write_if_changed "$UPDATE_DIR/updater.sh" << 'EOF_AITECH_UPDATER'
#!/usr/bin/env bash
# AItech updater / downgrade assistant
# Generated by AItech.sh. Designed for the canonical single-file distribution.
#
# Accepted update sources:
#   * pending files discovered in session.noq/update/
#   * local/dropped file passed explicitly
#   * http:// or https:// URL
#   * raw TCP endpoint: IP:PORT, HOST:PORT, tcp://HOST:PORT
#     Optional path/name: HOST:PORT/update.txt or HOST:PORT/component.py
#
# Remote payload naming:
#   A URL Content-Disposition filename, URL basename, endpoint /filename, or
#   '# AITECH_UPDATE_FILENAME=name' metadata is used when available. A complete
#   AItech script and directive payloads can be recognized by content without a
#   filename: a payload carrying @@ AITECH_TARGET and @@ AITECH_MIGRATION is read
#   as envmod.txt, one carrying @@ AITECH_TARGET alone as datamod.txt, and any
#   other @@ AITECH_ payload as update.txt. A bare component payload MUST provide
#   a filename so AItech does not guess which generated cat entry to replace.
#
# ── WHAT CAN BE UPDATED, AND BY WHAT ──────────────────────────────────────────
# Two mechanisms reach the launched AItech source.
#
# 1. COMPONENT REPLACEMENT (whole body)
#    Drop a file named after a generated target, e.g. prepare_graph_data.py.
#    Its entire write_if_changed heredoc body is replaced. Matching is by
#    basename and must resolve to exactly one top-level entry; nested cat files
#    inside a generated body are deliberately excluded. Files written with a
#    bare `cat >` rather than write_if_changed have no component form and must
#    be edited with envmod.txt below.
#
# 2. DIRECTIVE EDITING (individual lines)
#    All three directive files share one grammar — @@ AITECH_REPLACE_BEGIN /
#    @@ AITECH_WITH / @@ AITECH_REPLACE_END, plus INSERT_AFTER, INSERT_BEFORE and
#    DELETE. Every anchor must match EXACTLY ONCE or the transaction aborts with
#    the line numbers of the competing matches.
#
#    EXACT-ANCHOR ABORT MEANING:
#    "replace target must occur exactly once; found 0" means the literal OLD
#    text carried by the patch does not exist in the launched source. Usually the
#    patch was authored for a different revision/source shape, the target was
#    already changed by another update, or provenance/version text differs from
#    the assumed contributor branch. "No changes were committed" means the
#    transaction stopped safely before the staged copy replaced AItech.sh.
#
#    SOLUTION:
#    Do not force or loosen the transaction. Compare the launched source with the
#    patch, retarget implementation anchors to text that actually exists exactly
#    once, and use [AITECH_UPDATE] VERSION/DEVNAME metadata for revision identity
#    instead of exact replacements of old version/header strings. This revision
#    follows that rule: its own identity promotion is handled by the provenance
#    pass described in item 4 rather than by a brittle version-specific replace
#    target, which is why a patch for it applies to any revision that still has
#    the anchors it names.
#
#    They differ in reach:
#
#      update.txt   UNSCOPED. Anchors match anywhere in the launched source: the
#      (update.sh)  version header, the changelog, any generated body. This is
#                   the escape hatch and the only way to edit lines that are not
#                   inside a generated body. Full reach when the right tags are
#                   used. No @@ AITECH_TARGET; nothing is off limits.
#
#      datamod.txt  SCOPED to COMPONENT bodies (write_if_changed sites) — the
#                   engines, the map generator, orchestrator_core, GUI.sh, the
#                   plugins. Requires "@@ AITECH_TARGET <basename>" to open each
#                   section, and every anchor in that section must resolve inside
#                   that body. Naming an environment file is refused, so a
#                   datamod can never reach prompts.txt or programmer.prefs.
#
#      envmod.txt   SCOPED to ENVIRONMENT bodies (bare `cat >` sites) —
#                   prompts.txt, programmer.prefs, .installer_v32.template.
#                   Requires @@ AITECH_TARGET. Naming a component is refused.
#                   Two further rules apply, both of which exist because these
#                   files belong to the user in a way component bodies do not:
#
#                   SEED-ONCE PAIRING. prompts.txt and programmer.prefs are
#                   written under an `if [ ! -f ]` guard, so editing the seed
#                   body changes what a FRESH install receives and nothing else;
#                   an existing install already has the file and the guard skips
#                   it. An envmod naming such a target MUST supply a paired
#                   @@ AITECH_MIGRATION_BEGIN / @@ AITECH_MIGRATION_END block,
#                   which is inserted above the AITECH_ENVMOD_MIGRATIONS marker
#                   in AItech.sh and runs in the same non-destructive
#                   grep-guarded style as the v23-v31 migrations. Without it the
#                   envmod is refused rather than silently reaching nobody.
#                   .installer_v32.template is rewritten every run, so it needs
#                   no migration.
#
#                   USER-MODIFICATION SKIP. AItech records the SHA-256 of every
#                   file it writes in dgapi/system/managed_manifest.txt. Before
#                   touching a target, the envmod compares the installed file
#                   against that record. If it differs, the user has hand-edited
#                   it since initialization or the last update, and that target
#                   is SKIPPED and reported — their edits are never overwritten.
#                   Remaining targets in the same envmod still apply.
#
#    Ordering in the inbox: datamod.txt, then envmod.txt, then update.txt.
#    Narrowest reach first, so a scoped edit cannot be pre-empted by an unscoped
#    one inside the same transaction.
#
#
# ── COMPLETE FEATURE INDEX ────────────────────────────────────────────────────
# Everything updater.sh can do. The two mechanisms above are how the launched
# source is edited; this is the whole surface around them, so that a capability
# that exists is a capability that is written down.
#
# 3. CHANGELOG REVIEW (changelog.txt)
#    A changelog.txt in the inbox is not a patch. It is shown in full and
#    confirmed before any transaction that would change the script proceeds, so
#    a contributor can say what an update does in prose and the person applying
#    it reads that before agreeing. Declining stops the transaction with nothing
#    committed. It is consumed alongside the files it described.
#
# 4. PROVENANCE METADATA ([AITECH_UPDATE] and [CHANGELOG])
#    Any update.txt / update.sh / datamod.txt / envmod.txt may carry two
#    trailing metadata blocks, and both are applied to the STAGED copy after its
#    directives, never before.
#
#      [AITECH_UPDATE]   VERSION = v0.1.60
#                        DEVNAME = Name
#                        DATE    = 2026-09-04
#
#    VERSION rewrites "# Current revision:", AITECH_VERSION and, when the final
#    field is numeric, AITECH_REVISION. DEVNAME rewrites "# Development origin:"
#    and AITECH_DEVNAME. Together they rewrite "# Canonical revision filename:"
#    and AITECH_REVISION_FILENAME to AItech(v.MAJOR.MINOR.REVISION)-devname.sh.
#    Every one of those is matched BY PATTERN, not by the old literal value, so
#    a patch carrying metadata does not need to know which revision it is being
#    applied to. This is the supported way to promote revision identity, and the
#    reason a patch should never carry an exact replace target for a version
#    string.
#
#      [CHANGELOG]
#      - One line per change.
#      [/CHANGELOG]
#
#    Entries are rendered in the house style -- "# vX.Y.Z-Devname  first line"
#    followed by "#          " continuations, semantically wrapped at a
#    preferred 32 characters rather than a hard maximum, so a sentence is not
#    split mid-clause -- and inserted directly beneath the
#    "# CHANGELOG / CURRENT FEATURE INDEX" marker, which keeps the index
#    strictly newest-first. DATE, when given, becomes a trailing continuation.
#    If the marker is absent -- an older revision, a fork, a bare component --
#    the block is inserted after the leading header comment block instead and a
#    note is printed. The marker is preferred; its absence is never fatal.
#
# 5. COMPLETE VERSION INSTALL
#    A whole AItech*.sh in the inbox is an upgrade or downgrade candidate rather
#    than a patch. It is listed with its detected version, previewed, confirmed,
#    validated and installed atomically like any other transaction, after the
#    running script has been archived.
#
# 6. DOWNGRADE
#    Two sources are offered together: complete AItech*.sh versions in the inbox
#    whose detected version is older than the running one, and exupdate archive
#    snapshots taken automatically before every previous install. Each option
#    shows its version label and whether it is a complete version or an archive;
#    an archive whose version cannot be detected is still offered rather than
#    hidden. --downgrade with an explicit archive path skips the menu and
#    installs that file directly. A pre-downgrade snapshot of the current script
#    is taken first, so a downgrade is itself reversible.
#
# 7. SAFETY RAILS ON EVERY PATH
#    * Archive first. The running script is copied to
#      session.noq/archive/AItech_<stamp>_exupdate.txt before it is replaced.
#    * Stage, never edit in place. All work happens on a temporary copy; the
#      launched script is untouched until the copy has passed every check.
#    * Validate. The candidate must pass bash -n and must still carry the
#      canonical #!/usr/bin/env bash shebang.
#    * Install atomically, preserving the original file mode.
#    * Abort loudly and safely. Any failure prints [ABORT] Transaction cancelled
#      with the source file and line range, the target file and line, and the
#      reason. "No changes were committed" means the staged copy was discarded
#      and the launched script was never touched.
#    * Consume. Files that were applied are moved into the training history
#      rather than left in the inbox to be applied twice.
#    * Directive files are DECLARATIVE DATA. Nothing in an update.txt,
#      datamod.txt, envmod.txt or changelog.txt is ever executed.
#
# 8. INSPECTION
#    --scan / --list prints the plan without changing anything: the resolved
#    AItech script and its version, pending components, datamods, envmods,
#    update scripts, complete versions, archive snapshots, and anything in the
#    inbox it does not recognize. After a successful transaction a unified diff
#    of what actually changed is printed against the pre-apply archive, so the
#    result is auditable rather than merely reported.
#
# 9. COMMAND LINE
#    updater.sh                          interactive menu
#    updater.sh --scan | --list          print the plan, change nothing
#    updater.sh --interactive [SOURCE]   menu, optionally seeded with a source
#    updater.sh --apply [SOURCE]         apply the inbox, or one named source
#    updater.sh --source URL|IP:PORT     fetch from a remote source, then menu
#    updater.sh --downgrade [ARCHIVE]    downgrade menu, or install an archive
#    updater.sh --help | -h              usage
#    SOURCE is a local path, an http(s) URL, or a raw TCP endpoint.
#
# 10. WHERE THINGS LIVE
#    session.noq/update/            the inbox, and updater.sh itself
#    session.noq/update/.aitech_source.path
#                                   pointer to the launched script, used when
#                                   AITECH_LAUNCH_SCRIPT is not set and more
#                                   than one AItech*.sh sits beside the updater
#    session.noq/archive/           exupdate snapshots
#    session.noq/dgapi/system/managed_manifest.txt
#                                   SHA-256 of every file AItech writes, which
#                                   is what makes the user-modification skip
#                                   possible
#    session.noq/training/          consumed update files, kept as history
#
# Every path above is previewed apt-style, confirmed, validated with bash -n,
# archived to session.noq/archive/exupdate, and installed atomically. Directive
# files are DECLARATIVE DATA and are never executed.
set -u

SELF_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
DEFAULT_AITECH="${AITECH_LAUNCH_SCRIPT:-}"
SOURCE_POINTER="$SELF_DIR/.aitech_source.path"
if [[ ( -z "$DEFAULT_AITECH" || ! -f "$DEFAULT_AITECH" ) && -f "$SOURCE_POINTER" ]]; then
    pointer_candidate="$(head -n 1 "$SOURCE_POINTER" 2>/dev/null || true)"
    [[ -f "$pointer_candidate" ]] && DEFAULT_AITECH="$pointer_candidate"
fi
if [[ -z "$DEFAULT_AITECH" || ! -f "$DEFAULT_AITECH" ]]; then
    DEFAULT_AITECH="$(find "$PWD" -maxdepth 1 -type f -name 'AItech*.sh' ! -name 'updater.sh' -print 2>/dev/null | sort | tail -n 1)"
fi
AITECH_SCRIPT="${AITECH_SCRIPT:-$DEFAULT_AITECH}"
if [[ -z "$AITECH_SCRIPT" || ! -f "$AITECH_SCRIPT" ]]; then
    echo "[ABORT] Transaction cancelled" >&2
    echo "File: updater.sh" >&2
    echo "Lines: startup" >&2
    echo "Reason: No AItech.sh-compatible script was found beside updater.sh." >&2
    echo "Action: No changes were committed." >&2
    exit 1
fi
AITECH_SCRIPT="$(cd "$(dirname "$AITECH_SCRIPT")" && pwd)/$(basename "$AITECH_SCRIPT")"
AITECH_DIR="$(dirname "$AITECH_SCRIPT")"

resolve_noq_dir() {
    if [[ -n "${AITECH_NOQ_DIR:-}" && -d "${AITECH_NOQ_DIR}" ]]; then printf '%s\n' "$AITECH_NOQ_DIR"; return; fi
    if [[ "$(basename "$SELF_DIR")" == "update" && "$(basename "$(dirname "$SELF_DIR")")" == "session.noq" ]]; then
        dirname "$SELF_DIR"; return
    fi
    local parent candidate
    parent="$(dirname "$AITECH_DIR")"
    candidate="$parent/AItech/session.noq"
    if [[ -d "$candidate" || -d "$parent/AItech" ]]; then printf '%s\n' "$candidate"; return; fi
    printf '%s\n' "$AITECH_DIR/session.noq"
}
NOQ_DIR="$(resolve_noq_dir)"
UPDATE_DIR="${AITECH_UPDATE_DIR:-$NOQ_DIR/update}"
ARCHIVE_DIR="$NOQ_DIR/archive/exupdate"
TRAINING_HISTORY_DIR="$NOQ_DIR/training/num/exupdate"
mkdir -p "$UPDATE_DIR" "$ARCHIVE_DIR" "$TRAINING_HISTORY_DIR" 2>/dev/null || true

TMP_BASE="${TMPDIR:-/tmp}"
STAGE_DIR="$TMP_BASE/aitech-updater.$$.$RANDOM"
mkdir -p "$STAGE_DIR" || {
    echo "[ABORT] Transaction cancelled" >&2
    echo "File: $TMP_BASE" >&2
    echo "Lines: N/A" >&2
    echo "Reason: Could not create updater staging directory." >&2
    echo "Action: No changes were committed." >&2
    exit 1
}
trap 'rm -rf "$STAGE_DIR" 2>/dev/null || true' EXIT HUP INT TERM

py() { if command -v python3 >/dev/null 2>&1; then python3 "$@"; else python "$@"; fi; }
line_count() { awk 'END{print NR+0}' "$1" 2>/dev/null || echo "N/A"; }
file_lines() { local n; n="$(line_count "$1")"; [[ "$n" == "0" ]] && echo "EMPTY" || echo "1-$n"; }

record_failure() {
    local text="$1" stamp="$2"
    mkdir -p "$ARCHIVE_DIR" 2>/dev/null || return 0
    printf '%s\n' "$text" >> "$ARCHIVE_DIR/failed_${stamp}_exupdate.txt" 2>/dev/null || true
}

abort_diag() {
    local src="$1" src_lines="$2" tgt="$3" tgt_lines="$4" reason="$5" state="${6:-No changes were committed.}"
    local stamp block
    stamp="$(date '+%Y%m%d_%H%M%S')_${$}_${RANDOM}"
    block="[ABORT] Transaction cancelled
Source file: $src
Source lines: $src_lines
Target file: $tgt
Target lines: $tgt_lines
Reason: $reason
Action: $state"
    printf '%s\n' "$block" >&2
    record_failure "$block" "$stamp"
    return 1
}

current_version() {
    py - "$AITECH_SCRIPT" <<'PYV'
import re,sys
s=open(sys.argv[1],encoding='utf-8',errors='replace').read()
m=re.search(r'^AITECH_VERSION=["\']([^"\']+)',s,re.M) or re.search(r'^# Current revision:\s*(\S+)',s,re.M)
print(m.group(1) if m else 'unknown')
PYV
}
version_from_file() {
    py - "$1" <<'PYF'
import re,sys,os
p=sys.argv[1]
try:s=open(p,encoding='utf-8',errors='replace').read(12000)
except Exception:s=''
m=re.search(r'^AITECH_VERSION=["\']([^"\']+)',s,re.M) or re.search(r'^# Current revision:\s*(\S+)',s,re.M)
if not m:m=re.search(r'AItech\(?(v?\d+\.\d+\.\d+)\)?',os.path.basename(p),re.I)
print(m.group(1) if m else 'unknown')
PYF
}

# Emits: basename<TAB>raw-target<TAB>delimiter<TAB>opener-line<TAB>body-start<TAB>body-end<TAB>closer-line
list_cat_targets() {
    py - "$AITECH_SCRIPT" <<'PYC'
import re,sys,os
lines=open(sys.argv[1],encoding='utf-8',errors='replace').read().splitlines(True)
opener=re.compile(r'^[ \t]*write_if_changed[ \t]+(["\'])(.*?)\1[ \t]*<<-?[ \t]*(?:["\']([^"\']+)["\']|([^ \t\r\n]+))[ \t]*\r?\n?$')
i=0
while i<len(lines):
    m=opener.match(lines[i])
    if not m:i+=1;continue
    raw=m.group(2); delim=m.group(3) or m.group(4); op=i+1; start=i+2
    i+=1
    while i<len(lines) and lines[i].rstrip('\r\n').strip()!=delim:i+=1
    if i>=len(lines):
        print(f'__BROKEN__\t{raw}\t{delim}\t{op}\t{start}\tEOF\tNOT_FOUND')
        break
    end=i; close=i+1
    print(f'{os.path.basename(raw.replace(chr(92),"/"))}\t{raw}\t{delim}\t{op}\t{start}\t{end}\t{close}')
    # Deliberately skip nested heredocs/cat-files inside the outer generated file.
    i+=1
PYC
}
cat_target_rows() { list_cat_targets | awk -F '\t' -v n="$1" '$1==n'; }
cat_target_exists() { [[ "$(cat_target_rows "$1" | wc -l | tr -d ' ')" == "1" ]]; }

cat_body_equal() {
    local candidate="$1"
    py - "$AITECH_SCRIPT" "$candidate" <<'PYE'
import os,re,sys
sp,cp=sys.argv[1:]; name=os.path.basename(cp)
s=open(sp,encoding='utf-8',errors='replace').read(); c=open(cp,encoding='utf-8',errors='replace').read().rstrip('\n')
lines=s.splitlines(True)
opener=re.compile(r'^[ \t]*write_if_changed[ \t]+(["\'])(.*?)\1[ \t]*<<-?[ \t]*(?:["\']([^"\']+)["\']|([^ \t\r\n]+))[ \t]*\r?\n?$')
pos=0;i=0
while i<len(lines):
    line=lines[i];m=opener.match(line);pos+=len(line)
    if not m:i+=1;continue
    raw=m.group(2);delim=m.group(3) or m.group(4);start=pos;i+=1
    while i<len(lines) and lines[i].rstrip('\r\n').strip()!=delim:pos+=len(lines[i]);i+=1
    body=s[start:pos].rstrip('\n')
    if os.path.basename(raw.replace(chr(92),'/'))==name:raise SystemExit(0 if body==c else 1)
    if i<len(lines):pos+=len(lines[i]);i+=1
raise SystemExit(2)
PYE
}

is_remote_source() {
    case "$1" in http://*|https://*|tcp://*) return 0;; esac
    [[ "$1" =~ ^([A-Za-z0-9._-]+|\[[0-9A-Fa-f:]+\]):[0-9]{1,5}(/.*)?$ ]]
}

fetch_http() {
    local url="$1"
    py - "$url" "$STAGE_DIR" <<'PYHTTP'
import os,re,sys,urllib.request,urllib.parse
url,outdir=sys.argv[1:]
req=urllib.request.Request(url,headers={'User-Agent':'AItech-updater/1'})
try:
    with urllib.request.urlopen(req,timeout=81) as r:
        data=r.read(134217729)
        if len(data)>134217728: raise RuntimeError('remote update exceeds 128 MiB safety limit')
        cd=r.headers.get('Content-Disposition','')
        m=re.search(r'filename\*?=(?:UTF-8\'\')?["\']?([^"\';]+)',cd,re.I)
        name=urllib.parse.unquote(m.group(1).strip()) if m else os.path.basename(urllib.parse.urlparse(url).path)
except Exception as e:
    print('ERROR\t'+str(e).replace('\n',' ')); raise SystemExit(2)
name=os.path.basename(name or 'remote-update')
path=os.path.join(outdir,name)
open(path,'wb').write(data)
print('OK\t'+path)
PYHTTP
}

fetch_tcp() {
    local spec="$1"
    py - "$spec" "$STAGE_DIR" <<'PYTCP'
import os,re,socket,sys
spec,outdir=sys.argv[1:]
