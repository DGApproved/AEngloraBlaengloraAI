def _pid_alive(pid):
    try:
        pid = int(pid)
        if pid <= 0:
            return False
        os.kill(pid, 0)
        return True
    except Exception:
        return False


def _load_engine_roles():
    try:
        data = json.loads(Path(ENGINE_ROLE_PATH).read_text(encoding="utf-8"))
        return data if isinstance(data, dict) else {}
    except Exception:
        return {}


def _save_engine_roles(data):
    try:
        os.makedirs(CONTEXT_INDEX_DIR, exist_ok=True)
        tmp = ENGINE_ROLE_PATH + ".tmp"
        Path(tmp).write_text(json.dumps(data, indent=2, sort_keys=True), encoding="utf-8")
        os.replace(tmp, ENGINE_ROLE_PATH)
    except OSError:
        pass


def register_peer_engine(engine_name, specialization=None):
    """
    Activation order establishes default PRIMARY/SECONDARY orchestration only.
    Both peers expose the same shared contract; specialization advertises model
    strengths without removing any shared role from the other engine.
    """
    name = str(engine_name).upper()
    state = _load_engine_roles()
    peers = state.setdefault("peers", {})
    # Remove stale crashed processes before assigning order.
    for other in list(peers):
        if peers[other].get("active") and not _pid_alive(peers[other].get("pid")):
            peers[other]["active"] = False
    now = time.time()
    rec = peers.get(name, {})
    if not rec.get("active"):
        rec["activated_epoch"] = now
    rec.update({
        "active": True,
        "pid": os.getpid(),
        "protocol_version": AITECH_ENGINE_PROTOCOL_VERSION,
        "shared_capability_revision": AITECH_SHARED_CAPABILITY_REVISION,
        "capabilities": dict(_SHARED_ENGINE_CAPABILITIES),
        "specialization": specialization or {},
        "last_seen_epoch": now,
    })
    peers[name] = rec
    ordered = sorted(
        (n for n,r in peers.items() if r.get("active")),
        key=lambda n: float(peers[n].get("activated_epoch", now))
    )
    state["activation_order"] = ordered
    state["primary_engine"] = ordered[0] if ordered else None
    state["secondary_engine"] = ordered[1] if len(ordered) > 1 else None
    state.setdefault("role_assignment", {
        "semantic_intent": "PRIMARY",
        "lexical_selection": "PRIMARY",
        "secondary_review": "SECONDARY",
        "prosody_planning": "SECONDARY",
        "final_response": "PRIMARY",
    })
    state["updated_epoch"] = now
    _save_engine_roles(state)
    return state


def unregister_peer_engine(engine_name):
    state = _load_engine_roles()
    peers = state.setdefault("peers", {})
    name = str(engine_name).upper()
    if name in peers:
        peers[name]["active"] = False
        peers[name]["last_seen_epoch"] = time.time()
    ordered = sorted(
        (n for n,r in peers.items() if r.get("active") and _pid_alive(r.get("pid"))),
        key=lambda n: float(peers[n].get("activated_epoch", 0))
    )
    state["activation_order"] = ordered
    state["primary_engine"] = ordered[0] if ordered else None
    state["secondary_engine"] = ordered[1] if len(ordered) > 1 else None
    state["updated_epoch"] = time.time()
    _save_engine_roles(state)


def peer_engine_context(engine_name):
    state = register_peer_engine(engine_name)
    peers = state.get("peers", {})
    me = peers.get(str(engine_name).upper(), {})
    role = "PRIMARY" if state.get("primary_engine") == str(engine_name).upper() else (
        "SECONDARY" if state.get("secondary_engine") == str(engine_name).upper() else "ACTIVE_PEER"
    )
    return (
        "[PEER_ENGINE_CONTRACT]\n"
        f"engine={str(engine_name).upper()} role={role}\n"
        f"activation_order={state.get('activation_order', [])}\n"
        f"role_assignment={json.dumps(state.get('role_assignment', {}), sort_keys=True)}\n"
        f"shared_capability_revision={me.get('shared_capability_revision')}\n"
        "RULE=Role is runtime-selectable; architecture does not permanently own semantic, lexical, review, or prosody work.\n"
        "VOICE_RULE=Voice is a separate capability consumer; both peers may plan prosody or character/phoneme intent.\n"
        "[/PEER_ENGINE_CONTRACT]"
    )


_ORDINALS = {
    "first": 1, "second": 2, "third": 3, "fourth": 4, "fifth": 5,
    "sixth": 6, "seventh": 7, "eighth": 8, "ninth": 9, "tenth": 10,
}


def _select_response_span(content, prompt):
    low = str(prompt or "").lower()
    n = None
    unit = None
    m = re.search(r"\b(\d+)(?:st|nd|rd|th)?\s+(paragraph|sentence|line)\b", low)
    if m:
        n, unit = int(m.group(1)), m.group(2)
    else:
        for word, number in _ORDINALS.items():
            m = re.search(rf"\b{word}\s+(paragraph|sentence|line)\b", low)
            if m:
                n, unit = number, m.group(1)
                break
    if not n or n < 1:
        return content
    if unit == "paragraph":
        parts = [p.strip() for p in re.split(r"\n\s*\n", content) if p.strip()]
    elif unit == "line":
        parts = [p for p in content.splitlines() if p.strip()]
    else:
        parts = [p.strip() for p in re.split(r"(?<=[.!?])\s+", content) if p.strip()]
    return parts[n-1] if n <= len(parts) else content


def relative_context_reference(prompt, max_chars=5000):
    low = str(prompt or "").lower()
    patterns = (
        (r"\b(\d+)\s+(?:assistant\s+)?responses?\s+ago\b", "ASSISTANT_RESPONSE"),
        (r"\b(\d+)\s+(?:file\s+)?uploads?\s+ago\b", "FILE_UPLOAD"),
        (r"\b(\d+)\s+(?:file\s+)?analys(?:is|es)\s+ago\b", "FILE_ANALYSIS"),
    )
    events = _read_context_events()
    for pattern, kind in patterns:
        m = re.search(pattern, low)
        if not m:
            continue
        ago = int(m.group(1))
        matching = [e for e in events if e.get("kind") == kind]
        if ago < 1 or ago > len(matching):
            return f"[RELATIVE_CONTEXT] requested={ago} {kind} events ago; no indexed event exists at that distance.[/RELATIVE_CONTEXT]"
        event = matching[-ago]
        selected = _select_response_span(str(event.get("content", "")), prompt)
        return (
            f"[RELATIVE_CONTEXT event_id={event.get('event_id')} kind={kind} "
            f"category_index={event.get('category_index')}]\n"
            f"{selected[:max_chars]}\n[/RELATIVE_CONTEXT]"
        )
    return ""


def _cleanup_forgotten_payloads():
    now = time.time()
    kept = []
    try:
        with open(FORGOTTEN_PAYLOADS_PATH, "r", encoding="utf-8", errors="ignore") as f:
            for line in f:
                try:
                    item = json.loads(line)
                except Exception:
                    continue
                if float(item.get("expires_epoch", 0) or 0) > now:
                    kept.append(item)
    except OSError:
        return []
    try:
        with open(FORGOTTEN_PAYLOADS_PATH, "w", encoding="utf-8") as f:
            for item in kept:
                f.write(json.dumps(item, ensure_ascii=False, sort_keys=True) + "\n")
    except OSError:
        pass
    return kept


def forget_context_for_prompt(prompt, max_chars=3500):
    low = str(prompt or "").lower()
    asks_payload = bool(re.search(r"\bwhat did you forget\b|\bwhat was forgotten\b", low))
    asks_reason = bool(re.search(r"\b(?:do you )?remember why\b|\bwhy did (?:you|i) forget\b|\bwhy was .*forgot", low))
    if not asks_payload and not asks_reason:
        return ""
    payloads = _cleanup_forgotten_payloads()
    corrections = []
    try:
        with open(CORRECTION_EVENTS_PATH, "r", encoding="utf-8", errors="ignore") as f:
            for line in f:
                try:
                    corrections.append(json.loads(line))
                except Exception:
                    pass
    except OSError:
        pass
    lines = ["[FORGET_CONTEXT]"]
    if asks_payload:
        if payloads:
            last = payloads[-1]
            lines.append("RECOVERABLE_FORGOTTEN_PAYLOAD=" + str(last.get("payload", ""))[:max_chars])
            lines.append("NOTE=payload remains inside the temporary 30-day recovery index")
        else:
            lines.append("RECOVERABLE_FORGOTTEN_PAYLOAD=UNAVAILABLE")
            lines.append("NOTE=the temporary payload index is empty/cleared/expired; do not reconstruct the deleted payload")
    if asks_reason:
        if corrections:
            last = corrections[-1]
            lines.append("LAST_DURABLE_CORRECTION_REASON=" + str(last.get("reason", "UNKNOWN")))
            lines.append("LAST_DURABLE_REPLACEMENT=" + str(last.get("replacement", "UNKNOWN")))
            lines.append("NOTE=reason/change logic survives independently of the forgotten payload")
        else:
            lines.append("LAST_DURABLE_CORRECTION_REASON=UNKNOWN")
    lines.append("[/FORGET_CONTEXT]")
    return "\n".join(lines)


def process_forget_command(user_text, last_response, session_history_text):
    """
    Returns (handled, new_session_history, message).  The payload cache is
    recoverable for 30 days; durable correction logic never stores enough data
    to recreate a payload after the cache is cleared unless the user supplies
    that content again.
    """
    raw = str(user_text or "").strip()
    low = raw.lower()
    _cleanup_forgotten_payloads()

    if low in {"clear index", "clear forgotten index", "clear forget index"}:
        try:
            Path(FORGOTTEN_PAYLOADS_PATH).write_text("", encoding="utf-8")
        except OSError:
            pass
        event = {
            "time": time.strftime("%Y-%m-%dT%H:%M:%S"),
            "event": "FORGOTTEN_INDEX_CLEARED",
            "reason": "user explicitly cleared recoverable forgotten payload cache",
            "replacement": "",
        }
        _append_jsonl(CORRECTION_EVENTS_PATH, event)
        return True, session_history_text, "[Forget Index] Recoverable forgotten payloads cleared; durable correction logic retained."

    if re.match(r"^forget\s+(?:that|this)\b", low):
        target = str(last_response or "")
        if not target:
            return True, session_history_text, "[Forget Index] No previous assistant payload is available to forget."
        replacement = ""
        reason = "user requested forgetting/correction"
        rm = re.search(r"\breplace\s+it\s+with\s+(.+)$", raw, re.I | re.S)
        if rm:
            replacement = rm.group(1).strip()
        bm = re.search(r"\bbecause\s+(.+?)(?=\breplace\s+it\s+with\b|$)", raw, re.I | re.S)
        if bm:
            reason = bm.group(1).strip()
        now = time.time()
        payload = {
            "forgotten_id": "forgot:" + hashlib.sha256((target + str(now)).encode("utf-8", errors="ignore")).hexdigest(),
            "forgotten_at": time.strftime("%Y-%m-%dT%H:%M:%S"),
            "expires_epoch": now + FORGOTTEN_TTL_SECONDS,
            "payload": target,
            "target_hash": hashlib.sha256(target.encode("utf-8", errors="ignore")).hexdigest(),
        }
        _append_jsonl(FORGOTTEN_PAYLOADS_PATH, payload)
        correction = {
            "time": payload["forgotten_at"],
            "event": "USER_CORRECTION",
            "target_hash": payload["target_hash"],
            "reason": reason,
            "replacement": replacement,
            "derived_logic": "old payload superseded; conclusions depending on it may require reevaluation",
        }
        _append_jsonl(CORRECTION_EVENTS_PATH, correction)
        # Remove the active textual payload when it is still present in RAM.
        new_hist = session_history_text
        pos = new_hist.rfind(target)
        if pos >= 0:
            new_hist = new_hist[:pos] + "[FORGOTTEN CONTENT — correction logic retained]" + new_hist[pos+len(target):]
        if replacement:
            new_hist += f"\n[USER CORRECTION] Previous payload superseded. Replacement: {replacement}. Reason: {reason}\n"
        return True, new_hist, "[Forget Index] Previous payload removed from active use; recovery copy expires in 30 days. Correction logic retained."

    # Reintroduction after a cleared/expired payload is new provenance, not recall.
    rm = re.match(r"^replace\s+that\s+with\s+(.+)$", raw, re.I | re.S)
    if rm:
        replacement = rm.group(1).strip()
        event = {
            "time": time.strftime("%Y-%m-%dT%H:%M:%S"),
            "event": "USER_REINTRODUCED_CONTENT",
            "reason": "user supplied replacement/reconstruction",
            "replacement": replacement,
            "provenance": "USER_REINTRODUCED_NOT_CACHE_RECOVERY",
        }
        _append_jsonl(CORRECTION_EVENTS_PATH, event)
        return False, session_history_text, ""

    return False, session_history_text, ""


