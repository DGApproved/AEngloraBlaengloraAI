                body=_read_text_bounded(p,2_000_000); ls=body.splitlines()
                for no,line in enumerate(ls,1):
                    m=re.search(r"\bclass\s+([A-Za-z_][A-Za-z0-9_]*)",line)
                    if m: classes.append((rel,no,m.group(1)))
