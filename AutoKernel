def _run_binary_to_text(command, payload, channel="vision", suffix=".bin"):
    """Run an experimental binary-media -> UTF-8 text translator."""
    raw = bytes(payload or b"")
    cmd = str(command or "").strip()
    if not raw:
        return ""
    if not cmd:
        update_gui_chat("SYS", f"{channel}: converter command is blank; binary payload ignored")
        return ""
    tmp_path = None
    try:
        run_cmd, stdin_data = cmd, raw
        if "{input}" in run_cmd:
            fd, tmp_path = tempfile.mkstemp(prefix="aitech_vision_in_", suffix=suffix)
            with os.fdopen(fd, "wb") as f:
                f.write(raw)
            run_cmd = run_cmd.replace("{input}", shlex.quote(tmp_path))
            stdin_data = None
        result = subprocess.run(
            run_cmd, input=stdin_data, stdout=subprocess.PIPE,
            stderr=subprocess.PIPE, shell=True, timeout=300,
        )
        text = result.stdout.decode("utf-8", errors="ignore").strip()
        if not text:
            update_gui_chat("SYS", f"{channel}: converter returned no text")
        return text
    except Exception as exc:
        update_gui_chat("SYS", f"{channel} conversion failed: {exc}")
        return ""
    finally:
        if tmp_path:
            try: os.unlink(tmp_path)
            except OSError: pass



