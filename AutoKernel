        # Map variance to NPN/PNP state
        if variance < 50: state = "00"
        elif variance < 100: state = "01"
        elif variance < 150: state = "10"
        else: state = "11"
        
        # Distribute across strings to create the chord structure
        chord = (
            f"{tension}E{state} "
            f"{max(0, tension-1)}A{state} "
            f"{max(0, tension-2)}D{state} "
            f"{min(9, tension+1)}G{'11' if state=='10' else state} "
            f"{tension}B00 "
            f"{tension}e00"
        )
        sequence.append(chord)

    track_name = "".join(filter(str.isalnum, os.path.basename(input_path).split('.')[0]))[:8]
    final_track = f"0x0R99_{track_name} " + " -> ".join(sequence)
    
