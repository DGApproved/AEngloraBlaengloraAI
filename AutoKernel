def _interpreter_registry_entries():
    workspace=os.environ.get("AUTOKERNEL_WORKSPACE","")
    registry=os.environ.get("AUTOKERNEL_INTERPRETER_REGISTRY",os.path.join(workspace,".autokernel-interpreters") if workspace else "")
    entries=[]
    if registry and os.path.isfile(registry):
        try:
            for raw in Path(registry).read_text(encoding="utf-8",errors="ignore").splitlines():
                if not raw.strip() or raw.lstrip().startswith("#"): continue
                parts=raw.split("\t",1)
                if len(parts)==2: entries.append((parts[0].strip() or "REFERENCE",parts[1].strip()))
