def survey_overflow():
    """Re-present unresolved intake so later loops can drain it.

    Overflow is a work queue, not an archive. A fragment that has been sitting
    unresolved across many loops is a candidate question for the user rather than
    something to keep silently re-reading.
    """
    if not OVERFLOW_DIR.is_dir():
        return [], 0
    rows, total = [], 0
    now = time.time()
    for f in sorted(OVERFLOW_DIR.glob("*.unresolved.txt")):
        try:
            body = f.read_text(encoding="utf-8", errors="ignore")
        except OSError:
            continue
        # Count passage rows only — the block header also carries the word.
        passages = len(re.findall(r"^\[PASSAGE .*UNRESOLVED\s*$", body, re.M))
        total += passages
        age_days = (now - f.stat().st_mtime) / 86400.0
        if passages and age_days > 3:
            _admin_note(rows, "STALE_OVERFLOW",
                        f"{f.name} | {passages} passage(s) unresolved for {age_days:.1f}d "
                        f"| candidate for a user question")
        elif passages:
            _admin_note(rows, "OVERFLOW",
                        f"{f.name} | {passages} passage(s) awaiting interpretation")
    return rows, total


