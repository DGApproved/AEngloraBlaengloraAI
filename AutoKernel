        # Clean text to prevent multi-line breaks from breaking the UI layout
        clean_text = text.replace('\n', ' | ')
        lines.append(f"[{role}] {clean_text}\n")
        
        if len(lines) > max_lines:
            lines = lines[-max_lines:]
            
        with open(CHATART, "w", encoding="utf-8") as f:
            f.writelines(lines)
    except Exception:
        pass

