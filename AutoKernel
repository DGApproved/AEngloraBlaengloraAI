def evaluate_files(npu_dir: Path):
    """
    Evaluates L2 Cache (NPU) for typographic mass, applies 212-character PRNG 
    mutations to break deep-clone deadlocks, and sequences the predictions ledger.
    Trips the L3 Cache (CPU) clutch if 5+ identical files are detected.
    """
    files = [f for f in npu_dir.iterdir() if f.is_file()]
    if not files:
        return False

    evaluated = []
    content_hashes = {}
    deep_clone_count = 0

    for f in files:
        try:
            content = f.read_text(encoding="utf-8", errors="ignore")
            mass = len(content)
            latency = mass * 0.0015  # Proxy for hardware IO latency
            
            file_hash = hashlib.md5(content.encode()).hexdigest()
            
            # Deep-clone deadlock resolution
            if file_hash in content_hashes:
                deep_clone_count += 1
                if mass > 212:
                    # Apply 212-character PRNG mutation to break the identical loop
                    mutation_point = random.randint(0, mass - 212)
                    prng_string = (f"[PRNG_MUTATION:{file_hash[:8]}]" * 10)[:212]
                    mutated_content = content[:mutation_point] + prng_string + content[mutation_point+212:]
                    f.write_text(mutated_content, encoding="utf-8")
                    if not is_daemon_running():
                        print(f"    [!] Deep-clone detected: {f.name}. Applied 212-char PRNG mutation.")
            else:
                content_hashes[file_hash] = True
                
            evaluated.append({
                "name": f.name,
                "mass": mass,
                "latency": latency,
                "hash": file_hash
            })
        except Exception:
            continue

    # Exploit Trip: Engage the CPU Clutch
    if deep_clone_count >= 5:
        clutch_file = L3_CPU_DIR / "kqkkqq.txt"
        clutch_file.write_text("[axed]\nCRITICAL: Deep-clone deadlock limit (5+) exceeded. System IO halted.", encoding="utf-8")
        if not is_daemon_running():
            print("    \033[0;31m[!] EXPLOIT TRIP: 5+ clones detected. L3 Clutch [axed] engaged.\033[0m")
        return False

    # Sequence deterministically by typographic mass (descending)
    evaluated.sort(key=lambda x: (-x['mass'], x['name']))

    # Write L1 (GPU) predictions.txt ledger
    ledger = L1_GPU_DIR / "predictions.txt"
    ledger_lines = ["[ 1/2 TOKEN INSTRUCTION LEDGER ]"]
    for idx, item in enumerate(evaluated):
        ledger_lines.append(f"{idx+1}. {item['name']} | Typographic Mass: {item['mass']} | Latency: {item['latency']:.4f}s")
        
    ledger.write_text("\n".join(ledger_lines), encoding="utf-8")
    
    if not is_daemon_running():
        print(f"    [+] Evaluated {len(evaluated)} files. Ledger sequenced to L1.")
    return True


