def _action_consent(summary_lines, question):
    print("\n\033[1;33m[Action Request]\033[0m")
    for line in summary_lines: print(f"    {line}")
    try:
        sys.stdout.write(f"  {question} [y/N] ")
        sys.stdout.flush()
        answer = input("").strip().lower()
    except: return False
    return answer in ("y", "yes")

def parse_aitech_commands(response, model_name="KE"):
    calls = re.findall(r'<aitech\s+tool="([^"]+)"\s*>', response, re.IGNORECASE)
    if not calls: return False
    lines = [f"{model_name} is requesting its own tooling:"]
    for tool in calls: lines.append(f"  {tool}")
    if not _action_consent(lines, "Run these self-tools?"): return True
    for tool in calls:
        print(execute_plugin(tool))
    return True

def parse_exec_commands(response, model_name="KE"):
    calls = re.findall(r'<exec\s+dir="([^"]*)"\s*>\s*(.*?)\s*</exec>', response, re.DOTALL | re.IGNORECASE)
    if not calls: return False
    approved = []
    for directory, command in calls:
        target = os.path.abspath(directory.strip() or ".")
        if confirm_external_write(target, f"run command: {command[:60]}"):
            approved.append((target, command.strip()))
    if not approved: return True
    lines = [f"{model_name} requesting execution:"]
    for tgt, cmd in approved: lines.append(f"  in {tgt}: {cmd[:60]}")
    if not _action_consent(lines, "Execute?"): return True
    for tgt, cmd in approved:
        try:
            res = subprocess.run(cmd, shell=True, cwd=tgt, capture_output=True, text=True, timeout=120)
            if res.stdout: print(f"  [stdout]\n{res.stdout.strip()}")
            if res.stderr: print(f"  [stderr]\n{res.stderr.strip()}")
        except Exception as e: print(f"  [exec failed] {e}")
    return True

def parse_note_commands(response, model_name="KE"):
    notes = re.findall(r'<note\s+topic="([^"]+)"\s*>(.*?)</note>', response, re.DOTALL | re.IGNORECASE)
    if not notes: return False
    for topic, body in notes:
        safe = re.sub(r"[^A-Za-z0-9._-]+", "_", topic.strip()).strip("_")[:80] or "note"
        dest = os.path.join(INT_BOOKS_DIR, f"{safe}(note).txt")
        try:
            os.makedirs(INT_BOOKS_DIR, exist_ok=True)
            with open(dest, "a", encoding="utf-8") as fh:
                fh.write(f"\n[NOTE | topic: {topic.strip()}]\n{body.strip()}\n[/NOTE]\n")
            print(f"\n[Internal Note] Recorded: {os.path.basename(dest)}")
        except: pass
    return True

def parse_daemon_queries(response, model_name="KE"):
    queries = re.findall(r'<daemon\s+query="([^"]+)"\s*>', response, re.IGNORECASE)
    commands = re.findall(r'<daemon\s+cmd="([^"]+)"\s*>', response, re.IGNORECASE)
    if not queries and not commands: return False
    sources = {
        "predictions": os.path.join(GPU_DIR, "predictions.txt"),
        "clutch": os.path.join(CPU_DIR, "kqkkqq.txt"),
        "computations": os.path.join(SYSTEM_DIR, "computations.txt"),
    }
    for q in queries:
        key = q.strip().lower()
        path = sources.get(key)
        if path and os.path.isfile(path):
            print(f"\n[Daemon: {key}]\n{open(path).read().strip()[:1200]}")
    if commands:
        lines = [f"{model_name} is requesting daemon signals:"] + [f"  {c.strip()}" for c in commands]
        if _action_consent(lines, "Signal the daemon?"):
            for c in commands:
                marker = os.path.join(SYSTEM_DIR, f"{re.sub(r'[^A-Za-z0-9._-]+', '_', c.strip())[:60]}.request")
                try:
                    os.makedirs(SYSTEM_DIR, exist_ok=True)
                    open(marker, "w").write(str(time.time()))
                    print(f"  [signalled] {os.path.basename(marker)}")
                except: pass
    return True
    
def parse_markdown_fallback(response, model_name="KE"):
    blocks = re.findall(r'```(python|bash|sh|c|cpp|yaml|json|txt|text|md|markdown|html|js|css)\s*\n(.*?)\n```', response, re.DOTALL | re.IGNORECASE)
    if not blocks: return False
    lines = [f"{model_name} produced content without workspace tags:"]
    for lang, body in blocks: lines.append(f"  {lang} block, {len(body)} chars")
    if not _action_consent(lines, "Save these blocks?"): return True
    for idx, (lang, body) in enumerate(blocks, 1):
        dest = os.path.join(GENERATED_INTAKE_DIR, f"untagged_{int(time.time())}_{idx}.txt")
        try:
            os.makedirs(GENERATED_INTAKE_DIR, exist_ok=True)
            open(dest, "w").write(body.strip() + "\n")
            print(f"  [saved] {os.path.basename(dest)}")
        except: pass
    return True

def parse_and_execute_actions(response, model_name="KE"):
    handled = False
    for dispatch in (parse_aitech_commands, parse_exec_commands, parse_note_commands, parse_daemon_queries):
        try: handled = dispatch(response, model_name) or handled
        except Exception as e: print(f"[Action] {dispatch.__name__} failed: {e}")
    if not handled:
        try: handled = parse_markdown_fallback(response, model_name) or handled
        except: pass
    return handled

# ── QWEN LOCAL-KNOWLEDGE-SITE IDENTITY ───────────────────────────────────────
# Each locally reachable GGUF/backend is treated as a replaceable knowledge
# source, not as AItech's own identity.  A content hash is preferred when the
# runtime exposes a local GGUF path.  Otherwise an endpoint continuity key keeps
# sessions separated without pretending it is a model-file hash.
_LAST_QWEN_PROVENANCE = {}


def _load_qwen_sources():
    try:
        data = json.loads(Path(QWEN_SOURCES_PATH).read_text(encoding="utf-8"))
        return data if isinstance(data, dict) else {"sources": {}}
    except Exception:
        return {"sources": {}}


def _save_qwen_sources(data):
    try:
        tmp = QWEN_SOURCES_PATH + ".tmp"
        Path(tmp).write_text(json.dumps(data, indent=2, sort_keys=True), encoding="utf-8")
        os.replace(tmp, QWEN_SOURCES_PATH)
    except OSError:
        pass


def _qwen_endpoint_key(daemon):
    raw = f"{daemon.get('name')}|{daemon.get('host')}|{daemon.get('port')}|{QWEN_MODEL_NAME_CFG}"
    return "qwen-endpoint:" + hashlib.sha256(raw.encode("utf-8", errors="ignore")).hexdigest()


def _qwen_local_model_hash():
    candidate = str(QWEN_MODEL_NAME_CFG or "").strip()
    if candidate and os.path.isfile(candidate):
        return _sha256_file(candidate)
    return ""


def _parse_identity_report(report):
    fields = {}
    for line in str(report or "").splitlines():
        m = re.match(r"\s*(MODEL_NAME|MODEL_VERSION|MODEL_FAMILY|MODEL_REVISION)\s*=\s*(.*?)\s*$", line, re.I)
        if m:
            fields[m.group(1).upper()] = m.group(2).strip()
    joined = " ".join(fields.values()).strip().lower()
    anonymous = (not fields.get("MODEL_NAME")) or any(
        x in joined for x in ("anonymous", "unknown", "unspecified", "not sure", "cannot identify")
    )
    fields["IDENTITY_CLASS"] = "ANONYMOUS" if anonymous else (
        "PARTIAL" if not fields.get("MODEL_VERSION") and not fields.get("MODEL_REVISION") else "DECLARED"
    )
    return fields


def _probe_qwen_identity(daemon):
    """
    Ask a newly encountered backend how it identifies.  The answer is stored as
    SELF_REPORTED, never as stronger evidence than runtime metadata/hash.
    """
    prompt = (
        "AItech source-identity handshake. Reply with up to four plain lines and no prose:\\n"
        "MODEL_NAME=<name or ANONYMOUS>\\n"
        "MODEL_VERSION=<version or UNKNOWN>\\n"
        "MODEL_FAMILY=<family or UNKNOWN>\\n"
        "MODEL_REVISION=<revision/quantization/variant or UNKNOWN>"
    )
    try:
        if daemon.get("protocol") == "tcp-query":
            with socket.create_connection((daemon["host"], daemon["port"]), timeout=QWEN_HTTP_TIMEOUT_CFG) as sock:
                sock.sendall(("QUERY:" + prompt).encode("utf-8"))
                sock.settimeout(QWEN_HTTP_TIMEOUT_CFG)
                data = sock.recv(16384).decode("utf-8", errors="ignore")
                return data.strip()

        payload = json.loads(json.dumps(daemon.get("payload", {})))
        name = daemon.get("name")
        if name in ("KoboldCpp", "Ollama", "LM Studio"):
            payload["prompt"] = prompt
            if "max_length" in payload:
                payload["max_length"] = 96
            if "max_tokens" in payload:
                payload["max_tokens"] = 96
            if isinstance(payload.get("options"), dict):
                payload["options"]["num_predict"] = 96
        elif name == "SillyTavern":
            payload["messages"] = [{"role": "user", "content": prompt}]
            payload["max_tokens"] = 96
        req = urllib.request.Request(
            f"http://{daemon['host']}:{daemon['port']}{daemon['path']}",
            data=json.dumps(payload).encode("utf-8"),
            headers={"Content-Type": "application/json"},
        )
        with urllib.request.urlopen(req, timeout=QWEN_HTTP_TIMEOUT_CFG) as response:
            result = json.loads(response.read().decode("utf-8"))
        return daemon["extract"](result).replace("<|im_end|>", "").strip()
    except Exception:
        return ""


def ensure_qwen_source_identity(daemon, response_metadata=None):
    sources = _load_qwen_sources()
    table = sources.setdefault("sources", {})
    endpoint_id = _qwen_endpoint_key(daemon)
    existing = table.get(endpoint_id)
    now = time.strftime("%Y-%m-%dT%H:%M:%S")
    if existing:
        existing["last_seen"] = now
        table[endpoint_id] = existing
        _save_qwen_sources(sources)
        return existing

    report = _probe_qwen_identity(daemon)
    parsed = _parse_identity_report(report)
    content_hash = _qwen_local_model_hash()
    instance_id = (
        "gguf-sha256:" + content_hash
        if content_hash
        else endpoint_id
    )
    identity_class = parsed.get("IDENTITY_CLASS", "ANONYMOUS")
    collective = "ANONYMOUS_GGUF" if identity_class == "ANONYMOUS" else (
        parsed.get("MODEL_FAMILY") or parsed.get("MODEL_NAME") or "DECLARED_GGUF"
    )

    rec = {
        "source_id": endpoint_id,
        "model_instance_id": instance_id,
        "instance_id_basis": "GGUF_CONTENT_HASH" if content_hash else "ENDPOINT_CONTINUITY_KEY",
        "model_collective_id": collective,
        "identity_class": identity_class,
        "display_name": parsed.get("MODEL_NAME") or "ANONYMOUS",
        "version": parsed.get("MODEL_VERSION") or "UNKNOWN",
        "family": parsed.get("MODEL_FAMILY") or "UNKNOWN",
        "revision": parsed.get("MODEL_REVISION") or "UNKNOWN",
        "runtime_backend": daemon.get("name"),
        "runtime_host": daemon.get("host"),
        "runtime_port": daemon.get("port"),
        "runtime_configured_model": QWEN_MODEL_NAME_CFG,
        "self_report": report[:2000],
        "self_report_status": "SELF_REPORTED_BY_MODEL",
        "first_seen": now,
        "last_seen": now,
    }
    table[endpoint_id] = rec
    _save_qwen_sources(sources)
    _append_jsonl(QWEN_EVENTS_PATH, {"time": now, "event": "QWEN_SOURCE_FIRST_SEEN", **rec})
    return rec


def _extract_remote_model_provenance(text):
    """
    Qwen can preserve a second provenance hop when it consulted/relayed an
    online model.  The bridge prompt requests this envelope only when applicable.
    """
    pattern = re.compile(
        r"<AItechRemoteSource>\s*(.*?)\s*</AItechRemoteSource>", re.I | re.S
    )
    m = pattern.search(str(text or ""))
    if not m:
        return str(text or ""), {}
    fields = {}
    for line in m.group(1).splitlines():
        if "=" in line:
            k, v = line.split("=", 1)
            fields[k.strip().upper()] = v.strip()
    cleaned = pattern.sub("", str(text or "")).strip()
    return cleaned, {
        "origin_class": "QWEN_MEDIATED_ONLINE_LLM",
        "remote_provider": fields.get("REMOTE_PROVIDER", "UNKNOWN"),
        "remote_model": fields.get("REMOTE_MODEL", "UNKNOWN"),
        "remote_version": fields.get("REMOTE_VERSION", "UNKNOWN"),
        "remote_response_id": fields.get("REMOTE_RESPONSE_ID", "UNKNOWN"),
        "identity_confidence": "RELAY_DECLARED",
    }


def record_qwen_observation(identity, response_text, remote=None):
    global _LAST_QWEN_PROVENANCE
    remote = remote or {}
    encoding = unknown_character_encoding_map(response_text)
    event = {
