OUTPUT_DIR = "data/alphabet"

# Guitar String Base Frequencies (Hz)
TUNING_MAP = {'E': 82.41, 'A': 110.00, 'D': 146.83, 'G': 196.00, 'B': 246.94, 'e': 329.63}

def parse_xtx(track_target="active"):
    """Reads guitar.xtx and returns the sequence array for the target track."""
    if not os.path.exists(XTX_FILE):
        print(f"[Error] {XTX_FILE} not found.")
