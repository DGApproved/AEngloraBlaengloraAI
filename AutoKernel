def _fmt_size(path):
    """Return human-readable size of a file or directory."""
    p = Path(path)
    if p.is_file():
        b = p.stat().st_size
    elif p.is_dir():
        b = sum(f.stat().st_size for f in p.rglob("*") if f.is_file())
    else:
        return "?"
    for unit in ["B", "KB", "MB", "GB"]:
        if b < 1024:
            return f"{b:.1f} {unit}"
        b /= 1024
    return f"{b:.1f} TB"

