                    0) unset -f ak41_setup ak41_get_conf ak41_set_conf ak41_backup_edit ak41_publish_perspective ak41_publish_relations ak41_publish_system ak41_publish_paths ak41_publish_manager ak41_publish_all ak41_preferences_menu; return ;;
                    *) echo "Invalid selection."; sleep 1 ;;
                esac
            done
        }
