    elif '@@ AITECH_TARGET' in head:name='datamod.txt'                                  # scoped, no migration => component
    elif '@@ AITECH_' in head:name='update.txt'                                          # unscoped directives
if not name:
    print('ERROR\tRemote component has no filename. Use HOST:PORT/filename or add # AITECH_UPDATE_FILENAME=filename to the payload.'); raise SystemExit(2)
out=os.path.join(outdir,name); open(out,'wb').write(data); print('OK\t'+out)
