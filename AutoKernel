def build_and_train_knowledge_engine(
    data_folder="session.noq/data/alphabet",
    output_dir="session.noq/models/hf_knowledge_model",
    epochs=3,
    decay_unit='word',
    decay_value=10,
    is_percentage=True,
):
    print("\n--- Initializing Multi-Bank Knowledge Engine ---")
    update_gui_stats(5, "INITIALIZING", "Building tokenizer and semantic datasets...")

    tokenizer = GPT2Tokenizer.from_pretrained("gpt2")
    tokenizer.add_special_tokens({
        'additional_special_tokens': SPECIAL_TOKENS,
        'pad_token': '<|endoftext|>'
    })

    raw_samples = [
        "<|dict|> WORD: SYNTHESIZE | POS: [verb] | DEF: Combine ideas. <|endoftext|>"
    ]
    raw_samples.extend(semantic_memory_training_records())
    raw_samples.extend(parse_weight_ledger_for_training())

    scan_dirs = [data_folder, MEMORY_DIR, DATAS_DIR, VIRTUAL_DIR]
    seen_paths = set()
    for folder in scan_dirs:
        if not os.path.isdir(folder):
            continue
        for fname in sorted(os.listdir(folder)):
            path = os.path.join(folder, fname)
            real = os.path.realpath(path)
            if real in seen_paths:
                continue
            seen_paths.add(real)
            if os.path.basename(path) == os.path.basename(MEMORY_WEIGHTS_PATH):
                continue
            policy = classify_source_use(path, os.path.relpath(path, NOQ_DIR))
            source_rec = register_source_provenance(
                path, policy, logical_name=fname, source_origin="gpt2_knowledge_training_scan"
            )
            if policy.get("mode") != "TRAIN":
                _write_reference_index(path, os.path.relpath(path, NOQ_DIR), policy)
                continue
            if fname.endswith((".txt", ".sh", ".py", ".cpp")):
                raw_samples.extend(generate_text_decay_records(
                    path, fname, decay_unit, decay_value, is_percentage))
            elif fname.lower().endswith((".png", ".jpg", ".jpeg", ".bmp")):
                raw_samples.extend(generate_pixel_decay_records(
                    path, fname, decay_unit, decay_value, is_percentage))

    decay_mode_label = (
        "allc" if decay_unit == "char" and decay_value == 1 and not is_percentage else
        "allw" if decay_unit == "word" and decay_value == 1 and not is_percentage else
        (f"{decay_value}{'%' if is_percentage else ''}{'c' if decay_unit == 'char' else 'w'}"
         if decay_unit in ("char", "word") else "single")
    )
    raw_samples, knowledge_continuity_session = prepare_hierarchical_training_corpus(
        raw_samples, tokenizer, "GPT21_KNOWLEDGE",
        logical_window_tokens=min(TRAINING_MODEL_CONTEXT_CFG, 8192),
        batch_window_tokens=2048,
        decay_mode=decay_mode_label,
    )
    print(
        f"  [Continuity] knowledge prepared={len(raw_samples):,} | "
        f"oversized={knowledge_continuity_session.get('oversized_records_translated',0)} | "
        f"parents={knowledge_continuity_session.get('logical_parent_count',0)} | "
        f"windows={knowledge_continuity_session.get('neural_window_count',0)}"
    )
    # generate_text_decay_records already applied the selected decay. The
    # hierarchy records are final bounded observations, so do not decay again.
    dataset    = DecayDataset(raw_samples, tokenizer, 2048, 'single', 1, False)
    dataloader = DataLoader(dataset, batch_size=4, shuffle=True)

    config = GPT2Config(
        vocab_size=len(tokenizer), n_positions=2048, n_ctx=2048,
        n_embd=288, n_layer=6, n_head=6
    )
    model = GPT2LMHeadModel(config)
    model.resize_token_embeddings(len(tokenizer))
    inject_tokenizer_patches(tokenizer, model)

    device = torch.device(
        "cuda" if torch.cuda.is_available()
        else "mps" if hasattr(torch.backends, "mps") and torch.backends.mps.is_available()
        else "cpu"
    )
    model.to(device)
    optimizer = AdamW(model.parameters(), lr=5e-4)
    print(f"[*] Training on {device.type.upper()} | Samples: {len(dataset)} | Epochs: {epochs}")

    model.train()
    for epoch in range(epochs):
        total_loss = 0.0; batch_count = 0
        for batch in dataloader:
            batch      = batch.to(device)
            loss       = model(batch, labels=batch).loss
            optimizer.zero_grad(set_to_none=True)
            loss.backward()
            optimizer.step()
            total_loss += loss.item(); batch_count += 1
        avg_loss = total_loss / max(1, batch_count)
        pct      = int(((epoch + 1) / epochs) * 95)
        print(f"Epoch {epoch+1}/{epochs} | Avg Loss: {avg_loss:.4f}")
        update_gui_stats(pct, f"EPOCH {epoch+1}/{epochs}", f"Loss: {avg_loss:.4f}")

    os.makedirs(output_dir, exist_ok=True)
    model.save_pretrained(output_dir)
    tokenizer.save_pretrained(output_dir)
    note_training_store(output_dir, "knowledge model and tokenizer", "persist trained knowledge engine")
    finalize_training_continuity_session(
        knowledge_continuity_session, "COMPLETE",
        {"backend": device.type, "output_dir": output_dir, "epochs": epochs}
    )
    update_gui_stats(100, "TRAINING COMPLETE", f"Saved: {output_dir}")
    print(f"\n[✓] Knowledge Engine saved to '{output_dir}'")

