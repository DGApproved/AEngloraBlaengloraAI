AK_COLOR_RESET='\033[0m'
AK_COLOR_INFO='\033[0;37m'      # Goddess alternative: TEXT_COLOR #94a3b8
AK_COLOR_WARN='\033[1;33m'      # Goddess alternative: GODDESS_GOLD #facd68
AK_COLOR_ERROR='\033[0;31m'     # Goddess alternative: error accent / retain terminal red
AK_COLOR_CONTEXT='\033[0;90m'   # Goddess alternative: muted TEXT_COLOR over HISTORY_BG #050507

autokernel_is_warning_line() {
    local line="$1"
    [[ "$line" =~ [Ww][Aa][Rr][Nn]([Ii][Nn][Gg])? ]]
}

autokernel_is_error_line() {
    local line="$1"
    [[ "$line" =~ [Ee][Rr][Rr][Oo][Rr] ]] \
        || [[ "$line" =~ [Ff][Aa][Tt][Aa][Ll] ]] \
        || [[ "$line" =~ [Ff][Aa][Ii][Ll][Ee][Dd] ]] \
        || [[ "$line" =~ [Mm][Aa][Kk][Ee].*\*\*\* ]]
}

autokernel_record_warning() {
    local previous_line="$1"
    local warning_line="$2"
    local timestamp record_line
    timestamp="$(date '+%Y-%m-%d %H:%M:%S')"
    record_line=$(( $(wc -l < "$AUTOKERNEL_WARN_LOG") + 2 ))

    printf '[%s] {warn occurred here, recorded at: line %d in AutoKernel-warns.log}\n' \
        "$timestamp" "$record_line" >> "$AUTOKERNEL_LOG"

    {
        printf '[%s][CONTEXT] %s\n' "$timestamp" "${previous_line:-<no previous line>}"
        printf '[%s][WARN] %s\n\n' "$timestamp" "$warning_line"
    } >> "$AUTOKERNEL_WARN_LOG"
}

autokernel_record_error() {
    local previous_line="$1"
    local error_line="$2"
    local timestamp record_line
    timestamp="$(date '+%Y-%m-%d %H:%M:%S')"
    record_line=$(( $(wc -l < "$AUTOKERNEL_ERROR_LOG") + 2 ))

    printf '[%s] {error occurred here, recorded at: line %d in AutoKernel-errors.log}\n' \
        "$timestamp" "$record_line" >> "$AUTOKERNEL_LOG"

    {
        printf '[%s][CONTEXT] %s\n' "$timestamp" "${previous_line:-<no previous line>}"
        printf '[%s][ERROR] %s\n\n' "$timestamp" "$error_line"
    } >> "$AUTOKERNEL_ERROR_LOG"
}

run_historian_step() {
    local step_name="$1"
    shift

    local line previous_line="" timestamp status last_line_file
    last_line_file="$(mktemp)"

    timestamp="$(date '+%Y-%m-%d %H:%M:%S')"
    printf '[%s][STEP] %s\n' "$timestamp" "$step_name" >> "$AUTOKERNEL_LOG"

    "$@" 2>&1 | while IFS= read -r line || [[ -n "$line" ]]; do
        timestamp="$(date '+%Y-%m-%d %H:%M:%S')"

        if autokernel_is_error_line "$line"; then
            printf '%b%s%b\n' "$AK_COLOR_ERROR" "$line" "$AK_COLOR_RESET"
            autokernel_record_error "$previous_line" "$line"
        elif autokernel_is_warning_line "$line"; then
            printf '%b%s%b\n' "$AK_COLOR_WARN" "$line" "$AK_COLOR_RESET"
            autokernel_record_warning "$previous_line" "$line"
        else
            printf '%s\n' "$line"
            printf '[%s] %s\n' "$timestamp" "$line" >> "$AUTOKERNEL_LOG"
        fi

        previous_line="$line"
        printf '%s\n' "$previous_line" > "$last_line_file"
    done

    status=${PIPESTATUS[0]}
    if [[ -s "$last_line_file" ]]; then
        previous_line="$(cat "$last_line_file")"
    fi
    rm -f "$last_line_file"

    if (( status != 0 )); then
        autokernel_record_error "$previous_line" \
            "Command exited with status $status during: $step_name"
        printf '%bAutoKernel historian: step failed with status %d: %s%b\n' \
            "$AK_COLOR_ERROR" "$status" "$step_name" "$AK_COLOR_RESET"
    fi

    return "$status"
}

download_with_check() 
{
    local url="$1"
    local filename="$2"
    if [ -f "$filename" ]; then
        echo "File '$filename' already exists."
        echo -n "Do you want to re-download/overwrite it? (y/n): "
        read choice
        case "$choice" in
        y|Y )
            echo "Re-downloading $filename..."
            wget -O "$filename" "$url"
            ;;
          * )
            echo "skipping download for $filename."
            ;;
        esac
    else
        echo "Downloading: $url"
        wget "$url"
    fi
}
