def update_gui_ascii(img_obj, cols=60, rows=10):
    """
    Converts a PIL Image to ASCII and pushes it to the GUI.sh canvas.
    Terminal characters are roughly twice as tall as they are wide, 
    so we adjust the resize ratio to prevent severe stretching.
    """
    try:
        # Standard ASCII density palette (dark to light)
        ascii_chars = [" ", ".", ":", "-", "=", "+", "*", "#", "%", "@"]
        
        # Resize image to target dimensions. 
        # We stretch the width slightly because terminal fonts are tall.
        resized = img_obj.resize((cols, rows)).convert("L")
        pixels = list(resized.getdata())
        
        ascii_str = ""
        for i, pixel_value in enumerate(pixels):
            # Map the 0-255 grayscale value to the 0-9 ascii palette
            palette_idx = int((pixel_value / 255.0) * (len(ascii_chars) - 1))
            ascii_str += ascii_chars[palette_idx]
            
            # Wrap to the next line
            if (i + 1) % cols == 0:
                ascii_str += "\n"
                
        os.makedirs(NOQ_DIR, exist_ok=True)
        with open(ASCIIART_TXT, "w", encoding="utf-8") as f:
            f.write(ascii_str)
            
    except Exception as e:
        pass # Fail silently so terminal loop is not broken

def update_gui_chat(role, text, max_lines=50):
