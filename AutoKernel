        f"pass: {datetime.now().isoformat(timespec='seconds')}",
        f"unresolved overflow passages: {overflow_total}",
        "authority: sequencing, routing and holds only — meaning stays with the librarian",
        "",
    ]
    try:
        ADMIN_LEDGER.parent.mkdir(parents=True, exist_ok=True)
        ADMIN_LEDGER.write_text("\n".join(header + (rows or ["[CLEAR] nothing to report"])) + "\n",
                                encoding="utf-8")
    except OSError:
        pass
    return rows


