            "[AI]"*)  CURRENT_AI="${line:5}" ;;
            "[YOU]"*) CURRENT_USER="${line:6}" ;;
            "[SYS]"*) CURRENT_SYS="${line:6}" ;;
        esac
    done < "$CHATART"
}

next_view() {
    local direction="${1:-1}" count=${#VIEW_ORDER[@]}
    (( count == 0 )) && return
    MIDDLE_INDEX=$(( (MIDDLE_INDEX + direction + count) % count ))
    MIDDLE_SCROLL=0
}

draw_header() {
    local title=" AItech / GoddessMatrix " path_label=""
    (( GUI_SHOW_PATH == 1 )) && path_label=" $NOQ_DIR "
    tput cup 0 0; tput el; printf '%s' "$C_BORDER"; repeat_char '═' "$COLS"; printf '%s' "$C_RESET"
    tput cup 0 2; printf '%s%s%s' "$C_HEADER" "$title" "$C_RESET"
    if [[ -n "$path_label" && ${#path_label} -lt $(( COLS - ${#title} - 5 )) ]]; then
        tput cup 0 $(( COLS - ${#path_label} - 1 ))
        printf '%s%s%s' "$C_SYS" "$path_label" "$C_RESET"
    fi
}

draw_art_panel() {
    local width=$(( COLS - 4 )) row=0 line
    (( width < 1 )) && width=1
    while (( row < ART_ROWS )); do
        tput cup $(( ART_TOP - 1 + row )) 0; tput el
        line=""
        IFS= read -r line < <(sed -n "$((row + 1))p" "$ASCIIART" 2>/dev/null)
        printf '%s│%s %s%-*.*s%s %s│%s' "$C_BORDER" "$C_RESET" "$C_ART" "$width" "$width" "$line" "$C_RESET" "$C_BORDER" "$C_RESET"
        row=$(( row + 1 ))
    done
}

draw_table() {
    local title="COMMANDS" content=""
    if (( ${#VIEW_ORDER[@]} > 0 )); then
        title="${VIEW_TITLE[$MIDDLE_INDEX]:-${VIEW_ORDER[$MIDDLE_INDEX]^^}}"
        content="${VIEW_LINES[$MIDDLE_INDEX]:-}"
    fi
    local width=$(( COLS - 4 ))
    (( width < 1 )) && width=1
    local -a lines=()
    local line
    while IFS= read -r line || [[ -n "$line" ]]; do lines+=("$line"); done <<< "$content"

    local total=${#lines[@]}
    local max_scroll=$(( total > TABLE_HEIGHT ? total - TABLE_HEIGHT : 0 ))
    (( MIDDLE_SCROLL > max_scroll )) && MIDDLE_SCROLL=$max_scroll
    (( MIDDLE_SCROLL < 0 )) && MIDDLE_SCROLL=0

    tput cup $(( TABLE_TOP - 2 )) 0; tput el
    local hint="←/→ view  ↑/↓ scroll  PgUp/PgDn  Home latest  q close"
    printf '%s[%s]%s %s%s%s' "$C_HEADER" "$title" "$C_RESET" "$C_SYS" "${hint:0:$((COLS-${#title}-5))}" "$C_RESET"

    local row idx=$MIDDLE_SCROLL
    for ((row=0; row<TABLE_HEIGHT; row++)); do
        tput cup $(( TABLE_TOP - 1 + row )) 0; tput el
        if (( idx < total )); then
            printf '%s│%s %s%-*.*s%s %s│%s' "$C_BORDER" "$C_RESET" "$C_TABLE" "$width" "$width" "${lines[idx]}" "$C_RESET" "$C_BORDER" "$C_RESET"
        else
            printf '%s│%s %-*s %s│%s' "$C_BORDER" "$C_RESET" "$width" '' "$C_BORDER" "$C_RESET"
        fi
        idx=$(( idx + 1 ))
    done
}

draw_chat_bars() {
    local avail=$(( COLS - 8 ))
    (( avail < 1 )) && avail=1
    local ai_max=$(( ${#CURRENT_AI} > avail ? ${#CURRENT_AI} - avail : 0 ))
    local you_max=$(( ${#CURRENT_USER} > avail ? ${#CURRENT_USER} - avail : 0 ))
    (( AI_SCROLL > ai_max )) && AI_SCROLL=$ai_max
    (( USER_SCROLL > you_max )) && USER_SCROLL=$you_max
    (( AI_SCROLL < 0 )) && AI_SCROLL=0
    (( USER_SCROLL < 0 )) && USER_SCROLL=0

    tput cup $(( ROW_AI - 1 )) 0; tput el
    printf '%sAI ▶ %-*.*s%s' "$C_AI" "$avail" "$avail" "${CURRENT_AI:$AI_SCROLL:$avail}" "$C_RESET"

    local bar_width=$(( COLS - 2 ))
    local fill=$(( PROGRESS * bar_width / 100 ))
    local empty=$(( bar_width - fill ))
    tput cup $(( ROW_PROGRESS - 1 )) 0; tput el
    printf '%s' "$C_FILL"; repeat_char '█' "$fill"
    printf '%s' "$C_EMPTY"; repeat_char '░' "$empty"
    printf '%s' "$C_RESET"
    local label="${PROGRESS}% ${PROGRESS_LABEL}"
    [[ -n "$CURRENT_SYS" ]] && label+=" | ${CURRENT_SYS}"
    label="${label:0:$bar_width}"
    tput cup $(( ROW_PROGRESS - 1 )) $(( (COLS - ${#label}) / 2 ))
    printf '%s%s%s' "$C_SYS" "$label" "$C_RESET"

    tput cup $(( ROW_USER - 1 )) 0; tput el
    printf '%sYOU▶ %-*.*s%s' "$C_USER" "$avail" "$avail" "${CURRENT_USER:$USER_SCROLL:$avail}" "$C_RESET"
}

draw_full() {
    tput clear; draw_header; draw_art_panel; draw_table; draw_chat_bars
}

LAST_ART_MTIME=0; LAST_TEXT_MTIME=0; LAST_CHAT_MTIME=0

mtime() {
    stat -c '%Y:%s' "$1" 2>/dev/null || stat -f '%m:%z' "$1" 2>/dev/null || echo '0:0'
}

refresh_changed() {
    local a t c changed=0
    a=$(mtime "$ASCIIART"); t=$(mtime "$TEXTART"); c=$(mtime "$CHATART")
    if [[ "$a" != "$LAST_ART_MTIME" ]]; then LAST_ART_MTIME="$a"; changed=1; fi
    if [[ "$t" != "$LAST_TEXT_MTIME" ]]; then LAST_TEXT_MTIME="$t"; parse_textart; changed=1; fi
    if [[ "$c" != "$LAST_CHAT_MTIME" ]]; then LAST_CHAT_MTIME="$c"; parse_chatart; changed=1; fi
    (( changed )) && draw_full
}

enable_mouse() { printf '\033[?1000h\033[?1006h'; }
disable_mouse() { printf '\033[?1000l\033[?1006l'; }

handle_sgr_mouse() {
    local sequence="$1"
    local body="${sequence%[Mm]}"
    local btn="${body%%;*}"
    case "$btn" in
        64) MIDDLE_SCROLL=$(( MIDDLE_SCROLL > 0 ? MIDDLE_SCROLL - 1 : 0 )); draw_table ;;
        65) MIDDLE_SCROLL=$(( MIDDLE_SCROLL + 1 )); draw_table ;;
        0)  MIDDLE_SCROLL=0; AI_SCROLL=0; USER_SCROLL=0; draw_full ;;
    esac
}

cleanup() {
    disable_mouse 2>/dev/null || true
    tput cnorm 2>/dev/null || true
    tput rmcup 2>/dev/null || true
    [[ -f "$PID_FILE" ]] && [[ "$(cat "$PID_FILE" 2>/dev/null || true)" == "$$" ]] && rm -f "$PID_FILE"
}

on_resize() { calculate_layout; parse_textart; parse_chatart; draw_full; }
trap cleanup EXIT INT TERM
trap on_resize WINCH

main_display_loop() {
    calculate_layout; parse_textart; parse_chatart
    tput smcup; tput civis; enable_mouse; draw_full

    LAST_ART_MTIME=$(mtime "$ASCIIART"); LAST_TEXT_MTIME=$(mtime "$TEXTART"); LAST_CHAT_MTIME=$(mtime "$CHATART")
    local key k2 k3 seq mc
    while true; do
        key=""
        IFS= read -rsn1 -t "$GUI_POLL_INTERVAL" key 2>/dev/null || true
        if [[ -n "$key" ]]; then
            case "$key" in
                q|Q) break ;;
                $'\x1b')
                    k2=""; k3=""
                    IFS= read -rsn1 -t 0.05 k2 2>/dev/null || true
                    if [[ "$k2" == '[' ]]; then
                        IFS= read -rsn1 -t 0.05 k3 2>/dev/null || true
                        case "$k3" in
                            A) MIDDLE_SCROLL=$(( MIDDLE_SCROLL > 0 ? MIDDLE_SCROLL - 1 : 0 )); draw_table ;;
                            B) MIDDLE_SCROLL=$(( MIDDLE_SCROLL + 1 )); draw_table ;;
                            C) next_view 1; draw_table ;;
                            D) next_view -1; draw_table ;;
                            H) MIDDLE_SCROLL=0; AI_SCROLL=0; USER_SCROLL=0; draw_full ;;
                            5) IFS= read -rsn1 -t 0.05 mc 2>/dev/null || true; MIDDLE_SCROLL=$(( MIDDLE_SCROLL > TABLE_HEIGHT ? MIDDLE_SCROLL - TABLE_HEIGHT : 0 )); draw_table ;;
                            6) IFS= read -rsn1 -t 0.05 mc 2>/dev/null || true; MIDDLE_SCROLL=$(( MIDDLE_SCROLL + TABLE_HEIGHT )); draw_table ;;
                            '<')
                                seq=""
                                while IFS= read -rsn1 -t 0.05 mc 2>/dev/null; do
                                    seq+="$mc"
                                    [[ "$mc" == M || "$mc" == m ]] && break
                                done
                                handle_sgr_mouse "$seq"
                                ;;
                        esac
                    fi
                    ;;
                h) AI_SCROLL=$(( AI_SCROLL > 0 ? AI_SCROLL - 1 : 0 )); draw_chat_bars ;;
                l) AI_SCROLL=$(( AI_SCROLL + 1 )); draw_chat_bars ;;
                r|R) parse_textart; parse_chatart; draw_full ;;
            esac
        fi
        refresh_changed
    done
}

main_display_loop
exit 0
