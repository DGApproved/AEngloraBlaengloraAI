            f"timestamp: {time.strftime('%Y-%m-%dT%H:%M:%S')}\n"
            f"source: {source_name}\n"
            f"destination: {destination_name}\n"
            f"reason: {reason}\n"
            f"content: {content}\n"
            "[/RECLASSIFIED_MEMORY]\n"
        )

# -------------------------------------------------------------------------
# PINNED HEADER UI & TERMINAL CONTROL
# -------------------------------------------------------------------------
# Layout contract:
#   Row 1          : status header  (never scrolls)
#   Rows 2..N-1    : scroll region  (chat output lives here)
#   Row N          : input prompt   (never scrolls)
#
# ANSI sequences used:
#   [top;botR  : set scroll region to rows top..bot
#   [R;1H      : move cursor to row R, column 1
#   [K         : erase to end of line
#   [s / [u: save / restore cursor position

    def _term_size():
        """Return (columns, rows) of the current terminal."""
        s = shutil.get_terminal_size((80, 24))
        return s.columns, s.lines

    def _scroll_bot():
        """Last row of the scroll region (second-to-last terminal row)."""
        _, rows = _term_size()
        return max(3, rows - 1)

    def _set_scroll_region():
        """
        Restrict terminal scrolling to rows 2..(N-1).
        Row 1 holds the header; row N holds the prompt.
        Any text printed while the cursor is inside this region scrolls
        upward within it without touching the header or prompt.
        """
        sys.stdout.write(f"\033[2;{_scroll_bot()}r")

    def _draw_prompt_pin(partial=""):
        """
        Redraw the prompt line at the last terminal row without disturbing
        the cursor position in the scroll region.
        Called after every draw_pinned_header() and after processing each
        user command so the prompt remains visible.
        """
        _, rows = _term_size()
        sys.stdout.write(
            f"\033[s"            # save cursor
            f"\033[{rows};1H"   # jump to last row
            "\033[K"            # erase line
            "\033[1;32m[AIDev] > \033[0m"
            f"{partial}"
            "\033[u"            # restore cursor to wherever it was
        )
        sys.stdout.flush()

    def _move_to_scroll():
        """
        Place the cursor at the last line of the scroll region so subsequent
        print() output enters the scroll area (not the prompt row).
        Call this after input() returns and before printing any response.
        """
        sys.stdout.write(f"\033[{_scroll_bot()};1H")
        sys.stdout.flush()

    class _ScrollRegionWriter:
        """
        Thin stdout wrapper that routes every write() into the scroll region.

        Before writing it saves the cursor, moves to the last scroll line,
        writes the text, then restores the cursor. Row N is outside the terminal
        scroll region, so the live input line does not need to be redrawn here.
        In particular, never clear/repaint that row from asynchronous output:
        input()/readline may own a partially typed command there. This ensures
        daemon ticks, response rendering and processing output can continue
        scrolling without destroying what the user is visibly typing.

        ui_lock is held externally by callers when needed; this wrapper does
        not acquire it to avoid deadlocks with draw_pinned_header().
        """
        def __init__(self, underlying):
            self._u = underlying

        def write(self, text):
            if not text:
                return
            sb = _scroll_bot()
            self._u.write(
                f"\033[s"          # save the live cursor, including while user is typing
                f"\033[{sb};1H"   # last scroll line; output remains inside scroll region
                + text +
                "\033[u"          # restore exact typing/output cursor; do not touch prompt row
            )

        def flush(self):
            self._u.flush()

        def fileno(self):
            return self._u.fileno()

        @property
        def encoding(self):
            return getattr(self._u, "encoding", "utf-8")

        @property
        def errors(self):
            return getattr(self._u, "errors", "replace")

        @property
        def softspace(self):
            return getattr(self._u, "softspace", 0)

    def draw_pinned_header():
        global header_expanded, daemon_status, fg_tokens_total, bg_tokens_total, ui_paused
        if ui_paused or check_cpu_clutch(): return 

        term_width = shutil.get_terminal_size((80, 24)).columns
        active_str = " | ".join(active_cloud_models.keys()) if active_cloud_models else "Local Only"
        
        cpu_str = f"CPU:{psutil.cpu_percent()}%" if PSUTIL else ""
        left_str_raw = f"⚡ [AIDev] Active: {active_str} | GGUF:{ACTIVE_GGUF_NAME} | KCPP:{'ON' if KOBOLDCPP_URL else 'OFF'} | ST:{'ON' if SILLYTAVERN_URL else 'OFF'} {cpu_str}"
        right_str_raw = f"Daemon: {daemon_status} | FG Tok: {fg_tokens_total} | BG Tok: {bg_tokens_total} "
        
        padding = max(1, term_width - len(left_str_raw) - len(right_str_raw) - 2)
        
        sb  = _scroll_bot()
        _, rows = _term_size()
        # expanded header takes more rows; clamp scroll region accordingly
        exp_rows = min(10, rows - 3)

        with ui_lock:
            sys.stdout.write("\033[s")
            if not header_expanded:
                # header at row 1, scroll region rows 2..N-1
                sys.stdout.write(f"\033[2;{sb}r\033[1;1H\033[K")
                sys.stdout.write(f"\033[1;36m{left_str_raw}{' ' * padding}{right_str_raw}\033[0m")
            else:
                # expanded: rows 1..exp_rows are header, scroll below
                sys.stdout.write(f"\033[{exp_rows};{sb}r\033[1;1H\033[K"
                                 "\033[1;36m=== SYSTEM STATUS & REFERENCE MANUAL ===\033[0m\n")
                sys.stdout.write(f"\033[K[OK] Gemini, Claude, ChatGPT, Qwen Online.\n")
                sys.stdout.write(f"\033[K[OK] {right_str_raw}\n")
                sys.stdout.write(f"\033[K[MEM] Reading: {last_memory_read}\n")
                sys.stdout.write(f"\033[K[MEM] Storing: {last_memory_store}\n")
                sys.stdout.write("\033[K\033[1mCommands:\033[0m\n")
                sys.stdout.write("\033[K  - 'look at this: <path>' : Ingest file\n")
                sys.stdout.write("\033[K  - 'm', 'multi'           : Enter Multi-Line Paste Mode\n")
                sys.stdout.write("\033[K  - 'k', 'k: [dirs]'       : Peer-Review previous AI output\n")
                sys.stdout.write("\033[K  - 'go'/'stop'/'m N'       : Daemon control\n")
                sys.stdout.write("\033[K  - 'history', 'h'          : Open scrollable chat history\n")
                sys.stdout.write("\033[K  - '?', 'exit'             : [?] Show commands, [exit] Quit\n")
            # Header refresh owns header rows only. The main input loop owns row N.
            # Touching the prompt row here would erase a partially typed command
            # whenever a background HUD/header update occurs.
            sys.stdout.write("\033[u")
            sys.stdout.flush()

    def clear_and_init_ui():
        with ui_lock:
            # Full clear, set scroll region, draw header, draw prompt
            sys.stdout.write("\033[2J\033[1;1H")
            sys.stdout.flush()
        draw_pinned_header()           # draws header at row 1 + prompt at row N
        with ui_lock:
            _set_scroll_region()       # ensure scroll region is correct after clear
            _move_to_scroll()          # position cursor in scroll area for output
            sys.stdout.flush()

