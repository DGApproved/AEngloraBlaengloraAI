def _reference_structure_summary(root,role):
    ext=Counter(); symbols=Counter(); comment_words=Counter(); licenses=[]; files=0; dirs_seen=0
    text_exts={".txt",".md",".rst",".c",".h",".cc",".cpp",".hpp",".java",".kt",".rs",".go",".py",".sh",".bash",".zsh",".fish",".js",".ts",".lua",".rb",".pl",".php",".swift",".asm",".s",".cfg",".conf",".ini",".toml",".yaml",".yml",".xml",".html"}
    skip={".git",".svn",".hg","node_modules","venv",".venv","build","dist","target"}
    for current,dirs,names in os.walk(root,topdown=True,followlinks=False):
        dirs[:]=sorted(d for d in dirs if d not in skip and not os.path.islink(os.path.join(current,d)))
        if os.path.realpath(current)!=os.path.realpath(root): dirs_seen+=1
        for name in sorted(names):
            if files>=12000: break
            p=os.path.join(current,name)
            if os.path.islink(p): continue
            files+=1; suffix=Path(name).suffix.lower() or "<none>"; ext[suffix]+=1
            if name.lower() in {"license","license.txt","license.md","copying","copyright","notice","notice.txt"}: licenses.append(os.path.relpath(p,root))
            if suffix not in text_exts and name.lower() not in {"makefile","kconfig"}: continue
            body=_read_text_bounded(p,131072)
            for pat in (r"\b(?:def|class|struct|enum|interface)\s+([A-Za-z_][A-Za-z0-9_]*)",r"^\s*([A-Za-z_][A-Za-z0-9_]*)\s*\(\)\s*\{"):
                for sym in re.findall(pat,body,re.M): symbols[sym]+=1
            for _,_,clue in _comment_blocks(body.splitlines()):
                for word in re.findall(r"[A-Za-z][A-Za-z0-9_-]{3,}",clue.lower()):
                    if word not in {"this","that","with","from","have","will","into","when","where","then","than","they","their","there","does","only","also","used"}: comment_words[word]+=1
        if files>=12000: break
    return {"role":role,"root":os.path.realpath(root),"file_count":files,"directory_count":dirs_seen,
            "extensions":ext.most_common(80),"symbols":symbols.most_common(400),"comment_context_keywords":comment_words.most_common(250),
            "license_files":sorted(set(licenses))[:100],"mapping_mode":"INTERPRETER_ONLY","direct_training":False,
            "direct_example_use":"DISCOURAGED","attribution_if_directly_referenced":True,"boundary_rule":"train.enabled grants depth, not breadth"}


def refresh_interpreter_reference_maps():
    ref_dir=os.path.join("session.noq","dgapi","reference_maps"); os.makedirs(ref_dir,exist_ok=True)
    index=[]; seen=set()
    for role,root in _interpreter_registry_entries():
        real=os.path.realpath(root)
        if real in seen: continue
        seen.add(real)
        enabled=os.path.isfile(os.path.join(real,"train.enabled")); disabled=os.path.isfile(os.path.join(real,"train.disabled"))
        state="ENABLED" if enabled else ("DISABLED" if disabled else "NO_MARKER")
        entry={"role":role,"root":real,"state":state,"training_use":"NO_DIRECT_TRAINING"}
        if enabled and os.path.isdir(real):
            summary=_reference_structure_summary(real,role)
            safe=re.sub(r"[^A-Za-z0-9_.-]+","_",f"{role}_{os.path.basename(real)}")[:120]
            out_path=os.path.join(ref_dir,safe+".json")
            with open(out_path,"w",encoding="utf-8") as f: json.dump(summary,f,indent=2,sort_keys=True)
            entry["map"]=out_path; entry["mapped_files"]=summary.get("file_count",0)
        index.append(entry)
    with open(os.path.join(ref_dir,"index.json"),"w",encoding="utf-8") as f: json.dump(index,f,indent=2,sort_keys=True)
    return index


