def _term_size():
    size = shutil.get_terminal_size((80, 24))
    return size.columns, size.lines

def _scroll_bot():
    _, rows = _term_size()
    return max(3, rows - 1)

def _set_scroll_region():
    sys.stdout.write(f"\033[2;{_scroll_bot()}r")

def _draw_prompt_pin(partial=""):
    _, rows = _term_size()
    sys.stdout.write(
        f"\033[s"
        f"\033[{rows};1H"
        "\033[K"
        "\033[1;32m[Terminal] > \033[0m"
        f"{partial}"
        "\033[u"
    )
    sys.stdout.flush()

def _move_to_scroll():
    sys.stdout.write(f"\033[{_scroll_bot()};1H")
    sys.stdout.flush()

class _ScrollRegionWriter:
    """Keep asynchronous runtime output above a pinned input prompt.

    Row N is outside the scroll region and belongs to the live terminal line
    editor. Background output must never clear or redraw that row: doing so
    visually destroys a partially typed command. Save the live cursor, write
    only in the scroll region, then restore the exact cursor instead.
    """
    def __init__(self, underlying):
        self._u = underlying

    def write(self, text):
        if not text:
            return 0
        sb = _scroll_bot()
        rendered = (
            f"\033[s"
            f"\033[{sb};1H"
            + text +
            "\033[u"
        )
        result = self._u.write(rendered)
        return len(text) if result is None else result

    def flush(self):
        self._u.flush()

    def fileno(self):
        return self._u.fileno()

    def isatty(self):
        return getattr(self._u, "isatty", lambda: False)()

    @property
    def encoding(self):
        return getattr(self._u, "encoding", "utf-8")

    @property
    def errors(self):
        return getattr(self._u, "errors", "replace")

    @property
    def softspace(self):
        return getattr(self._u, "softspace", 0)

