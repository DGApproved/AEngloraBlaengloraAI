# ============================================================================
# AUTOKERNEL PORTABLE STARTUP / HOST ENVIRONMENT
# ============================================================================
AUTOKERNEL_SELF="${BASH_SOURCE[0]:-$0}"
case "$AUTOKERNEL_SELF" in
    /*) ;;
    *) AUTOKERNEL_SELF="$(cd "$(dirname "$AUTOKERNEL_SELF")" 2>/dev/null && pwd -P)/$(basename "$AUTOKERNEL_SELF")" ;;
esac
export AUTOKERNEL_PATH="$AUTOKERNEL_SELF"
export AUTOKERNEL_DIR="$(cd "$(dirname "$AUTOKERNEL_SELF")" 2>/dev/null && pwd -P || dirname "$AUTOKERNEL_SELF")"

OS_Selector() {
    # ------------------------------------------------------------------------
    # AutoKernel boot environment selector.
    #
    # This one boot-time function owns AutoKernel's host/target OS selection,
    # read-only-media handling, portable workspace symlink behavior, and the
    # OS-specific local installer.  Child projects may still choose their own
    # working directories and dependencies.  In particular, Python selection
    # remains AItech's responsibility rather than AutoKernel's.
    # ------------------------------------------------------------------------

    HOST_OS_TYPE="unknown"
    case "${OSTYPE:-}" in
        darwin*) HOST_OS_TYPE="Apple" ;;
        linux*) HOST_OS_TYPE="Distro" ;;
        msys*|cygwin*|win32*) HOST_OS_TYPE="Microsoft" ;;
        *)
            case "$(uname -s 2>/dev/null || true)" in
                Darwin) HOST_OS_TYPE="Apple" ;;
                Linux) HOST_OS_TYPE="Distro" ;;
                MINGW*|MSYS*|CYGWIN*) HOST_OS_TYPE="Microsoft" ;;
            esac
            ;;
    esac
    export HOST_OS_TYPE

    case "$HOST_OS_TYPE" in
        Distro)    default_os_choice=0 ;;
        Microsoft) default_os_choice=2 ;;
        *)         default_os_choice=1 ;;
    esac

    case "${TARGET_OS:-}" in
        linux)   OS_SEC="Linux" ;;
        unix)    OS_SEC="Unix" ;;
        windows) OS_SEC="Win" ;;
        *)
            printf '\033[0;36m=================================================================\033[0m\n'
            printf '\033[0;34m                           Detected OS:                          \033[0m\n'
            printf '\033[0;35m                             ~%s                         \033[0m\n' "$HOST_OS_TYPE"
            printf '\033[0;34m               AutoKernel System Environment Selector            \033[0m\n'
            printf '\033[0;36m=================================================================\033[0m\n'
            printf '\033[1;33mSelect Target Environment:\033[0m\n'
            echo "  0) Linux-based (Distro)"
            echo "  1) Unix-based (MacOS)"
            echo "  2) NT-based (Windows)"
            printf '\033[0;36m-----------------------------------------------------------------\033[0m\n'
            read -r -p "Select OS [0-2, default $HOST_OS_TYPE]: " os_choice_input
            os_choice_input="${os_choice_input:-$default_os_choice}"
            case "$os_choice_input" in
                0) TARGET_OS="linux"; OS_SEC="Linux" ;;
                2) TARGET_OS="windows"; OS_SEC="Win" ;;
                *) TARGET_OS="unix"; OS_SEC="Unix" ;;
            esac
            ;;
    esac
    export TARGET_OS OS_SEC

    # Everything below this point is deliberately scoped under OS_Selector().
    # The installer and portable-symlink behaviors are boot-environment logic,
    # not independent menu subsystems.

    _autokernel_user_home() {
        if [[ -n "${SUDO_USER:-}" && "${SUDO_USER}" != "root" ]]; then
            if command -v getent >/dev/null 2>&1; then
                getent passwd "$SUDO_USER" 2>/dev/null | cut -d: -f6 | head -n1
            elif [[ "$TARGET_OS" == "unix" ]] && command -v dscl >/dev/null 2>&1; then
                dscl . -read "/Users/$SUDO_USER" NFSHomeDirectory 2>/dev/null | awk '{print $2}'
            else
                printf '%s\n' "${HOME:-$AUTOKERNEL_DIR}"
            fi
        else
            printf '%s\n' "${HOME:-$AUTOKERNEL_DIR}"
        fi
    }

    # ------------------------------------------------------------------------
    # Installation lifecycle journal.
    # .autokernel-install is human-readable history + install/update landmark.
    # ------------------------------------------------------------------------
    autokernel_install_log() {
        local action="${1:-UNKNOWN}" result="${2:-UNKNOWN}"
        local source="${3:-}" target="${4:-}" detail="${5:-}"
        local stamp journal target_journal
        stamp="$(date -Is 2>/dev/null || date '+%Y-%m-%dT%H:%M:%S')"
        journal="${AUTOKERNEL_INSTALL_JOURNAL:-${AUTOKERNEL_WORKSPACE:-$AUTOKERNEL_DIR}/.autokernel-install}"
        mkdir -p "$(dirname "$journal")" 2>/dev/null || true
        {
            echo
            echo "[$stamp]"
            echo "ACTION=$action"
            echo "RESULT=$result"
            echo "HOST_OS_TYPE=$HOST_OS_TYPE"
            echo "TARGET_OS=$TARGET_OS"
            echo "OS_SEC=$OS_SEC"
            [[ -n "$source" ]] && echo "SOURCE=$source"
            [[ -n "$target" ]] && echo "TARGET=$target"
            [[ -n "$detail" ]] && echo "DETAIL=$detail"
        } >> "$journal" 2>/dev/null || true

        if [[ -n "$target" && "$target" == */AutoKernel ]]; then
            target_journal="$(dirname "$target")/.autokernel-install"
            if [[ "$target_journal" != "$journal" ]]; then
                mkdir -p "$(dirname "$target_journal")" 2>/dev/null || true
                {
                    echo
                    echo "[$stamp]"
                    echo "ACTION=$action"
                    echo "RESULT=$result"
                    echo "HOST_OS_TYPE=$HOST_OS_TYPE"
                    echo "TARGET_OS=$TARGET_OS"
                    echo "OS_SEC=$OS_SEC"
                    [[ -n "$source" ]] && echo "SOURCE=$source"
                    echo "TARGET=$target"
                    [[ -n "$detail" ]] && echo "DETAIL=$detail"
                } >> "$target_journal" 2>/dev/null || true
            fi
        fi
    }

    autokernel_latest_install_target() {
        local journal="${AUTOKERNEL_INSTALL_JOURNAL:-${AUTOKERNEL_WORKSPACE:-$AUTOKERNEL_DIR}/.autokernel-install}"
        [[ -f "$journal" ]] || return 1
        awk '
            /^\[/ { action=""; result=""; target="" }
            /^ACTION=/ { action=substr($0,8) }
            /^RESULT=/ { result=substr($0,8) }
            /^TARGET=/ { target=substr($0,8) }
            {
                if (result=="SUCCESS" && target!="" &&
                    (action=="INSTALL" || action=="REINSTALL" ||
                     action=="REPAIR" || action=="UPDATE")) latest=target
            }
            END { if (latest!="") print latest }
        ' "$journal"
    }

    _autokernel_copy_or_repair() {
        local installed="$1" answer=""
        AUTOKERNEL_INSTALL_ACTION="INSTALL"
        if [[ -e "$installed" ]] && [[ "$installed" -ef "$AUTOKERNEL_PATH" ]] 2>/dev/null; then
            AUTOKERNEL_INSTALL_ACTION="REPAIR"
            echo "[AutoKernel] Existing installation detected at $installed"
            echo "[AutoKernel] Repairing launcher / OS integration without copying onto itself."
            chmod +x "$installed" 2>/dev/null || true
            return 0
        fi
        if [[ -e "$installed" ]]; then
            AUTOKERNEL_INSTALL_ACTION="REINSTALL"
            read -r -p "Existing $installed found. Replace it? [y/N]: " answer
            [[ "${answer,,}" == y || "${answer,,}" == yes ]] || return 1
        fi
        cp "$AUTOKERNEL_PATH" "$installed" || return 1
        chmod +x "$installed" 2>/dev/null || true
    }

    _autokernel_finish_install() {
        local installed="$1" install_dir="$2"; shift 2
        autokernel_install_log "$AUTOKERNEL_INSTALL_ACTION" "SUCCESS" \
            "$AUTOKERNEL_PATH" "$installed" "native launcher integration refreshed"
        if [[ "${AUTOKERNEL_INSTALL_CALLER:-menu}" == "boot" ]]; then
            AUTOKERNEL_WORKSPACE="$install_dir"
            AUTOKERNEL_INSTALL_JOURNAL="$install_dir/.autokernel-install"
            export AUTOKERNEL_WORKSPACE AUTOKERNEL_INSTALL_JOURNAL
            echo "[AutoKernel] Restarting from installed copy..."
            exec "$installed" "$@"
        fi
    }

    install_autokernel_linux() {
        local user_home default_dir install_dir installed wrapper desktop_dir desktop_file answer
        user_home="$(_autokernel_user_home)"
        default_dir="$user_home/AutoKernel"
        read -r -p "Install AutoKernel directory [default: $default_dir]: " install_dir
        install_dir="${install_dir:-$default_dir}"
        mkdir -p "$install_dir" || return 1
        installed="$install_dir/AutoKernel"

        _autokernel_copy_or_repair "$installed" || {
            autokernel_install_log "INSTALL" "CANCELLED" "$AUTOKERNEL_PATH" "$installed" "user declined replacement or copy failed"
            return 1
        }

        wrapper="$install_dir/LaunchAutoKernel.sh"
        cat > "$wrapper" <<EOF_AK_LINUX
#!/bin/bash
AK_INSTALLED=$(printf '%q' "$installed")
if command -v gnome-terminal >/dev/null 2>&1; then
    exec gnome-terminal -- bash -lc "sudo \"\$AK_INSTALLED\"; exec bash"
elif command -v konsole >/dev/null 2>&1; then
    exec konsole -e bash -lc "sudo \"\$AK_INSTALLED\"; exec bash"
elif command -v xfce4-terminal >/dev/null 2>&1; then
    exec xfce4-terminal --command="bash -lc 'sudo \"\$AK_INSTALLED\"; exec bash'"
elif command -v x-terminal-emulator >/dev/null 2>&1; then
    exec x-terminal-emulator -e bash -lc "sudo \"\$AK_INSTALLED\"; exec bash"
else
    exec sudo "$installed"
fi
EOF_AK_LINUX
        chmod +x "$wrapper" || return 1

        desktop_dir="$user_home/.local/share/applications"
        mkdir -p "$desktop_dir" || true
        desktop_file="$desktop_dir/AutoKernel.desktop"
        cat > "$desktop_file" <<EOF_AK_DESKTOP
[Desktop Entry]
Type=Application
Name=AutoKernel
Comment=AutoKernel Development Environment
Exec=$wrapper
Icon=utilities-terminal
Terminal=false
Categories=Development;Programming;
EOF_AK_DESKTOP
        chmod +x "$desktop_file" 2>/dev/null || true
        command -v update-desktop-database >/dev/null 2>&1 && \
            update-desktop-database "$desktop_dir" >/dev/null 2>&1 || true

        echo "[AutoKernel] ${AUTOKERNEL_INSTALL_ACTION}: $installed"
        echo "[AutoKernel] Programming launcher: $desktop_file"
        _autokernel_finish_install "$installed" "$install_dir" "$@"
    }

    install_autokernel_macos() {
        local user_home default_dir install_dir installed launcher answer
        user_home="$(_autokernel_user_home)"
        default_dir="$user_home/Applications/AutoKernel"
        read -r -p "Install AutoKernel directory [default: $default_dir]: " install_dir
        install_dir="${install_dir:-$default_dir}"
        mkdir -p "$install_dir" || return 1
        installed="$install_dir/AutoKernel"

        _autokernel_copy_or_repair "$installed" || {
            autokernel_install_log "INSTALL" "CANCELLED" "$AUTOKERNEL_PATH" "$installed" "user declined replacement or copy failed"
            return 1
        }

        launcher="$install_dir/LaunchAutoKernel.command"
        cat > "$launcher" <<EOF_AK_MAC
#!/bin/bash
sudo $(printf '%q' "$installed")
printf '\nAutoKernel exited. Press return to close...'
read -r _
EOF_AK_MAC
        chmod +x "$launcher" || return 1

        echo "[AutoKernel] ${AUTOKERNEL_INSTALL_ACTION}: $installed"
        echo "[AutoKernel] macOS launcher: $launcher"
        _autokernel_finish_install "$installed" "$install_dir" "$@"
    }

    install_autokernel_windows() {
        local user_home default_dir install_dir installed cmd_wrapper start_menu ps_path win_cmd answer
        user_home="$(_autokernel_user_home)"
        default_dir="$user_home/AutoKernel"
        read -r -p "Install AutoKernel directory [default: $default_dir]: " install_dir
        install_dir="${install_dir:-$default_dir}"
        mkdir -p "$install_dir" || return 1
        installed="$install_dir/AutoKernel"

        _autokernel_copy_or_repair "$installed" || {
            autokernel_install_log "INSTALL" "CANCELLED" "$AUTOKERNEL_PATH" "$installed" "user declined replacement or copy failed"
            return 1
        }

        cmd_wrapper="$install_dir/LaunchAutoKernel.cmd"
        win_cmd="$(cygpath -w "$installed" 2>/dev/null || printf '%s' "$installed")"
        cat > "$cmd_wrapper" <<EOF_AK_WIN
@echo off
powershell -NoProfile -ExecutionPolicy Bypass -Command "Start-Process bash -Verb RunAs -ArgumentList '-lc','\"$win_cmd\"; exec bash'"
EOF_AK_WIN

        if command -v powershell.exe >/dev/null 2>&1; then
            start_menu="$(powershell.exe -NoProfile -Command '[Environment]::GetFolderPath("StartMenu")' 2>/dev/null | tr -d '\r')/Programs/Programming"
            mkdir -p "$start_menu" 2>/dev/null || true
            ps_path="$(cygpath -w "$cmd_wrapper" 2>/dev/null || printf '%s' "$cmd_wrapper")"
            powershell.exe -NoProfile -Command "\$d='$start_menu'; New-Item -ItemType Directory -Force -Path \$d | Out-Null; \$w=New-Object -ComObject WScript.Shell; \$s=\$w.CreateShortcut((Join-Path \$d 'AutoKernel.lnk')); \$s.TargetPath='$ps_path'; \$s.Save()" >/dev/null 2>&1 || true
        fi

        echo "[AutoKernel] ${AUTOKERNEL_INSTALL_ACTION}: $installed"
        echo "[AutoKernel] Windows launcher: $cmd_wrapper"
        _autokernel_finish_install "$installed" "$install_dir" "$@"
    }

    install_autokernel() {
        local caller="${1:-menu}"
        if [[ "$caller" == "boot" || "$caller" == "menu" ]]; then shift || true; else caller="menu"; fi
        AUTOKERNEL_INSTALL_CALLER="$caller"
        export AUTOKERNEL_INSTALL_CALLER
        case "$TARGET_OS" in
            linux)   install_autokernel_linux "$@" ;;
            unix)    install_autokernel_macos "$@" ;;
            windows) install_autokernel_windows "$@" ;;
            *) echo "Unsupported install target: $TARGET_OS"; return 1 ;;
        esac
    }

    ensure_autokernel_workspace_link() {
        local workspace="$1" link_path="$1/AutoKernel" target
        mkdir -p "$workspace" || return 1

        if [[ -L "$link_path" ]]; then
            target="$(readlink "$link_path" 2>/dev/null || true)"
            [[ "$target" == "$AUTOKERNEL_PATH" ]] && return 0
            rm -f "$link_path" || return 1
        elif [[ -e "$link_path" ]]; then
            echo "[AutoKernel] Existing user-owned path preserved: $link_path"
            return 0
        fi

        ln -s "$AUTOKERNEL_PATH" "$link_path" 2>/dev/null && {
            echo "[AutoKernel] Workspace reference: $link_path -> $AUTOKERNEL_PATH"
            return 0
        }

        echo "[AutoKernel] Warning: could not create workspace symlink: $link_path"
        return 1
    }

    local autokernel_origin_writable=0
    local autokernel_probe="$AUTOKERNEL_DIR/.autokernel-write-test.$$"
    local autokernel_workspace_answer=""
    local workspace_probe=""

    if : > "$autokernel_probe" 2>/dev/null; then
        rm -f "$autokernel_probe"
        autokernel_origin_writable=1
    fi

    AUTOKERNEL_ORIGIN_WRITABLE="$autokernel_origin_writable"
    export AUTOKERNEL_ORIGIN_WRITABLE
    if (( autokernel_origin_writable )); then
        AUTOKERNEL_WORKSPACE="$AUTOKERNEL_DIR"
    else
        echo
        echo "AutoKernel detected read-only source media: $AUTOKERNEL_DIR"
        echo "Enter a writable working directory, or type 'install' for a local OS-integrated installation."

        while :; do
            read -r -p "AutoKernel workspace [path/install]: " autokernel_workspace_answer

            if [[ "${autokernel_workspace_answer,,}" == install ]]; then
                install_autokernel boot "$@"
                echo "[AutoKernel] Installation did not complete."
                continue
            fi

            [[ -n "$autokernel_workspace_answer" ]] || {
                echo "Please enter a writable path or 'install'."
                continue
            }

            AUTOKERNEL_WORKSPACE="$autokernel_workspace_answer"
            mkdir -p "$AUTOKERNEL_WORKSPACE" 2>/dev/null || {
                echo "Could not create $AUTOKERNEL_WORKSPACE"
                continue
            }

            workspace_probe="$AUTOKERNEL_WORKSPACE/.autokernel-write-test.$$"
            if : > "$workspace_probe" 2>/dev/null; then
                rm -f "$workspace_probe"
                ensure_autokernel_workspace_link "$AUTOKERNEL_WORKSPACE" || true
                break
            fi

            echo "Directory is not writable: $AUTOKERNEL_WORKSPACE"
        done
    fi

    export AUTOKERNEL_WORKSPACE
    AUTOKERNEL_INSTALL_JOURNAL="$AUTOKERNEL_WORKSPACE/.autokernel-install"
    export AUTOKERNEL_INSTALL_JOURNAL
    cd "$AUTOKERNEL_WORKSPACE" || {
        echo "Unable to enter AutoKernel workspace: $AUTOKERNEL_WORKSPACE"
        exit 1
    }
    autokernel_install_log "START" "SUCCESS" "$AUTOKERNEL_PATH" "$AUTOKERNEL_PATH"         "AutoKernel booted in workspace $AUTOKERNEL_WORKSPACE"
}

