                    print(f"\n[!] {clean_name} recognized complexity. Attempting partial resolution & handoff.")
                    target = None
                    if "gemini" in output.lower() and "ARCHITECT" in active_cloud_models: target = active_cloud_models["ARCHITECT"]
                    elif "claude" in output.lower() and "REFACTOR" in active_cloud_models: target = active_cloud_models["REFACTOR"]
                    elif "chatgpt" in output.lower() and "DEBUGGER" in active_cloud_models: target = active_cloud_models["DEBUGGER"]

                    if not target: 
                        for fb in ["ARCHITECT", "DEBUGGER", "REFACTOR"]:
                            if fb in active_cloud_models:
                                target = active_cloud_models[fb]
                                break

                    if target:
                        next_name = MODEL_CONFIGS[target]["name"]
                        print(f"[-] Rerouting workflow to {next_name}...")
                        prompt = (
                            f"Original Request: {prompt}\n\n"
                            f"Local Agent ({clean_name}) attempted this but requested help. Their partial notes:\n{output}\n\n"
                            f"Please take over and complete the task. "
                            f"IMPORTANT: If the Local Agent missed a concept or workflow, use the <companion note=\"Topic Name\"> "
                            f"tag to write a brief how-to guide so they learn how to handle this for next time."
                        )
                        current_model = target
                        continue
                    else:
                        print("[!] No cloud agents available for handoff. Stopping cascade.")

                log_collaboration(current_model, task_snippet, "SUCCESS.")
                print(f"\n=== {clean_name.upper()} ===\n{output}\n==================\n")
                append_transcript(clean_name, output)

                conversation_history.append({"role": "user", "content": prompt})
                conversation_history.append({"role": "assistant", "content": output})
                if len(conversation_history) > 8: conversation_history = conversation_history[-8:]

                if capture_only:
                    return output

                # THE ROOMATE FEEDBACK LOOP
                roomate_feedback = parse_roomate_queries(output, clean_name)
                if roomate_feedback:
                    # If the agent asked the roomate something, we instantly feed the answer back in as a new prompt
                    prompt = f"[System: Local AItech IPC Response]\n{roomate_feedback}\n\nPlease proceed or analyze the roomate's response."
                    append_transcript("System", roomate_feedback)
                    continue

                if programmer_project:
                    _oc_prog_save_candidate(programmer_project,output,request=prompt,status="pending",source="generation")
                    ok,details=_oc_prog_apply_generation(programmer_project,output)
                    print(f"[PROGRAMMER/PROG] Structured generation {'APPLIED' if ok else 'REJECTED'}:")
                    for detail in details: print(f"  {detail}")
                else:
                    parse_and_execute_actions(output, clean_name)
                return output

            except Exception as e:
                error_msg = str(e).lower()
                if any(term in error_msg for term in ["quota", "rate limit", "insufficient", "429", "credit", "balance is too low"]):
                    print(f"\n[!] ALERT: {clean_name} out of credits. Disabling from pool.")
                    keys_to_remove = [k for k, v in active_cloud_models.items() if v == current_model]
                    for k in keys_to_remove: del active_cloud_models[k]
                    current_model = triage_task(prompt)
                else:
                    print(f"[!] Error: {e}")
                    if programmer_project:
                        _oc_prog_session_update(programmer_project,last_error=str(e),progress=0,progress_label="GENERATION ERROR")
                        _oc_prog_gui(programmer_project,0,"GENERATION ERROR",output=str(e),error=str(e))
                    return None
        return None

