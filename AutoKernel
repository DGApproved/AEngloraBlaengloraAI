                    3) read -r -p "Active project path: " v; ak41_set_conf project_path "$v"; ak41_publish_all ;;
                    4) read -r -p "Custom GUI / game-engine path: " v; ak41_set_conf engine_path "$v"; ak41_publish_all ;;
                    5) read -r -p "GoddessMatrix source root: " v; ak41_set_conf goddessmatrix_root "$v"; ak41_publish_all ;;
