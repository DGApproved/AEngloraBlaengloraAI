# RICHER TEXT DECAY (line count + end-char metadata, semantic prefix embedding)
# =============================================================================
def generate_text_decay_records(text_path, filename, decay_unit, decay_value, is_percentage):
    """
    Extended text decay that embeds semantic role prefix, line count, and
    end-char/word-count metadata in each record — mirroring the richer format
    from train_base_multimodal_decayv2.py.

    Also handles Goddess Matrix hex dump files transparently.
    """
    records = []
    try:
        with open(text_path, "r", encoding="utf-8", errors="ignore") as f:
            raw = f.read().strip()
    except OSError:
        return records
    if not raw:
        return records

    # Decode hex dumps before training on them
    if is_hex_dump(raw):
        raw = decode_hex_dump(raw)

    spec       = semantic_spec(filename)
    role_pfx   = semantic_prefix(filename)
    role       = spec.get("role", "GENERAL_TEXT") if spec else "GENERAL_TEXT"
    update_gui_chat("SYS", f"training reads {filename} as {role}")

    if decay_unit == "single":
        records.append(
            f"User: Analyze {filename}\nAssistant: {role_pfx}"
            f"[FILE: {filename}] [MODE: SINGLE] TEXT_START {raw} TEXT_END"
        )
        print(f"  Text '{filename}': 1 step (single pass)")
        write_progress(5, f"INGESTED: {filename}")

    elif decay_unit == "char":
        total   = len(raw)
        step    = max(1, int(total * (decay_value / 100.0))) if is_percentage else decay_value
        for length in range(total, 0, -step):
            substr     = raw[:length]
            end_char   = raw[length - 1] if length > 0 else ""
            line_count = substr.count("\n") + 1
            records.append(
                f"User: Analyze {filename} length {length}\nAssistant: {role_pfx}"
                f"[FILE: {filename}] [CHAR_LEN: {length}/{total}] "
                f"[LINE_COUNT: {line_count}] [END_CHAR: '{end_char}'] "
                f"TEXT_START {substr} TEXT_END"
            )
        print(f"  Text '{filename}' ({total} chars): {len(records)} char steps")
        write_progress(5, f"INGESTED: {filename} ({len(records)} char steps)")

    elif decay_unit == "word":
        words = raw.split()
        total = len(words)
        step  = max(1, int(total * (decay_value / 100.0))) if is_percentage else decay_value
        for length in range(total, 0, -step):
            substr     = " ".join(words[:length])
            line_count = substr.count("\n") + 1
            records.append(
                f"User: Analyze {filename} words {length}\nAssistant: {role_pfx}"
                f"[FILE: {filename}] [WORD_LEN: {length}/{total}] "
                f"[LINE_COUNT: {line_count}] TEXT_START {substr} TEXT_END"
            )
        print(f"  Text '{filename}' ({total} words): {len(records)} word steps")
        write_progress(5, f"INGESTED: {filename} ({len(records)} word steps)")

    return records

