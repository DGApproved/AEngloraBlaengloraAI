def colorize_cognition(text):
    """Gray structural/schema noise while leaving ordinary answer text prominent."""
    gray = "\033[90m"
    reset = "\033[0m"
    noise_pattern = (
        r'(\[.*?\]|<.*?>|^#.*|\b\d{4}-\d{2}-\d{2}(?:T\S+)?\b|'
        r'\S+\.(?:txt|json|md|xtx|code)\b|'
        r'\b(?:TEXT_START|TEXT_END|TEXT_ENDINGLE|SINGLE|MODE|Assistant|User|NOQ|'
        r'Qwen|Inferred|concept|semantic|store|Dynamically|discovered|evolve|writes|'
        r'Purpose|Role|reorganization|Translated|events|unresolved|details|context|'
        r'provenance)\b)'
    )
    return re.sub(
        noise_pattern,
        lambda match: f"{gray}{match.group(0)}{reset}",
        str(text),
        flags=re.IGNORECASE | re.DOTALL | re.MULTILINE,
    )


