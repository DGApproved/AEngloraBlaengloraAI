def index_reference_only_source(path,relpath,policy):
    rec={"path":"session.noq/"+relpath,"reason":policy.get("reason",""),"license_file":policy.get("license_file",""),
         "license_id":policy.get("license_id",""),"source_state":policy.get("source_state","REFERENCE_ONLY"),
         "extension":policy.get("media_extension",""),"sha256":"","line_fingerprints":[],
         "index_complete":False,"indexed_bytes":0,"total_bytes":0}
    try:
        h=hashlib.sha256()
        with open(path,"rb") as f:
            while True:
                chunk=f.read(1024*1024)
                if not chunk: break
                h.update(chunk)
        rec["sha256"]=h.hexdigest()
    except OSError: pass
    try:
        rec["total_bytes"]=os.path.getsize(path)
    except OSError:
        rec["total_bytes"]=0
    rec["indexed_bytes"]=min(rec["total_bytes"],4_000_000) if rec["total_bytes"] else 0
    rec["index_complete"]=bool(rec["total_bytes"] and rec["total_bytes"] <= 4_000_000)
    body=_source_prefix_text(path,4_000_000)
    if body:
        page=1
        for line_no,line in enumerate(body.splitlines(),1):
            if "\f" in line: page += line.count("\f")
            norm=re.sub(r"\s+"," ",line).strip()
            if len(norm)<12: continue
            rec["line_fingerprints"].append({"page_hint":page,"line":line_no,"sha256":hashlib.sha256(norm.encode("utf-8",errors="ignore")).hexdigest()})
            if len(rec["line_fingerprints"])>=10000: break
    try:
        with open(_reference_index_path(),"a",encoding="utf-8") as f: f.write(json.dumps(rec,sort_keys=True)+"\n")
    except OSError: pass

