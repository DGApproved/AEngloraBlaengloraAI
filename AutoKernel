            sys.stdout.write(f"\r\033[K[KE->Qwen] {thought[:50]}...\n")
            source_reference = _recent_source_notebook_reference(max_chars=1600)
            qwen_prompt = (source_reference + "\n" + thought) if source_reference else thought
            qwen_reply = ping_qwen(qwen_prompt)
            _append_qwen_source_interpretation(qwen_reply, thought)
            sys.stdout.write(f"[Qwen->KE] {qwen_reply}\n")
            sys.stdout.flush()
            log = (f"\n[{time.strftime('%Y-%m-%dT%H:%M:%S')}] "
                   f"KE: {thought}\nQwen: {qwen_reply}\n")
            session_history += log
            append_memory_file(CHAT_LOG, log,
