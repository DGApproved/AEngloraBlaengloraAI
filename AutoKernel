        v_desc = tokenizer.decode(v_out[0][v_in['input_ids'].shape[1]:], skip_special_tokens=True).strip().replace('\n', ' ')

        a_in = tokenizer("User: Generate a brief description of the auditory soundscape or frequency in your current dream.\nAssistant:", return_tensors="pt").to(device)
        with torch.no_grad():
