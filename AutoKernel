def _build_llama_with_llamacpp(hf_dir, out_path, quant):
    """
    Convert a Llama HF checkpoint to GGUF using llama.cpp's converter.
    Runs as a subprocess so stdout streams live to the terminal.
    """
    converter = _find_llama_converter()
    if not converter:
        _err("llama.cpp converter not found. Clone llama.cpp and place "
             "convert_hf_to_gguf.py in the search path.")
        return False
    cmd = [sys.executable, converter, str(hf_dir),
           "--outtype", quant,
           "--outfile", str(out_path)]
    _info(f"Running: {' '.join(cmd)}")
    try:
        result = subprocess.run(cmd, check=True)
        return result.returncode == 0
    except subprocess.CalledProcessError as e:
        _err(f"Converter exited with code {e.returncode}")
        return False
    except FileNotFoundError:
        _err("python3 / converter not found")
        return False

def _build_gpt2_to_gguf(hf_dir, out_path):
    """
    Write a GPT2 HuggingFace checkpoint directly into GGUF format using
    the gguf Python package.  llama.cpp does not support GPT2 natively,
    so this path uses gguf.GGUFWriter to emit tensors in F16 precision.

    The resulting GGUF is loadable by gguf-compatible runtimes that
    support the gpt2 architecture key.
    """
    if not (GGUF_AVAILABLE and TORCH_AVAILABLE and HF_AVAILABLE):
        _err("Requires: gguf, torch, transformers. "
             "pip install gguf torch transformers")
        return False

    _info("Loading GPT2 checkpoint …")
    tok   = GPT2Tokenizer.from_pretrained(str(hf_dir))
    model = GPT2LMHeadModel.from_pretrained(str(hf_dir))
    cfg   = model.config

    writer = gguf.GGUFWriter(str(out_path), arch="gpt2")

    # ── Metadata ──────────────────────────────────────────────────────────
    writer.add_name(Path(hf_dir).name)
    writer.add_description(f"GPT2 knowledge engine — {Path(hf_dir).name}")
    writer.add_file_type(gguf.LlamaFileType.MOSTLY_F16)

    writer.add_uint32("gpt2.context_length",      cfg.n_positions)
    writer.add_uint32("gpt2.embedding_length",     cfg.n_embd)
    writer.add_uint32("gpt2.feed_forward_length",  cfg.n_inner or cfg.n_embd * 4)
    writer.add_uint32("gpt2.block_count",          cfg.n_layer)
    writer.add_uint32("gpt2.attention.head_count", cfg.n_head)
    writer.add_float32("gpt2.attention.layer_norm_epsilon",
                       cfg.layer_norm_epsilon if hasattr(cfg, "layer_norm_epsilon") else 1e-5)
    writer.add_uint32("tokenizer.ggml.model", 0)

    # Vocab
    tokens = [tok.convert_tokens_to_string([tok.convert_ids_to_tokens(i)])
              for i in range(cfg.vocab_size)]
    writer.add_token_list(tokens)
    writer.add_uint32("tokenizer.ggml.bos_token_id",
                      tok.bos_token_id or 0)
    writer.add_uint32("tokenizer.ggml.eos_token_id",
                      tok.eos_token_id or 0)

    writer.write_header_to_file()
    writer.write_kv_data_to_file()

    # ── Tensors ───────────────────────────────────────────────────────────
    _info("Writing tensors (F16) …")
    sd   = model.state_dict()
    total = len(sd)
    for i, (name, tensor) in enumerate(sd.items()):
        t16 = tensor.to(torch.float16).numpy()
        writer.write_tensor_to_file(
            gguf.GGUFTensor(name=name, data=t16)
        )
        _write_progress(int((i + 1) / total * 90), f"tensor {i+1}/{total}")
        if (i + 1) % 20 == 0:
            sys.stdout.write(f"\r    {i+1}/{total} tensors …")
            sys.stdout.flush()

    writer.write_tensors_to_file()
    writer.close()
    sys.stdout.write("\n")
    return True

