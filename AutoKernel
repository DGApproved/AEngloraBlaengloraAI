def scan_plugins():
    """
    Build a plain-text reference note describing detected plugin tools.
    DIRECTION: this is discovery/documentation only; execution policy remains
    separate so adding a plugin cannot silently grant it authority.
    """
    registry = "# Plugin Notes — registry of detected .code and .xtx tools\n\n"
    registry += "Detected tools may be referenced by later AItech/GoddessMatrix layers.\n\n"

    for category, path in [("TOOLS", TOOLS_DIR), ("Instruments", Instruments_DIR),
                           ("SELF-TOOLS", SELF_TOOLS_DIR)]:
        registry += f"## {category}\n"
        count = 0
        if os.path.exists(path):
            for filename in sorted(os.listdir(path)):
                if filename.endswith(".code"):
                    registry += f"- {filename} (Executable Logic)\n"
                    base = filename.replace("play", "").replace(".code", "")
                    xtx_file = f"{base}.xtx"
                    if os.path.exists(os.path.join(path, xtx_file)):
                        registry += f"  > Linked Data File: {xtx_file}\n"
                    count += 1
        if count == 0: registry += "  (None detected)\n"

    try:
        with open(NOTES_XTX, "w", encoding="utf-8") as f: f.write(registry)
    except OSError: pass

def execute_plugin(plugin_name, args="", timeout=30):
    """Locates and executes a .code plugin, returning its standard output.

    timeout defaults to the original 30-second failsafe, so every existing
    caller behaves exactly as it did. Self-tools may declare a longer budget in
    their .xtx sidecar for work that legitimately takes longer than a chat turn.
    """
    target_file = f"{plugin_name}.code"
    plugin_path = None
    
    # Search the scanned registries. self-tools is appended, so tools/ and
    # Instruments/ keep priority and every existing lookup resolves as before.
    for p_dir in [TOOLS_DIR, Instruments_DIR, SELF_TOOLS_DIR]:
        candidate = os.path.join(p_dir, target_file)
        if os.path.exists(candidate):
            plugin_path = candidate
            break
            
    if not plugin_path:
        return f"[Plugin Error] '{plugin_name}' not found in tools or Instruments."
        
    try:
        # Ensure it has execution permissions
        os.chmod(plugin_path, 0o755)
        
        cmd = [plugin_path]
        if args:
            cmd.extend(args.split())
            
        sys.stdout.write(f"\n\033[1;35m[Plugin Executor] Firing hardware logic: {plugin_name}...\033[0m\n")
        update_gui_chat("SYS", f"Executing plugin: {plugin_name}")
        
        # Execute and capture the output with the caller's failsafe (default 30s)
        result = subprocess.run(cmd, capture_output=True, text=True, timeout=timeout)
        
        output = result.stdout.strip()
        err = result.stderr.strip()
        
        final_res = ""
        if output: final_res += f"Output:\n{output}\n"
        if err: final_res += f"Errors:\n{err}\n"
        
        if not final_res: final_res = "[Executed successfully with no output.]"
        return final_res
        
    except Exception as e:
        return f"[Plugin Error] Hardware failure on {plugin_name}: {e}"

# ── SEMANTIC MEMORY I/O ──────────────────────────────────────────────────────
# Training teaches these distinctions during model generation. Runtime uses the
# same schema after generation so real experience can reinforce/refine them.
try:
    with open(MEMORY_SCHEMA_JSON, "r", encoding="utf-8") as f:
        MEMORY_SEMANTICS = json.load(f).get("files", {})
except Exception:
    MEMORY_SEMANTICS = {}

def get_semantic_schema_prompt():
    """
    Generates XML instructions and the full semantic taxonomy for prompts.
    Schema (named) files are listed first and take priority.
    Gentext (dynamic) stores are listed after — they exist and can be written
    to, but the named schema files should be preferred for established content.
    """
    if not MEMORY_SEMANTICS: return ""
    schema_str = " | ".join([f"{f} ({s.get('role')})" for f, s in MEMORY_SEMANTICS.items()])
    base = (
        f"You have write access to semantic memory. To store data, use XML: "
        f"<file path=\"session.noq/dgapi/datas/filename.txt\">data</file>. "
        f"Available Stores / PRIORITY STORES (use these first): {schema_str}"
    )
    # Append gentext dynamic stores if any exist
    gentext_ext = _get_gentext_schema_prompt_str()
    return base + gentext_ext

def _get_gentext_schema_prompt_str():
    """Build the gentext portion of the schema prompt from live gentext_schema.json."""
    schema = _load_gentext_schema_safe()
    if not schema.get("files"):
        return (
            " | DYNAMIC STORES (gentext/ — invent a descriptive name to create): "
            "session.noq/dgapi/gentext/<new_name>.txt"
        )
    lines = []
    for fname, entry in sorted(schema["files"].items(),
                                key=lambda kv: kv[1].get("write_count", 0),
                                reverse=True):
        role    = entry.get("role", "GENTEXT")
        accepts = entry.get("accepts", [])
        top_kw  = ", ".join(accepts[:5]) if accepts else "evolving"
        lines.append(f"session.noq/dgapi/gentext/{fname} [{role}] top-kw: {top_kw}")
    lines.append("session.noq/dgapi/gentext/<new_name>.txt [NEW — invent descriptive name]")
    return " | DYNAMIC STORES (secondary, write if relevant): " + " ; ".join(lines)

def memory_semantics(path):
    return MEMORY_SEMANTICS.get(os.path.basename(str(path)).lower(), {})

# Compatibility names retained for imported training/decay helpers.
# The consolidated runtime uses memory_semantics() as the canonical schema
# lookup, while the older multimodal training path expects semantic_spec()
# and semantic_prefix().  Keep all three names pointed at the same live
# MEMORY_SEMANTICS dictionary so chat, training, and decay cannot drift.
def semantic_spec(path_or_name):
    return memory_semantics(path_or_name)

def semantic_prefix(path_or_name):
    spec = semantic_spec(path_or_name)
    if not spec:
        return ""
    return (
        f"[MEMORY_ROLE:{spec.get('role', 'UNCLASSIFIED')}] "
        f"[MEMORY_PURPOSE:{spec.get('purpose', '')}] "
    )

def record_memory_io(action, path, what, why, refresh=True):
    global gui_last_memory_read, gui_last_memory_store
    filename = os.path.basename(str(path))
    message = f"{filename} | {what} | WHY: {why}"

    if action == "read":
        gui_last_memory_read = message
    else:
        gui_last_memory_store = message

    if refresh:
        update_gui_stats(gui_progress_value, gui_progress_label, gui_system_message)

def read_memory_file(path, what=None, why=None, refresh=True):
    spec = memory_semantics(path)
    role = spec.get("role", "UNCLASSIFIED")
    purpose = spec.get("purpose", "explicitly requested file read")
    what = what or role
    why = why or purpose

    with open(path, "r", encoding="utf-8", errors="ignore") as f:
        content = f.read()

    record_memory_io("read", path, what, why, refresh=refresh)

    # Reads reinforce importance more gently than writes.
    if os.path.basename(str(path)) != os.path.basename(MEMORY_WEIGHTS_TXT):
        update_memory_weights(path, content, multiplier=0.10, reason=what)

    return content

def _log_write_to_ledger(file_path, content, source="chat_engine"):
    """
    Record a semantic file write in the shared collision ledger.

    The orchestrator reads this ledger and compares concurrent writes from
    both engines. The training model (this engine) is always ground truth —
    if the orchestrator wrote a conflicting value, Qwen autocorrects it to
    show the training model's term with the orchestrator's term in parentheses.

    Ledger entries are pruned automatically by the orchestrator; this function
    only appends. Thread safety is provided by a simple try/except on the
    JSON load — last writer wins on the file itself, which is acceptable for
    a low-frequency audit log.
    """
    import hashlib
    entry = {
        "file":         str(file_path),
        "content_head": content[:300],
        "content_hash": hashlib.md5(
            content.encode("utf-8", errors="ignore")
        ).hexdigest()[:12],
        "source":       source,
        "timestamp":    time.time(),
        "resolved":     False,
    }
    try:
        existing = []
        if os.path.exists(COLLISION_LEDGER):
            with open(COLLISION_LEDGER, "r", encoding="utf-8") as f:
                existing = json.load(f)
        # Prune entries older than 60 seconds to keep the ledger small
        cutoff = time.time() - 60.0
        existing = [e for e in existing if e.get("timestamp", 0) > cutoff]
        existing.append(entry)
        tmp = COLLISION_LEDGER + ".chat_tmp"
        os.makedirs(os.path.dirname(COLLISION_LEDGER), exist_ok=True)
        with open(tmp, "w", encoding="utf-8") as f:
            json.dump(existing, f)
        os.replace(tmp, COLLISION_LEDGER)
    except Exception:
        pass  # never block a write for a ledger failure


def append_memory_file(path, text, what=None, why=None, refresh=True):
    """
    Append only when the caller identifies what is being stored and why.

    CONTRACT:
    This helper does not invent a destination. The caller must already have
    selected the semantically correct named file.
    """
    spec = memory_semantics(path)
    role = spec.get("role", "UNCLASSIFIED")
    purpose = spec.get("purpose", "explicitly selected destination")
    what = what or role
    why = why or purpose

    os.makedirs(os.path.dirname(path), exist_ok=True)
    with open(path, "a", encoding="utf-8") as f:
        f.write(text)

    record_memory_io("store", path, what, why, refresh=refresh)

    # Semantic token importance is maintained alongside ordinary named memory.
    if os.path.basename(str(path)) != os.path.basename(MEMORY_WEIGHTS_TXT):
        update_memory_weights(path, text, multiplier=1.0, reason=what)

    # Log this write to the shared collision ledger so the orchestrator can
    # compare it against concurrent writes from the cloud agent loop.
    # This engine is always ground truth — the orchestrator defers to us.
    _log_write_to_ledger(path, text, source="chat_engine")

    # ENTROPY PRESSURE CONTRACT:
    # A trash write marks unresolved entropy as dirty, but the active operating
    # mode decides whether that entropy should immediately shrink, be held, or
    # be allowed to accumulate. This preserves trash.xtx as a useful signal of
    # unresolved cognitive load rather than treating it as a conventional bin.
    if os.path.basename(str(path)).lower() == os.path.basename(TRASH_XTX).lower():
        try:
            TRASH_WAKE_REASON.append(what or "trash routing")
            TRASH_WAKE_EVENT.set()
            update_gui_chat("SYS", "trash.xtx changed -> entropy pressure update")
        except Exception:
            pass

def _tokenize_weight_words(text):
    """
    Convert memory text into normalized word tokens for the local importance ledger.

    WHY:
    weights.txt is not model weights. It is a human-readable semantic ledger that
    records how frequently/strongly words occur inside each named memory store.
    """
    return re.findall(r"[A-Za-z0-9_'-]+", text.lower())


def _load_weight_ledger():
    ledger = {}
    current = None

    if not os.path.exists(MEMORY_WEIGHTS_TXT):
        return ledger

    try:
        with open(MEMORY_WEIGHTS_TXT, "r", encoding="utf-8", errors="ignore") as f:
            for raw in f:
                line = raw.strip()
                if not line:
                    continue
                if line.startswith("[") and line.endswith("]"):
                    current = line[1:-1]
                    ledger.setdefault(current, {})
                    continue
                if current and "\t" in line:
                    word, value = line.split("\t", 1)
                    try:
                        ledger[current][word] = float(value)
                    except ValueError:
                        # A non-numeric value is a STATE MARKER, not a weight.
                        # <computed> marks a sheared entry: settled, nothing left
                        # to solve for. Preserve it verbatim rather than dropping
                        # the line, or the marker would vanish on the next save.
                        ledger[current][word] = value.strip()
    except Exception:
        pass

    return ledger


def _save_weight_ledger(ledger):
    """
    Rewrite weights.txt deterministically so each memory file has its own header.
    Uses a thread-safe unique temp file to prevent race conditions.

    Format:
      [dictionary.txt]
      a<TAB>1
      b<TAB>2
    """
    tmp = f"{MEMORY_WEIGHTS_TXT}.{threading.get_ident()}.tmp"
    os.makedirs(os.path.dirname(MEMORY_WEIGHTS_TXT), exist_ok=True)
    with open(tmp, "w", encoding="utf-8") as f:
        f.write(
            "# AItech localized semantic token-importance ledger\n"
            "# Each section corresponds to one named memory file.\n"
            "# Values are local importance weights, not neural-network parameters.\n\n"
        )
        for filename in sorted(ledger.keys()):
            f.write(f"[{filename}]\n")
            items = sorted(ledger[filename].items(), key=_ledger_sort_key)
            for word, value in items:
                if isinstance(value, str):
                    value_text = value          # state marker, e.g. <computed>
                elif float(value).is_integer():
                    value_text = str(int(value))
                else:
                    value_text = f"{value:.4f}".rstrip("0").rstrip(".")
                f.write(f"{word}\t{value_text}\n")
            f.write("\n")

    os.replace(tmp, MEMORY_WEIGHTS_TXT)


# ── COMPUTATION-BASED AGING ───────────────────────────────────────────────────
# Age here is measured in COMPUTATIONS, not in wall-clock time.
#
# One computation is one user prompt processed through the terminal front end.
# Counting in computations rather than dates means age describes how much
# thinking has happened since a thing was written, which is what actually
# matters to a model deciding whether something is still current. It is also
# stable across timezone changes, DST, clock skew, and long idle periods: a
# machine left off for a month has aged nothing, because it processed nothing.
#
# A creation DATE is still recorded per file as a starting reference, so
# absolute time stays recoverable when a human needs it.
#
# All of this lives in weights.txt, which already holds per-file token
# importance. The new sections are @-prefixed so they can never collide with a
# memory filename, and each holds one flat float per key, which is exactly what
# the existing two-column parser expects. No semantic memory file is touched.
#
#   [@computations]  now = current tick, genesis = epoch seconds when counting began
#   [@born]          tick at which a file, entry or token was first seen
#   [@borndate]      epoch-second creation reference (file level only)
#   [@seen]          tick of last access
#   [@uses]          how many times touched
#
# Key shapes:  facts.txt              a memory file
#              facts.txt::cheesecake  a token inside that file
#              facts.txt::#a1b2c3d4   an entry inside that file (content hash)
COMPUTATION_COUNTER_PATH = os.path.join(SYSTEM_DIR, "computations.txt")
AGE_META_SECTION = "@computations"
AGE_BORN_SECTION = "@born"
AGE_DATE_SECTION = "@borndate"
AGE_SEEN_SECTION = "@seen"
AGE_USES_SECTION = "@uses"
AGE_SECTIONS = (AGE_META_SECTION, AGE_BORN_SECTION, AGE_DATE_SECTION,
                AGE_SEEN_SECTION, AGE_USES_SECTION)


def computation_now():
    """Current computation tick. 0 before the first prompt is processed."""
    try:
        with open(COMPUTATION_COUNTER_PATH, "r", encoding="utf-8", errors="ignore") as f:
            for line in f:
                line = line.strip()
                if line and not line.startswith("#"):
                    return int(float(line.split()[0]))
    except Exception:
        pass
    return 0


def computation_tick():
    """Advance the clock by one. Called once per user prompt, by the front end."""
    n = computation_now() + 1
    try:
        os.makedirs(os.path.dirname(COMPUTATION_COUNTER_PATH), exist_ok=True)
        tmp = f"{COMPUTATION_COUNTER_PATH}.{os.getpid()}.{threading.get_ident()}.tmp"
        with open(tmp, "w", encoding="utf-8") as f:
            f.write(f"{n}\n")
            f.write("# AItech computation counter.\n")
            f.write("# One computation = one user prompt processed through the terminal front end.\n")
            f.write("# Memory age in weights.txt is measured against this counter, not against dates.\n")
        os.replace(tmp, COMPUTATION_COUNTER_PATH)
    except Exception:
        return n
    return n


def entry_key(text):
    """Stable identity for one memory entry, used as filename::#hash."""
    import hashlib
    digest = hashlib.md5((text or "").strip().encode("utf-8", errors="ignore")).hexdigest()
    return "#" + digest[:12]


def _age_key(filename, key=None):
    return filename if key is None else f"{filename}::{key}"


def _ledger_sort_key(kv):
    """Numeric weights first by descending value; state markers after, by name."""
    value = kv[1]
    if isinstance(value, str):
        return (1, 0.0, kv[0])
    return (0, -float(value), kv[0])


# ── SHEARING ──────────────────────────────────────────────────────────────────
# Weights are like a sheep's hair: they keep growing, and what has stopped
# growing should be trimmed rather than carried at full length forever.
#
# An entry is COMPUTATIONALLY COMPLETE when nothing is left to solve for -- every
# piece of memory it refers to has been resolved adequately and no new computation
# has disturbed it for a quiet stretch. At that point its creation date is no
# longer doing any work, because the entry is not going anywhere: the date is
# trimmed away and replaced by the marker <computed>.
#
# The trim is reversible, and that is the point. When a later computation would
# MODIFY a sheared entry, the <computed> marker is replaced by a fresh creation
# date and its birth tick is reset to now. The entry starts aging again from the
# moment it became unsettled, not from when it was first written. Age therefore
# measures time-since-last-unsettled in computations, which is what "how current
# is this" actually means for a thought.
#
# Reads do not un-shear. Only a modifying write does, so consulting a settled
# entry leaves it settled.
COMPUTED_TAG = "<computed>"
# Computations of stillness before an entry is considered settled.
SHEAR_QUIESCENCE = 50


def is_computed(filename, key=None, ledger=None):
    """True when this key has been sheared and nothing is outstanding for it."""
    ledger = _load_weight_ledger() if ledger is None else ledger
    return ledger.get(AGE_DATE_SECTION, {}).get(_age_key(filename, key)) == COMPUTED_TAG


def mark_computed(ledger, filename, key=None):
    """Shear: trim the creation date down to the <computed> marker."""
    k = _age_key(filename, key)
    if k not in ledger.get(AGE_BORN_SECTION, {}):
        return False
    dates = ledger.setdefault(AGE_DATE_SECTION, {})
    if dates.get(k) == COMPUTED_TAG:
        return False
    dates[k] = COMPUTED_TAG
    return True


def clear_computed(ledger, filename, key, now):
    """Regrow: a modifying computation re-stamps a sheared entry with a date."""
    k = _age_key(filename, key)
    dates = ledger.setdefault(AGE_DATE_SECTION, {})
    if dates.get(k) != COMPUTED_TAG:
        return False
    dates[k] = float(int(time.time()))
    ledger.setdefault(AGE_BORN_SECTION, {})[k] = float(now)
    return True


def _shear_settled(ledger, now, quiescence=None):
    """Trim every key that has gone quiet. Runs during an ordinary ledger save.

    Kept inside the engine's own atomic save rather than run by the daemon, so
    there is never a second writer racing the ledger. The daemon reports the
    flock; the engine does the shearing.
    """
    quiescence = SHEAR_QUIESCENCE if quiescence is None else quiescence
    seen = ledger.get(AGE_SEEN_SECTION, {})
    dates = ledger.setdefault(AGE_DATE_SECTION, {})
    trimmed = 0
    for k, last in list(seen.items()):
        if dates.get(k) == COMPUTED_TAG:
            continue
        try:
            idle = now - int(last)
        except (TypeError, ValueError):
            continue
        if idle >= quiescence:
            dates[k] = COMPUTED_TAG
            trimmed += 1
    return trimmed


def computation_boot():
    """Record a program initialization. Called once when a chat engine starts."""
    try:
        ledger = _load_weight_ledger()
        meta = ledger.setdefault(AGE_META_SECTION, {})
        now = computation_now()
        meta["now"] = float(now)
        meta["total"] = float(now)
        meta["runs"] = float(int(float(meta.get("runs", 0) or 0)) + 1)
        meta["session_start"] = float(now)
        meta.setdefault("genesis", float(int(time.time())))
        _save_weight_ledger(ledger)
        return now
    except Exception:
        return computation_now()


def computations_total():
    """Lifetime computations recorded in the ledger, across every run."""
    ledger = _load_weight_ledger()
    meta = ledger.get(AGE_META_SECTION, {})
    try:
        return int(float(meta.get("total", meta.get("now", 0)) or 0))
    except (TypeError, ValueError):
        return computation_now()


def computations_this_run():
    """Computations performed since this program initialization."""
    ledger = _load_weight_ledger()
    try:
        start = int(float(ledger.get(AGE_META_SECTION, {}).get("session_start", 0) or 0))
    except (TypeError, ValueError):
        start = 0
    return max(0, computation_now() - start)


def _stamp_age(ledger, filename, key, now, modifies=True):
    """Record first sighting, refresh last sighting, and count the use.

    modifies=False marks a read. A read refreshes last-seen but never un-shears
    a settled entry, because consulting something is not the same as changing it.
    """
    k = _age_key(filename, key)
    born = ledger.setdefault(AGE_BORN_SECTION, {})
    if k not in born:
        born[k] = float(now)
        if key is None:
            # Creation date is a starting reference, kept at file level only so
            # the ledger does not carry a timestamp per token.
            ledger.setdefault(AGE_DATE_SECTION, {})[k] = float(int(time.time()))
    elif modifies:
        # A modifying computation regrows a sheared entry: the <computed> marker
        # becomes a fresh creation date and the birth tick resets to now.
        clear_computed(ledger, filename, key, now)
    ledger.setdefault(AGE_SEEN_SECTION, {})[k] = float(now)
    uses = ledger.setdefault(AGE_USES_SECTION, {})
    uses[k] = uses.get(k, 0.0) + 1.0


def _stamp_meta(ledger, now):
    meta = ledger.setdefault(AGE_META_SECTION, {})
    meta["now"] = float(now)
    meta["total"] = float(now)          # lifetime computations across every run
    meta.setdefault("runs", 1.0)        # program initializations recorded
    meta.setdefault("session_start", 0.0)
    meta.setdefault("genesis", float(int(time.time())))


def age_in_computations(filename, key=None, ledger=None):
    """How many computations have been processed since this was created."""
    ledger = _load_weight_ledger() if ledger is None else ledger
    born = ledger.get(AGE_BORN_SECTION, {}).get(_age_key(filename, key))
    if born is None:
        return None
    return max(0, computation_now() - int(born))


def computations_since_access(filename, key=None, ledger=None):
    """How many computations have been processed since this was last touched."""
    ledger = _load_weight_ledger() if ledger is None else ledger
    seen = ledger.get(AGE_SEEN_SECTION, {}).get(_age_key(filename, key))
    if seen is None:
        return None
    return max(0, computation_now() - int(seen))


def weight_uses(filename, key=None, ledger=None):
    ledger = _load_weight_ledger() if ledger is None else ledger
    return int(ledger.get(AGE_USES_SECTION, {}).get(_age_key(filename, key), 0))


def created_date_reference(filename, key=None, ledger=None):
    """Epoch seconds when this was last unsettled, or None if sheared/untracked."""
    ledger = _load_weight_ledger() if ledger is None else ledger
    stamp = ledger.get(AGE_DATE_SECTION, {}).get(_age_key(filename, key))
    if stamp is None or isinstance(stamp, str):
        return None
    return int(stamp)


def weight_age_report(filename, key=None):
    """One readable line describing age in computations."""
    ledger = _load_weight_ledger()
    age = age_in_computations(filename, key, ledger)
    if age is None:
        return f"{_age_key(filename, key)}: not yet tracked"
    idle = computations_since_access(filename, key, ledger)
    uses = weight_uses(filename, key, ledger)
    parts = [f"{_age_key(filename, key)}: created {age} computation(s) ago",
             f"last touched {idle} computation(s) ago",
             f"{uses} use(s)"]
    if is_computed(filename, key, ledger):
        parts.append("state <computed> (settled; nothing left to solve for)")
    else:
        ref = created_date_reference(filename, ledger)
        if ref:
            parts.append("reference date " + time.strftime("%Y-%m-%dT%H:%M:%S", time.localtime(ref)))
    return " | ".join(parts)

def update_memory_weights(path, text, multiplier=1.0, reason="memory write", entry_text=None):
    """
    Increase the local importance of words stored/read in a specific memory file.

    The ledger is file-local:
      cheesecake can have one weight in definitions.txt and a different weight
      in almanac.txt after later reclassification.
    """
    filename = os.path.basename(str(path))
    if filename == os.path.basename(MEMORY_WEIGHTS_TXT):
        return

    tokens = _tokenize_weight_words(text)
    if not tokens:
        return

    ledger = _load_weight_ledger()
    section = ledger.setdefault(filename, {})

    for token in tokens:
        section[token] = section.get(token, 0.0) + float(multiplier)

    # Computation-based aging, recorded alongside importance in the same ledger.
    # entry_text is optional so every existing caller keeps working unchanged;
    # callers that know which entry they wrote can stamp entry-level age too.
    now = computation_now()
    # multiplier 1.0 marks a write; 0.10 marks read-reinforcement. Only a write
    # counts as a modification, so reading a settled entry leaves it settled.
    modifies = float(multiplier) >= 1.0
    _stamp_meta(ledger, now)
    _stamp_age(ledger, filename, None, now, modifies)
    for token in tokens:
        _stamp_age(ledger, filename, token, now, modifies)
    if entry_text:
        _stamp_age(ledger, filename, entry_key(entry_text), now, modifies)
    # Trim what has gone quiet, inside this same atomic save.
    _shear_settled(ledger, now)

    _save_weight_ledger(ledger)

    record_memory_io(
        "store",
        MEMORY_WEIGHTS_TXT,
        what=f"token importance for {filename}",
        why=f"trace importance of words involved in {reason}",
        refresh=False
    )


def rebuild_memory_weights():
    """
    Recompute weights.txt from the current contents of every known semantic memory.

    REFINEMENT:
    This is useful after manual edits or major reclassification so the ledger can
    be regenerated from the actual files rather than only incremental events.
    """
    # A rebuild recomputes token importance from current file contents, but the
    # aging sections describe history that cannot be recovered from contents.
    # Carry them across rather than discarding what the counter has recorded.
    _preserved_age = {}
    try:
        _existing = _load_weight_ledger()
        for _sec in AGE_SECTIONS:
            if _sec in _existing:
                _preserved_age[_sec] = _existing[_sec]
    except Exception:
        _preserved_age = {}

    ledger = {}
    ledger.update(_preserved_age)

    semantic_paths = [spec["path"] for spec in GODDESS_MEMORY_FILES]
    semantic_paths += [AMDREAM_TXT, IMAGES_TXT, AUDIO_TXT, VIDEO_TXT, TEXT_LOG_TXT]

    for path in semantic_paths:
        if not os.path.exists(path):
            continue
        filename = os.path.basename(path)
        try:
            content = read_memory_file(
                path,
                what=f"{memory_semantics(path).get('role', 'memory')} for weight rebuild",
                why="recalculate localized token importance from current stored contents",
                refresh=False
            )
        except Exception:
            continue

        words = _tokenize_weight_words(content)
        if not words:
            continue

        section = ledger.setdefault(filename, {})
        for word in words:
            section[word] = section.get(word, 0.0) + 1.0

    _save_weight_ledger(ledger)
    update_gui_stats(gui_progress_value, gui_progress_label, gui_system_message)
    return f"[Weights] Rebuilt localized token ledger for {len(ledger)} memory files."


def reclassify_memory_entry(
    source_path,
    destination_path,
    text,
    reason,
    duplicate=True,
    source_note=True,
):
    """
    Reclassify a specific piece of information after post-training understanding changes.

    duplicate=True:
      preserve the original and copy the entry to the new semantic destination.

    duplicate=False:
      copy to destination and record a source-side reclassification note. Physical
      deletion of arbitrary prose is intentionally avoided unless a future structured
      entry system can identify exact entry boundaries safely.

    EXAMPLE:
      cheesecake may first appear in definitions.txt, then later be recognized as
      culinary/reference material appropriate for almanac.txt.
    """
    src_name = os.path.basename(str(source_path))
    dst_name = os.path.basename(str(destination_path))
    dst_sem = memory_semantics(destination_path)
    src_sem = memory_semantics(source_path)
    stamp = time.strftime("%Y-%m-%dT%H:%M:%S")

    entry = (
        f"\n[RECLASSIFIED_MEMORY]\n"
        f"timestamp: {stamp}\n"
        f"source: {src_name}\n"
        f"destination: {dst_name}\n"
        f"reason: {reason}\n"
        f"mode: {'duplicate' if duplicate else 'move-intent'}\n"
        f"content: {text}\n"
        f"[/RECLASSIFIED_MEMORY]\n"
    )

    append_memory_file(
        destination_path,
        entry,
        what=f"reclassified {dst_sem.get('role', 'memory')} entry",
        why=reason
    )
    update_memory_weights(
        destination_path,
        text,
        multiplier=1.5,
        reason=f"reclassification into {dst_name}"
    )

    if source_note:
        note = (
            f"\n[RECLASSIFICATION_NOTE]\n"
            f"timestamp: {stamp}\n"
            f"destination: {dst_name}\n"
            f"reason: {reason}\n"
            f"content_reference: {text[:240]}\n"
            f"[/RECLASSIFICATION_NOTE]\n"
        )
        append_memory_file(
            source_path,
            note,
            what=f"{src_sem.get('role', 'memory')} reclassification provenance",
            why=f"record that this information was reinterpreted as {dst_name}"
        )

    return (
        f"[Memory] Reclassified '{text[:60]}' from {src_name} to {dst_name} "
        f"({'duplicated' if duplicate else 'move-intent recorded'})."
    )


