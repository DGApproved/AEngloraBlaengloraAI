def _append_jsonl(path, obj):
    try:
        os.makedirs(os.path.dirname(path), exist_ok=True)
        with open(path, "a", encoding="utf-8") as f:
            f.write(json.dumps(obj, sort_keys=True, ensure_ascii=False) + "\n")
    except OSError:
        pass


def _fingerprint_overlap(a, b):
    sa, sb = set(a or []), set(b or [])
    if not sa or not sb:
        return 0.0
    # containment rather than Jaccard: a complete later copy may add headers or
    # appendices while still containing the earlier incomplete body.
    return len(sa & sb) / max(1, min(len(sa), len(sb)))


def register_source_provenance(path, policy=None, logical_name=None, source_origin="local"):
    policy = dict(policy or classify_source_use(path, os.path.basename(path)))
    digest = _sha256_file(path)
    fingerprints = _body_fingerprints(path)
    registry = _load_source_registry()
    records = registry.setdefault("records", {})
    now = time.strftime("%Y-%m-%dT%H:%M:%S")
    record_id = "source:" + hashlib.sha256(
        ((digest or os.path.realpath(path)) + "|" + str(logical_name or os.path.basename(path))).encode("utf-8", errors="ignore")
    ).hexdigest()

    existing = records.get(record_id, {})
    history = list(existing.get("history", []))
    provenance_version = int(existing.get("provenance_version", 0) or 0) + 1
    rec = {
        "source_id": record_id,
        "logical_name": logical_name or os.path.basename(path),
        "last_path": os.path.realpath(path),
        "source_origin": source_origin,
        "sha256": digest,
        "body_fingerprints": fingerprints,
        "source_state": policy.get("source_state", "LEGACY_NORMAL"),
        "mode": policy.get("mode", "TRAIN"),
        "license_id": policy.get("license_id", ""),
        "evidence_class": policy.get("evidence_class", "NONE"),
        "evidence_value": policy.get("evidence_value", ""),
        "evidence_certainty": policy.get("evidence_certainty", "UNKNOWN"),
        "policy_source": policy.get("policy_source", ""),
        "provenance_version": provenance_version,
        "first_seen": existing.get("first_seen", now),
        "last_seen": now,
        "history": history,
    }
    rec["history"].append({
        "time": now, "event": "OBSERVED",
        "state": rec["source_state"], "mode": rec["mode"],
        "evidence_class": rec["evidence_class"], "license_id": rec["license_id"],
    })
    records[record_id] = rec

    # Retroactive correction: only a stronger, explicit new provenance state may
    # automatically revise a previously LEGACY_NORMAL record.  Similarity alone
    # never turns one unrelated work into another.
    if rec["source_state"] != "LEGACY_NORMAL":
        for old_id, old in list(records.items()):
            if old_id == record_id or old.get("source_state") != "LEGACY_NORMAL":
                continue
            exact = bool(digest and digest == old.get("sha256"))
            overlap = _fingerprint_overlap(fingerprints, old.get("body_fingerprints", []))
            enough = exact or (overlap >= 0.90 and min(len(fingerprints), len(old.get("body_fingerprints", []))) >= 3)
            if not enough:
                continue
            old_version = int(old.get("provenance_version", 1) or 1) + 1
            old.setdefault("history", []).append({
                "time": now,
                "event": "RETROACTIVE_RECLASSIFICATION",
                "matched_source_id": record_id,
                "match_overlap": overlap,
                "previous_state": "LEGACY_NORMAL",
                "new_state": rec["source_state"],
                "new_mode": rec["mode"],
                "reason": rec.get("evidence_value") or rec.get("evidence_class"),
            })
            old["source_state"] = rec["source_state"]
            old["mode"] = rec["mode"]
            old["license_id"] = rec.get("license_id", "")
            old["evidence_class"] = "RETROACTIVE_MATCH:" + rec.get("evidence_class", "")
            old["evidence_value"] = rec.get("evidence_value", "")
            old["evidence_certainty"] = "STRONGLY_DETECTED" if not exact else "DECLARED_MATCH"
            old["provenance_version"] = old_version
            old["descendants_require_review"] = True
            records[old_id] = old
            _append_jsonl(SOURCE_EVENTS_PATH, old["history"][-1])

    _save_source_registry(registry)
    _append_jsonl(SOURCE_EVENTS_PATH, {
        "time": now, "event": "SOURCE_CLASSIFIED", "source_id": record_id,
        "state": rec["source_state"], "mode": rec["mode"],
        "license_id": rec["license_id"], "evidence_class": rec["evidence_class"],
        "provenance_version": provenance_version,
    })
    return rec


def detect_chat_governance(text):
    """
    Chat stays low-friction by default.  Only explicit current-context rules
    narrow training/reference operations.
    """
    s = str(text or "")
    low = s.lower()
    if re.search(r"\b(?:do not|don't)\s+(?:use\s+(?:this|that)\s+for\s+)?train(?:ing)?\b", low) \
       or re.search(r"\breference[- ]only\b", low):
        return {"training_allowed": False, "chat_use_allowed": True,
                "reason": "user explicitly requested reference-only/no-training handling"}
    if re.search(r"\b(?:nda|confidential|private contract|under contract)\b", low) and \
       re.search(r"\b(?:this|that|following|file|work|data)\b", low):
        return {"training_allowed": False, "chat_use_allowed": True,
                "reason": "user supplied a confidentiality/contract governance cue"}
    return {"training_allowed": True, "chat_use_allowed": True,
            "reason": "no explicit chat-facing restriction supplied"}


def detect_user_declared_provenance(text):
    """Extract user assertions without upgrading them to independently verified facts."""
    s = str(text or "")
    claims = []
    models = r"(ChatGPT|Claude|Gemini|Qwen|GPT[- ]?\d+(?:\.\d+)?|Llama|Mistral|Copilot)"
    for m in re.finditer(rf"\b({models})\s+(?:made|generated|wrote|created)\s+(?:this|that|it)\b", s, re.I):
        claims.append({"authorship_class": "MODEL_GENERATED",
                       "declared_creator": m.group(1), "declared_by": "USER",
                       "confidence": "USER_ASSERTED"})
    for m in re.finditer(rf"\bI\s+(?:made|created|wrote)\s+(?:this|that|it)\s+with\s+({models})\b", s, re.I):
        claims.append({"authorship_class": "COLLABORATIVE",
                       "human_creator": "USER", "model_assistant": m.group(1),
                       "declared_by": "USER", "confidence": "USER_ASSERTED"})
    for m in re.finditer(r"\bmy friend(?:\s+([A-Z][A-Za-z0-9_.-]{1,40}))?\s+(?:made|created|wrote|generated)\s+(?:this|that|it)\b", s):
        claims.append({"authorship_class": "HUMAN_CREATED",
                       "declared_creator": m.group(1) or "UNNAMED_FRIEND",
                       "declared_by": "USER", "confidence": "USER_ASSERTED"})
    return claims


def unknown_character_encoding_map(text, max_unique=64):
    """
    Lossless fallback for characters outside AItech's native printable ASCII
    layer.  Preserve the glyph, code point, UTF-8 bytes and bits so later
    teaching can attach linguistic meaning without data loss.
    """
    seen = set()
    rows = []
    for ch in str(text or ""):
        if ch in "\n\r\t" or 0x20 <= ord(ch) <= 0x7E:
            continue
        if ch in seen:
            continue
        seen.add(ch)
        raw = ch.encode("utf-8", errors="surrogatepass")
        rows.append({
            "glyph": ch,
            "codepoint": f"U+{ord(ch):04X}",
            "utf8_hex": " ".join(f"{b:02X}" for b in raw),
            "binary": " ".join(f"{b:08b}" for b in raw),
        })
        if len(rows) >= max_unique:
            break
    if not rows:
        return ""
    lines = ["[UNRECOGNIZED_CHARACTER_ENCODING]",
             "OBSERVATION=character is outside native printable character layer; preserve before interpretation"]
    for row in rows:
        lines.append(
            f"glyph={row['glyph']} codepoint={row['codepoint']} "
            f"utf8={row['utf8_hex']} bits={row['binary']}"
        )
    lines.append("[/UNRECOGNIZED_CHARACTER_ENCODING]")
    return "\n".join(lines)


