    private static final long MAX_DOWNLOAD_BYTES = 256L * 1024L * 1024L;
    private static final DateTimeFormatter STAMP =
            DateTimeFormatter.ofPattern("yyyyMMdd-HHmmss");

    private final MatrixState state;
    private final File inboxDir;

    public Update(MatrixState state)
    {
        this.state = state;
        File root = state.aiHomeDirectory != null
                ? state.aiHomeDirectory : new File(System.getProperty("user.dir"));
        this.inboxDir = new File(root, "modular/update");
        this.inboxDir.mkdirs();
    }

    /** Left-click entry point. Toggle the transient UPDATE tab/input route. */
    public void launch()
    {
        if (state.isUpdateModeActive) {
            closeUpdateMode();
            return;
        }

        state.isUpdateModeActive = true;
        state.updateInputHook = this::submit;

        if (state.chatHistory != null) {
            state.chatHistory.showUpdateTab();
            state.chatHistory.clearUpdateView();
            state.chatHistory.appendUpdate(
                    "GODDESSMATRIX PLUGIN UPDATE INTAKE\n" +
                    "==================================\n" +
                    "Inbox: " + inboxDir.getAbsolutePath() + "\n\n" +
                    "Paste an http:// or https:// URL into the normal chatbar and press ENTER.\n" +
                    "The payload is downloaded to the inbox but is NOT automatically executed.\n\n" +
                    "Commands:\n" +
                    "  help   show this information\n" +
                    "  inbox  open the update inbox folder\n" +
                    "  clear  clear this tab\n" +
                    "  close  leave Update mode\n\n" +
                    "Right-click [Update] at any time to choose a local update file."
            );
        }
        status("SYS_UPDATE: URL_INPUT_READY");
    }

    /** Right-click entry point. Choose a local artifact and stage it in the inbox. */
    public void selectLocalUpdate()
    {
        Runnable chooserTask = () -> {
            try {
                inboxDir.mkdirs();
                JFileChooser chooser = new JFileChooser(inboxDir);
                chooser.setDialogTitle("Select GoddessMatrix Plugin Update");
                chooser.setFileSelectionMode(JFileChooser.FILES_ONLY);
                chooser.setMultiSelectionEnabled(false);

                int result = chooser.showOpenDialog(
                        state.uiWindow != null ? state.uiWindow : null);
                if (result != JFileChooser.APPROVE_OPTION) {
                    status("SYS_UPDATE: LOCAL_SELECTION_CANCELLED");
                    return;
                }

                File selected = chooser.getSelectedFile();
                if (selected == null || !selected.isFile()) {
                    reportError("LOCAL_UPDATE_INVALID: no regular file selected");
                    return;
                }

                new Thread(() -> stageLocalFile(selected),
                        "GoddessMatrix-UpdateLocalStage").start();
            } catch (Exception e) {
                reportError("LOCAL_UPDATE_CHOOSER_FAILED: " + e.getMessage());
            }
        };

        if (SwingUtilities.isEventDispatchThread()) chooserTask.run();
        else SwingUtilities.invokeLater(chooserTask);
    }

    private void submit(String raw)
    {
        String input = raw == null ? "" : raw.trim();
        if (input.isEmpty()) return;

        if (input.equalsIgnoreCase("close") || input.equalsIgnoreCase("exit")) {
            closeUpdateMode();
            return;
        }
        if (input.equalsIgnoreCase("clear")) {
            if (state.chatHistory != null) state.chatHistory.clearUpdateView();
            return;
        }
        if (input.equalsIgnoreCase("inbox")) {
            openInbox();
            return;
        }
        if (input.equalsIgnoreCase("help")) {
            if (state.chatHistory != null) {
                state.chatHistory.appendUpdate(
                        "Enter an HTTP/HTTPS URL to stage a plugin update.\n" +
                        "Nothing downloaded here is executed automatically.\n" +
                        "Right-click [Update] for local file selection."
                );
            }
            return;
        }

        if (!(input.startsWith("http://") || input.startsWith("https://"))) {
            reportError("UPDATE_INPUT_REJECTED: expected http:// or https:// URL");
            return;
        }

        if (state.chatHistory != null)
            state.chatHistory.appendUpdate("SOURCE> " + input);
        status("SYS_UPDATE: DOWNLOADING");

        new Thread(() -> downloadToInbox(input),
                "GoddessMatrix-UpdateDownload").start();
    }

    private void stageLocalFile(File source)
    {
        try {
            inboxDir.mkdirs();
            String safeName = sanitizeFilename(source.getName());
            Path target = uniqueTarget(safeName);
            Files.copy(source.toPath(), target, StandardCopyOption.COPY_ATTRIBUTES);
            reportSuccess("LOCAL_UPDATE_STAGED", target.toFile());
        } catch (Exception e) {
            reportError("LOCAL_UPDATE_STAGE_FAILED: " + e.getMessage());
        }
    }

    private void downloadToInbox(String sourceUrl)
    {
        HttpURLConnection conn = null;
        Path temp = null;
        try {
            URL url = URI.create(sourceUrl).toURL();
            conn = (HttpURLConnection) url.openConnection();
            conn.setInstanceFollowRedirects(true);
            conn.setConnectTimeout(10000);
            conn.setReadTimeout(30000);
            conn.setRequestProperty("User-Agent", "GoddessMatrix-Update/1.0");

            int code = conn.getResponseCode();
            if (code < 200 || code >= 300)
                throw new IllegalStateException("HTTP " + code);

            long declared = conn.getContentLengthLong();
            if (declared > MAX_DOWNLOAD_BYTES)
                throw new IllegalStateException("payload exceeds 256 MiB limit");

            String filename = filenameFromConnection(conn, url);
            Path finalTarget = uniqueTarget(filename);
            temp = finalTarget.resolveSibling(finalTarget.getFileName() + ".part");

            long total = 0;
            try (InputStream in = conn.getInputStream();
                 java.io.OutputStream out = Files.newOutputStream(temp)) {
                byte[] buf = new byte[8192];
                int n;
                while ((n = in.read(buf)) != -1) {
                    total += n;
                    if (total > MAX_DOWNLOAD_BYTES)
                        throw new IllegalStateException("payload exceeds 256 MiB limit");
                    out.write(buf, 0, n);
                }
            }

            try {
                Files.move(temp, finalTarget, StandardCopyOption.ATOMIC_MOVE);
            } catch (Exception atomicUnavailable) {
                Files.move(temp, finalTarget, StandardCopyOption.REPLACE_EXISTING);
            }
            temp = null;
            reportSuccess("REMOTE_UPDATE_STAGED", finalTarget.toFile());

        } catch (Exception e) {
            if (temp != null) {
                try { Files.deleteIfExists(temp); } catch (Exception ignored) {}
            }
            reportError("UPDATE_DOWNLOAD_FAILED: " + e.getMessage());
        } finally {
            if (conn != null) conn.disconnect();
        }
    }

    private String filenameFromConnection(HttpURLConnection conn, URL url)
    {
        String cd = conn.getHeaderField("Content-Disposition");
        if (cd != null) {
            for (String part : cd.split(";")) {
                String p = part.trim();
                if (p.toLowerCase().startsWith("filename=")) {
                    String value = p.substring(p.indexOf('=') + 1).trim();
                    if (value.startsWith("\"") && value.endsWith("\"") && value.length() >= 2)
                        value = value.substring(1, value.length() - 1);
                    String clean = sanitizeFilename(value);
                    if (!clean.isEmpty()) return clean;
                }
            }
        }

        String path = url.getPath();
        String base = path == null ? "" : new File(path).getName();
        base = sanitizeFilename(base);
        return base.isEmpty() ? "plugin-update-" + STAMP.format(LocalDateTime.now()) + ".bin" : base;
    }

    private Path uniqueTarget(String requested)
    {
        inboxDir.mkdirs();
        String safe = sanitizeFilename(requested);
        if (safe.isEmpty()) safe = "plugin-update.bin";

        Path candidate = new File(inboxDir, safe).toPath();
        if (!Files.exists(candidate)) return candidate;

        int dot = safe.lastIndexOf('.');
        String stem = dot > 0 ? safe.substring(0, dot) : safe;
        String ext  = dot > 0 ? safe.substring(dot) : "";
        String stamped = stem + "-" + STAMP.format(LocalDateTime.now()) + ext;
        return new File(inboxDir, stamped).toPath();
    }

    private String sanitizeFilename(String name)
    {
        if (name == null) return "";
        String base = new File(name).getName().trim();
        return base.replaceAll("[^A-Za-z0-9._()\\-]", "_");
    }

    private void openInbox()
    {
        try {
            inboxDir.mkdirs();
            if (java.awt.Desktop.isDesktopSupported()) {
                java.awt.Desktop.getDesktop().open(inboxDir);
            } else {
                new ProcessBuilder("xdg-open", inboxDir.getAbsolutePath()).start();
            }
            if (state.chatHistory != null)
                state.chatHistory.appendUpdate("INBOX_OPENED> " + inboxDir.getAbsolutePath());
            status("SYS_UPDATE: INBOX_OPENED");
        } catch (Exception e) {
            reportError("UPDATE_INBOX_OPEN_FAILED: " + e.getMessage());
        }
    }

    private void closeUpdateMode()
    {
        state.isUpdateModeActive = false;
        state.updateInputHook = null;
        if (state.chatHistory != null) state.chatHistory.hideUpdateTab();
        status("SYS_UPDATE: CLOSED");
    }

    private void reportSuccess(String kind, File file)
    {
        String msg = kind + "> " + file.getAbsolutePath() +
                "\nSTATUS> staged only; activation/install is a separate action.";
        if (state.chatHistory != null) {
            state.chatHistory.appendUpdate(msg);
            state.chatHistory.appendSystem(kind + ": " + file.getName());
        }
        status("SYS_UPDATE: STAGED");
    }

    private void reportError(String message)
    {
        if (state.chatHistory != null) {
            state.chatHistory.appendUpdate("ERROR> " + message);
            state.chatHistory.appendError(message);
        }
        status("SYS_UPDATE: ERROR");
    }

    private void status(String text)
    {
        if (state.statusHook != null) state.statusHook.set(text);
        else if (state.statusLabel != null) state.statusLabel.setText(text);
    }
}
