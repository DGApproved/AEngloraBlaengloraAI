        update_local_weight_ledger(path, content, multiplier=1.0, reason=what)
        publish_semantic_io_to_gui("ORCHESTRATOR MEMORY STORE")
        # Log this write so the collision detector can compare it against
        # concurrent writes from the chat engine.
