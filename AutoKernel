        clean_out = m_text.replace('\n', ' ')
        prefix_out = "[HYPER-DREAM]" if multiplier > 1 else "[amdream]"
        sys.stdout.write(f"\r\033[K{prefix_out} {mutated_str[:20]} -> {clean_out} [Interest: {self.interest:.2f}]\n")
        sys.stdout.flush()

        dream_log = (
            f"[{time.strftime('%Y-%m-%dT%H:%M:%S')}] {log_prefix}\n"
            f"  CPU Load: {cpu_load} | Battery: {battery_level} | Calc Time: {calc_time}s\n"
            f"  Base Prompt: '{base_str}' -> Result: '{b_text}'\n"
            f"  Mutated Prompt: '{mutated_str}' -> Result: '{m_text}'\n"
            f"  Delta Interest Score: {self.interest:.4f}\n\n"
        )
        
        append_memory_file(AMDREAM_TXT, dream_log, what="dream cycle record", why="amdream.txt owns ponder/dream process history")
        append_memory_file(IMAGES_TXT, f"[{time.strftime('%Y-%m-%dT%H:%M:%S')}] {log_prefix} VISUAL: {v_desc}\n", what="dream visual description", why="images.txt owns visual-generation and visual-reference events")
        append_memory_file(AUDIO_TXT, f"[{time.strftime('%Y-%m-%dT%H:%M:%S')}] {log_prefix} AUDIO: {a_desc}\n", what="dream auditory description", why="audio.txt owns auditory-generation and sound-reference events")
        
