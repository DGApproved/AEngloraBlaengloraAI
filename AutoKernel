def _aitech_self_question(text):
    q=(" "+str(text or "").lower()+" ")
    phrases=(
        " yourself"," about you"," what are you"," who are you"," what can you do",
        " your features"," your functionality"," your capabilities"," your version",
        " current version"," aitech version"," aitech script"," this script",
        " your source"," your code"," how do you "," how does aitech"," prog mode",
        " programmer mode"," standard mode"," stan mode"," sensory"," headset",
        " vision"," memory system"," training mode"," gguf"," configure<",
        " compile<"," build<"," test<"," list<"," who contributed"," contributor",
        " who made"," who added"," who implemented"," best help"," assistance order",
        " which llm"," ask for assistance"
    )
    return any(p in q for p in phrases)

def get_aitech_self_source_reference(query="", max_chars=12000):
    """Retrieve bounded evidence from the exact top-level AItech shell script that launched this runtime."""
    if not _aitech_self_question(query):
        return ""
    path=AITECH_LAUNCH_SCRIPT
    identity=(
        "[AItech CURRENT runtime self-source]\n"
        f"version={AITECH_RUNNING_VERSION or 'unknown'}\n"
        f"development_origin={AITECH_RUNNING_DEVNAME or 'unknown'}\n"
        f"canonical_filename={AITECH_RUNNING_FILENAME or 'unknown'}\n"
        f"launched_from={path or 'unavailable'}\n"
        "Authority: current launched source outranks archived/training revisions for claims about CURRENT functionality. "
        "Historical variants are ancestry/reference only.\n"
    )
    if not path or not os.path.isfile(path):
        return identity+"[Launcher source unavailable for scanning.]"
    try:
        source=Path(path).read_text(encoding="utf-8",errors="ignore")
    except OSError as exc:
        return identity+f"[Launcher source read failed: {exc}]"
    budget=max(1024,min(40000,int(max_chars)))
    header=source[:min(7000,budget//2)]
    words=[]
    for word in re.findall(r"[A-Za-z_][A-Za-z0-9_:+<>\-]{2,}",str(query or "").lower()):
        if word not in {"what","does","your","you","the","this","that","with","about","from","have","can","are","how","its"} and word not in words:
            words.append(word)
    windows=[]; seen=set(); low=source.lower(); radius=700
    for word in words[:12]:
        pos=0; hits=0
        while hits<3:
            at=low.find(word,pos)
            if at<0: break
            a=max(0,at-radius); b=min(len(source),at+radius); key=(a//300,b//300)
            if key not in seen:
                seen.add(key); windows.append(source[a:b])
            hits+=1; pos=at+len(word)
    result=identity+"\n--- current source header / feature index ---\n"+header
    if windows:
        result+="\n\n--- query-matched current-source windows ---\n"+"\n\n--- source window ---\n".join(windows)
    return result[:budget]

