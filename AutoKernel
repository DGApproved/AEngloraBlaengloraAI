    private void toggleAICapability(String route)
    {
        if (route == null) return;
        route = route.trim().toUpperCase();

        boolean turningOn = !state.isCapabilityActive(route);
        state.setCapabilityActive(route, turningOn);

        if ("VOICE".equals(route)) {
            // Voice is a modality, not a model backend.  It can remain active in
            // the background while another view has focus.
            if (turningOn) state.setForegroundFocus(MatrixState.FOCUS_VOICE);
            setStatus("SYS_AI: VOICE " + (turningOn ? "ACTIVE" : "OFF"));
        } else {
            state.foregroundAIBackend = route;
            if (turningOn) {
                state.setForegroundFocus(MatrixState.FOCUS_AI);
                runAutoKernelOption39(route);
            } else {
                stopAIBackend(route);
            }
        }

        state.isAIModeActive = state.isCapabilityActive("LLAMA")
                || state.isCapabilityActive("GPT2")
                || state.isCapabilityActive("SAFETENSORS")
                || state.isCapabilityActive("VOICE");
        state.sessionModes.put(state.currentSession, state.isAIModeActive ? 2 : 0);
        updateModifierVisuals();
    }

    private String aiBackendKey(String route)
    {
        return state.currentSession + ":" + route.toUpperCase();
    }

    private void stopAIBackend(String route)
    {
        String key = aiBackendKey(route);
        java.io.PrintWriter writer = state.aiBackendStdin.remove(key);
        if (writer != null) writer.close();
        Process process = state.aiBackendProcesses.remove(key);
        if (process != null && process.isAlive()) process.destroy();
    }

    private java.io.PrintWriter focusedLocalAIWriter()
    {
        java.io.PrintWriter writer = state.aiBackendStdin.get(
                aiBackendKey(state.foregroundAIBackend));
        if (writer != null) return writer;

        synchronized (state.aiBackendStdin) {
            for (java.io.PrintWriter candidate : state.aiBackendStdin.values())
                if (candidate != null) return candidate;
        }
        return null;
    }

    private void runAutoKernelOption39(String route)
    {
        final String selectedRoute = route.toUpperCase();
        final int selectedSession = state.currentSession;
        new Thread(() -> {
            String key = selectedSession + ":" + selectedRoute;
            try {
                String autoKernelPath = System.getenv("AUTOKERNEL_PATH");
                if (autoKernelPath == null || autoKernelPath.isBlank())
                    throw new IllegalStateException("AUTOKERNEL_PATH was not inherited from AutoKernel");

                ProcessBuilder pb = new ProcessBuilder("bash", autoKernelPath, "39");
                pb.redirectErrorStream(true);

                java.io.File sessionDir = state.sessionDirectories.get(selectedSession);
                if (sessionDir != null) {
                    java.io.File noq = "session.noq".equals(sessionDir.getName())
                            ? sessionDir : new java.io.File(sessionDir, "session.noq");
                    noq.mkdirs();
                    pb.environment().put("SESSION_NOQ_PATH", noq.getAbsolutePath());
                }
                pb.environment().put("FN_NUMBER", Integer.toString(selectedSession));
                pb.environment().put("GODDESS_AI_ROUTE", selectedRoute);
                pb.environment().put("GODDESS_FOCUS", state.foregroundFocus);
                pb.environment().put("GODDESS_ACTIVE_CAPABILITIES", state.activeCapabilitySummary());
                pb.environment().put("GODDESS_SERVER_POLICY", state.serverRoutingPolicy);
                if (state.aiHomeDirectory != null)
                    pb.environment().put("GODDESS_MATRIX_ROOT", state.aiHomeDirectory.getAbsolutePath());

                String inheritedAItechRoot = System.getenv("AITECH_ROOT");
                if (inheritedAItechRoot != null && !inheritedAItechRoot.isBlank())
                    pb.environment().put("AITECH_ROOT", inheritedAItechRoot);

                Process process = pb.start();
                java.io.PrintWriter stdin = new java.io.PrintWriter(process.getOutputStream(), true);
                state.aiBackendProcesses.put(key, process);
                state.aiBackendStdin.put(key, stdin);

                java.io.BufferedReader reader = new java.io.BufferedReader(
                        new java.io.InputStreamReader(process.getInputStream()));
                String line;
                while ((line = reader.readLine()) != null) {
                    final String outputLine = line;
                    SwingUtilities.invokeLater(() -> {
                        if (state.chatHistory != null) state.chatHistory.appendRaw(outputLine + "\n");
                    });
                }
                process.waitFor();
            } catch (Exception e) {
                SwingUtilities.invokeLater(() -> {
                    if (state.chatHistory != null)
                        state.chatHistory.appendError("AUTOKERNEL_OPTION_39_" + selectedRoute + "_FAILED: " + e.getMessage());
                });
            } finally {
                state.aiBackendStdin.remove(key);
                state.aiBackendProcesses.remove(key);
            }
        }, "AutoKernelOption39-" + selectedRoute + "-FN" + selectedSession).start();
    }

