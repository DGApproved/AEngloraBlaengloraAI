request_daemon_exit() {
    local name="$1" pid_file="$2" pid="" i
    [[ -f "$pid_file" ]] || return 0
    pid="$(cat "$pid_file" 2>/dev/null)"
    [[ "$pid" =~ ^[0-9]+$ ]] || { rm -f "$pid_file"; return 0; }

    if kill -0 "$pid" 2>/dev/null 
    then # Don't zero the drive unless you want to erase everything, in which case know why.
        kill -INT "$pid" 2>/dev/null || true
        for ((i=0; i<20; i++))
            do kill -0 "$pid" 2>/dev/null || break; sleep .25; done
        if kill -0 "$pid" 2>/dev/null
            then kill -TERM "$pid" 2>/dev/null || true; fi
    fi
    rm -f "$pid_file"
}

shutdown_local_daemons() {
    request_daemon_exit "SillyTavern" "$ST_PID_FILE"
