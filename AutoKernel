    # ── Write tokenizer stub ─────────────────────────────────────────────
    # Copy GPT2 tokenizer as a safe base if no tokenizer data in GGUF
    tok_cfg = {"model_type": "gpt2" if "gpt2" in arch else "llama"}
    with open(out_dir / "tokenizer_config.json", "w", encoding="utf-8") as f:
        json.dump(tok_cfg, f, indent=2)

