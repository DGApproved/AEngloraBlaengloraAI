def record_context_event(kind, content="", metadata=None):
    counters = _load_context_counters()
    key_map = {
        "ASSISTANT_RESPONSE": "assistant_responses",
        "FILE_UPLOAD": "file_uploads",
        "FILE_ANALYSIS": "file_analyses",
        "USER_CHAT": "user_turns",
    }
    key = key_map.get(kind, "other_events")
    counters[key] = int(counters.get(key, 0) or 0) + 1
    counters["all_events"] = int(counters.get("all_events", 0) or 0) + 1
    _save_context_counters(counters)
    raw_content = str(content or "")
    normalized_for_hash = re.sub(r"\\s+", " ", raw_content).strip()
    semantic_tags = sorted({
        w.lower() for w in re.findall(r"[A-Za-z0-9_]{4,}", raw_content)
        if w.lower() not in {
            "that","this","with","from","have","what","when","then","they","their",
            "there","would","could","should","about","because","which","while",
            "user","assistant","system","file","response"
        }
    })[:80]
    event = {
        "event_id": f"E{counters['all_events']:08d}",
        "kind": kind,
        "category_index": counters[key],
        "time": time.strftime("%Y-%m-%dT%H:%M:%S"),
        "content": raw_content[:24000],
        "content_hash": hashlib.sha256(normalized_for_hash.encode("utf-8", errors="ignore")).hexdigest(),
        "semantic_tags": semantic_tags,
        "current_relevance": "DEFERRED",
        "relevance_revision": 1,
        "metadata": metadata or {},
    }
    _append_jsonl(CONTEXT_EVENTS_PATH, event)
    return event


def _read_context_events():
    rows = []
    try:
        with open(CONTEXT_EVENTS_PATH, "r", encoding="utf-8", errors="ignore") as f:
            for line in f:
                try:
                    rows.append(json.loads(line))
                except Exception:
                    pass
    except OSError:
        pass
    return rows


def _context_event_distances(events):
    """Return category-relative distances without rewriting historical events."""
    totals = {}
    for e in events:
        k = e.get("kind")
        totals[k] = totals.get(k, 0) + 1
    seen = dict(totals)
    result = {}
    for e in reversed(events):
        kind = e.get("kind")
        idx = int(e.get("category_index", seen.get(kind, 0)) or 0)
        result[e.get("event_id")] = {
            "responses_ago": (totals.get("ASSISTANT_RESPONSE", 0) - idx + 1)
                if kind == "ASSISTANT_RESPONSE" else None,
            "uploads_ago": (totals.get("FILE_UPLOAD", 0) - idx + 1)
                if kind == "FILE_UPLOAD" else None,
            "file_analyses_ago": (totals.get("FILE_ANALYSIS", 0) - idx + 1)
                if kind == "FILE_ANALYSIS" else None,
            "user_turns_ago": (totals.get("USER_CHAT", 0) - idx + 1)
                if kind == "USER_CHAT" else None,
        }
    return result


def longitudinal_context_for_prompt(prompt_text, max_chars=4200, max_hits=6):
    """
    Revisit older raw conversation/file events when a new prompt makes them
    relevant. Relevance is an interpretation layer; the original event remains
    immutable. A low score means "not selected now", never "irrelevant forever".
    """
    prompt = str(prompt_text or "")
    words = {
        w.lower() for w in re.findall(r"[A-Za-z0-9_]{4,}", prompt)
        if w.lower() not in {
            "that","this","with","from","have","what","when","then","they","their",
            "there","would","could","should","about","because","which","while",
            "user","assistant","system","file","response"
        }
    }
    if not words:
        return ""
    events = _read_context_events()
    if not events:
        return ""
    # Exclude the newest user turn itself and control-only forget payload records.
    scored = []
    for e in events[:-1]:
        if e.get("kind") not in {"USER_CHAT","ASSISTANT_RESPONSE","FILE_UPLOAD","FILE_ANALYSIS"}:
            continue
        content = str(e.get("content", ""))
        if "[FORGOTTEN CONTENT" in content:
            continue
        tags = set(e.get("semantic_tags") or [])
        if not tags:
            tags = {w.lower() for w in re.findall(r"[A-Za-z0-9_]{4,}", content)}
        overlap = words & tags
        if not overlap:
            continue
        score = len(overlap) / max(1.0, len(words) ** 0.5)
        scored.append((score, len(overlap), e, sorted(overlap)))
    if not scored:
        return ""
    scored.sort(key=lambda row: (row[0], row[1], row[2].get("event_id","")), reverse=True)
    distances = _context_event_distances(events)
    lines = [
        "[LONGITUDINAL_CONTEXT]",
        "RULE=Older observations may become relevant later. Preserve raw statement separately from current interpretation.",
    ]
    selected = []
    for score, _, e, overlap in scored[:max_hits]:
        d = distances.get(e.get("event_id"), {})
        distance_bits = [f"{k}={v}" for k, v in d.items() if v is not None]
        excerpt = re.sub(r"\\s+", " ", str(e.get("content",""))).strip()[:700]
        lines.append(
            f"event_id={e.get('event_id')} kind={e.get('kind')} "
            f"match_terms={','.join(overlap[:12])} {' '.join(distance_bits)}\n"
            f"raw_excerpt={excerpt}"
        )
        selected.append(e.get("event_id"))
    link_event = {
        "time": time.strftime("%Y-%m-%dT%H:%M:%S"),
        "event": "RELEVANCE_LINK",
        "prompt_hash": hashlib.sha256(prompt.encode("utf-8", errors="ignore")).hexdigest(),
        "linked_event_ids": selected,
        "rule": "new context increased present relevance; historical event content unchanged",
    }
    _append_jsonl(CONTEXT_EVENTS_PATH, link_event)
    lines.append("[/LONGITUDINAL_CONTEXT]")
    return "\n".join(lines)[:max_chars]


