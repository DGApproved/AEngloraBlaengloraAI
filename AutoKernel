def _prog_runnable(project):
    project=_prog_safe_name(project); meta=_prog_read_metadata(project); lang=meta.get("language","")
    pdir=_prog_paths(project)["program"]
    try: candidates=[os.path.join(pdir,x) for x in os.listdir(pdir) if x!="aitech_project.json"]
    except OSError: return None
    if lang=="java":
        jars=[x for x in candidates if x.lower().endswith(".jar")]
        return jars[0] if jars else None
    preferred=[x for x in candidates if os.path.isfile(x) and (os.access(x,os.X_OK) or x.endswith((".sh",".py",".bat",".cmd")))]
    return preferred[0] if preferred else (candidates[0] if candidates else None)

def _prog_run(project):
    project=_prog_safe_name(project)
    if not _prog_project_open(project):
        return False,f"Project {project} is not running. Use prog start {project} or prog resume {project}."
    path=_prog_runnable(project)
    if not path:
        msg="No runnable program artifact found."
        _prog_session_update(project,last_operation="run",last_error=msg,progress=0,progress_label="RUN FAILED")
        _prog_gui_update(project,0,"RUN FAILED",compiler_output=msg,error=msg)
        return False,msg
    lang=_prog_read_metadata(project).get("language","")
    try:
        if lang=="java" and path.endswith(".jar"): cmd=["java","-jar",path]
        elif path.endswith(".py"): cmd=[sys.executable,path]
        elif path.endswith(".sh"): cmd=["bash",path]
        else: cmd=[path]
        _prog_session_update(project,last_operation="run",last_error="",progress=20,progress_label="RUNNING")
        _prog_gui_update(project,20,"RUNNING",compiler_output="$ "+" ".join(cmd))
        result=subprocess.run(cmd,cwd=os.path.dirname(path),stdout=subprocess.PIPE,stderr=subprocess.PIPE,text=True,timeout=1800)
        output=((result.stdout or "")+("\n"+result.stderr if result.stderr else "")).strip() or f"exit={result.returncode}"
        if result.returncode==0:
            _prog_session_update(project,last_operation="run",last_error="",progress=100,progress_label="RUN COMPLETE")
            _prog_gui_update(project,100,"RUN COMPLETE",compiler_output=output)
            return True,output
        _prog_session_update(project,last_operation="run",last_error=output,progress=100,progress_label="RUN FAILED")
        _prog_gui_update(project,100,"RUN FAILED",compiler_output=output,error=output)
        return False,output
    except Exception as exc:
        msg=str(exc)
        _prog_session_update(project,last_operation="run",last_error=msg,progress=0,progress_label="RUN ERROR")
        _prog_gui_update(project,0,"RUN ERROR",compiler_output=msg,error=msg)
        return False,msg

