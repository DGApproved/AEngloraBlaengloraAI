fn_legacy_scan_training_data() {
     echo -e "${CYAN}[+] Scanning domain directories and building indexes...${NC}"

     for domain in num hex hexabet alphabet; do
         TARGET="$LEGACY_DATA_DIR/$domain"
         echo "[*] Indexing $domain..."

         DICT_TXT="$TARGET/dictionary.txt"
         DICT_SH="$TARGET/dictionary.sh"
         THES_TXT="$TARGET/thesaurus.txt"
         THES_SH="$TARGET/thesaurus.sh"

         echo "# AItech Dictionary Map for $domain" > "$DICT_TXT"
         echo "#!/usr/bin/env bash" > "$DICT_SH"
         echo "# AItech Semantic Equivalency Map for $domain" > "$THES_TXT"
         echo "#!/usr/bin/env bash" > "$THES_SH"

         find "$TARGET" -maxdepth 2 -type f \( -name "*.txt" -o -name "*.sh" \) | while read -r file; do
             filename=$(basename "$file")
             echo "FILE: $filename | PATH: $file | SIZE: $(wc -c < "$file") bytes" >> "$DICT_TXT"
             echo "declare -A MAP_${filename//[^a-zA-Z0-9]/_}=([path]=\"$file\")" >> "$DICT_SH"
         done
         chmod +x "$DICT_SH" "$THES_SH"
     done
     echo -e "${GREEN}[✓] Data scanning and symbol mapping complete.${NC}"
}

# ------------------------------------------------------------------------------------------
# 4) Train Models & Interactive Lossless Prompt (2s4)
# ------------------------------------------------------------------------------------------
fn_legacy_train_models() {
     echo -e "${CYAN}[+] Checking seed assets and initializing interactive session...${NC}"

     # Check for empty folders and populate origin seeds if missing
     for domain in num hex hexabet alphabet; do
         DIR="$LEGACY_DATA_DIR/$domain"
         if [ ! -f "$DIR/origin.txt" ]; then
             case $domain in
                 num)
                     echo "0123456789!@#$%^&*()" > "$DIR/origin.txt"
                     echo '#!/usr/bin/env bash' > "$DIR/origin.sh"
                     echo '# Interpreter: Numeric & Shift Emphasis' >> "$DIR/origin.sh"
                     ;;
                 hex)
                     echo "0123456789abcdef" > "$DIR/origin.txt"
                     echo '#!/usr/bin/env bash' > "$DIR/origin.sh"
                     echo '# Interpreter: Hexadecimal & Visual Elements' >> "$DIR/origin.sh"
                     # Generate 1x1 default PNG
                     ffmpeg -y -f lavfi -i color=c=red:s=1x1 -vframes 1 "$DIR/origin.png" &>/dev/null
                     ;;
                 hexabet)
                     echo "0123456789abcdefghijklmnopqrstuvwxyz" > "$DIR/origin.txt"
                     echo '#!/usr/bin/env bash' > "$DIR/origin.sh"
                     echo '# Interpreter: Extended Hexabet & Motion Assets' >> "$DIR/origin.sh"
                     # Generate 1-second default MP4
                     ffmpeg -y -f lavfi -i color=c=blue:s=16x16:d=1 -r 1 "$DIR/origin.mp4" &>/dev/null
                     ;;
             esac
             chmod +x "$DIR/origin.sh" 2>/dev/null || true
         fi
     done

     echo -e "${BLUE}=== Lossless Interactive Training Session ===${NC}"
     echo "Type 'exit' to end session. Interactive data is written to data/alphabet/interaction.txt"

     INT_FILE="$LEGACY_DATA_DIR/alphabet/interaction.txt"
     while true; do
         read -p "AItech Input > " user_input
         if [ "${user_input,,}" == "exit" ]; then 
             echo "Ending training session..."
             break
         fi
         timestamp=$(date "+%Y-%m-%d %H:%M:%S")
         echo "[$timestamp] USER: $user_input" >> "$INT_FILE"
         response="[AItech Processing]: Encoded entry to training dataset."
         echo "[$timestamp] MODEL: $response" >> "$INT_FILE"
         echo -e "${GREEN}$response${NC}"
     done
}

