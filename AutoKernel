                    7) ak41_backup_edit "$relations_conf"; ak41_publish_relations ;;
                    8) cat "$perspective_conf"; read -r -p "Press enter..." dummy ;;
                    9) ls -lah "$shared_dir" 2>/dev/null || true; read -r -p "Press enter..." dummy ;;
