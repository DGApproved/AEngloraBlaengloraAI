class MouthHandler(BaseHTTPRequestHandler):
    def do_OPTIONS(self):
        self.send_response(200)
        self.send_header('Access-Control-Allow-Origin', '*')
        self.send_header('Access-Control-Allow-Methods', 'GET, POST, OPTIONS')
        self.send_header('Access-Control-Allow-Headers', 'Content-Type')
        self.end_headers()

    def do_POST(self):
        global session_history
        if self.path == "/api/v1/generate":
            content_length = int(self.headers['Content-Length'])
            post_data = self.rfile.read(content_length)
            req = json.loads(post_data.decode('utf-8'))
            prompt = req.get("prompt", "").strip()

            sys.stdout.write(f"\r\033[K\n[Nervous System] Headset receiving simulated audio stream:\n\033[1;35m[Left & Right Ears] > {prompt}\033[0m\n")
            sys.stdout.flush()

            inputs = tokenizer(f"User: {prompt}\nAssistant:", return_tensors="pt").to(device)
            model.eval()
            with torch.no_grad():
                out = model.generate(
                    **inputs, max_new_tokens=150, 
                    pad_token_id=tokenizer.eos_token_id, 
                    do_sample=True, temperature=0.75
                )
            response = tokenizer.decode(out[0][inputs['input_ids'].shape[1]:], skip_special_tokens=True).strip()

            display_response = colorize_cognition(response)
            sys.stdout.write(terminal_sensory(f"Mouth (HTTP:{self.server.server_port}): {display_response}") + "\n\n")
            sys.stdout.flush()

            interaction_log = f"\n[{time.strftime('%Y-%m-%dT%H:%M:%S')}] User (Headset): {prompt}\nAssistant: {response}\n"
            session_history += interaction_log
            mark_wake_consolidation_if_needed()
            append_memory_file(CHAT_LOG, interaction_log, what="headset interaction", why="journal.txt owns simulated interactions") 

            update_gui_chat("EARS", prompt)
            update_gui_chat("MOUTH", response)
            publish_headset_output(response, source="Sensory HTTP")
            publish_vision_output(response, source="Sensory HTTP")
            _run_headphone_tts(HEADPHONE_TTS_MIC_CMD_CFG, response, source="Sensory Mouth")

            self.send_response(200)
            self.send_header('Content-type', 'application/json')
            self.send_header('Access-Control-Allow-Origin', '*')
            self.end_headers()
            res_data = json.dumps({"results": [{"text": response}]})
            self.wfile.write(res_data.encode('utf-8'))
        else:
            self.send_response(404)
            self.end_headers()

    def log_message(self, format, *args):
        pass 

class MouthEngine(threading.Thread):
    def __init__(self, host="127.0.0.1", port=6776):
        super().__init__(daemon=True)
        self.host = host
        self.port = port
    def run(self):
        try:
            server = HTTPServer((self.host, self.port), MouthHandler)
            server.serve_forever()
        except Exception: pass

