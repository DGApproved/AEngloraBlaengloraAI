class DaemonEngine(threading.Thread):
    def __init__(self, host='127.0.0.1', port=5678):
        super().__init__(daemon=True)
        self.host = host
        self.port = port

    def run(self):
        server_socket = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
        server_socket.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)
        try:
            server_socket.bind((self.host, self.port))
            server_socket.listen(5)
            # We don't print to stdout to avoid messing up the interactive prompt.
            while True:
                client_sock, addr = server_socket.accept()
                threading.Thread(target=self.handle_client, args=(client_sock,), daemon=True).start()
        except Exception as e:
            pass

    def handle_client(self, client_sock):
        global session_history
        try:
            data = client_sock.recv(4096).decode('utf-8').strip()
            if not data: return
            
            if data.startswith("QUERY:"):
                query = data[6:].strip()
                
                # 1. Announce Qwen's query to the terminal natively
                sys.stdout.write(f"\r\033[K\n[IPC SENSOR] Incoming transmission from Qwen:\nUser (Qwen): {query}\n")
                sys.stdout.flush()

                # Process inference silently in the background
                inputs = tokenizer(f"User: {query}\nAssistant:", return_tensors="pt").to(device)
                model.eval()
                with torch.no_grad():
                    outputs = model.generate(
                        **inputs, max_new_tokens=150, 
                        pad_token_id=tokenizer.eos_token_id, 
                        do_sample=True, temperature=0.7
                    )
                response = tokenizer.decode(outputs[0][inputs['input_ids'].shape[1]:], skip_special_tokens=True).strip()
                
                # 2. Print response and cleanly restore your input prompt
                sys.stdout.write(f"Assistant (Goddess): {response}\n")
                sys.stdout.flush()

                # 3. Push the interaction to the GUI logs
                update_gui_chat("QWEN", query)
                update_gui_chat("AI", response)

                # 4. Inject into her active session memory so she learns!
                interaction_log = f"\n[{time.strftime('%Y-%m-%dT%H:%M:%S')}] User (via IPC): {query}\nAssistant: {response}\n"
                session_history += interaction_log
                mark_wake_consolidation_if_needed()
                append_memory_file(CHAT_LOG, interaction_log, what="chronological interaction event", why="journal.txt owns chronological interactions and provenance") 

                # Push a notification to the GUI so you know a background program talked to the AI
                update_gui_chat("EXT", f"Query: {query[:20]}... -> {response[:30]}...")
                
                client_sock.sendall(response.encode('utf-8'))
            
            elif data.startswith("CMD:"):
                cmd = data[4:].strip().lower()
                if cmd == "wake":
                    ponder_thread.wake_mode = True
                    sys.stdout.write(f"\r\033[K\n[IPC SENSOR] Qwen triggered WAKE MODE.\n")
                    sys.stdout.flush()
                    client_sock.sendall(b"ACK: WAKE_MODE_ENABLED")
                elif cmd == "stats":
                    stats = f"Context Size: {context_size} | Ponder Eagerness: {ponder_thread.interest:.2f}"
                    client_sock.sendall(stats.encode('utf-8'))
                else:
                    client_sock.sendall(b"ERR: UNKNOWN_CMD")
            else:
                client_sock.sendall(b"ERR: PROTOCOL_MISMATCH (Use QUERY: or CMD:)")
        except Exception as e:
            pass
        finally:
            client_sock.close()

