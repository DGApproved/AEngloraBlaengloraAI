    42|43|44|45|46|47|48)
        echo "So it's an option $option placeholder."
        read -p "Press enter to continue this program and return to the main menu..." dummy
        ;;
        15)
        echo "Exiting script. Goodbye!"
        exit 0
        ;;
    * ) 
        echo "Invalid option, please choose between 0 and 26."
        sleep 2
        ;;
    esac
done

