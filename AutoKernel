def _load_prompts_and_config(path=PROMPTS_TXT):
    """Load user-editable Qwen headers and bounded bridge configuration."""
    cfg, prompts = {}, {}
    current = None
    try:
        with open(path, "r", encoding="utf-8", errors="ignore") as f:
            for raw in f:
                line = raw.rstrip("\n")
                stripped = line.strip()
                if stripped.startswith("[prompt:") and stripped.endswith("]"):
                    current = stripped[len("[prompt:"):-1].strip().upper()
                    prompts[current] = []
                    continue
                if stripped == "[/prompt]":
                    current = None
                    continue
                if current is not None:
                    prompts[current].append(line)
                    continue
                if not stripped or stripped.startswith("#") or stripped in ("[config]", "[/config]"):
                    continue
                if "=" in line:
                    key, value = line.split("=", 1)
                    cfg[key.strip().upper()] = value.strip()
    except OSError:
        pass
    return cfg, {k: "\n".join(v).strip() for k, v in prompts.items()}

