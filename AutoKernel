pid_is_alive() {
    local file="$1" pid=""
    [[ -f "$file" ]] || return 1
    pid="$(cat "$file" 2>/dev/null)"
    [[ "$pid" =~ ^[0-9]+$ ]] || return 1
    kill -0 "$pid" 2>/dev/null
}

wait_for_http() {
    local url="$1" tries="${2:-40}" i
    for ((i=0; i<tries; i++)); do
        if python3 - "$url" <<'PY' >/dev/null 2>&1
import sys, urllib.request
try:
    urllib.request.urlopen(sys.argv[1], timeout=.5).read(1)
    raise SystemExit(0)
except Exception:
    raise SystemExit(1)
PY
        then return 0; fi
        sleep .25
    done
    return 1
}

