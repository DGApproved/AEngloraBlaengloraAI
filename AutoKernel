    (( ART_ROWS < 3 )) && ART_ROWS=3
    local max_art=$(( ROWS / 3 ))
    (( max_art < 3 )) && max_art=3
    (( ART_ROWS > max_art )) && ART_ROWS=$max_art
    TABLE_TOP=$(( ART_TOP + ART_ROWS + 1 ))
    ROW_AI=$(( ROWS - 2 )); ROW_PROGRESS=$(( ROWS - 1 )); ROW_USER=$ROWS
    TABLE_BOT=$ROW_AI
    TABLE_HEIGHT=$(( TABLE_BOT - TABLE_TOP - 1 ))
    (( TABLE_HEIGHT < 1 )) && TABLE_HEIGHT=1
}

parse_textart() {
    VIEW_ORDER=(); VIEW_LINES=(); VIEW_TITLE=()
    local current_title="" accum="" line pv idx=-1

    while IFS= read -r line || [[ -n "$line" ]]; do
        if [[ "$line" == \[VIEW:*\]* ]]; then
            local vname="${line#\[VIEW:}"
            vname="${vname%%\]*}"
            current_title="${line#*]}"
            current_title="${current_title# }"
            accum=""
            VIEW_ORDER+=("$vname")
            idx=$((idx + 1))
        elif [[ "$line" == "[/VIEW]" ]]; then
            if (( idx >= 0 )); then
                VIEW_LINES[idx]="$accum"
                VIEW_TITLE[idx]="${current_title:-${VIEW_ORDER[idx]^^}}"
            fi
            current_title=""; accum=""
        elif [[ "$line" == \[PROGRESS:*\]* ]]; then
            pv="${line#\[PROGRESS:}"
            pv="${pv%%\]*}"
            PROGRESS=$(clamp_int "$pv" 0 100)
            PROGRESS_LABEL="${line#*]}"
            PROGRESS_LABEL="${PROGRESS_LABEL# }"
            [[ -z "$PROGRESS_LABEL" ]] && PROGRESS_LABEL="WORKING"
        elif (( idx >= 0 )); then
            if [[ -n "$accum" ]]; then accum+=$'\n'; fi
            accum+="$line"
        fi
    done < "$TEXTART"

    if (( MIDDLE_INDEX >= ${#VIEW_ORDER[@]} )); then MIDDLE_INDEX=0; MIDDLE_SCROLL=0; fi
