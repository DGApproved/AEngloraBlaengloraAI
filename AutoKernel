def run_chat_mode():
    """
    Runs a full interactive chat session using the GPT2 knowledge engine.

    Mirrors chat_and_display_interactivev3.py in functionality:
      - All economy commands (point, sp, si, wake, ce, auto, cnsl …)
      - Swap pager, memory controller, CPU clutch monitor
      - PonderEngine background thread (pondering + wake:qwen)
      - DaemonEngine IPC on port 5678
      - Live training after each response
      - Triage scan, gentext writes, collision ledger logging
      - Modality output (image, audio, video, text)
      - Full display protocol (asciiart, textart, chatart)

    Key difference from chat_and_display:
      The model is GPT2 (knowledge engine) rather than Llama (base model).
      GPT2 uses a 512-position context optimised for factual recall from the
      semantic memory files it was trained on. The Llama base model is better
      for open-ended conversation; the knowledge engine is better for structured
      fact retrieval and memory-routing tasks.

    Selecting this mode at startup does not affect the model files — you can
    switch between the two engines freely by choosing which script to run.
    """

    # ── MODEL LOAD ──────────────────────────────────────────────────────────
    print("\n" + "="*60)
    print("  KNOWLEDGE ENGINE — CHAT MODE")
    print("="*60)

    global MODEL_DIR
    detected_models = _scan_knowledge_models()
    selected_model = _select_knowledge_model_interactive(detected_models)
    if not selected_model:
        print("  Knowledge-model selection cancelled.")
        return
    MODEL_DIR = selected_model

    print(f"  Loading: {MODEL_DIR}")
    tokenizer = GPT2Tokenizer.from_pretrained(MODEL_DIR)
    tokenizer.pad_token = tokenizer.eos_token
    model     = GPT2LMHeadModel.from_pretrained(MODEL_DIR)
    inject_tokenizer_patches(tokenizer, model)

    device = torch.device(
        "cuda" if torch.cuda.is_available()
        else "mps" if hasattr(torch.backends, "mps") and torch.backends.mps.is_available()
        else "cpu"
    )
    model.to(device)
    optimizer = AdamW(model.parameters(), lr=5e-4)
    print(f"  Device: {device.type.upper()}")

    # GPT2's positional embedding table is a hard neural limit. Keep it
    # separate from the larger logical/session context used for memory routing.
    _position_candidates = []
    for _attr in ("n_positions", "n_ctx", "max_position_embeddings"):
        try:
            _value = int(getattr(model.config, _attr, 0) or 0)
        except Exception:
            _value = 0
        if _value > 0:
            _position_candidates.append(_value)
    try:
        _tok_limit = int(getattr(tokenizer, "model_max_length", 0) or 0)
    except Exception:
        _tok_limit = 0
    if 0 < _tok_limit < 1_000_000:
        _position_candidates.append(_tok_limit)
    neural_position_limit = min(_position_candidates) if _position_candidates else 2048

    def encode_chat_generation_prompt(prompt_text, max_new_tokens):
        """
        Encode one GPT2 generation prefill inside the checkpoint's actual
        positional capacity while preserving the newest/rightmost context.
        """
        reserve = max(1, int(max_new_tokens)) + 1
        input_budget = max(1, neural_position_limit - reserve)
        encoded = tokenizer(
            str(prompt_text), return_tensors="pt",
            add_special_tokens=False, truncation=False, verbose=False
        )
        input_len = int(encoded["input_ids"].shape[1])
        if input_len > input_budget:
            for _key, _value in list(encoded.items()):
                try:
                    if getattr(_value, "ndim", 0) >= 2 and _value.shape[1] == input_len:
                        encoded[_key] = _value[:, -input_budget:]
                except Exception:
                    pass
        return encoded.to(device)

