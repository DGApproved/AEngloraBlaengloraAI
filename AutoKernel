    def inject_tokenizer_patches(tokenizer, model):
        """
        Injects manual symbol patches directly into the model's neural vocabulary 
        so the AI recognizes them as atomic, mathematical concepts rather than unknown bytes.
        """
        gpu_chars = os.path.join(GPU_DIR, "characters.txt")
        if not os.path.exists(gpu_chars):
            return
        
        new_tokens = []
        try:
            with open(gpu_chars, "r", encoding="utf-8") as f:
                for line in f:
                    if line.startswith("[") and "][" in line:
                        parts = line.strip("[]\n").split("][")
                        if len(parts) >= 3:
                            symbol = parts[1]
                            name_token = f"<{parts[2].upper()}>" # e.g., <COMMA>
                            new_tokens.extend([symbol, name_token])
                        
            if new_tokens:
                # Only add tokens that don't already exist in the vocabulary
                added_count = tokenizer.add_tokens(list(set(new_tokens)))
                if added_count > 0:
                    # CRITICAL: We must physically resize the model's embedding matrix 
                    # to accommodate the new mathematical dimensions.
                    model.resize_token_embeddings(len(tokenizer))
                    sys.stdout.write(f"\r\033[K[System] Injected {added_count} manual mechanical patches into active vocabulary.\n")
