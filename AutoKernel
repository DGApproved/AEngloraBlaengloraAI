def build_input_register_state(text):
    """Build transient IR1 exact-character, IR2 local-text, and IR3 interpretation state."""
    raw = str(text or "")
    char = raw[-1] if raw else " "
    local = raw[-2:] if len(raw) >= 2 else raw.ljust(2, " ")

    try:
        code = ord(char)
        ir1 = f"CHAR={repr(char)}|HEX={hex(code)}|BIN={format(code, '08b')}|DEC={code}"
    except Exception:
        ir1 = f"CHAR={repr(char)}"

    stripped = raw.strip()
    symbolic = bool(re.search(
        r"(?:0x[0-9a-fA-F]+|\d+\s*[-+*/%=<>^]\s*\d+|[()[\]{}]|==|!=|<=|>=)",
        stripped
    ))
    math_request = bool(re.search(
        r"\b(calculate|compute|solve|sum|product|divide|multiply|equation|ratio|percent|hex|binary|decimal|coordinate)\b",
        stripped, re.I
    ))
    sentence_like = bool(re.match(r"^[A-Z]", stripped)) and bool(
        re.search(r"[.!?]['\")\]]?$", stripped)
    )

    if symbolic or math_request:
        mode = "CALC" if math_request or re.search(r"\d+\s*[-+*/%=]\s*\d+", stripped) else "THEORY"
    elif sentence_like:
        mode = "TEXT"
    elif stripped and re.search(r"[^A-Za-z0-9\s.,!?'\-]", stripped):
        mode = "THEORY"
    else:
        mode = "TEXT"

    return (
        f"[IR1:{ir1}]\n"
        f"[IR2:{local}]\n"
        f"[IR3:MODE={mode}|STATUS=PROVISIONAL]"
    )

def classify_linguistic_form(text):
    """Classify current form without treating form as proof of desired response style."""
    value = str(text or "").strip()
    if not value:
        return "NOISE"
    if re.search(r"(?:0x[0-9a-fA-F]+|\d+\s*[-+*/%=<>^]\s*\d+|[{}\[\]();])", value):
        return "SYMBOLIC"
    words = re.findall(r"[A-Za-z]+(?:'[A-Za-z]+)?", value)
    if not words:
        return "NOISE"
    if re.match(r"^[A-Z]", value) and re.search(r"[.!?]['\")\]]?$", value):
        return "PROPER_SENTENCE"
    if len(words) >= 3:
        return "SENTENCE_LIKE"
    return "PHRASE"

def estimate_school_complexity(text):
    """
    Runtime prior only: FOUNDATIONAL, MIDDLE, or OPEN_ADVANCED.
    This organizes reasoning and is not a judgement of the user.
    """
    value = str(text or "").strip()
    words = re.findall(r"[A-Za-z]+", value)
    if not words:
        return "OPEN_ADVANCED" if re.search(r"[=<>*/^{}\[\]]", value) else "FOUNDATIONAL"

    avg_len = sum(len(w) for w in words) / max(1, len(words))
    clauses = len(re.findall(
        r"[,;:]|\b(?:because|although|however|therefore|whereas|which|while)\b",
        value, re.I
    ))
    symbols = len(re.findall(r"[=<>*/^{}\[\]]", value))
    specialist = len(re.findall(
        r"\b(?:derive|recursive|recursion|algorithm|hypothesis|coefficient|variable|"
        r"photosynthesis|ecosystem|constitutional|metaphor|symbolism|probability|"
        r"function|compiler|syntax|theoretical|dimensional|epistemic)\b",
        value, re.I
    ))

    score = (
        (1 if avg_len >= 5.2 else 0)
        + (1 if clauses >= 2 else 0)
        + (1 if len(words) >= 28 else 0)
        + (1 if symbols >= 2 else 0)
        + min(2, specialist)
    )
    if score <= 1:
        return "FOUNDATIONAL"
    if score <= 3:
        return "MIDDLE"
    return "OPEN_ADVANCED"

def build_interpretation_scaffold(text):
    """Create a small six-state-friendly linguistic and developmental runtime scaffold."""
    return (
        "[INTERPRETATION_SCAFFOLD]\n"
        f"LINGUISTIC_FORM={classify_linguistic_form(text)}\n"
        f"COMPLEXITY_BAND={estimate_school_complexity(text)}\n"
        "STYLE_RULE=Input form is evidence about desired response form, not a universal command. "
        "The opposite or an additional rule may also apply; use task demands, local examples, "
        "explicit preference, and six-state reasoning.\n"
        "COMPLEXITY_RULE=When useful, decompose mixed material into foundational, middle, "
        "and open/advanced reasoning layers.\n"
        "[/INTERPRETATION_SCAFFOLD]"
    )

def process_autonomic_cache_routing(generated_text: str):
    """
    Scans the model's output stream for cache routing tags.
    Allows the model to self-regulate by writing directly to L2 or L3 mid-generation.
    """
    # 1. Check if model wants to stage a thought in L2 (NPU) for sorting
    l2_matches = re.findall(r"<L2_ROUTE>(.*?)</L2_ROUTE>", generated_text, re.DOTALL)
    for thought in l2_matches:
        if thought.strip():
            filename = L2_NPU / f"self_reflection_{int(time.time()*1000)}.txt"
            filename.write_text(thought.strip(), encoding="utf-8")
            print(f"\n\033[1;35m[🧠 Subconscious Routed {len(thought)} chars to L2 NPU for sorting]\033[0m")
            
    # 2. Check if model is intentionally pulling the L3 (CPU) Clutch to halt
    if "<L3_HALT>" in generated_text:
        clutch_file = L3_CPU / "kqkkqq.txt"
        clutch_file.write_text("[axed]\nMODEL SELF-INVOKED HALT: Cognitive overload / Morning Coffee break requested.", encoding="utf-8")
        print("\n\033[1;31m[⚙️ Model engaged L3 CPU Clutch. Entering forced resting state.]\033[0m")

    # 3. Clean the tags out of the final string so the user just sees natural conversation
    cleaned_text = re.sub(r"<L2_ROUTE>.*?</L2_ROUTE>", "", generated_text, flags=re.DOTALL)
    cleaned_text = cleaned_text.replace("<L3_HALT>", "")
    
    return cleaned_text.strip()

