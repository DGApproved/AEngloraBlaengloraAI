def cognitive_resonance_memory_context(concept, max_chars=1500):
    """
    Query named semantic memory for material relevant to a repeated concept.

    This is retrieval only. It does not redistribute or rewrite memory.
    """
    keywords = {
        w.lower()
        for w in re.findall(r"[A-Za-z0-9_'-]{3,}", concept)
    }

    if not keywords:
        return ""

    matches = []
    used = 0

    for filename, spec in MEMORY_SEMANTICS.items():
        candidates = [
            os.path.join(DATAS_DIR, filename),
            os.path.join(MEMORY_DIR, filename),
            os.path.join(VIRTUAL_DIR, filename),
        ]

        path = next((p for p in candidates if os.path.isfile(p)), None)
        if not path:
            continue

        semantic_description = " ".join([
            filename,
            str(spec.get("role", "")),
            str(spec.get("purpose", "")),
            str(spec.get("accepts", "")),
        ]).lower()

        semantic_score = sum(k in semantic_description for k in keywords)

        try:
            body = Path(path).read_text(
                encoding="utf-8",
                errors="ignore"
            )
        except OSError:
            continue

        body_lower = body.lower()
        content_score = sum(k in body_lower for k in keywords)

        score = semantic_score * 2 + content_score
        if score:
            matches.append((score, filename, body))

    matches.sort(key=lambda item: item[0], reverse=True)

    chunks = []

    for score, filename, body in matches:
        remaining = max_chars - used
        if remaining <= 0:
            break

        # Find a useful region instead of blindly loading the whole file.
        lower = body.lower()
        positions = [
            lower.find(k)
            for k in keywords
            if lower.find(k) >= 0
        ]

        if positions:
            center = min(positions)
            start = max(0, center - 350)
            snippet = body[start:start + min(700, remaining)]
        else:
            snippet = body[-min(700, remaining):]

        chunks.append(
            f"[{filename} | relevance={score}]\n{snippet.strip()}"
        )
        used += len(snippet)

    return "\n\n".join(chunks)[:max_chars]

def source_notebook_context_for_prompt(prompt_text, max_chars=1800):
    """Retrieve the most relevant source notebook for likely source/book/code discussion."""
    low = str(prompt_text or "").lower()
    if not any(term in low for term in (
        "book", "chapter", "story", "text", "author", "character", "plot",
        "theme", "passage", "source", "document", "script", "code", "program"
    )):
        return ""
    try:
        schema = _load_gentext_schema_safe()
        query_words = set(re.findall(r"[a-z0-9]{3,}", low))
        scored = []
        for fname, entry in schema.get("files", {}).items():
            if entry.get("role") != "SOURCE_LEARNED_NOTEBOOK":
                continue
            path = os.path.join(GENTEXT_DIR, fname)
            if not os.path.isfile(path):
                continue
            descriptor = " ".join([
                fname,
                str(entry.get("purpose", "")),
                " ".join(entry.get("accepts", []) or []),
            ]).lower()
            score = sum(1 for word in query_words if word in descriptor)
            scored.append((score, entry.get("last_written", ""), fname, path))
        if not scored:
            return ""
        scored.sort(reverse=True)
        _, _, fname, path = scored[0]
        raw = Path(path).read_text(encoding="utf-8", errors="ignore").strip()
        if not raw:
            return ""
        return (
            f"[SOURCE_SPECIFIC_LEARNED_CONTEXT file={fname}]\n"
            f"{raw[-max_chars:]}\n"
            "[/SOURCE_SPECIFIC_LEARNED_CONTEXT]\n"
            "Keep source observations, model interpretations, user opinions, and generalized facts distinct."
        )
    except Exception:
        return ""


