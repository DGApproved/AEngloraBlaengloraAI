                except Exception:
                    pass

            # ── WAKE:QWEN TICK (every 13 cycles) ─────────────────────────────
            # Ask the chat engine's local model to generate an abstract thought
            # via IPC, then interpret it here with the cloud model.
            if idle_cycle_count % 13 == 0:
                try:
                    abstract = roomate_ipc(
