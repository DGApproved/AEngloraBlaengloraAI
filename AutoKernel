# =============================================================================
# INPUT INTERPRETATION REGISTERS + CONTEXT SCAFFOLDING
# =============================================================================
# IR1/IR2/IR3 are transient input-interpretation registers.  They are not the
# L1/L2/L3 hardware-inspired runtime cache hierarchy and are never, by
# themselves, durable semantic memory.
def build_input_register_state(text):
    raw = str(text or "")
    final_char = raw[-1:] if raw else ""
    ir1 = {
        "char": final_char,
        "hex": f"{ord(final_char):02X}" if final_char else "",
        "bin": f"{ord(final_char):08b}" if final_char else "",
        "dec": ord(final_char) if final_char else None,
    }
    ir2 = raw[-2:] if raw else ""

    stripped = raw.strip()
    mathish = bool(re.search(
        r"(?:\d\s*[+\-*/%^=<>]\s*\d|[(){}\[\]]|\b(?:sin|cos|tan|sqrt|log|sum|mean|median|variance|probability)\b)",
        stripped, re.I
    ))
    words = re.findall(r"[A-Za-z]+", stripped)
    symbols = re.findall(r'[^\w\s.,!?\'"]', stripped)
    if mathish:
        ir3_mode = "IR3_CALC"
    elif symbols and len(symbols) >= max(2, len(words)):
        ir3_mode = "IR3_THEORY"
    else:
        ir3_mode = "IR3_TEXT"

    return (
        "[INPUT_REGISTERS]\n"
        f"IR1_CHAR={ir1['char']!r} IR1_HEX={ir1['hex']} IR1_BIN={ir1['bin']} IR1_DEC={ir1['dec']}\n"
        f"IR2_LOCAL={ir2!r}\n"
        f"IR3_MODE={ir3_mode}\n"
        "NOTE=IR registers are transient interpretation state, not L1/L2/L3 cache and not durable memory.\n"
        "[/INPUT_REGISTERS]"
    )


def classify_linguistic_form(text):
    raw = str(text or "").strip()
    if not raw:
        return "NOISE"
    if re.search(r"\d\s*[+\-*/%^=<>]\s*\d", raw) or (
        re.search(r"[=+*/%^]", raw) and len(re.findall(r"[A-Za-z]+", raw)) <= 3
    ):
        return "SYMBOLIC"
    alpha = re.findall(r"[A-Za-z]+", raw)
    if not alpha:
        return "NOISE"
    if len(alpha) >= 2 and raw[:1].isupper() and raw[-1:] in ".!?":
        return "PROPER_SENTENCE"
    if len(alpha) >= 2 and (raw[-1:] in ".!?" or raw[:1].isupper()):
        return "SENTENCE_LIKE"
    if len(alpha) >= 1:
        return "PHRASE"
    return "NOISE"


def estimate_school_complexity(text):
    raw = str(text or "")
    words = re.findall(r"[A-Za-z]+", raw)
    if not words:
        return "FOUNDATIONAL"
    avg_word = sum(len(w) for w in words) / len(words)
    clauses = len(re.findall(r"[,;:]|\b(?:because|although|however|therefore|whereas|unless|while)\b", raw, re.I))
    symbolic = len(re.findall(r"[=+*/%^<>]|\b(?:variable|function|derivative|integral|algorithm|probability|hypothesis|architecture)\b", raw, re.I))
    specialist = len(re.findall(r"\b(?:epistemology|ontology|dimensional|semantic|inference|compiler|runtime|statistical|cognitive|provenance)\b", raw, re.I))
    score = (avg_word >= 5.2) + (len(words) >= 22) + (clauses >= 2) + (symbolic >= 2) + (specialist >= 1)
    if score >= 4:
        return "OPEN_ADVANCED"
    if score >= 2:
        return "MIDDLE"
    return "FOUNDATIONAL"


def build_interpretation_scaffold(text):
    form = classify_linguistic_form(text)
    complexity = estimate_school_complexity(text)
    return (
        "[INTERPRETATION_SCAFFOLD]\n"
        f"LINGUISTIC_FORM={form}\n"
        f"COMPLEXITY_BAND={complexity}\n"
        "STYLE_RULE=Input form is conditional evidence about desired output form, not evidence that the idea is true.\n"
        "RULE_STATUS=Competing or opposite style rules may also be valid in different contexts; evaluate with UNKNOWN/NO/UNLIKELY/MAYBE/LIKELY/YES reasoning.\n"
        "GRAMMAR_HINT=Capitalization and terminal punctuation are evidence, not absolute proof, of a proper sentence; imperatives may have an implicit subject.\n"
        "UTILITY_RULE=Do not degrade code, filenames, commands, math, or other task-critical information merely to imitate malformed input.\n"
        "MIXED_COMPLEXITY=Complex material may contain multiple complexity bands and can be decomposed rather than forced into one grade-equivalent label.\n"
        "[/INTERPRETATION_SCAFFOLD]"
    )


def _hardware_context_relevant(text):
    return bool(re.search(
        r"\b(?:l1|l2|l3|gpu|npu|cpu|cache|ledger|prediction|queue|daemon|orchestrator|scheduler|training|inference|device|hardware|clutch|halt|route|routing)\b",
        str(text or ""), re.I
    ))


def check_internal_cache_state(query_text="", max_chars=1200, daemon_active=None):
    """Bounded, relevance-gated L1/L2/L3 operational context.

    L1 = GPU fast prediction cache, L2 = NPU intermediate queue,
    L3 = CPU general-control/fallback/clutch.  Retained files are explicitly
    marked stale/not-live when the local daemon is inactive.
    """
    if not _hardware_context_relevant(query_text):
        return ""
    active = bool(daemon_active)
    state = "ACTIVE" if active else "INACTIVE_RETAINED"
    parts = [
        "[HARDWARE_CACHE_STATE]",
        f"DAEMON_STATE={state}",
        "SEMANTICS=L1 GPU fast prediction; L2 NPU intermediate queue/reflection; L3 CPU general-control/fallback/clutch.",
        "SEPARATION=IR1/IR2/IR3 are transient input registers and are not hardware cache layers.",
    ]

    l1_predictions = os.path.join(GPU_DIR, "predictions.txt")
    if os.path.isfile(l1_predictions):
        try:
            txt = Path(l1_predictions).read_text(encoding="utf-8", errors="ignore")[-400:]
            parts.append("L1_PREDICTIONS=" + txt.replace("\n", " | "))
        except Exception:
            pass

    if os.path.isdir(NPU_DIR):
        try:
            queued = [n for n in os.listdir(NPU_DIR) if not n.startswith(".")][:12]
            if queued:
                parts.append("L2_QUEUE_FILES=" + ", ".join(queued))
        except Exception:
            pass

    l3_clutch = os.path.join(CPU_DIR, "kqkkqq.txt")
    if os.path.isfile(l3_clutch):
        try:
            txt = Path(l3_clutch).read_text(encoding="utf-8", errors="ignore")[-400:]
            parts.append("L3_CLUTCH_TAIL=" + txt.replace("\n", " | "))
        except Exception:
            pass

    if not active:
        parts.append("STALE_RULE=Existing ledgers may be useful retained state but do not imply active processing.")
    parts.append("USE_RULE=Do not inject cache state merely because a file exists; use it only when relevant to the current task.")
    parts.append("DURABILITY=Operational cache context is transient and must not automatically become semantic memory or a live-training target.")
    parts.append("[/HARDWARE_CACHE_STATE]")
    return "\n".join(parts)[:max_chars]


# ── SOURCE USE / PROVENANCE FRAMEWORK ────────────────────────────────────────
# The low-friction rule is intentional:
#   no meaningful provenance signal -> LEGACY_NORMAL -> preserve old behavior.
# A signal is evidence to interpret, not an accusation and not automatically a
# legal conclusion.  The same source identity can be revised when later evidence
# appears, while historical classifications remain append-only provenance events.
