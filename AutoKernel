                    if name in ignored: continue
                    candidate=os.path.join(root,name)
                    try: mt=os.path.getmtime(candidate)
                    except OSError: continue
                    if mt>latest_mtime:
                        latest_mtime=mt
                        latest_path=candidate
        except OSError:
            pass
    if not latest_path:
        return "",""
    try: rel=os.path.relpath(latest_path,CODE_DIR)
    except Exception: rel=latest_path
    return rel,time.strftime("%Y-%m-%d %H:%M:%S",time.localtime(latest_mtime))

def _prog_session_update(project,**changes):
    project=_prog_safe_name(project)
    data=_prog_session_load(project)
    data.update(changes)
    data["project"]=project
    meta=_prog_read_metadata(project)
    if meta: data["language"]=meta.get("language",data.get("language",""))
    data["updated_at"]=time.strftime("%Y-%m-%dT%H:%M:%S")
    last_file,last_time=_prog_latest_file(project)
    if last_file:
        data["last_updated_file"]=last_file
        data["last_updated_time"]=last_time
    path=_prog_session_path(project)
    os.makedirs(os.path.dirname(path),exist_ok=True)
    try: Path(path).write_text(json.dumps(data,indent=2)+"\n",encoding="utf-8")
    except OSError: pass
    return data

def _prog_project_open(project):
    state=_prog_session_load(project)
    return state.get("status")=="running"

def _prog_start_project(project,resume=False):
    global programmer_mode_enabled, active_programmer_project, current_mode, mode_history
    project=_prog_safe_name(project)
    meta=_prog_read_metadata(project)
    if not meta:
        return False,f"No project metadata found for {project}."
    previous=_prog_session_load(project)
    status="running"
    state=_prog_session_update(
        project,status=status,
        opened_at=(previous.get("opened_at") or time.strftime("%Y-%m-%dT%H:%M:%S")),
        last_operation=("resume" if resume else "start"),
        last_error="",
        progress=0,progress_label=("RESUMED" if resume else "STARTED")
    )
    _set_programmer_project_active(project,meta.get("language"),True)
    active_programmer_project=project
    programmer_mode_enabled=True
    current_mode="programmer"
    if not mode_history or mode_history[-1]!="programmer":
        mode_history.append("programmer")
    _prog_gui_update(project,0,state["progress_label"])
    return True,state

def _prog_pause_project(project):
    global active_programmer_project, programmer_mode_enabled
    project=_prog_safe_name(project)
    if not _prog_read_metadata(project):
        return False,f"No project metadata found for {project}."
    state=_prog_session_update(project,status="paused",last_operation="pause",progress=0,progress_label="PAUSED")
    active_programmer_project=project
    programmer_mode_enabled=True
    _prog_gui_update(project,0,"PAUSED")
    return True,state

def _prog_stop_project(project):
    global active_programmer_project, programmer_mode_enabled, current_mode
    project=_prog_safe_name(project)
    meta=_prog_read_metadata(project)
    if not meta:
        return False,f"No project metadata found for {project}."
    state=_prog_session_update(project,status="stopped",last_operation="stop",progress=0,progress_label="STOPPED")
    _set_programmer_project_active(project,meta.get("language"),False)
    if active_programmer_project==project:
        active_programmer_project=None
    programmer_mode_enabled=False
    if current_mode=="programmer":
        current_mode=mode_history[-2] if len(mode_history)>1 else "normal"
    _prog_gui_update(project,0,"STOPPED")
    return True,state

def _prog_language_prompt(project):
    meta=_prog_read_metadata(project)
    language=str(meta.get("language","")).lower()
    layout=_programmer_layout(language) or {}
    prompt=str(layout.get("qwen prompt","") or "").strip()
    if not prompt:
        prompt=f"You are the coding engine for a {language} project. Generate only artifacts appropriate to {language} and use only the declared AItech project stage paths."
    return prompt

def _prog_allowed_filename(stage,filename,layout):
    filename=os.path.basename(filename)
    if not filename or filename in (".",".."): return False
    allowed=layout.get(stage,[]) or []
    if not allowed:
        return stage=="comments"
    lower=filename.lower()
    for item in allowed:
        item=str(item).strip()
        if not item: continue
        if item.startswith(".") and lower.endswith(item.lower()): return True
        if filename==item: return True
        if item.lower() in ("binary","executable") and "." not in filename: return True
    # configure intentionally may need helper scripts or text-like files generated
    # from a language-specific prompt; source/build/program remain strict.
    return stage=="configure" and any(filename.endswith(ext) for ext in (".sh",".txt",".md",".json",".toml",".mk",".cmake",".mf",".env"))

def _prog_generation_prompt(project,developer_request):
    project=_prog_safe_name(project)
    meta=_prog_read_metadata(project)
    if not meta:
        raise ValueError(f"No project metadata found for {project}.")
    language=str(meta.get("language","")).lower()
    layout=_programmer_layout(language) or {}
    paths=_prog_paths(project)
    comments=_prog_read_comments(project,6000)
    return f"""<AItechProgrammerProject>
PROJECT={project}
LANGUAGE={language}
HOST_OS={meta.get('host_os',sys.platform)}
HOST_ARCH={meta.get('host_arch',(os.uname().machine if hasattr(os,'uname') else 'unknown'))}
TOOLCHAIN={meta.get('asm_toolchain','language default')}
SESSION_STATUS={_prog_session_load(project).get('status')}
ROOT={CODE_DIR}
SOURCE={paths['source']}
CONFIGURE={paths['configure']}
BUILD={paths['build']}
PROGRAM={paths['program']}
COMMENTS={paths['comments']}
LAYOUT_SOURCE={layout.get('source',[])}
LAYOUT_CONFIGURE={layout.get('configure',[])}
LAYOUT_BUILD={layout.get('build',[])}
LAYOUT_PROGRAM={layout.get('program',[])}
LAYOUT_COMMENTS={layout.get('comments',[])}
LANGUAGE_QWEN_PROMPT={_prog_language_prompt(project)}

HARD CONTRACT:
- The request is about PROJECT={project} and LANGUAGE={language}.
- Do not silently substitute another programming language.
- Do not write outside this project's five folders.
- Return every editable file to create/update using EXACTLY:
  <progfile stage="source|configure|build|program|comments" path="relative_filename">FILE CONTENT</progfile>
- path must be relative and must not contain .. or an absolute path.
- Respect programmer.prefs file-type placement for this language.
- Do not claim a file was written unless you emitted a progfile record.
- Build artifacts such as .o/.class/.jar/binaries should normally be produced by build commands rather than fabricated as text.
- Existing project comments are historical context and should be consulted when restoring behavior.

PROJECT COMMENTS:
{comments}
</AItechProgrammerProject>

<DeveloperRequest>
{developer_request}
<${DEV_KERNEL}eloperRequest>
"""


def _prog_candidate_path(project):
    return os.path.join(_prog_paths(project)["comments"],"pending_generation.json")

def _prog_save_candidate(project,response_text,request="",status="pending",source="generation"):
    project=_prog_safe_name(project)
    data={
        "project":project,
        "language":_prog_read_metadata(project).get("language",""),
        "response":str(response_text or ""),
        "request":str(request or ""),
        "status":status,
        "source":source,
        "updated_at":time.strftime("%Y-%m-%dT%H:%M:%S"),
    }
    path=_prog_candidate_path(project)
    os.makedirs(os.path.dirname(path),exist_ok=True)
    try: Path(path).write_text(json.dumps(data,indent=2)+"\n",encoding="utf-8")
    except OSError: pass
    return data

def _prog_load_candidate(project):
    project=_prog_safe_name(project)
    try:
        path=_prog_candidate_path(project)
        if os.path.isfile(path):
            data=json.loads(Path(path).read_text(encoding="utf-8",errors="ignore"))
            if isinstance(data,dict): return data
    except Exception:
        pass
    return {}

def _prog_candidate_code(text):
    """Extract the developer-visible code body while preserving raw code when no fence exists."""
    raw=str(text or "").strip()
    if not raw: return ""
    fenced=re.findall(r"```(?:[A-Za-z0-9_+.-]+)?\s*\n(.*?)```",raw,re.S)
    if fenced:
        return max(fenced,key=len).strip()
    # Remove common assistant framing but do not rewrite the candidate.
    lines=raw.splitlines()
    while lines and lines[0].strip().lower().startswith(("here is","here's","sure","certainly")):
        lines.pop(0)
    return "\n".join(lines).strip()

def _prog_primary_editable_target(project):
    project=_prog_safe_name(project)
    meta=_prog_read_metadata(project)
    language=str(meta.get("language","")).lower()
    artifacts=meta.get("artifacts") or {}
    paths=_prog_paths(project)
    if language=="asm":
        name=artifacts.get("source") or ("main.s" if meta.get("host_os")=="darwin" and meta.get("host_arch") in ("arm64","aarch64") else "main.asm")
        return "source",str(name)
    if language=="c":
        return "source",str(artifacts.get("source") or "main.c")
    if language=="java":
        return "build",str(artifacts.get("build") or "Main.java")
    if language=="bash":
        return "program",str(artifacts.get("program") or (project+".sh"))
    if language=="python":
        return "program",str(artifacts.get("program") or (project+".py"))
    layout=_programmer_layout(language) or {}
    # For custom languages, pick the first concrete extension in source, then build/program.
    for stage in ("source","build","program"):
        for item in layout.get(stage,[]) or []:
            if str(item).startswith("."):
                return stage,"main"+str(item)
    return "source","main.txt"


def _prog_existing_editable_files(project):
    project=_prog_safe_name(project)
    layout=_programmer_layout(_prog_read_metadata(project).get("language","")) or {}
    found=[]
    ignored={"aitech_project.json","token_ledger.json","project_session.json","pending_generation.json","README.txt"}
    for stage in ("source","configure","build","program","comments"):
        root=_prog_paths(project)[stage]
        try:
            for walk_root,_,files in os.walk(root):
                for name in files:
                    if name in ignored: continue
                    rel=os.path.relpath(os.path.join(walk_root,name),root)
                    if _prog_allowed_filename(stage,name,layout):
                        found.append((stage,rel))
        except OSError:
            pass
    return found

def _prog_candidate_target(project,candidate):
    """
    Resolve the destination only when the candidate already supplies one or the
    developer's request clearly refers to an existing project file.

    Return (stage, relpath, needs_filename).
    """
    project=_prog_safe_name(project)
    response=str(candidate.get("response","") or "")
    records=re.findall(r'<progfile\s+stage="([^"]+)"\s+path="([^"]+)">(.*?)</progfile>',response,re.S|re.I)
    if records:
        # The model already supplied a filename. Validation still happens later.
        stage,rel,_=records[0]
        return stage.strip().lower(),rel.strip().replace("\\","/"),False

    # A rewrite is explicitly based on the project's current primary artifact,
    # therefore it is a modification rather than an unnamed new file.
    if str(candidate.get("source","")).lower()=="rewrite":
        stage,rel=_prog_primary_editable_target(project)
        return stage,rel,False

    request=str(candidate.get("request","") or "")
    request_lower=request.lower()
    existing=_prog_existing_editable_files(project)

    # If the developer explicitly named an existing filename/path in the
    # generating request, resolve it as a modification.
    matches=[]
    for stage,rel in existing:
        base=os.path.basename(rel)
        if base.lower() in request_lower or rel.lower() in request_lower:
            matches.append((stage,rel))
    if len(matches)==1:
        return matches[0][0],matches[0][1],False

    # Verbs that strongly imply editing may use the sole existing primary
    # editable artifact, but only when the target is unambiguous.
    edit_words=("modify","update","fix","debug","repair","change","edit","refactor","rewrite")
    if any(word in request_lower for word in edit_words):
        primary_stage,primary_rel=_prog_primary_editable_target(project)
        primary_path=os.path.join(_prog_paths(project)[primary_stage],primary_rel)
        if os.path.isfile(primary_path):
            return primary_stage,primary_rel,False

    # Initial raw generation has no trustworthy filename. The developer chooses.
    return None,None,True

def _prog_stage_for_new_filename(project,filename):
    """Choose the unique stage allowed by programmer.prefs for a new filename."""
    project=_prog_safe_name(project)
    filename=os.path.basename(str(filename or "").strip())
    if not filename:
        return None,"Filename is empty."
    if filename in (".","..") or "/" in filename or "\\" in filename:
        return None,"Use a filename only, not a path."
    layout=_programmer_layout(_prog_read_metadata(project).get("language","")) or {}
    matches=[]
    for stage in ("source","configure","build","program","comments"):
        if _prog_allowed_filename(stage,filename,layout):
            matches.append(stage)
    # Prefer the language's normal editable stages when generic configure rules
    # would otherwise make a source filename appear ambiguous.
    preferred=[s for s in ("source","build","program") if s in matches]
    if len(preferred)==1:
        return preferred[0],None
    if len(matches)==1:
        return matches[0],None
    if not matches:
        return None,f"Filename {filename} does not match this language's programmer.prefs layout."
    return None,f"Filename {filename} is ambiguous across stages: {', '.join(matches)}."

def _prog_inject_wrapper(project,stage,rel,response_text):
    """Construct the missing canonical progfile envelope before validation/write."""
    body=_prog_candidate_code(response_text)
    if not body:
        return ""
    return f'<progfile stage="{stage}" path="{rel}">\n{body.rstrip()}\n</progfile>'

def _prog_write_candidate(project,filename=None):
    project=_prog_safe_name(project)
    if not _prog_project_open(project):
        return False,f"Project {project} is not running. Use prog resume {project}."
    candidate=_prog_load_candidate(project)
    response=str(candidate.get("response","") or "")
    if not response:
        return False,"No pending generation candidate exists."

    stage,rel,needs_filename=_prog_candidate_target(project,candidate)
    if needs_filename:
        if not filename:
            return False,{
                "need_filename":True,
                "message":"Pending candidate is an unnamed new file. Enter the filename to commit it.",
                "language":_prog_read_metadata(project).get("language",""),
                "layout":_programmer_layout(_prog_read_metadata(project).get("language","")) or {},
            }
        rel=os.path.basename(str(filename).strip())
        stage,error=_prog_stage_for_new_filename(project,rel)
        if error:
            return False,error

    layout=_programmer_layout(_prog_read_metadata(project).get("language","")) or {}
    if stage not in ("source","configure","build","program","comments"):
        return False,f"Unknown project stage: {stage}"
    if rel.startswith("/") or rel.startswith("~") or ".." in Path(rel).parts:
        return False,f"Unsafe project filename/path: {rel}"
    if not _prog_allowed_filename(stage,os.path.basename(rel),layout):
        return False,f"{stage}/{rel} conflicts with programmer.prefs."

    # If the model omitted the envelope, inject it manually. The result then
    # passes through the exact same structured validator used by normal Qwen
    # generation instead of bypassing that safety/path contract.
    records=re.findall(r'<progfile\s+stage="([^"]+)"\s+path="([^"]+)">(.*?)</progfile>',response,re.S|re.I)
    if records:
        wrapped=response
    else:
        wrapped=_prog_inject_wrapper(project,stage,rel,response)
        if not wrapped:
            return False,"Pending candidate contains no writable code."
        candidate["response"]=wrapped
        candidate["wrapper_injected"]=True
        candidate["wrapper_injected_at"]=time.strftime("%Y-%m-%dT%H:%M:%S")
        candidate["resolved_stage"]=stage
        candidate["resolved_filename"]=rel
        try: Path(_prog_candidate_path(project)).write_text(json.dumps(candidate,indent=2)+"\n",encoding="utf-8")
        except OSError: pass

    _prog_gui_update(project,25,f"VALIDATING WRITE {stage}/{rel}")
    ok,details=_prog_apply_generation(project,wrapped)
    if not ok:
        return False,"; ".join(str(x) for x in details)

    written_match=None
    expected=os.path.join(stage,project,rel)
    for detail in details:
        if str(detail).replace("\\","/").endswith(f"{stage}/{project}/{rel}".replace("\\","/")):
            written_match=str(detail)
            break
    candidate=_prog_load_candidate(project) or candidate
    candidate["status"]="written"
    candidate["written_to"]=written_match or expected
    candidate["written_at"]=time.strftime("%Y-%m-%dT%H:%M:%S")
    try: Path(_prog_candidate_path(project)).write_text(json.dumps(candidate,indent=2)+"\n",encoding="utf-8")
    except OSError: pass
    _prog_session_update(project,last_operation="candidate write",last_error="",progress=100,progress_label="WRITE COMPLETE")
    _prog_gui_update(project,100,"WRITE COMPLETE",compiler_output=f"Wrote candidate -> {candidate['written_to']}")
    return True,candidate["written_to"]

def _prog_project_file_context(project,max_chars=18000):
    project=_prog_safe_name(project)
    chunks=[]; used=0
    ignored={"aitech_project.json","token_ledger.json","project_session.json","pending_generation.json"}
    for stage,path in _prog_paths(project).items():
        try:
            for root,_,files in os.walk(path):
                for name in sorted(files):
                    if name in ignored: continue
                    fp=os.path.join(root,name)
                    try:
                        body=Path(fp).read_text(encoding="utf-8",errors="ignore")
                    except Exception:
                        continue
                    rel=os.path.relpath(fp,CODE_DIR)
                    block=f"\n--- EXISTING {rel} ---\n{body}\n"
                    if used+len(block)>max_chars:
                        remaining=max_chars-used
                        if remaining>200: chunks.append(block[:remaining])
                        return "".join(chunks)
                    chunks.append(block); used+=len(block)
        except OSError:
            pass
    return "".join(chunks)

def _prog_rewrite_candidate(project,instructions):
    project=_prog_safe_name(project)
    if not _prog_project_open(project):
        return False,f"Project {project} is not running. Use prog resume {project}."
    candidate=_prog_load_candidate(project)
    previous=str(candidate.get("response","") or "")
    if not previous:
        return False,"No previous generated candidate exists to rewrite."
    instructions=str(instructions or "").strip()
    if not instructions:
        return False,"Usage: rewrite <instructions>"
    meta=_prog_read_metadata(project)
    language=meta.get("language","")
    context=_prog_project_file_context(project)
    prompt=f"""<AItechProgrammerRewrite>
PROJECT={project}
LANGUAGE={language}
LANGUAGE_QWEN_PROMPT={_prog_language_prompt(project)}
PRIMARY_TARGET={_prog_primary_editable_target(project)}
The developer is debugging/revising the most recent candidate.
Compare the candidate against the project's current files and comments.
Apply the rewrite instructions while preserving the project's language, host/toolchain, folder conventions, and intended behavior.
Return ONLY the complete revised candidate source text for the primary editable artifact. Do not use markdown fences and do not emit <progfile> tags.

<PreviousCandidate>
{previous}
</PreviousCandidate>

<ProjectFiles>
{context}
</ProjectFiles>

<RewriteInstructions>
{instructions}
</RewriteInstructions>
</AItechProgrammerRewrite>"""
    _prog_session_update(project,last_operation="rewrite",last_error="",progress=10,progress_label="REWRITE START")
    _prog_gui_update(project,10,"REWRITE START")
    _prog_record_text_tokens(project,instructions,"rewrite_instruction","developer rewrite")
    try:
        _prog_gui_update(project,35,"QWEN REWRITING")
        reply=ping_qwen(prompt,explicit=True)
    except Exception as exc:
        msg=str(exc)
        _prog_session_update(project,last_operation="rewrite",last_error=msg,progress=0,progress_label="REWRITE ERROR")
        _prog_gui_update(project,0,"REWRITE ERROR",compiler_output=msg,error=msg)
        return False,msg
    _prog_save_candidate(project,reply,request=instructions,status="pending",source="rewrite")
    _prog_record_text_tokens(project,reply,"rewrite_output","rewritten candidate")
    _prog_session_update(project,last_operation="rewrite",last_error="",progress=100,progress_label="REWRITE CANDIDATE READY")
    _prog_gui_update(project,100,"REWRITE CANDIDATE READY",compiler_output=reply)
    return True,reply

def _prog_apply_generation(project,response_text):
    project=_prog_safe_name(project)
    meta=_prog_read_metadata(project)
    language=str(meta.get("language","")).lower()
    layout=_programmer_layout(language) or {}
    records=re.findall(r'<progfile\s+stage="([^"]+)"\s+path="([^"]+)">(.*?)</progfile>',str(response_text),re.S|re.I)
    if not records:
        return False,["Qwen returned no <progfile> records; no project files were changed."]
    written=[]; errors=[]
    total=len(records)
    for index,(stage,rel,body) in enumerate(records,1):
        stage=stage.strip().lower()
        rel=rel.strip().replace("\\","/")
        pct=min(90,20+int(index/max(1,total)*65))
        _prog_gui_update(project,pct,f"WRITING {stage}/{rel}")
        if stage not in ("source","configure","build","program","comments"):
            errors.append(f"rejected unknown stage: {stage}")
            continue
        if rel.startswith("/") or rel.startswith("~") or ".." in Path(rel).parts:
            errors.append(f"rejected unsafe path: {rel}")
            continue
        if "/" in rel:
            # nested files are allowed but extension is validated from basename.
            filename=os.path.basename(rel)
        else:
            filename=rel
        if not _prog_allowed_filename(stage,filename,layout):
            errors.append(f"rejected {stage}/{rel}: file type does not match [{language}] programmer.prefs")
            continue
        target=os.path.abspath(os.path.join(_prog_paths(project)[stage],rel))
        root=os.path.abspath(_prog_paths(project)[stage])
        if os.path.commonpath([target,root])!=root:
            errors.append(f"rejected path outside project stage: {rel}")
            continue
        os.makedirs(os.path.dirname(target),exist_ok=True)
        try:
            Path(target).write_text(body.lstrip("\n").rstrip()+"\n",encoding="utf-8")
            written.append(os.path.relpath(target,CODE_DIR))
        except OSError as exc:
            errors.append(f"{stage}/{rel}: {exc}")
    if written:
        _prog_record_text_tokens(project,response_text,"generation_output","structured progfile generation")
    last_error="; ".join(errors)
    _prog_session_update(
        project,last_operation="generation",
        last_error=last_error,
        progress=(100 if written and not errors else 95 if written else 0),
        progress_label=("GENERATION COMPLETE" if written and not errors else "GENERATION PARTIAL" if written else "GENERATION FAILED")
    )
    _prog_gui_update(project,100 if written else 0,"GENERATION COMPLETE" if written else "GENERATION FAILED",error=last_error)
    return bool(written),written+errors


def _prog_generate_request(project,developer_request):
    project=_prog_safe_name(project)
    if not _prog_project_open(project):
        return False,f"Project {project} is not running. Use prog start {project} or prog resume {project}."
    request=str(developer_request or "").strip()
    if not request:
        return False,"Empty developer request."
    meta=_prog_read_metadata(project)
    language=meta.get("language","")
    _prog_session_update(project,last_operation="generation",last_error="",progress=5,progress_label="GENERATION START")
    _prog_gui_update(project,5,f"GENERATING {language.upper()}")
    full_prompt=_prog_generation_prompt(project,request)
    _prog_record_text_tokens(project,request,"developer_prompt","bound project generation request")
    try:
        _prog_gui_update(project,20,"QWEN GENERATING")
        reply=ping_qwen(full_prompt,explicit=True)
    except Exception as exc:
        msg=str(exc)
        _prog_session_update(project,last_error=msg,progress=0,progress_label="GENERATION ERROR")
        _prog_gui_update(project,0,"GENERATION ERROR",compiler_output=msg,error=msg)
        return False,msg
    _prog_gui_update(project,65,"QWEN RESPONSE RECEIVED",compiler_output=reply)
    # Always retain the latest model output as a candidate, even when structured
    # validation succeeds. A rejected candidate can later be committed with
    # `write` or revised with `rewrite <instructions>`.
    _prog_save_candidate(project,reply,request=request,status="pending",source="generation")
    ok,details=_prog_apply_generation(project,reply)
    if not ok:
        _prog_session_update(project,last_operation="generation candidate",last_error="structured write rejected; candidate retained",progress=100,progress_label="CANDIDATE READY")
        _prog_gui_update(project,100,"CANDIDATE READY",compiler_output=reply,error="Structured generation rejected; type write to commit candidate or rewrite <instructions>.")
        _prog_add_comment(project,"generation",f"Generation did not produce acceptable structured project files; candidate retained for write/rewrite. Request: {request}",snippet=reply[:12000],relation=f"project={project}; language={language}",feature="generation routing",status="candidate")
    return ok,{"reply":reply,"details":details}

def _prog_gui_update(project,progress,label,compiler_output="",error=""):
    """Publish project state through existing asciiart/textart GUI protocol."""
    project=_prog_safe_name(project)
    state=_prog_session_update(project,progress=int(progress),progress_label=str(label),last_error=(str(error) if error else _prog_session_load(project).get("last_error","")))
    meta=_prog_read_metadata(project)
    language=meta.get("language","")
    ledger=_prog_load_token_ledger(project)
    last_file=state.get("last_updated_file") or "(none)"
    last_time=state.get("last_updated_time") or "(none)"
    # Compiler/generation output temporarily owns the ASCII-art panel.
    if compiler_output:
        lines=str(compiler_output).splitlines()[-6:] or ["(no compiler output)"]
        write_art(*[f"[PROG] {line}" for line in lines])
    else:
        write_art(
            f"PROG {project} [{language}] {state.get('status','')}",
            f"{label} {int(progress)}%",
            f"Last: {last_file}",
            f"Time: {last_time}",
            f"Error: {(state.get('last_error') or 'none')[:120]}",
        )
    # Keep the ordinary views and add a dedicated project view.
    update_gui_stats(int(progress),str(label),f"PROG {project}: {state.get('status','')}")
    try:
        with open(TEXTART,"a",encoding="utf-8") as f:
            f.write(
                "[VIEW:project] PROGRAMMER PROJECT\n"
                f"Project: {project} | Language: {language} | Session: {state.get('status','')}\n"
                f"Source: {_prog_paths(project)['source']}\n"
                f"Configure: {_prog_paths(project)['configure']}\n"
                f"Build: {_prog_paths(project)['build']}\n"
                f"Program: {_prog_paths(project)['program']}\n"
                f"Comments: {_prog_paths(project)['comments']}\n"
                f"Last updated: {last_file} @ {last_time}\n"
                f"Last operation: {state.get('last_operation','none')}\n"
                f"Last error: {state.get('last_error') or 'none'}\n"
                f"Processed tokens: {ledger.get('processed_tokens',0)} | Value: {ledger.get('valuation',{}).get('token_attention_score',0)}\n"
                "[/VIEW]\n"
            )
    except OSError:
        pass

def _prog_comment_slug(filetype):
    """Normalize a referenced file/artifact type into a stable comments filename."""
    raw=str(filetype or "general").strip()
    if not raw:
        raw="general"
    # Keep a useful visual hint while avoiding path traversal and separators.
    clean=re.sub(r"[^A-Za-z0-9._+-]+","_",raw).strip("._")
    return clean[:64] or "general"

def _prog_comment_file(project,filetype):
    project=_prog_safe_name(project)
    return os.path.join(_prog_paths(project)["comments"],_prog_comment_slug(filetype)+".comments.txt")

def _prog_add_comment(project,filetype,comment,snippet="",relation="",feature="",status="note"):
    """
    Append durable project context. One file groups context by the artifact/file
    type it concerns (java, c, h, asm, jar, sh, etc.) and preserves enough detail
    to understand removed/restored features later.
    """
    project=_prog_safe_name(project)
    meta=_prog_read_metadata(project)
    if not meta:
        return False,f"No project metadata found for {project}."
    path=_prog_comment_file(project,filetype)
    os.makedirs(os.path.dirname(path),exist_ok=True)
    entry=[
        "=== AItech PROGRAMMER COMMENT ===",
        "timestamp: "+time.strftime("%Y-%m-%dT%H:%M:%S"),
        "project: "+project,
        "language: "+str(meta.get("language","unknown")),
        "regarding filetype: "+str(filetype or "general"),
        "status: "+str(status or "note"),
    ]
    if feature: entry.append("feature: "+str(feature))
    if relation: entry.append("relation: "+str(relation))
    entry.append("comment: "+str(comment or "").strip())
    if snippet:
        entry += ["snippet:", "```", str(snippet).rstrip(), "```"]
    entry += ["=== END COMMENT ===",""]
    try:
        with open(path,"a",encoding="utf-8") as f:
            f.write("\n".join(entry))
        return True,path
    except OSError as exc:
        return False,str(exc)

def _prog_read_comments(project,max_chars=12000):
    project=_prog_safe_name(project); cdir=_prog_paths(project)["comments"]
    if not os.path.isdir(cdir): return ""
    chunks=[]; used=0
    try: names=sorted(os.listdir(cdir))
    except OSError: return ""
    for name in names:
        path=os.path.join(cdir,name)
        if not os.path.isfile(path): continue
        try: body=Path(path).read_text(encoding="utf-8",errors="ignore")
        except OSError: continue
        if not body: continue
        remaining=max_chars-used
        if remaining<=0: break
        block=f"\n--- COMMENTS: {name} ---\n{body[:remaining]}"
        chunks.append(block); used+=len(block)
    return "".join(chunks)

def _prog_list_projects():
    names=set()
    for root in (CODE_SOURCE_DIR,CODE_CONFIGURE_DIR,CODE_BUILD_DIR,CODE_PROGRAM_DIR,CODE_COMMENTS_DIR):
        try: names.update(x for x in os.listdir(root) if os.path.isdir(os.path.join(root,x)))
        except OSError: pass
    return sorted(names)


def _prog_resolve_source_file(project,filename):
    project=_prog_safe_name(project)
    filename=str(filename or "").strip().strip("<>")
    if not filename:
        return None,None,"Filename is required."
    if os.path.isabs(filename) or ".." in Path(filename).parts:
        return None,None,"Unsafe filename/path."
    # Explicit stage-relative paths are allowed if they remain inside this project.
    source_root=os.path.abspath(_prog_paths(project)["source"])
    build_root=os.path.abspath(_prog_paths(project)["build"])
    candidates=[]
    if "/" in filename or "\\" in filename:
        rel=filename.replace("\\","/")
        for stage,root in (("source",source_root),("build",build_root)):
            target=os.path.abspath(os.path.join(root,rel))
            if os.path.commonpath([target,root])==root and os.path.isfile(target):
                candidates.append((stage,target))
    else:
        for stage,root in (("source",source_root),("build",build_root)):
            target=os.path.join(root,filename)
            if os.path.isfile(target):
                candidates.append((stage,target))
    if len(candidates)==1:
        return candidates[0][0],candidates[0][1],None
    if len(candidates)>1:
        return None,None,f"Filename {filename} exists in more than one editable stage; specify the stage-relative path."
    return None,None,f"Project file not found: {filename}"

def _prog_stage_names(filename):
    name=os.path.basename(str(filename or "").strip().strip("<>"))
    stem=os.path.splitext(name)[0] or name
    return name,stem

def _prog_compile_script_path(project,filename):
    _,stem=_prog_stage_names(filename)
    return os.path.join(_prog_paths(project)["configure"],f"{stem}.compile.sh")

def _prog_object_path(project,filename):
    _,stem=_prog_stage_names(filename)
    meta=_prog_read_metadata(project); lang=str(meta.get("language","")).lower()
    if lang=="java":
        return os.path.join(_prog_paths(project)["source"],stem+".class")
    return os.path.join(_prog_paths(project)["build"],stem+".o")

def _prog_binary_path(project,filename):
    _,stem=_prog_stage_names(filename)
    meta=_prog_read_metadata(project); lang=str(meta.get("language","")).lower()
    if lang=="java":
        return os.path.join(_prog_paths(project)["program"],stem+".jar")
    if lang=="bash":
        return os.path.join(_prog_paths(project)["program"],os.path.basename(filename))
    if lang=="python":
        return os.path.join(_prog_paths(project)["program"],os.path.basename(filename))
    return os.path.join(_prog_paths(project)["program"],stem)

def _prog_configure_file(project,filename):
    project=_prog_safe_name(project)
    if not _prog_project_open(project):
        return False,f"Project {project} is not running. Use prog resume {project}."
    stage,source,error=_prog_resolve_source_file(project,filename)
    if error: return False,error
    meta=_prog_read_metadata(project); lang=str(meta.get("language","")).lower()
    _,stem=_prog_stage_names(filename)
    obj=_prog_object_path(project,filename)
    script=_prog_compile_script_path(project,filename)
    os.makedirs(os.path.dirname(script),exist_ok=True)
    if lang=="asm":
        host_os=str(meta.get("host_os",sys.platform)).lower()
        host_arch=str(meta.get("host_arch","")).lower()
        if host_os=="darwin" and host_arch in ("arm64","aarch64"):
            command=f'clang -arch arm64 -c "{source}" -o "{obj}"'
        elif host_os=="darwin":
            command=f'nasm -f macho64 "{source}" -o "{obj}"'
        else:
            command=f'nasm -f elf64 "{source}" -o "{obj}"'
    elif lang=="c":
        command=f'cc -c "{source}" -o "{obj}"'
    elif lang=="java":
        # Preserve AItech's intentional Java layout: editable .java in build,
        # compiled .class in source.
        command=f'javac -d "{_prog_paths(project)["source"]}" "{source}"'
    elif lang in ("bash","python"):
        return False,f"{lang} is directly runnable and does not compile to an object file."
    else:
        return False,f"configure<{filename}> has no deterministic compiler rule for language [{lang}]. Add a language-specific compiler rule first."
    content=(
        "#!/usr/bin/env bash\nset -e\n"
        f"# AItech v0.1.42 compile stage | project={project} | language={lang} | input={os.path.basename(source)}\n"
        f'mkdir -p "{_prog_paths(project)["build"]}"\n'
        +command+"\n"
        +f'echo "{obj}"\n'
    )
    Path(script).write_text(content,encoding="utf-8")
    try: os.chmod(script,0o755)
    except OSError: pass
    _prog_session_update(project,last_operation=f"configure {filename}",last_error="",progress=100,progress_label="CONFIGURE COMPLETE")
    _prog_gui_update(project,100,"CONFIGURE COMPLETE",compiler_output=f"Generated compile script:\n{os.path.relpath(script,CODE_DIR)}\n{command}")
    return True,os.path.relpath(script,CODE_DIR)

def _prog_compile_file(project,filename):
    project=_prog_safe_name(project)
    script=_prog_compile_script_path(project,filename)
    if not os.path.isfile(script):
        return False,f"No compile script for {filename}. Run configure<{filename}> first."
    _prog_session_update(project,last_operation=f"compile {filename}",last_error="",progress=10,progress_label="COMPILE START")
    _prog_gui_update(project,10,"COMPILE START",compiler_output=f"$ {script}")
    try:
        _prog_gui_update(project,45,"COMPILING",compiler_output=f"Compiling {filename} -> build/{project}/")
        result=subprocess.run([script],cwd=os.path.dirname(script),stdout=subprocess.PIPE,stderr=subprocess.PIPE,text=True,timeout=1800)
        output=((result.stdout or "")+("\n"+result.stderr if result.stderr else "")).strip() or f"exit={result.returncode}"
        if result.returncode!=0:
            _prog_session_update(project,last_operation=f"compile {filename}",last_error=output,progress=100,progress_label="COMPILE FAILED")
            _prog_gui_update(project,100,"COMPILE FAILED",compiler_output=output,error=output)
            return False,output
        _prog_session_update(project,last_operation=f"compile {filename}",last_error="",progress=100,progress_label="COMPILE COMPLETE")
        _prog_gui_update(project,100,"COMPILE COMPLETE",compiler_output=output)
        return True,output
    except Exception as exc:
        msg=str(exc)
        _prog_session_update(project,last_operation=f"compile {filename}",last_error=msg,progress=0,progress_label="COMPILE ERROR")
        _prog_gui_update(project,0,"COMPILE ERROR",compiler_output=msg,error=msg)
        return False,msg

def _prog_build_file(project,filename):
    project=_prog_safe_name(project)
    if not _prog_project_open(project):
        return False,f"Project {project} is not running. Use prog resume {project}."
    meta=_prog_read_metadata(project); lang=str(meta.get("language","")).lower()
    obj=_prog_object_path(project,filename)
    binary=_prog_binary_path(project,filename)
    if lang=="java":
        # For Java, compile stage emits .class into source/ by AItech policy.
        class_dir=_prog_paths(project)["source"]
        classes=[x for x in os.listdir(class_dir) if x.endswith(".class")] if os.path.isdir(class_dir) else []
        if not classes: return False,f"No compiled .class files found. Run compile<{filename}> first."
        manifest=os.path.join(_prog_paths(project)["configure"],"MANIFEST.MF")
        main_class=os.path.splitext(os.path.basename(filename))[0]
        Path(manifest).write_text(f"Main-Class: {main_class}\n",encoding="utf-8")
        cmd=["jar","cfm",binary,manifest,"-C",class_dir,"."]
    else:
        if not os.path.isfile(obj):
            return False,f"Object file not found: {os.path.relpath(obj,CODE_DIR)}. Run compile<{filename}> first."
        if lang=="asm":
            host_os=str(meta.get("host_os",sys.platform)).lower()
            host_arch=str(meta.get("host_arch","")).lower()
            if host_os=="darwin":
                cmd=["clang"]+(["-arch","arm64"] if host_arch in ("arm64","aarch64") else [])+[obj,"-o",binary]
            else:
                cmd=["ld",obj,"-o",binary]
        elif lang=="c":
            cmd=["cc",obj,"-o",binary]
        else:
            return False,f"build<{filename}> has no deterministic linker rule for language [{lang}]."
    os.makedirs(os.path.dirname(binary),exist_ok=True)
    _prog_session_update(project,last_operation=f"build {filename}",last_error="",progress=15,progress_label="BUILD START")
    _prog_gui_update(project,15,"BUILD START",compiler_output="$ "+" ".join(cmd))
    try:
        result=subprocess.run(cmd,cwd=_prog_paths(project)["build"],stdout=subprocess.PIPE,stderr=subprocess.PIPE,text=True,timeout=1800)
        output=((result.stdout or "")+("\n"+result.stderr if result.stderr else "")).strip() or f"exit={result.returncode}"
        if result.returncode!=0:
            _prog_session_update(project,last_operation=f"build {filename}",last_error=output,progress=100,progress_label="BUILD FAILED")
            _prog_gui_update(project,100,"BUILD FAILED",compiler_output=output,error=output)
            return False,output
        if os.path.isfile(binary):
            try: os.chmod(binary,0o755)
            except OSError: pass
        _prog_session_update(project,last_operation=f"build {filename}",last_error="",progress=100,progress_label="BUILD COMPLETE")
        _prog_gui_update(project,100,"BUILD COMPLETE",compiler_output=f"{output}\n{os.path.relpath(binary,CODE_DIR)}")
        return True,os.path.relpath(binary,CODE_DIR)
    except Exception as exc:
        msg=str(exc)
        _prog_session_update(project,last_operation=f"build {filename}",last_error=msg,progress=0,progress_label="BUILD ERROR")
        _prog_gui_update(project,0,"BUILD ERROR",compiler_output=msg,error=msg)
        return False,msg

def _prog_terminal_command(binary,lang):
    if lang=="java" and str(binary).endswith(".jar"):
        return ["java","-jar",binary]
    if str(binary).endswith(".py"):
        return [sys.executable,binary]
    if str(binary).endswith(".sh"):
        return ["bash",binary]
    return [binary]

def _prog_test_file(project,filename):
    import shutil,shlex
    project=_prog_safe_name(project)
    binary=_prog_binary_path(project,filename)
    if not os.path.isfile(binary):
        return False,f"Built program not found: {os.path.relpath(binary,CODE_DIR)}. Run build<{filename}> first."
    lang=str(_prog_read_metadata(project).get("language","")).lower()
    cmd=_prog_terminal_command(binary,lang)
    quoted=" ".join(shlex.quote(x) for x in cmd) if "shlex" in globals() else " ".join(cmd)
    try:
        if sys.platform=="darwin":
            script=f'tell application "Terminal" to do script {json.dumps(quoted)}'
            subprocess.Popen(["osascript","-e",script],stdout=subprocess.DEVNULL,stderr=subprocess.DEVNULL)
        elif os.name=="nt":
            subprocess.Popen(["cmd","/c","start","cmd","/k"]+cmd)
        else:
            terminal=None
            for candidate in ("x-terminal-emulator","gnome-terminal","konsole","xterm"):
                if shutil.which(candidate):
                    terminal=candidate; break
            if not terminal:
                return False,"No supported terminal emulator found for test command."
            if terminal=="gnome-terminal":
                subprocess.Popen([terminal,"--","bash","-lc",quoted+"; echo; read -p 'Press Enter to close...'"])
            elif terminal=="konsole":
                subprocess.Popen([terminal,"-e","bash","-lc",quoted+"; echo; read -p 'Press Enter to close...'"])
            else:
                subprocess.Popen([terminal,"-e","bash","-lc",quoted+"; echo; read -p 'Press Enter to close...'"])
        _prog_session_update(project,last_operation=f"test {filename}",last_error="",progress=100,progress_label="TEST LAUNCHED")
        _prog_gui_update(project,100,"TEST LAUNCHED",compiler_output=f"New terminal: {quoted}")
        return True,quoted
    except Exception as exc:
        msg=str(exc)
        _prog_session_update(project,last_operation=f"test {filename}",last_error=msg,progress=0,progress_label="TEST ERROR")
        _prog_gui_update(project,0,"TEST ERROR",compiler_output=msg,error=msg)
        return False,msg

def _prog_list_code_folder(folder):
    raw=str(folder or "").strip().strip("<>").replace("\\","/")
    if not raw: raw="."
    if raw.startswith("/") or ".." in Path(raw).parts:
        return False,"list folder must stay inside AItech/code."
    target=os.path.abspath(os.path.join(CODE_DIR,raw))
    root=os.path.abspath(CODE_DIR)
    if os.path.commonpath([target,root])!=root:
        return False,"list folder must stay inside AItech/code."
    if not os.path.isdir(target):
        return False,f"Folder not found under code/: {raw}"
    rows=[]
    try:
        for name in sorted(os.listdir(target)):
            path=os.path.join(target,name)
            kind="dir" if os.path.isdir(path) else "file"
            try:
                stamp=time.strftime("%Y-%m-%d %H:%M:%S",time.localtime(os.path.getmtime(path)))
            except OSError:
                stamp="unknown"
            rows.append(f"{kind:4}  {name}  {stamp}")
    except OSError as exc:
        return False,str(exc)
    return True,(f"code/{raw.rstrip('/')}\n" if raw!="." else "code/\n")+("\n".join(rows) if rows else "(empty)")

def _prog_build(project):
