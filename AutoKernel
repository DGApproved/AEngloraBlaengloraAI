    print('ERROR\tExpected HOST:PORT, IP:PORT, or tcp://HOST:PORT[/filename]'); raise SystemExit(2)
host,port,path=m.group(1),int(m.group(2)),m.group(3) or ''
if not (1<=port<=65535): print('ERROR\tPort must be 1..65535'); raise SystemExit(2)
try:
    with socket.create_connection((host,port),timeout=20) as sock:
        sock.settimeout(20); chunks=[]; total=0
        while True:
            try:b=sock.recv(65536)
            except socket.timeout: raise RuntimeError('TCP source timed out before closing the response')
            if not b:break
            total+=len(b)
            if total>134217728: raise RuntimeError('remote update exceeds 128 MiB safety limit')
            chunks.append(b)
