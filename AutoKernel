    def _oc_prog_safe(name):
        clean=re.sub(r"[^A-Za-z0-9._-]+","_",str(name or "").strip()).strip("._-")
        return clean[:81] or "project"

    def _oc_prog_paths(project):
        project=_oc_prog_safe(project)
        return {
            "source":CODE_SOURCE/project,
            "configure":CODE_CONFIGURE/project,
            "build":CODE_BUILD/project,
            "program":CODE_PROGRAM/project,
            "comments":CODE_COMMENTS/project,
        }

    def _oc_prog_prefs():
        result={}; current=None
        if not PROGRAMMER_PREFS.is_file():
            return result
        try:
            for raw in PROGRAMMER_PREFS.read_text(encoding="utf-8",errors="ignore").splitlines():
                line=raw.strip()
                if not line or line.startswith("#"): continue
                if line.startswith("[") and line.endswith("]"):
                    current=line[1:-1].strip().lower()
                    if current:
                        result.setdefault(current,{"source":[],"configure":[],"build":[],"program":[],"comments":[],"qwen prompt":"","active projects":[]})
                    continue
                if current and "=" in line:
                    key,val=[x.strip() for x in line.split("=",1)]
                    key=key.lower()
                    if key in ("source","configure","build","program","comments"):
                        inner=val[1:-1] if val.startswith("[") and val.endswith("]") else val
                        result[current][key]=[x.strip() for x in inner.split(",") if x.strip()]
                    elif key=="qwen prompt":
                        result[current][key]=val.strip().strip('"').strip("'")
                    elif key=="active projects":
                        inner=val[1:-1] if val.startswith("{") and val.endswith("}") else val
                        result[current][key]=[x.strip() for x in inner.split(",") if x.strip()]
        except OSError:
            pass
        return result

    def _oc_prog_set_active(project,language,active=True):
        project=_oc_prog_safe(project); language=str(language or "").lower().strip()
        if not PROGRAMMER_PREFS.is_file(): return False
        lines=PROGRAMMER_PREFS.read_text(encoding="utf-8",errors="ignore").splitlines()
        inside=False
        for i,line in enumerate(lines):
            s=line.strip()
            if s.startswith("[") and s.endswith("]"):
                inside=(s[1:-1].strip().lower()==language); continue
            if inside and s.lower().startswith("active projects") and "=" in s:
                raw=s.split("=",1)[1].strip()
                inner=raw[1:-1] if raw.startswith("{") and raw.endswith("}") else raw
                projects=[x.strip() for x in inner.split(",") if x.strip()]
                if active and project not in projects: projects.append(project)
                if not active: projects=[x for x in projects if x!=project]
                lines[i]="active projects = {"+", ".join(projects)+"}"
                PROGRAMMER_PREFS.write_text("\n".join(lines)+"\n",encoding="utf-8")
                return True
        return False

    def _oc_prog_meta(project):
        for path in _oc_prog_paths(project).values():
            meta=path/"aitech_project.json"
            try:
                if meta.is_file():
                    return json.loads(meta.read_text(encoding="utf-8",errors="ignore"))
            except Exception:
                pass
        return {}

    def _oc_prog_write_meta(project,meta):
        for path in _oc_prog_paths(project).values():
            path.mkdir(parents=True,exist_ok=True)
            try: (path/"aitech_project.json").write_text(json.dumps(meta,indent=2)+"\n",encoding="utf-8")
            except OSError: pass

    def _oc_prog_ledger(project):
        project=_oc_prog_safe(project)
        path=_oc_prog_paths(project)["comments"]/"token_ledger.json"
        data={"project":project,"processed_tokens":0,"events":0,"by_activity":{},"valuation":{"token_attention_score":0.0,"interpretation":"no recorded model processing yet"}}
        try:
            if path.is_file():
                loaded=json.loads(path.read_text(encoding="utf-8",errors="ignore"))
                if isinstance(loaded,dict): data.update(loaded)
        except Exception: pass
        return data

    def _oc_prog_record_tokens(project,count,activity="orchestrator"):
        try: count=max(0,int(count))
        except Exception: count=0
        data=_oc_prog_ledger(project)
        if count<=0: return data
        data["processed_tokens"]=int(data.get("processed_tokens",0))+count
        data["events"]=int(data.get("events",0))+1
        by=dict(data.get("by_activity") or {})
        by[activity]=int(by.get(activity,0))+count
        data["by_activity"]=by
        score=round(__import__("math").log10(data["processed_tokens"]+1)*10.0 + min(data["events"],1000)*0.01,4)
        data["valuation"]={"token_attention_score":score,"interpretation":"orchestrator/model attention history; not a code-quality score"}
        data["last_update"]=time.strftime("%Y-%m-%dT%H:%M:%S")
        path=_oc_prog_paths(project)["comments"]/"token_ledger.json"
        path.parent.mkdir(parents=True,exist_ok=True)
        try: path.write_text(json.dumps(data,indent=2)+"\n",encoding="utf-8")
        except OSError: pass
        meta=_oc_prog_meta(project)
        if meta:
            meta["processed_tokens"]=data["processed_tokens"]
            meta["token_events"]=data["events"]
            meta["project_valuation"]=data["valuation"]
            _oc_prog_write_meta(project,meta)
        return data

    def _oc_prog_estimate_tokens(text):
        return max(1,(len(str(text or ""))+3)//4) if text else 0

    def _oc_prog_write_if_missing(path,content,executable=False):
        path=Path(path); path.parent.mkdir(parents=True,exist_ok=True)
        if path.exists(): return
        path.write_text(content,encoding="utf-8")
        if executable:
            try: path.chmod(0o755)
            except OSError: pass

    def _oc_prog_build_script(project,language):
        root='ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/../../.." && pwd)"\n'
        host_os=sys.platform.lower()
        host_arch=(os.uname().machine.lower() if hasattr(os,"uname") else "")
        if language=="asm":
            if host_os=="darwin" and host_arch in ("arm64","aarch64"):
                return "#!/usr/bin/env bash\nset -e\n"+root+(
                    f'SRC="$ROOT/code/source/{project}/main.s"\n'
                    f'OBJ="$ROOT/code/build/{project}/main.o"\n'
                    f'OUT="$ROOT/code/program/{project}/{project}"\n'
                    'mkdir -p "$(dirname "$OBJ")" "$(dirname "$OUT")"\n'
                    'clang -arch arm64 -c "$SRC" -o "$OBJ"\n'
                    'clang -arch arm64 "$OBJ" -o "$OUT"\nchmod +x "$OUT"\necho "$OUT"\n'
                )
            if host_os=="darwin":
                return "#!/usr/bin/env bash\nset -e\n"+root+(
                    f'SRC="$ROOT/code/source/{project}/main.asm"\n'
                    f'OBJ="$ROOT/code/build/{project}/main.o"\n'
                    f'OUT="$ROOT/code/program/{project}/{project}"\n'
                    'mkdir -p "$(dirname "$OBJ")" "$(dirname "$OUT")"\n'
                    'nasm -f macho64 "$SRC" -o "$OBJ"\nclang "$OBJ" -o "$OUT"\nchmod +x "$OUT"\necho "$OUT"\n'
                )
            return "#!/usr/bin/env bash\nset -e\n"+root+(
                f'SRC="$ROOT/code/source/{project}/main.asm"\n'
                f'OBJ="$ROOT/code/build/{project}/main.o"\n'
                f'OUT="$ROOT/code/program/{project}/{project}"\n'
                'mkdir -p "$(dirname "$OBJ")" "$(dirname "$OUT")"\n'
                'nasm -f elf64 "$SRC" -o "$OBJ"\nld "$OBJ" -o "$OUT"\nchmod +x "$OUT"\necho "$OUT"\n'
            )
        if language=="c":
            return "#!/usr/bin/env bash\nset -e\n"+root+(
                f'SRC="$ROOT/code/source/{project}/main.c"\n'
                f'OBJ="$ROOT/code/build/{project}/main.o"\n'
                f'OUT="$ROOT/code/program/{project}/{project}"\n'
                'mkdir -p "$(dirname "$OBJ")" "$(dirname "$OUT")"\n'
                'cc -c "$SRC" -o "$OBJ"\ncc "$OBJ" -o "$OUT"\nchmod +x "$OUT"\necho "$OUT"\n'
            )
        if language=="java":
            return "#!/usr/bin/env bash\nset -e\n"+root+(
                f'JAVA="$ROOT/code/build/{project}/Main.java"\n'
                f'CLASSDIR="$ROOT/code/source/{project}"\n'
                f'OUT="$ROOT/code/program/{project}/{project}.jar"\n'
                f'MANIFEST="$ROOT/code/configure/{project}/MANIFEST.MF"\n'
                'mkdir -p "$CLASSDIR" "$(dirname "$OUT")"\n'
                'javac -d "$CLASSDIR" "$JAVA"\n'
                "printf 'Main-Class: Main\\n' > \"$MANIFEST\"\n"
                'jar cfm "$OUT" "$MANIFEST" -C "$CLASSDIR" .\necho "$OUT"\n'
            )
        return ""

    def _oc_prog_new(project,language):
        project=_oc_prog_safe(project); language=str(language or "").lower().strip()
        prefs=_oc_prog_prefs()
        if language not in prefs:
            return False,f"Language [{language}] is not configured in {PROGRAMMER_PREFS}."
        paths=_oc_prog_paths(project)
        for path in paths.values(): path.mkdir(parents=True,exist_ok=True)
        host_os=sys.platform.lower(); host_arch=(os.uname().machine.lower() if hasattr(os,"uname") else "")
        meta={
            "project":project,"language":language,
