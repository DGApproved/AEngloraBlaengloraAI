        obj.setsampwidth(2)
        obj.setframerate(sample_rate)
        
        # Pack and clamp the final mixed audio
        packed_frames = []
        for val in final_audio:
            clamped = max(-32768, min(32767, int(val)))
            packed_frames.append(struct.pack('<h', clamped))
            
        obj.writeframes(b''.join(packed_frames))
        
    print(f"[playguitar.code] Exported physical waveform to {out_path}")
