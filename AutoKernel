#--recalls_tokens_to_context_from_swap.txt--
def memory_controller(current_input):
    """
    The Memory Management Unit: Actively scans for Page Faults (missing context).
    If a keyword is missing from RAM but exists in Swap, it pulls it back in.
    """
    global session_history, swap_token_counter
    
    tokens = tokenizer.encode(session_history, add_special_tokens=False)
    ram_usage = len(tokens)
    free_space = context_size - ram_usage
    
    if free_space > 20 and os.path.exists(SWAP_FILE) and current_input:
        
        # Extract meaningful keywords from the current prompt
        keywords = set(re.findall(r'\b[a-zA-Z]{5,}\b', current_input.lower()))
        missing_keys = [k for k in keywords if k not in session_history.lower()]
        
        if missing_keys:
            with open(SWAP_FILE, "r", encoding="utf-8") as f:
                swap_content = f.read()
            
            swapped_tokens = re.findall(r'\[(.*?)\]', swap_content)
            found_keys = [k for k in missing_keys if k in swap_content.lower()]
            
            if found_keys and swapped_tokens:
                # Find the most recent swap sector containing the missing data
                target_idx = -1
                for i in range(len(swapped_tokens) - 1, -1, -1):
                    if any(k in swapped_tokens[i].lower() for k in found_keys):
                        target_idx = i
                        break
                        
                if target_idx != -1:
                    pull_count = min(free_space, 150)
                    start_idx = max(0, target_idx - (pull_count // 2))
                    end_idx = min(len(swapped_tokens), start_idx + pull_count)
                    
                    pulled_tokens = swapped_tokens[start_idx:end_idx]
                    recovered_str = "".join([t.replace('↵', '\n') for t in pulled_tokens])
                    
                    # Splice the swap file back together
                    retained_swap = swapped_tokens[:start_idx] + swapped_tokens[end_idx:]
                    
                    # Inject the recovered memory into active RAM
                    session_history = f"\n[PAGE FAULT RECOVERY: '{found_keys[0]}']\n{recovered_str}\n" + session_history
                    
                    # Rewrite the disk using the rigid 4-token sector format
                    with open(SWAP_FILE, "w", encoding="utf-8") as f:
                        swap_token_counter = 0
                        for t in retained_swap:
                            f.write(f"[{t}] ")
                            swap_token_counter += 1
                            if swap_token_counter >= 4:
                                f.write("\n")
                                swap_token_counter = 0
                                
                    sys.stdout.write(f"\r\033[K[Memory Controller] PAGE FAULT: '{found_keys[0]}' recovered from swap.txt\n")
                    sys.stdout.flush()

#--sends_context_to_swap.txt--
def dynamic_pager():
    """
    Monitors the RAM (session_history). If the token count exceeds the 
    context_size limit, it physically pops the oldest tokens 1 by 1 
    and writes them to the swap drive in 4-token sectors.
    """
    global session_history, swap_token_counter
    
    # 1. Measure the physical RAM footprint
    tokens = tokenizer.encode(session_history, add_special_tokens=False)
    ram_usage = len(tokens)
    
    # 2. Check against the 8192 UMA limit
    if ram_usage > context_size:
        excess_count = ram_usage - context_size
        
        # 3. Slice the excess tokens from the oldest part of the memory
        paged_out_tokens = tokens[:excess_count]
        retained_tokens = tokens[excess_count:]
        
        # 4. Rebuild the active RAM with the surviving tokens
        session_history = tokenizer.decode(retained_tokens)
        
        # 5. Write the overflow to the SATA Hard Drive (swap.txt)
        with open(SWAP_FILE, "a", encoding="utf-8") as f:
            for token_id in paged_out_tokens:
                # Decode 1 token at a time
                token_str = tokenizer.decode([token_id])
                
                # Sanitize the output so raw line breaks don't ruin the 4-token grid
                clean_str = token_str.replace('\n', '↵').strip()
                if not clean_str:
                    clean_str = "[SPACE]"
                
                # Write 1 token to the disk
                f.write(f"[{clean_str}] ")
                swap_token_counter += 1
                
                # Format into 4-token disk sectors (lines)
                if swap_token_counter >= 4:
                    f.write("\n")
                    swap_token_counter = 0
                    
        sys.stdout.write(f"\r\033[K[SMC Pager] Paged out {excess_count} tokens to swap.txt\n")
        sys.stdout.flush()


class CompressedTokenizerAdapter:
    """Persistent, deterministic lossy token-ID compression for k-scale models.

    The base GPT-2 tokenizer remains intact on disk. Source IDs that exceed the
    reduced model vocabulary are folded into a compact ID space. Special token
    IDs are reserved at the top of that space so EOS/PAD/BOS cannot collide
    with ordinary folded tokens. Because many source IDs can map to one compact
    ID, decoding uses a deterministic representative and is necessarily lossy.

    IMPORTANT FOR FUTURE REVISIONS:
    This adapter is part of the model format whenever compression is enabled.
    Do not train with compressed IDs and later load the checkpoint with a raw
    tokenizer; always reload aitech_token_compression.json with the checkpoint.
    """
    METADATA_NAME = "aitech_token_compression.json"

    def __init__(self, base_tokenizer, target_vocab_size, special_source_ids=None):
        object.__setattr__(self, "base", base_tokenizer)
        target_vocab_size = int(target_vocab_size)
        source_special = sorted(set(int(x) for x in (special_source_ids or base_tokenizer.all_special_ids)))
        # Leave a useful ordinary-ID region even if many special tokens exist.
        min_vocab = max(128, len(source_special) + 32)
        if target_vocab_size < min_vocab:
            raise ValueError(f"compressed vocabulary must be >= {min_vocab}")
        object.__setattr__(self, "target_vocab_size", target_vocab_size)
        object.__setattr__(self, "special_source_ids", source_special)
        reserved_start = target_vocab_size - len(source_special)
        object.__setattr__(self, "regular_slots", reserved_start)
        s2c = {sid: reserved_start + i for i, sid in enumerate(source_special)}
        c2s = {cid: sid for sid, cid in s2c.items()}
        object.__setattr__(self, "special_to_compact", s2c)
        object.__setattr__(self, "compact_to_special", c2s)
        object.__setattr__(self, "collision_analysis_summary", None)

    def __len__(self):
        return self.target_vocab_size

    def __getattr__(self, name):
        return getattr(self.base, name)

    def __setattr__(self, name, value):
        if name in {"base", "target_vocab_size", "special_source_ids", "regular_slots",
                    "special_to_compact", "compact_to_special", "collision_analysis_summary"}:
            object.__setattr__(self, name, value)
        else:
            setattr(self.base, name, value)

    def _compress_id(self, token_id):
        token_id = int(token_id)
        return self.special_to_compact.get(token_id, token_id % self.regular_slots)

    def _expand_id(self, token_id):
        token_id = int(token_id)
        return self.compact_to_special.get(token_id, token_id)

    def _map_ids(self, ids, compress=True):
        fn = self._compress_id if compress else self._expand_id
        if torch.is_tensor(ids):
            flat = ids.detach().cpu().reshape(-1).tolist()
            mapped = torch.tensor([fn(x) for x in flat], dtype=ids.dtype, device=ids.device)
            return mapped.reshape(ids.shape)
        if isinstance(ids, tuple):
            return tuple(self._map_ids(x, compress=compress) if isinstance(x, (list, tuple)) else fn(x) for x in ids)
        if isinstance(ids, list):
            if ids and isinstance(ids[0], (list, tuple)):
                return [self._map_ids(x, compress=compress) for x in ids]
            return [fn(x) for x in ids]
        return fn(ids)

    @property
    def eos_token_id(self):
        return self._compress_id(self.base.eos_token_id)

    @property
    def pad_token_id(self):
        src = self.base.pad_token_id if self.base.pad_token_id is not None else self.base.eos_token_id
        return self._compress_id(src)

    @property
    def bos_token_id(self):
        src = self.base.bos_token_id if self.base.bos_token_id is not None else self.base.eos_token_id
        return self._compress_id(src)

    @property
    def all_special_ids(self):
        return [self._compress_id(x) for x in self.base.all_special_ids]

    def encode(self, *args, **kwargs):
        return self._map_ids(self.base.encode(*args, **kwargs), compress=True)

    def decode(self, token_ids, *args, **kwargs):
        return self.base.decode(self._map_ids(token_ids, compress=False), *args, **kwargs)

    def batch_decode(self, sequences, *args, **kwargs):
        expanded = [self._map_ids(seq, compress=False) for seq in sequences]
        return self.base.batch_decode(expanded, *args, **kwargs)

    def __call__(self, *args, **kwargs):
        encoded = self.base(*args, **kwargs)
        if "input_ids" in encoded:
            encoded["input_ids"] = self._map_ids(encoded["input_ids"], compress=True)
        return encoded

    def analyze_collision_projection(self, corpus, report_directory=None):
        """Measure modulo-fold collisions against the actual uncompressed corpus.

        GPT-2 vocabulary entries are byte-pair tokens, not necessarily single
        characters.  Therefore a "character position" here is deliberately a
        PROJECTED uncompressed text offset: each original source token is
        decoded independently, its decoded length is accumulated, and the
        resulting [start,end) span records where that token-piece would have
        occupied the uncompressed stream.

        This follows the collision-accounting convention that is appropriate
        for this script's deterministic modulo-fold compressor: a source ID is
        counted as overlapped when compress->expand does not return that same
        source ID.  In other words, the compact bucket's current representative
        is another source ID.  Special tokens are losslessly reserved and are
        therefore excluded from ordinary collision counts.

        Full overlapping occurrences are streamed to JSONL rather than held in
        RAM.  The metadata JSON keeps aggregate counts plus a small preview.
        Future compression algorithms should supply their own equivalent
        projection rule instead of reusing modulo-specific assumptions.
        """
        report_path = None
        report_fh = None
        if report_directory:
            os.makedirs(report_directory, exist_ok=True)
            report_path = os.path.join(report_directory, "aitech_token_collision_positions.jsonl")
            report_fh = open(report_path, "w", encoding="utf-8")

        # Vocabulary-level accounting: n-k style collision excess for this
        # actual mapping, plus pair occupancy, are useful independent of corpus
        # frequency and correspond to standard hash-bucket collision measures.
        bucket_occupancy = {}
        vocab_overlapped_source_ids = 0
        source_vocab_size = len(self.base)
        for source_id in range(source_vocab_size):
            compact_id = self._compress_id(source_id)
            bucket_occupancy[compact_id] = bucket_occupancy.get(compact_id, 0) + 1
            if self._expand_id(compact_id) != source_id:
                vocab_overlapped_source_ids += 1
        occupied_buckets = len(bucket_occupancy)
        vocab_collision_excess = sum(max(0, n - 1) for n in bucket_occupancy.values())
        vocab_collision_pairs = sum((n * (n - 1)) // 2 for n in bucket_occupancy.values())
        max_bucket_occupancy = max(bucket_occupancy.values(), default=0)

        total_source_tokens = 0
        total_projected_characters = 0
        overlapped_token_occurrences = 0
        overlapped_projected_characters = 0
        overlap_by_compact_id = {}
        preview = []
        corpus_char_cursor = 0

        try:
            for record_index, text in enumerate(corpus):
                source_ids = self.base.encode(str(text), add_special_tokens=False)
                record_char_cursor = 0
                for token_index, source_id in enumerate(source_ids):
                    source_id = int(source_id)
                    compact_id = self._compress_id(source_id)
                    representative_id = self._expand_id(compact_id)
                    try:
                        piece = self.base.decode([source_id], clean_up_tokenization_spaces=False)
                    except TypeError:
                        piece = self.base.decode([source_id])
                    piece_len = len(piece)
                    record_start = record_char_cursor
                    record_end = record_start + piece_len
                    corpus_start = corpus_char_cursor
                    corpus_end = corpus_start + piece_len
                    record_char_cursor = record_end
                    corpus_char_cursor = corpus_end
                    total_source_tokens += 1
                    total_projected_characters += piece_len

                    if representative_id == source_id:
                        continue

                    overlapped_token_occurrences += 1
                    overlapped_projected_characters += piece_len
                    b = overlap_by_compact_id.setdefault(str(compact_id), {
                        "occurrences": 0,
                        "projected_characters": 0,
                        "source_ids": set(),
                        "representative_source_id": int(representative_id),
                    })
                    b["occurrences"] += 1
                    b["projected_characters"] += piece_len
                    b["source_ids"].add(source_id)

                    event = {
                        "record_index": record_index,
                        "token_index": token_index,
                        "source_token_id": source_id,
                        "compact_id": compact_id,
                        "representative_source_id": int(representative_id),
                        "projected_record_char_start": record_start,
                        "projected_record_char_end": record_end,
                        "projected_corpus_char_start": corpus_start,
                        "projected_corpus_char_end": corpus_end,
                        "decoded_piece": piece,
                    }
                    if report_fh is not None:
                        report_fh.write(json.dumps(event, ensure_ascii=False) + "\n")
                    if len(preview) < 32:
                        preview.append(event)

                # Preserve a one-character conceptual separator between records
                # in corpus-global projected offsets. It is not a model token.
                corpus_char_cursor += 1
        finally:
            if report_fh is not None:
                report_fh.close()

        top_buckets = []
        for compact_id, data in sorted(
                overlap_by_compact_id.items(),
                key=lambda kv: (kv[1]["projected_characters"], kv[1]["occurrences"]),
                reverse=True)[:64]:
            top_buckets.append({
                "compact_id": int(compact_id),
                "representative_source_id": data["representative_source_id"],
                "occurrences": data["occurrences"],
                "projected_characters": data["projected_characters"],
                "distinct_overlapped_source_ids": len(data["source_ids"]),
                "sample_source_ids": sorted(data["source_ids"])[:16],
            })

        summary = {
            "projection_version": 1,
            "projection_method": "cumulative-independent-token-decode-character-offsets",
            "collision_rule": "source_id != expand(compress(source_id))",
            "source_vocab_size": source_vocab_size,
            "target_vocab_size": self.target_vocab_size,
            "regular_compact_slots": self.regular_slots,
            "occupied_compact_buckets": occupied_buckets,
            "vocabulary_overlapped_source_ids": vocab_overlapped_source_ids,
            "vocabulary_collision_excess_n_minus_k": vocab_collision_excess,
            "vocabulary_collision_pairs": vocab_collision_pairs,
            "max_bucket_occupancy": max_bucket_occupancy,
            "corpus_source_token_occurrences": total_source_tokens,
            "corpus_projected_characters": total_projected_characters,
            "overlapped_token_occurrences": overlapped_token_occurrences,
            "overlapped_projected_characters": overlapped_projected_characters,
            "overlapped_token_percent": (100.0 * overlapped_token_occurrences / total_source_tokens) if total_source_tokens else 0.0,
            "overlapped_projected_character_percent": (100.0 * overlapped_projected_characters / total_projected_characters) if total_projected_characters else 0.0,
            "positions_file": os.path.basename(report_path) if report_path else None,
            "position_preview": preview,
            "highest_overlap_buckets": top_buckets,
        }
        object.__setattr__(self, "collision_analysis_summary", summary)
        return summary

    def save_pretrained(self, save_directory, *args, **kwargs):
        result = self.base.save_pretrained(save_directory, *args, **kwargs)
        meta = {
            "format": 1,
            "algorithm": "reserved-special-modulo-fold",
            "lossy": True,
            "source_vocab_size": len(self.base),
            "target_vocab_size": self.target_vocab_size,
            "special_source_ids": self.special_source_ids,
            "collision_analysis": self.collision_analysis_summary,
        }
        with open(os.path.join(save_directory, self.METADATA_NAME), "w", encoding="utf-8") as f:
            json.dump(meta, f, indent=2, sort_keys=True)
        return result

    @classmethod
    def load_if_present(cls, base_tokenizer, model_directory):
        path = os.path.join(model_directory, cls.METADATA_NAME)
        if not os.path.isfile(path):
            return base_tokenizer
        with open(path, "r", encoding="utf-8") as f:
            meta = json.load(f)
        print(f"[Tokenizer] Loading persistent lossy ID compression: {len(base_tokenizer):,} -> {int(meta['target_vocab_size']):,} IDs")
        return cls(base_tokenizer, int(meta["target_vocab_size"]), meta.get("special_source_ids"))


def run_training_mode():
    """
    Multimodal Llama 4M/15M training across all 7 data directories.
    Native PyTorch primary path; optional Accelerate fallback (exit 42).
    """
    print("\n" + "="*55)
    print("  GODDESS MATRIX \u2014 LLAMA BASE MODEL TRAINING")
    print("="*55)
    print("  4m  : ~4M preset  | 128-hidden | faster iteration")
    print("  15m : ~15M preset | 256-hidden | deeper training")
    print("  c N : fit a specific parameter target, e.g. c 500k, c 12.5m")
    print("  ~   : profile post-decay training data and choose a workload-sized model")
    print("="*55)
    size_choice = input("Model size [4m/15m/c <number>/~, default=4m]: ").strip().lower() or "4m"

    # CUSTOM MODEL SIZE POLICY:
    # The historical 4m/15m presets are intentionally preserved exactly.  A
    # custom `c <number>` request instead searches valid Llama dimensions for
    # an architecture whose estimated parameter count is near the requested
    # target.  The exact instantiated count is printed after model creation.
    # This keeps custom sizing independent from preset compatibility behavior.
    def _parse_custom_target(choice):
        m = re.match(r"^c\s*([0-9]+(?:\.[0-9]+)?)\s*([kmb]?)$", choice)
        if not m:
            return None
        value = float(m.group(1)); suffix = m.group(2)
        multiplier = {"": 1_000_000, "k": 1_000, "m": 1_000_000, "b": 1_000_000_000}[suffix]
        return max(100_000, int(value * multiplier))

    def _custom_llama_dims(target_params, vocab_size=50257):
        """Fit the current Llama architecture as closely as safely possible.

        A numeric `c` request is a parameter target rather than an approximate
        preset.  The fitter uses every parameter-count lever currently safe for
        the generated runtime: hidden width, SwiGLU/MLP width, layer count,
        attention-head layout, grouped-query KV heads, and tied/untied output
        embeddings.  The GPT-2 tokenizer vocabulary is not truncated because
        doing that without a persistent token-ID remapper would make saved
        models unsafe for later inference.  That vocabulary therefore creates
        a real lower bound for very small requested models.
        """
        target_params = max(1, int(target_params))
        if target_params < 5_000_000:
            hidden_max = 256
        elif target_params < 100_000_000:
            hidden_max = 1024
        elif target_params < 1_000_000_000:
            hidden_max = 2048
        else:
            hidden_max = 4096
        best = None
        head_options = (1, 2, 4, 8, 16, 32, 64)
        for hidden in range(4, hidden_max + 1, 4):
            valid_heads = [h for h in head_options if h <= hidden and hidden % h == 0]
            for heads in valid_heads:
                kv_options = [k for k in valid_heads if k <= heads and heads % k == 0]
                for kv_heads in kv_options:
                    kv_dim = hidden * kv_heads // heads
                    for tied in (True, False):
                        embedding_params = vocab_size * hidden * (1 if tied else 2)
                        for layers in range(1, 65):
                            base = embedding_params + hidden
                            per_without_mlp = ((2 * hidden * hidden) +
                                               (2 * hidden * kv_dim) +
                                               (2 * hidden))
                            remaining = target_params - base - layers * per_without_mlp
                            ideal_i = remaining / max(1, (3 * hidden * layers))
                            # Keep the MLP dimension in a useful transformer range.
                            # Without this guard an exact arithmetic fit could choose
                            # hidden=4 plus an enormous MLP, matching the number while
                            # producing a badly unbalanced language model.
                            min_i = max(8, hidden)
                            max_i = max(min_i, hidden * 8)
                            center = int(round(ideal_i / 4.0)) * 4
                            center = min(max_i, max(min_i, center))
                            candidates_i = {center}
                            for ratio in (1.0, 1.5, 2.0, 2.5, 3.0, 4.0, 6.0, 8.0):
                                candidates_i.add(min(max_i, max(min_i, int(round((hidden * ratio) / 4.0)) * 4)))
                            for delta in range(-32, 33, 4):
                                candidates_i.add(min(max_i, max(min_i, center + delta)))
                            for intermediate in candidates_i:
                                estimate = base + layers * (per_without_mlp + 3 * hidden * intermediate)
                                error = abs(estimate - target_params)
                                # Parameter error is always primary. For equally
                                # close fits prefer balanced MLP ratios and modest
                                # depth rather than pathological exact-size shapes.
                                shape_penalty = abs(intermediate - (2 * hidden))
                                depth_penalty = abs(layers - 6)
                                candidate = (error, shape_penalty, depth_penalty,
                                             estimate > target_params, estimate,
                                             hidden, layers, intermediate, heads,
                                             kv_heads, tied)
                                if best is None or candidate < best:
                                    best = candidate
        _, _, _, _, estimate, hidden, layers, intermediate, heads, kv_heads, tied = best
        return hidden, intermediate, layers, heads, kv_heads, tied, estimate

    def _compressed_vocab_fit(target_params, full_vocab_size):
        """Search vocabulary compression as another parameter-fitting lever.

        Only explicit targets use this path. It samples a broad range of compact
        vocabulary sizes, then lets the normal architecture fitter optimize all
        remaining dimensions. The returned vocabulary is deliberately never
        applied without the user's confirmation dialog below.
        """
        full_vocab_size = int(full_vocab_size)
        candidates = {128, 192, 256, 384, 512, 768, 1024, 1536, 2048, 3072,
                      4096, 6144, 8192, 12288, 16384, 24576, 32768, full_vocab_size}
        # Add target-derived neighborhoods so unusual k targets are not forced
        # onto powers of two. Values represent plausible embedding budgets at
        # several small hidden widths.
        for hidden in (4, 8, 12, 16, 24, 32, 48, 64):
            for frac in (0.20, 0.35, 0.50, 0.65, 0.80):
                v = int((target_params * frac) / max(1, hidden))
                for delta in (-256, -128, -64, 0, 64, 128, 256):
                    candidates.add(v + delta)
        candidates = sorted(v for v in candidates if 128 <= v <= full_vocab_size)
        best = None
        for vocab in candidates:
            dims = _custom_llama_dims(target_params, vocab)
            estimate = dims[-1]
            candidate = (abs(estimate - target_params), abs(vocab - min(full_vocab_size, 8192)), vocab, dims)
            if best is None or candidate < best:
                best = candidate
        _, _, vocab, dims = best
        return vocab, dims

    def _profile_corpus_for_size(corpus, tokenizer_obj):
        """Profile the actual post-decay workload for `~` auto sizing.

        This happens after text decay and image-to-record expansion, so the
        sizing decision reflects what will really be tokenized and trained.
        The current reproducible heuristic aims near 20 effective training
        tokens per parameter and includes planned epoch exposure.  It is a
        workload-sizing policy, not a claim of a universal optimum, and is kept
        isolated so future research can revise it without changing presets or
        explicit `c` target-fitting behavior.
        """
        total_tokens = 0
        unique_ids = set()
        batch_size = 128
        for start in range(0, len(corpus), batch_size):
            batch = corpus[start:start + batch_size]
            enc = tokenizer_obj(
                batch, add_special_tokens=False,
                truncation=False, padding=False, verbose=False
            )["input_ids"]
            for ids in enc:
                total_tokens += len(ids)
                unique_ids.update(ids)
        total_tokens = max(1, total_tokens)
        epochs_for_sizing = 5
        target = max(100_000, int((total_tokens * epochs_for_sizing) / 20.0))
        if target > 8_000_000:
            epochs_for_sizing = 20
            target = max(100_000, int((total_tokens * epochs_for_sizing) / 20.0))
        return target, total_tokens, len(unique_ids), epochs_for_sizing

    custom_target = _parse_custom_target(size_choice)
    adaptive_size = (size_choice == "~")
    allow_token_compression = False
    compressed_vocab_target = None
    if custom_target is not None:
        # First test the safe/full-tokenizer architecture. If the requested
        # target cannot be approached closely, offer a lossy compression lane.
        # This is opt-in because folded IDs can collide and decoding becomes an
        # approximation. "No" intentionally returns to this same size menu.
        _full_vocab_preview = 50257 + len(SPECIAL_TOKENS)
        _safe_dims = _custom_llama_dims(custom_target, _full_vocab_preview)
        _safe_error = abs(_safe_dims[-1] - custom_target)
        _compression_vocab, _compression_dims = _compressed_vocab_fit(custom_target, _full_vocab_preview)
        _compression_error = abs(_compression_dims[-1] - custom_target)
        if _compression_vocab < _full_vocab_preview and _compression_error < _safe_error:
            print("\n" + "!"*66)
            print("  WARNING — LOSSY TOKEN-ID COMPRESSION REQUIRED FOR CLOSER FIT")
            print("!"*66)
            print(f"  Requested target       : {custom_target:,} parameters")
            print(f"  Full tokenizer fit     : {_safe_dims[-1]:,} ({_safe_dims[-1]-custom_target:+,})")
            print(f"  Compressed-vocab fit   : {_compression_dims[-1]:,} ({_compression_dims[-1]-custom_target:+,})")
            print(f"  Token ID space         : ~{_full_vocab_preview:,} -> {_compression_vocab:,}")
            print("  Out-of-range source IDs will be algorithmically folded into")
            print("  the reduced ID space. Multiple source tokens can therefore share")
            print("  one model ID; reverse decoding uses a representative token and is lossy.")
            print("  A persistent compression map/algorithm descriptor will be saved with")
            print("  the checkpoint and automatically reloaded for chat/inference.")
            print("  If accepted, AItech will also measure actual corpus collisions and")
            print("  projected uncompressed character spans, saving a JSONL position report.")
            print("!"*66)
            confirm = input("Use lossy algorithmic token-ID compression? [y/N]: ").strip().lower()
            if confirm not in ("y", "yes"):
                print("[i] Compression declined. Returning to the model-size menu.\n")
                return run_training_mode()
            allow_token_compression = True
            compressed_vocab_target = _compression_vocab
            print(f"[i] Compression accepted. Target compact vocabulary: {compressed_vocab_target:,} IDs")

    if custom_target is not None:
        _preview_vocab = compressed_vocab_target if allow_token_compression else 50257
        (MODEL_HIDDEN, MODEL_INTERMEDIATE, MODEL_LAYERS, MODEL_HEADS,
         MODEL_KV_HEADS, MODEL_TIE_EMBEDDINGS, estimated_params) = _custom_llama_dims(custom_target, _preview_vocab)
        target_m = custom_target / 1_000_000
        MODEL_SIZE_LABEL = f"CUSTOM {target_m:g}M"
        custom_slug = (f"{target_m:g}").replace(".", "p")
        out_dir = os.path.join(MODELS_DIR, f"hf_custom_{custom_slug}m_model")
        MAX_LENGTH = TRAINING_BATCH_SEQUENCE_CFG if custom_target <= 8_000_000 else (1536 if custom_target <= 40_000_000 else 2048)
        EPOCHS = 5 if custom_target <= 8_000_000 else 20
        BATCH_SIZE = 4 if custom_target <= 8_000_000 else (2 if custom_target <= 40_000_000 else 1)
        LR = 5e-4 if custom_target <= 8_000_000 else 1e-4
        DEFAULT_MODE = "10%w" if custom_target <= 8_000_000 else "allw"
        diff = estimated_params - custom_target
        pct = abs(diff) / custom_target * 100.0
        print(f"  Custom target: {custom_target:,} parameters")
        print(f"  Fitted config: {estimated_params:,} params ({diff:+,}, {pct:.4f}% error)")
        print(f"  hidden={MODEL_HIDDEN} | mlp={MODEL_INTERMEDIATE} | layers={MODEL_LAYERS} | heads={MODEL_HEADS} | kv={MODEL_KV_HEADS} | tied={MODEL_TIE_EMBEDDINGS}")
    elif adaptive_size:
        # Final dimensions are deliberately deferred until corpus creation.
        MODEL_HIDDEN=128; MODEL_INTERMEDIATE=256; MODEL_LAYERS=4; MODEL_HEADS=4
        MODEL_KV_HEADS=4; MODEL_TIE_EMBEDDINGS=False
        MAX_LENGTH=TRAINING_BATCH_SEQUENCE_CFG; EPOCHS=5; BATCH_SIZE=4; LR=5e-4
        out_dir=os.path.join(MODELS_DIR, "hf_auto_model")
        DEFAULT_MODE="10%w"; MODEL_SIZE_LABEL="AUTO (~ pending corpus profile)"
    elif size_choice == "15m":
        MODEL_HIDDEN=256; MODEL_INTERMEDIATE=512; MODEL_LAYERS=6; MODEL_HEADS=8
        MODEL_KV_HEADS=8; MODEL_TIE_EMBEDDINGS=False
        MAX_LENGTH=1536; EPOCHS=20; BATCH_SIZE=2; LR=1e-4
        out_dir=os.path.join(MODELS_DIR, "hf_base_model")
        DEFAULT_MODE="allw"; MODEL_SIZE_LABEL="15M"
    else:
        if size_choice not in ("4m", "4"):
            print(f"[!] Unrecognized model size '{size_choice}'. Using 4m preset.")
        MODEL_HIDDEN=128; MODEL_INTERMEDIATE=256; MODEL_LAYERS=4; MODEL_HEADS=4
        MODEL_KV_HEADS=4; MODEL_TIE_EMBEDDINGS=False
        MAX_LENGTH=TRAINING_BATCH_SEQUENCE_CFG; EPOCHS=5; BATCH_SIZE=4; LR=5e-4
        out_dir=os.path.join(MODELS_DIR, "hf_4m_model")
        DEFAULT_MODE="10%w"; MODEL_SIZE_LABEL="4M"

    # A B-created blank model owns its requested checkpoint path. Size presets,
    # `c`, and `~` describe architecture, not identity, so they must not rename
    # a user-named model behind the selector's back.
    if MODEL_SEED_ID is not None:
        out_dir = MODEL_PATH
        print(f"  Named model output: {out_dir}")

    MODEL_CONTEXT_TOKENS = TRAINING_MODEL_CONTEXT_CFG
    write_text_view("training", "LLAMA BASE CONFIG",
        f"Size: {MODEL_SIZE_LABEL}",
        f"Output: {out_dir}", f"Max length: {MAX_LENGTH}",
        f"Epochs: {EPOCHS}", f"LR: {LR}")
    write_progress(2, "CONFIGURING")

    print("\n" + "="*55 + "\n  CONFIGURE DATA DECAY INGESTION\n" + "="*55)
    print("  s / allc / allw / [N]c / [N]%c / [N]w / [N]%w\n" + "="*55)
    user_mode  = input(f"Decay mode [default: {DEFAULT_MODE}]: ").strip().lower() or DEFAULT_MODE
    decay_unit = "single"; decay_value = 1; is_percentage = False
    m = re.match(r"^(\d+)(%?)(c|w)$", user_mode)
    if user_mode == "allc":   decay_unit,decay_value,is_percentage = "char",1,False
    elif user_mode == "allw": decay_unit,decay_value,is_percentage = "word",1,False
    elif user_mode in ["s","single"]: decay_unit = "single"
    elif m:
        v,pct,u   = m.groups(); decay_value=int(v)
        is_percentage=(pct=="%"); decay_unit="char" if u=="c" else "word"
    else: print("[!] Invalid. Defaulting to single scan.")

    corpus = semantic_memory_training_records()
    try:
        ref_index = _reference_index_path()
        if os.path.exists(ref_index):
            os.remove(ref_index)
    except OSError:
        pass
    seen = set()
    territory_files = 0
    territory_folders = 0
    opaque_files = 0
    for kind, fpath, relpath in iter_training_territory():
        real = os.path.realpath(fpath)
        if real in seen:
            continue
        seen.add(real)
        if kind == "folder":
            territory_folders += 1
            corpus.append(generate_folder_boundary_record(fpath, relpath))
            continue

        territory_files += 1
        ext = Path(fpath).suffix.lower()
        label = "session.noq/" + relpath
        source_policy = classify_training_source(fpath, relpath)
        if source_policy.get("mode") == "REFERENCE_ONLY":
            opaque_files += 1
            index_reference_only_source(fpath, relpath, source_policy)
            corpus.append(generate_reference_only_record(fpath, relpath, source_policy))
            continue
        if ext in _IMAGE_TRAINING_EXTENSIONS:
            image_records = generate_pixel_decay_records(
                fpath, label, decay_unit, decay_value, is_percentage
            )
            if image_records:
                corpus.extend(image_records)
            else:
                opaque_files += 1
                corpus.append(generate_opaque_file_record(fpath, relpath))
        elif ext in _TEXTLIKE_TRAINING_EXTENSIONS or not ext:
            text_records = generate_text_decay_records(
                fpath, label, decay_unit, decay_value, is_percentage
            )
            if text_records:
                corpus.extend(text_records)
            else:
                opaque_files += 1
                corpus.append(generate_opaque_file_record(fpath, relpath))
        else:
            opaque_files += 1
            corpus.append(generate_opaque_file_record(fpath, relpath))
    print(
        f"  Training territory: {territory_files} files, "
        f"{territory_folders} folder boundaries, {opaque_files} structural-only files"
    )
    if not corpus: corpus = ["User: Hello\nAssistant: System ready."]
    print(f"  Total training records: {len(corpus)}")

    tokenizer_t = GPT2Tokenizer.from_pretrained("gpt2")
    tokenizer_t.add_special_tokens({"additional_special_tokens": SPECIAL_TOKENS,
                                     "pad_token": "<|endoftext|>"})
    tokenizer_t.model_max_length = MODEL_CONTEXT_TOKENS

    if custom_target is not None:
        # Refit against the tokenizer's FINAL vocabulary. When the user opted
        # into compression, wrap only after special-token creation so those IDs
        # can be reserved correctly in the compact space.
        if allow_token_compression:
            final_compact_vocab, compact_dims = _compressed_vocab_fit(custom_target, len(tokenizer_t))
            # Do not unexpectedly enlarge beyond the already-confirmed preview.
            final_compact_vocab = min(final_compact_vocab, compressed_vocab_target or final_compact_vocab)
            tokenizer_t = CompressedTokenizerAdapter(tokenizer_t, final_compact_vocab)
            print(f"  Persistent token-ID compression active: source vocab -> {len(tokenizer_t):,} model IDs")
            collision_stats = tokenizer_t.analyze_collision_projection(corpus, out_dir)
            print("  Compression collision projection:")
            print(f"    vocab source IDs overlapped : {collision_stats['vocabulary_overlapped_source_ids']:,}")
            print(f"    bucket collision pairs      : {collision_stats['vocabulary_collision_pairs']:,}")
            print(f"    corpus token overlaps       : {collision_stats['overlapped_token_occurrences']:,} "
                  f"({collision_stats['overlapped_token_percent']:.2f}%)")
            print(f"    projected chars overlapped  : {collision_stats['overlapped_projected_characters']:,} "
                  f"({collision_stats['overlapped_projected_character_percent']:.2f}%)")
            print(f"    projected positions         : {os.path.join(out_dir, 'aitech_token_collision_positions.jsonl')}")
        (MODEL_HIDDEN, MODEL_INTERMEDIATE, MODEL_LAYERS, MODEL_HEADS,
         MODEL_KV_HEADS, MODEL_TIE_EMBEDDINGS, estimated_params) = _custom_llama_dims(custom_target, len(tokenizer_t))
        diff = estimated_params - custom_target
        pct = abs(diff) / custom_target * 100.0
        print(f"  Final tokenizer-aware fit: {estimated_params:,} params ({diff:+,}, {pct:.4f}% error) | model vocab={len(tokenizer_t):,}")


    if adaptive_size:
        auto_target, workload_tokens, unique_token_ids, suggested_epochs = _profile_corpus_for_size(corpus, tokenizer_t)
        (MODEL_HIDDEN, MODEL_INTERMEDIATE, MODEL_LAYERS, MODEL_HEADS,
         MODEL_KV_HEADS, MODEL_TIE_EMBEDDINGS, estimated_params) = _custom_llama_dims(auto_target, len(tokenizer_t))
        EPOCHS = suggested_epochs
        MAX_LENGTH = 512 if auto_target <= 8_000_000 else (1536 if auto_target <= 40_000_000 else 2048)
        BATCH_SIZE = 4 if auto_target <= 8_000_000 else (2 if auto_target <= 40_000_000 else 1)
        LR = 5e-4 if auto_target <= 8_000_000 else 1e-4
        MODEL_SIZE_LABEL = f"AUTO ~ {auto_target/1_000_000:g}M target"
        if MODEL_SEED_ID is None:
            out_dir = os.path.join(MODELS_DIR, f"hf_auto_{auto_target}_model")
        diff = estimated_params - auto_target
        pct = abs(diff) / auto_target * 100.0
        print("\n  [~] Workload sizing complete")
        print(f"  Post-decay records: {len(corpus):,}")
        print(f"  Post-decay tokens : {workload_tokens:,} | unique token IDs: {unique_token_ids:,}")
        print(f"  Derived target    : {auto_target:,} parameters ({suggested_epochs} planned epochs / ~20 effective tokens per parameter)")
        print(f"  Fitted config     : {estimated_params:,} params ({diff:+,}, {pct:.4f}% error)")
        print(f"  hidden={MODEL_HIDDEN} | mlp={MODEL_INTERMEDIATE} | layers={MODEL_LAYERS} | heads={MODEL_HEADS} | kv={MODEL_KV_HEADS} | tied={MODEL_TIE_EMBEDDINGS}")


    decay_mode_label = (
        "allc" if decay_unit == "char" and decay_value == 1 and not is_percentage else
        "allw" if decay_unit == "word" and decay_value == 1 and not is_percentage else
        (f"{decay_value}{'%' if is_percentage else ''}{'c' if decay_unit == 'char' else 'w'}"
         if decay_unit in ("char", "word") else "single")
    )
    corpus, training_continuity_session = prepare_hierarchical_training_corpus(
        corpus, tokenizer_t, "LLAMA",
        logical_window_tokens=MODEL_CONTEXT_TOKENS,
        batch_window_tokens=MAX_LENGTH,
        decay_mode=decay_mode_label,
    )
    print(
        f"  [Continuity] prepared={len(corpus):,} | "
        f"oversized={training_continuity_session.get('oversized_records_translated',0)} | "
        f"parents={training_continuity_session.get('logical_parent_count',0)} | "
        f"windows={training_continuity_session.get('neural_window_count',0)}"
    )


    def tokenize_fn(examples):
        tok = tokenizer_t(examples["text"],truncation=True,max_length=MAX_LENGTH,padding="max_length",verbose=False)
        tok["labels"] = [ids.copy() for ids in tok["input_ids"]]
        return tok

    ds = HFDataset.from_dict({"text": corpus}).map(tokenize_fn,batched=True,remove_columns=["text"])
    ds.set_format(type="torch", columns=["input_ids","attention_mask","labels"])
    train_loader = DataLoader(ds, batch_size=BATCH_SIZE, shuffle=True)

    cfg = LlamaConfig(
        vocab_size=len(tokenizer_t), hidden_size=MODEL_HIDDEN,
        intermediate_size=MODEL_INTERMEDIATE, num_hidden_layers=MODEL_LAYERS,
        num_attention_heads=MODEL_HEADS, num_key_value_heads=MODEL_KV_HEADS,
        tie_word_embeddings=MODEL_TIE_EMBEDDINGS, pad_token_id=tokenizer_t.eos_token_id,
        bos_token_id=tokenizer_t.eos_token_id, eos_token_id=tokenizer_t.eos_token_id,
        max_position_embeddings=MODEL_CONTEXT_TOKENS,
    )
    if MODEL_RANDOM_SEED is not None:
        random.seed(MODEL_RANDOM_SEED)
        torch.manual_seed(MODEL_RANDOM_SEED)
        if torch.cuda.is_available():
            torch.cuda.manual_seed_all(MODEL_RANDOM_SEED)
        print(f"  Applying model seed/ID before initialization: {MODEL_SEED_ID} ({MODEL_RANDOM_SEED})")
    model_t = LlamaForCausalLM(cfg)
    actual_params = sum(p.numel() for p in model_t.parameters())
    print(f"  Instantiated parameters: {actual_params:,}")
    write_text_view("training", "MODEL PARAMETER COUNT",
                    f"Requested/config: {MODEL_SIZE_LABEL}",
                    f"Actual parameters: {actual_params:,}")

    def _run_native():
        dev, backend = select_native_device(); print(f"  Backend: {backend}")
        model_t.to(dev); opt = AdamW(model_t.parameters(), lr=LR); model_t.train()
        for epoch in range(EPOCHS):
            total=0.0; cnt=0
            for batch in train_loader:
                ids=batch["input_ids"].to(dev); msk=batch["attention_mask"].to(dev)
                lbls=ids.clone(); lbls[msk==0]=-100
                opt.zero_grad(set_to_none=True)
                loss=model_t(input_ids=ids,attention_mask=msk,labels=lbls).loss
                loss.backward(); opt.step(); total+=loss.item(); cnt+=1
            avg=total/max(1,cnt); pct=int(((epoch+1)/EPOCHS)*95)
            print(f"  Epoch {epoch+1}/{EPOCHS} | Loss: {avg:.4f}")
            write_progress(pct, f"EPOCH {epoch+1}/{EPOCHS}")
            write_art(f"BASE {MODEL_SIZE_LABEL} TRAINING",
                      f"epoch:{epoch+1}/{EPOCHS}", f"loss:{avg:.4f}", backend, f"{pct}%")
        os.makedirs(out_dir,exist_ok=True)
        model_t.save_pretrained(out_dir); tokenizer_t.save_pretrained(out_dir)
        _save_model_identity(out_dir)
        _verify_chat_discoverable_checkpoint(out_dir)
        finalize_training_continuity_session(
            training_continuity_session, "COMPLETE",
            {"backend": backend, "output_dir": out_dir}
        )
        write_progress(100, f"SAVED \u2014 {out_dir}")
        print(f"\n[\u2713] Llama model saved to '{out_dir}'")

    def _run_accelerate():
        try: from accelerate import Accelerator
        except ImportError: print("[!] Accelerate not installed."); return False
        acc=Accelerator(); opt=AdamW(model_t.parameters(),lr=LR)
        pm,po,pl=acc.prepare(model_t,opt,train_loader); pm.train()
        for epoch in range(EPOCHS):
            total=0.0; cnt=0
            for batch in pl:
                ids=batch["input_ids"]; msk=batch["attention_mask"]
                lbls=ids.clone(); lbls[msk==0]=-100
                po.zero_grad(set_to_none=True)
                loss=pm(input_ids=ids,attention_mask=msk,labels=lbls).loss
                acc.backward(loss); po.step(); total+=loss.detach().float().item(); cnt+=1
            if acc.is_main_process:
                avg=total/max(1,cnt); print(f"  Epoch {epoch+1}/{EPOCHS} | Loss: {avg:.4f}")
        if acc.is_main_process:
            os.makedirs(out_dir,exist_ok=True)
            acc.unwrap_model(pm).save_pretrained(out_dir); tokenizer_t.save_pretrained(out_dir)
            _save_model_identity(out_dir)
            _verify_chat_discoverable_checkpoint(out_dir)
            finalize_training_continuity_session(
                training_continuity_session, "COMPLETE",
                {"backend": "accelerate", "output_dir": out_dir}
            )
        acc.wait_for_everyone(); return True

    if USE_ACCELERATE_FALLBACK:
        if not _run_accelerate(): sys.exit(1)
    else:
        try: _run_native()
        except (KeyboardInterrupt,SystemExit): raise
        except Exception as exc:
            print(f"\n[!] Native training failed: {type(exc).__name__}: {exc}")
            sys.exit(NATIVE_FALLBACK_EXIT_CODE)




# ── HEADPHONE AUDIO/TEXT TRANSLATION ───────────────────────────────────────
def _run_headphone_stt(command, payload, channel="ear"):
    """Translate received sensory bytes to model-readable UTF-8 text.

    Blank command preserves legacy behavior by decoding the payload directly.
    Configured commands consume bytes on stdin, or a temp file when {input} is
    present, and must return recognized text on stdout.
    """
    raw = bytes(payload or b"")
    cmd = str(command or "").strip()
    if not raw:
        return ""
    if not cmd:
        return raw.decode("utf-8", errors="ignore").strip()
    tmp_path = None
    try:
        run_cmd = cmd
        stdin_data = raw
        if "{input}" in run_cmd:
            fd, tmp_path = tempfile.mkstemp(prefix="aitech_headphone_", suffix=".audio")
            with os.fdopen(fd, "wb") as f:
                f.write(raw)
            run_cmd = run_cmd.replace("{input}", shlex.quote(tmp_path))
            stdin_data = None
        result = subprocess.run(
            run_cmd, input=stdin_data, stdout=subprocess.PIPE,
            stderr=subprocess.PIPE, shell=True, timeout=120,
        )
        text = result.stdout.decode("utf-8", errors="ignore").strip()
        if not text:
            update_gui_chat("SYS", f"{channel} STT command produced no transcript")
        return text
    except Exception as exc:
        update_gui_chat("SYS", f"{channel} STT conversion failed: {exc}")
        return ""
    finally:
        if tmp_path:
            try: os.unlink(tmp_path)
            except OSError: pass


def _run_headphone_tts(command, text, source="mouth"):
    """Send model text through the configured headphone/TTS command."""
    cmd = str(command or "").strip()
    speech = str(text or "").strip()
    if not cmd or not speech:
        return False
    try:
        subprocess.Popen(
            cmd, stdin=subprocess.PIPE, stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL, shell=True,
        ).communicate(speech.encode("utf-8"), timeout=120)
        return True
    except Exception as exc:
        update_gui_chat("SYS", f"{source} TTS conversion failed: {exc}")
        return False


