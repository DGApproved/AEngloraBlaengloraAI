    # =========================================================================
    # WRITE COLLISION DETECTION & QWEN RESOLUTION
    # =========================================================================
    # CONTRACT:
    #   - Both engines log every semantic write to COLLISION_LEDGER (shared JSON).
    #   - A collision is only declared when two writes to the SAME FILE within
    #     COLLISION_WINDOW seconds carry DIFFERENT content on the SAME topic.
    #   - Identical content or different topics are NOT collisions.
    #   - On genuine collision: the training model (chat engine) is ground truth.
    #     Qwen acts as autocorrect: conflicting Qwen terms appear as (term)
    #     alongside the training model's version in the file.
    #
    # LEDGER ENTRY FORMAT:
    #   { "file": str, "content_head": str, "content_hash": str,
    #     "source": "chat_engine"|"orchestrator",
    #     "timestamp": float, "resolved": bool }

    COLLISION_WINDOW = 10.0   # seconds — writes within this window are compared
    _ledger_lock = threading.Lock()

    def _ledger_load():
        """Load the write ledger, pruning entries older than COLLISION_WINDOW * 6."""
        if not os.path.exists(COLLISION_LEDGER):
            return []
        try:
            with open(COLLISION_LEDGER, "r", encoding="utf-8") as f:
                entries = json.load(f)
            cutoff = time.time() - (COLLISION_WINDOW * 6)
            return [e for e in entries if e.get("timestamp", 0) > cutoff]
        except Exception:
            return []

    def _ledger_save(entries):
        tmp = COLLISION_LEDGER + ".tmp"
        os.makedirs(os.path.dirname(COLLISION_LEDGER), exist_ok=True)
        with open(tmp, "w", encoding="utf-8") as f:
            json.dump(entries, f, indent=2)
        os.replace(tmp, COLLISION_LEDGER)

    def _content_hash(text):
        import hashlib
        return hashlib.md5(text.encode("utf-8", errors="ignore")).hexdigest()[:12]

    def log_write_to_ledger(file_path, content, source):
        """
        Record a semantic file write in the shared collision ledger.
        Called by append_semantic_memory (orchestrator) and should also be
        called by append_memory_file in chat_and_display_interactivev3.py
        with source='chat_engine'.
        """
        entry = {
            "file":         str(file_path),
            "content_head": content[:300],
            "content_hash": _content_hash(content),
            "source":       source,
            "timestamp":    time.time(),
            "resolved":     False,
        }
        with _ledger_lock:
            entries = _ledger_load()
            entries.append(entry)
            _ledger_save(entries)

    def _qwen_collision_check(file_path, content_local, content_qwen):
        """
        Ask Qwen to compare two writes to the same file.

        Returns one of three verdicts:
          DIFFERENT_TOPIC   — not a collision, both writes are valid additions
          SAME_TOPIC_AGREE  — same fact stated consistently, no conflict
          SAME_TOPIC_CONFLICT:<local_term>:<qwen_term>
                            — genuine conflict; terms are the specific words
                              that differ so autocorrect can target them
        """
        collision_header = _oprompt(
            "COLLISION_DETECTOR",
            "You are a semantic collision detector. Given two text fragments written to the same memory file, decide if they conflict."
        )
        prompt = (
            f"<|im_start|>system\n{collision_header}\n"
            "Reply with EXACTLY one of:\n"
            "  DIFFERENT_TOPIC\n"
            "  SAME_TOPIC_AGREE\n"
            "  SAME_TOPIC_CONFLICT:<training_model_term>:<qwen_term>\n"
            "where the terms are the specific conflicting words/values only.\n"
            "No explanation. One line.<|im_end|>\n"
            "<|im_start|>user\n"
            f"FILE: {os.path.basename(str(file_path))}\n\n"
            f"TRAINING MODEL WROTE:\n{content_local[:400]}\n\n"
            f"ORCHESTRATOR (QWEN) WROTE:\n{content_qwen[:400]}<|im_end|>\n"
            "<|im_start|>assistant\n"
        )
        try:
            if KOBOLDCPP_URL and not DIRECT_GGUF_MODE:
                verdict = koboldcpp_generate(prompt, max_length=QWEN_COLLISION_MAX_CFG, temperature=QWEN_COLLISION_TEMPERATURE_CFG)
            else:
                res = completion(
                    model=LOCAL_MODEL,
                    messages=[{"role": "user", "content": prompt}],
                    api_base=MODEL_CONFIGS[LOCAL_MODEL]["api_base"]
                )
                verdict = res.choices[0].message.content.strip()
            return verdict.strip().split("\n")[0].strip()
        except Exception:
            return "DIFFERENT_TOPIC"

    def _apply_autocorrect(file_path, local_term, qwen_term):
        """
        Edit the file so the training model's term remains authoritative and
        Qwen's conflicting term appears in parentheses alongside it.

        Example: local_term="8192"  qwen_term="16384"
          Before: "The context size is 8192 tokens."
          After:  "The context size is 8192 (16384) tokens."

        Only the first occurrence of local_term is modified to avoid cascading
        edits across a large file.
        """
        if not os.path.exists(file_path):
            return False
        try:
            with open(file_path, "r", encoding="utf-8", errors="ignore") as f:
                body = f.read()
            if local_term not in body:
                return False
            # Insert Qwen's term in parentheses after the local model's term
            corrected = body.replace(
                local_term,
                f"{local_term} ({qwen_term})",
                1  # first occurrence only
            )
            tmp = str(file_path) + ".collision_tmp"
            with open(tmp, "w", encoding="utf-8") as f:
                f.write(corrected)
            os.replace(tmp, file_path)
            return True
        except Exception:
            return False

    def _resolve_collision(file_path, local_entry, qwen_entry):
        """
        Full collision resolution pipeline:
          1. Ask Qwen whether the two writes conflict semantically.
          2. If DIFFERENT_TOPIC or SAME_TOPIC_AGREE → no action needed.
          3. If SAME_TOPIC_CONFLICT → apply autocorrect to the file,
             log the resolution to journal.txt, notify via GUI.
        """
        verdict = _qwen_collision_check(
            file_path,
            local_entry["content_head"],
            qwen_entry["content_head"]
        )

        fname = os.path.basename(str(file_path))
        stamp = time.strftime("%Y-%m-%dT%H:%M:%S")

        if verdict.startswith("SAME_TOPIC_CONFLICT"):
            parts = verdict.split(":")
            local_term = parts[1].strip() if len(parts) > 1 else ""
            qwen_term  = parts[2].strip() if len(parts) > 2 else ""

            corrected = False
            if local_term and qwen_term and local_term != qwen_term:
                corrected = _apply_autocorrect(file_path, local_term, qwen_term)

            resolution = (
                f"\n[COLLISION_RESOLVED]\n"
                f"timestamp: {stamp}\n"
                f"file: {fname}\n"
                f"verdict: {verdict}\n"
                f"training_model_term: {local_term}\n"
                f"qwen_term: {qwen_term}\n"
                f"autocorrect_applied: {corrected}\n"
                f"rule: training model is authoritative; "
                f"qwen term shown as ({qwen_term}) if applicable\n"
                f"[/COLLISION_RESOLVED]\n"
            )
            try:
                journal = str(NOQ_DIR / "dgapi" / "datas" / "journal.txt")
                with open(journal, "a", encoding="utf-8") as f:
                    f.write(resolution)
            except Exception:
                pass

            update_gui_chat(
                "SYS",
                f"Collision resolved: {fname} | "
                f"{'✓ autocorrected' if corrected else 'logged only'} | "
                f"{local_term} ({qwen_term})"
            )
            return "resolved"

        elif verdict == "SAME_TOPIC_AGREE":
            update_gui_chat("SYS", f"Concurrent write to {fname}: same fact, no conflict.")
            return "agree"
        else:
            # DIFFERENT_TOPIC — both writes are valid, nothing to do
            return "ok"

    def scan_write_ledger_for_collisions():
        """
        Background scan called by the idle daemon.
        Finds pairs of unresolved writes to the same file from different
        sources within COLLISION_WINDOW seconds and resolves any conflicts.
        """
        with _ledger_lock:
            entries = _ledger_load()

        now = time.time()
        unresolved = [
            e for e in entries
            if not e.get("resolved") and (now - e.get("timestamp", 0)) < COLLISION_WINDOW
        ]

        # Group by file
        import collections
        by_file = collections.defaultdict(list)
        for e in unresolved:
            by_file[e["file"]].append(e)

        updated = False
        for file_path, writes in by_file.items():
            sources = {w["source"] for w in writes}
            if len(sources) < 2:
                continue  # only one engine wrote here — no potential collision

            local_writes = [w for w in writes if w["source"] == "chat_engine"]
            qwen_writes  = [w for w in writes if w["source"] == "orchestrator"]

            if not local_writes or not qwen_writes:
                continue

            # Compare most recent write from each source
            local_entry = max(local_writes, key=lambda e: e["timestamp"])
            qwen_entry  = max(qwen_writes,  key=lambda e: e["timestamp"])

            # Identical content hash → same data, skip
            if local_entry["content_hash"] == qwen_entry["content_hash"]:
                continue

            _resolve_collision(file_path, local_entry, qwen_entry)

            # Mark both as resolved
            for e in entries:
                if (e["file"] == file_path
                        and e["timestamp"] in
                        {local_entry["timestamp"], qwen_entry["timestamp"]}):
                    e["resolved"] = True
            updated = True

        if updated:
            with _ledger_lock:
                _ledger_save(entries)

    def append_semantic_memory(path, content, what=None, why=None):
        """
        Append only to an explicitly selected semantic store.
        Orchestrator does not guess destinations merely because a file exists.
        """
        spec = semantic_spec(path)
        role = spec.get("role", "UNCLASSIFIED")
        purpose = spec.get("purpose", "explicit semantic destination")
        what = what or role
        why = why or purpose

        Path(path).parent.mkdir(parents=True, exist_ok=True)
        with open(path, "a", encoding="utf-8") as f:
