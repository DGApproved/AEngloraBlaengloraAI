            f"layers={m.get('num_layers','?')}  {compat}{marker}"
        )
    print("  0) Cancel")
    print("="*60)

    while True:
        try:
            raw = input(f"  Select knowledge model [1-{len(models)}, 0=cancel, Enter={default_idx+1}]: ").strip()
        except (EOFError, KeyboardInterrupt):
            return None
        if raw == "":
            choice = default_idx + 1
        else:
            try:
                choice = int(raw)
