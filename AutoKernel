def _write_reference_index(path, relpath, policy):
    """
    GPT2 parity helper: fingerprint a reference-only source without copying its
    body into training or source notebooks.  Page numbers are PAGE_HINT values
    derived from form-feed boundaries, not claims about a parsed document format.
    """
    rec = {
        "path": "session.noq/" + relpath,
        "reason": policy.get("reason", ""),
        "license_file": policy.get("license_file", ""),
        "license_id": policy.get("license_id", ""),
        "source_state": policy.get("source_state", "REFERENCE_ONLY"),
        "extension": policy.get("media_extension", ""),
        "sha256": "",
        "line_fingerprints": [],
        "index_complete": False,
        "indexed_bytes": 0,
        "total_bytes": 0,
    }
    try:
        rec["total_bytes"] = os.path.getsize(path)
    except OSError:
        rec["total_bytes"] = 0

    rec["indexed_bytes"] = min(rec["total_bytes"], 4_000_000) if rec["total_bytes"] else 0
    rec["index_complete"] = bool(rec["total_bytes"] and rec["total_bytes"] <= 4_000_000)

    try:
        h = hashlib.sha256()
        with open(path, "rb") as f:
            while True:
                chunk = f.read(1024 * 1024)
                if not chunk:
                    break
                h.update(chunk)
        rec["sha256"] = h.hexdigest()
    except OSError:
        pass

    body = _source_prefix_text(path, 4_000_000)
    if body:
        page_hint = 1
        line_no = 0
        for raw_line in body.splitlines():
            line_no += 1
            page_hint += raw_line.count("\f")
            norm = re.sub(r"\s+", " ", raw_line).strip()
            if len(norm) < 12:
                continue
            rec["line_fingerprints"].append({
                "page_hint": page_hint,
                "line": line_no,
                "sha256": hashlib.sha256(
                    norm.encode("utf-8", errors="ignore")
                ).hexdigest(),
            })
            if len(rec["line_fingerprints"]) >= 4096:
                break

    _append_jsonl(_reference_index_path(), rec)
    return rec


def index_reference_only_source(path, relpath, policy):
    """Compatibility alias shared with the Llama-side naming."""
    return _write_reference_index(path, relpath, policy)


def generate_reference_only_record(path, relpath, policy):
    """
    Return a structural training-map record without the restricted body.  This
    describes the boundary/policy only and does not promote source text.
    """
    rec = _write_reference_index(path, relpath, policy)
    return (
        "User: Interpret this source-use boundary.\n"
        "Assistant: [REFERENCE_ONLY_SOURCE] "
        f"path={rec.get('path')} "
        f"state={rec.get('source_state')} "
        f"license={rec.get('license_id') or 'UNKNOWN'} "
        f"reason={rec.get('reason') or 'policy restricted'} "
        f"index_complete={rec.get('index_complete')} "
        f"indexed_bytes={rec.get('indexed_bytes')} "
        f"total_bytes={rec.get('total_bytes')}. "
        "The source body is not a training target. Recognition may use bounded "
        "fingerprints while preserving provenance."
    )


def restricted_reference_context_for_prompt(prompt_text, max_chars=1400):
    index_path = _reference_index_path()
    if not os.path.isfile(index_path):
        return ""

    raw = str(prompt_text or "")
    candidates = []
    for part in raw.splitlines():
        norm = re.sub(r"\s+", " ", part).strip()
        if len(norm) >= 12:
            candidates.append(norm)
    for part in re.split(r"(?<=[.!?;{}])\s+", raw):
        norm = re.sub(r"\s+", " ", part).strip()
        if len(norm) >= 20:
            candidates.append(norm)

    hashes = {
        hashlib.sha256(x.encode("utf-8", errors="ignore")).hexdigest()
        for x in candidates
    }
    if not hashes:
        return ""

    hits = []
    try:
        with open(index_path, "r", encoding="utf-8", errors="ignore") as f:
            for row in f:
                try:
                    item = json.loads(row)
                except Exception:
                    continue
                for fp in item.get("line_fingerprints", []):
                    if fp.get("sha256") in hashes:
                        hits.append((item, fp))
                        break
    except OSError:
        return ""

    if not hits:
        return ""

    lines = [
        "[REFERENCE_ONLY_RECOGNITION]",
        "The user supplied text matching a mapped reference-only source.",
        "Do not claim this recognition as original insight. Credit the mapped source.",
        "Do not reproduce unseen surrounding source text; explain related concepts from permitted/native knowledge.",
    ]
    for item, fp in hits[:8]:
        lines.append(
            f"source={item.get('path','unknown')} "
            f"page_hint={fp.get('page_hint','?')} "
            f"line={fp.get('line','?')} "
            f"policy={item.get('reason','REFERENCE_ONLY')} "
            f"license_file={item.get('license_file') or 'none'}"
        )
    lines.append("[/REFERENCE_ONLY_RECOGNITION]")
    return "\n".join(lines)[:max_chars]


def source_notebook_context_for_prompt(prompt_text, max_chars=1800):
    restricted=restricted_reference_context_for_prompt(prompt_text,max_chars=min(1200,max_chars))
    source_terms=re.search(r"\b(?:book|chapter|story|text|author|character|plot|theme|passage|source|document|script|code|program)\b",str(prompt_text or ""),re.I)
    if not source_terms and not restricted: return ""
    try:
        files=[os.path.join(GENTEXT_DIR,n) for n in os.listdir(GENTEXT_DIR) if n.startswith("learned_") and n.endswith(".txt")]
        if not files: return restricted
        words={w.lower() for w in re.findall(r"[A-Za-z0-9_]{3,}",str(prompt_text))}
        ranked=[]
        for path in files:
            name_words=set(re.findall(r"[a-z0-9_]{3,}",os.path.basename(path).lower()))
            ranked.append((len(words & name_words),os.path.getmtime(path),path))
        ranked.sort(reverse=True); path=ranked[0][2]
        body=Path(path).read_text(encoding="utf-8",errors="ignore")[-max_chars:]
        normal=(f"[SOURCE_SPECIFIC_REFERENCE:{os.path.basename(path)}]\n{body}\n"
                "INTERPRETATION_RULE=Distinguish literal source observations, model interpretations, user-attributed interpretations, and generalized facts.\n"
                "[/SOURCE_SPECIFIC_REFERENCE]")
        return (normal + ("\n"+restricted if restricted else ""))[:max_chars]
    except Exception:
        return restricted


