    def _oc_prog_apply_generation(project,response):
        project=_oc_prog_safe(project); meta=_oc_prog_meta(project); lang=str(meta.get("language","")).lower(); layout=_oc_prog_prefs().get(lang,{})
        records=re.findall(r'<progfile\s+stage="([^"]+)"\s+path="([^"]+)">(.*?)</progfile>',str(response),re.S|re.I)
        if not records:
            msg="No structured <progfile> records returned; no project files changed."
            _oc_prog_session_update(project,last_operation="generation",last_error=msg,progress=0,progress_label="GENERATION FAILED")
            _oc_prog_gui(project,0,"GENERATION FAILED",output=msg,error=msg)
            return False,[msg]
        results=[]; errors=[]
        for n,(stage,rel,body) in enumerate(records,1):
            stage=stage.lower().strip(); rel=rel.strip().replace("\\","/")
            _oc_prog_gui(project,min(90,20+int(n/max(1,len(records))*65)),f"WRITING {stage}/{rel}")
            if stage not in ("source","configure","build","program","comments") or rel.startswith("/") or ".." in Path(rel).parts:
                errors.append(f"rejected unsafe stage/path {stage}/{rel}"); continue
            name=Path(rel).name
            if not _oc_prog_allowed(stage,name,layout):
                errors.append(f"rejected {stage}/{rel}: wrong file type for [{lang}]"); continue
            root=_oc_prog_paths(project)[stage].resolve(); target=(root/rel).resolve()
            if root not in target.parents and target!=root:
                errors.append(f"rejected path outside stage: {rel}"); continue
            target.parent.mkdir(parents=True,exist_ok=True)
            try:
                target.write_text(body.lstrip("\n").rstrip()+"\n",encoding="utf-8")
                results.append(str(target.relative_to(CODE_ROOT)))
            except OSError as exc: errors.append(str(exc))
        if results: _oc_prog_record_tokens(project,_oc_prog_estimate_tokens(response),"generation_output")
        err="; ".join(errors)
        _oc_prog_session_update(project,last_operation="generation",last_error=err,progress=(100 if results else 0),progress_label=("GENERATION COMPLETE" if results else "GENERATION FAILED"))
        _oc_prog_gui(project,100 if results else 0,"GENERATION COMPLETE" if results else "GENERATION FAILED",error=err)
        return bool(results),results+errors

    def _oc_prog_comment(project,filetype,note):
        project=_oc_prog_safe(project)
        if not _oc_prog_meta(project):
            return False,f"No project metadata found for {project}."
        slug=re.sub(r"[^A-Za-z0-9._+-]+","_",str(filetype or "general")).strip("._") or "general"
        path=_oc_prog_paths(project)["comments"]/(slug+".comments.txt")
