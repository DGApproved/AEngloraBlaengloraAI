version_is_older() {
    local candidate="$1" current="$2"
    py - "$candidate" "$current" <<'PYVEROLDER' >/dev/null 2>&1
import re,sys
def key(v):
    nums=[int(x) for x in re.findall(r'\d+', v or '')]
    return tuple((nums+[0,0,0])[:3])
raise SystemExit(0 if key(sys.argv[1]) < key(sys.argv[2]) else 1)
PYVEROLDER
}

downgrade_menu() {
    local cur v f choice idx kind path
    cur="$(current_version)"
    local -a labels=() kinds=() paths=()

    while IFS= read -r f; do
        [[ -n "$f" ]] || continue
        v="$(version_from_file "$f")"
        if version_is_older "$v" "$cur"; then
            labels+=("$v  [complete]  $(basename "$f")")
            kinds+=("full")
            paths+=("$f")
        fi
    done < <(scan_full_versions)

    while IFS= read -r f; do
        [[ -n "$f" ]] || continue
        v="$(archive_version "$f")"
        if [[ "$v" == "unknown" ]] || version_is_older "$v" "$cur"; then
            labels+=("$v  [archive]   $(basename "$f")")
            kinds+=("archive")
            paths+=("$f")
        fi
    done < <(scan_archives)

    if ((${#labels[@]} == 0)); then
        echo "[!] No downgrade candidates older than $cur were found."
        return 1
    fi

    echo
    echo "Current version: $cur"
    echo "Available downgrade options:"
    for ((idx=0; idx<${#labels[@]}; idx++)); do
        printf '  %d) %s\n' "$((idx+1))" "${labels[$idx]}"
    done
    echo "  0) Cancel"
    read -r -p "Select downgrade: " choice
    [[ "$choice" =~ ^[0-9]+$ ]] || { echo "Abort."; return 1; }
    (( choice >= 1 && choice <= ${#labels[@]} )) || { echo "Abort."; return 1; }

    idx=$((choice-1))
    kind="${kinds[$idx]}"
    path="${paths[$idx]}"
    echo "Selected: ${labels[$idx]}"
    confirm_apt_style "Downgrade to this version?" || return 1
    if [[ "$kind" == "archive" ]]; then
        install_archive "$path"
    else
        install_full_version "$path" "local downgrade"
    fi
}
classify_explicit(){ local p="$1" b="$(basename "$p")";case "$b" in update.sh)echo patch;;AItech*.sh)echo full;;*)if cat_target_exists "$b";then echo component;else echo unknown;fi;;esac; }

