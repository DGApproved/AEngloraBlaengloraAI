        return

    items = list(hfs.items())
    for i, (path, owners) in enumerate(items, 1):
        meta = _read_hf_meta(path)
        size = _fmt_size(path)
        print(f"  \033[1m{i:2d}.\033[0m  {Path(path).name:<28}  "
              f"\033[0;36m{meta['arch']:<22}\033[0m  "
              f"{meta['params']:<8}  {size}")
        print(f"        engines: {', '.join(owners)}")
    print(f"  \033[2m 0.   Back\033[0m")

    try:
        choice = int(input("\n  Select model [0 to cancel]: ").strip())
    except ValueError:
        return
    if choice == 0 or choice > len(items):
        return

    hf_dir, owners = items[choice - 1]
    hf_path = Path(hf_dir)
    meta = _read_hf_meta(hf_dir)
    arch = meta["arch"].lower()

    print(f"\n  Selected: \033[1m{hf_path.name}\033[0m  ({meta['arch']}, {meta['params']})")

    # Quant type
    print("\n  Quantisation type:")
    for i, q in enumerate(QUANT_TYPES, 1):
        note = {
            "f16":   "full precision — largest, best quality",
            "q8_0":  "8-bit — near-lossless, large",
            "q4_0":  "4-bit — fast, small, some quality loss",
            "q4_k_m":"4-bit K-means — best 4-bit quality",
            "q5_k_m":"5-bit K-means — balance of size and quality",
            "q6_k":  "6-bit K-means — near q8 quality, smaller",
        }.get(q, "")
        print(f"    {i}.  {q:<12} {note}")
    print("    0.  Back")

    try:
        qchoice = int(input("\n  Select quantisation [default=1 f16]: ").strip() or "1")
    except ValueError:
        qchoice = 1
    if qchoice == 0:
        return
    quant = QUANT_TYPES[min(qchoice - 1, len(QUANT_TYPES) - 1)]

    # Output path
    out_name    = f"{hf_path.name}_{quant}.gguf"
    default_out = str(NOQ_MODELS / out_name)
    out_input   = input(f"\n  Output path [{default_out}]: ").strip()
    out_path    = Path(out_input) if out_input else Path(default_out)
    out_path.parent.mkdir(parents=True, exist_ok=True)

    print(f"\n  \033[1;33mBuilding {hf_path.name} → {out_path.name} …\033[0m")
    _write_art("BUILDING GGUF", hf_path.name, f"quant: {quant}", "0%")
    _write_chat("SYS", f"build: {hf_path.name} -> {out_path.name} [{quant}]")

    success = False
    is_gpt2 = ("gpt2" in arch or "gpt2" in hf_path.name.lower())

    if is_gpt2:
        _info("GPT2 architecture — using direct gguf package writer")
        success = _build_gpt2_to_gguf(hf_dir, out_path)
    else:
        _info("Llama/non-GPT2 architecture — using llama.cpp converter")
        success = _build_llama_with_llamacpp(hf_dir, out_path, quant)

    if success:
        size = _fmt_size(out_path)
        _ok(f"GGUF written: {out_path}  ({size})")
        _write_progress(100, f"GGUF saved: {out_name}")
        _write_art("BUILD COMPLETE", out_path.name, size, "100%")
        _write_chat("SYS", f"GGUF saved: {out_path}")

        rename = input(
            "\n  Mark as active? Renames to include '(Active)' "
            "[y/N]: "
        ).strip().lower()
        if rename == "y":
            stem = out_path.stem
            active_name = out_path.parent / f"{stem}(Active).gguf"
            # Remove previous active tag from siblings
            for sibling in out_path.parent.glob("*(Active)*.gguf"):
                new_sib = sibling.parent / sibling.name.replace("(Active)", "")
                sibling.rename(new_sib)
                _info(f"Cleared active tag: {sibling.name}")
            out_path.rename(active_name)
            _ok(f"Marked as active: {active_name.name}")
    else:
        _err("Build failed. Check output above for details.")

    input("\n  [Enter] return to menu  ")

# ── DECOMPRESS: GGUF → HuggingFace ───────────────────────────────────────────
def _decompress_gguf_to_hf(gguf_path, out_dir):
    """
    Extract tensors and metadata from a GGUF file and write a
    HuggingFace-compatible checkpoint.

    Supports:
      llama / llama2 / llama3 → LlamaForCausalLM
      gpt2                     → GPT2LMHeadModel
      other                    → AutoModelForCausalLM (best-effort)

    The resulting directory contains config.json + pytorch_model.bin /
    model.safetensors so it can be loaded with from_pretrained() and
    immediately passed to build_and_train_knowledge_engine() or
    run_native_training() in train_m_K_e.py.
    """
    if not (GGUF_AVAILABLE and TORCH_AVAILABLE and HF_AVAILABLE):
        _err("Requires: gguf, torch, transformers.  "
             "pip install gguf torch transformers")
        return False

    out_dir = Path(out_dir)
    out_dir.mkdir(parents=True, exist_ok=True)

    _info(f"Opening GGUF: {gguf_path}")
    try:
        reader = gguf.GGUFReader(str(gguf_path))
    except Exception as e:
        _err(f"Failed to open GGUF: {e}")
        return False

    # ── Read metadata ────────────────────────────────────────────────────
    kv = {}
    for field in reader.fields.values():
        try:
            raw = bytes(field.parts[-1])
            # Try int, then float, then string
            if field.types and field.types[0] in (
                gguf.GGUFValueType.UINT8,  gguf.GGUFValueType.INT8,
                gguf.GGUFValueType.UINT16, gguf.GGUFValueType.INT16,
                gguf.GGUFValueType.UINT32, gguf.GGUFValueType.INT32,
                gguf.GGUFValueType.UINT64, gguf.GGUFValueType.INT64,
            ):
                kv[field.name] = int.from_bytes(raw, "little")
            elif field.types and field.types[0] == gguf.GGUFValueType.FLOAT32:
                kv[field.name] = struct.unpack("<f", raw[:4])[0]
            else:
                kv[field.name] = raw.decode("utf-8", errors="ignore").rstrip("\x00")
        except Exception:
            pass

    arch = str(kv.get("general.architecture", "llama")).lower()
    _info(f"Architecture: {arch}")

    # ── Build config.json ────────────────────────────────────────────────
    def _kv(key, default=None):
        for suffix in [f".{key}", key]:
            for prefix in [arch, ""]:
                candidate = f"{prefix}{suffix}" if prefix else key
                if candidate in kv:
                    return kv[candidate]
        return default

    if "gpt2" in arch:
        cfg_dict = {
            "model_type":       "gpt2",
            "architectures":    ["GPT2LMHeadModel"],
            "n_embd":           _kv("embedding_length", 288),
            "n_layer":          _kv("block_count", 6),
            "n_head":           _kv("attention.head_count", 6),
            "n_positions":      _kv("context_length", 512),
            "n_inner":          _kv("feed_forward_length", None),
            "vocab_size":       _kv("vocab_size", 50257),
            "layer_norm_epsilon": _kv("attention.layer_norm_epsilon", 1e-5),
            "bos_token_id":     _kv("tokenizer.ggml.bos_token_id", 50256),
            "eos_token_id":     _kv("tokenizer.ggml.eos_token_id", 50256),
        }
        cfg_dict = {k: v for k, v in cfg_dict.items() if v is not None}
    else:
        # Default to Llama-compatible config
        n_heads    = _kv("attention.head_count", 8)
        n_kv_heads = _kv("attention.head_count_kv", n_heads)
        hidden     = _kv("embedding_length", 256)
        cfg_dict = {
            "model_type":                 "llama",
            "architectures":              ["LlamaForCausalLM"],
            "hidden_size":                hidden,
            "intermediate_size":          _kv("feed_forward_length", hidden * 4),
            "num_hidden_layers":          _kv("block_count", 6),
            "num_attention_heads":        n_heads,
            "num_key_value_heads":        n_kv_heads,
            "max_position_embeddings":    _kv("context_length", 4096),
            "rms_norm_eps":               _kv("attention.layer_norm_rms_epsilon", 1e-5),
            "vocab_size":                 _kv("vocab_size", 32000),
            "bos_token_id":               _kv("tokenizer.ggml.bos_token_id", 1),
            "eos_token_id":               _kv("tokenizer.ggml.eos_token_id", 2),
        }

    cfg_path = out_dir / "config.json"
    with open(cfg_path, "w", encoding="utf-8") as f:
        json.dump(cfg_dict, f, indent=2)
    _ok(f"config.json written ({cfg_path})")

    # ── Extract tensors ──────────────────────────────────────────────────
    _info("Extracting tensors (this may take a while) …")
    state_dict = {}
    tensors = list(reader.tensors)
    total   = len(tensors)

    for i, tensor in enumerate(tensors):
        try:
            import numpy as np
            data = np.array(tensor.data, copy=True)
            # Dequantise to float32 if needed
            if data.dtype not in (np.float16, np.float32, np.float64):
                data = data.astype(np.float32)
            state_dict[tensor.name] = torch.from_numpy(data)
        except Exception as exc:
            _warn(f"Skipping tensor '{tensor.name}': {exc}")
        _write_progress(int((i + 1) / total * 85), f"tensor {i+1}/{total}")
        if (i + 1) % 20 == 0:
            sys.stdout.write(f"\r    Extracted {i+1}/{total} tensors …")
            sys.stdout.flush()

    sys.stdout.write("\n")
    _info(f"Extracted {len(state_dict)} tensors")

    # ── Save weights ─────────────────────────────────────────────────────
    if ST_AVAILABLE and state_dict:
        wt_path = out_dir / "model.safetensors"
        st.save_file(state_dict, str(wt_path))
