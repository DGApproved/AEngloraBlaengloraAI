def _safe_source_notebook_name(filename):
    stem = Path(str(filename)).stem.lower()
    slug = re.sub(r"[^a-z0-9]+", "_", stem).strip("_") or "source"
    return f"learned_{slug[:80]}.txt"


def _record_source_notebook(filename, source_text, source_kind="Text Data", source_policy=None, source_record=None):
    """
    Create/update a source-specific gentext notebook.
    Source observations stay distinct from generalized facts and definitions.
    """
    if not str(source_text or "").strip():
        return ""

    notebook = _safe_source_notebook_name(filename)
    purpose = (
        f"Source-specific learned notebook for {filename}; preserves observations, "
        "later model interpretations, user-attributed interpretations, uncertainty, "
        "and passage references without treating them as universal facts."
    )
    keywords = [
        word for word in re.findall(r"[a-z0-9]{3,}", Path(str(filename)).stem.lower())
        if word not in {"txt", "md", "html", "htm"}
    ][:8]

    _register_gentext_file(
        notebook,
        "SOURCE_LEARNED_NOTEBOOK",
        purpose,
        keywords or ["source", "learned", "interpretation"],
    )

    policy = source_policy or {}
    state = policy.get("source_state", "LEGACY_NORMAL")
    mode = policy.get("mode", "TRAIN")
    source_id = (source_record or {}).get("source_id", "UNKNOWN")
    if mode == "TRAIN":
        excerpt = str(source_text).strip()[:1400]
    else:
        excerpt = "[WITHHELD_FROM_NOTEBOOK: reference/interpreter-only source]"
    entry = (
        "[SOURCE_INTAKE]\n"
        f"SOURCE_FILE={filename}\n"
        f"SOURCE_KIND={source_kind}\n"
        f"SOURCE_ID={source_id}\n"
        f"SOURCE_STATE={state}\n"
        f"SOURCE_MODE={mode}\n"
        f"EVIDENCE_CLASS={policy.get('evidence_class','NONE')}\n"
        f"EVIDENCE_CERTAINTY={policy.get('evidence_certainty','UNKNOWN')}\n"
        "STATUS=SCANNED_NOT_INTERPRETED_AS_UNIVERSAL_FACT\n"
        f"LINGUISTIC_FORM={classify_linguistic_form(source_text)}\n"
        f"COMPLEXITY_BAND={estimate_school_complexity(source_text)}\n"
        f"SOURCE_EXCERPT={excerpt}\n"
        "[/SOURCE_INTAKE]"
    )
    _append_to_gentext(notebook, entry)
    return notebook

