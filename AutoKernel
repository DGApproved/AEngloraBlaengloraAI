# apply_scoped MODE FILE WORKCOPY
# MODE is "data" (component bodies) or "env" (environment bodies). Every anchor
# must resolve exactly once INSIDE the declared target's generator body, so a
# directive written for one file can never land in another. The manifest lets an
# envmod tell an AItech-authored file from one the user has since made their own.
apply_scoped() {
    local mode="$1" directives="$2" work="$3" out rc src_lines manifest
    src_lines="$(file_lines "$directives")"
    manifest="$NOQ_DIR/dgapi/system/managed_manifest.txt"     # written by AItech's record_managed
    out="$(py - "$work" "$directives" "$mode" "$manifest" <<'PYSCOPED'
import os,re,sys,hashlib
# Scoped directive engine shared by envmod.txt and datamod.txt.
# argv: <aitech-source> <directive-file> <mode: env|data> <manifest-path>
# Unlike update.txt, every anchor here must resolve INSIDE the generator body of
# a declared target, so a directive written for one file can never land in
# another. Emits TAB-separated report rows on stdout; exit 0 only if it wrote.
sp,dp,mode,manifest=sys.argv[1:5]
s=open(sp,encoding='utf-8',errors='replace').read()
d=open(dp,encoding='utf-8',errors='replace').read()

def ln(text,pos):return text.count('\n',0,pos)+1
def rng(text,pos,length):
    a=ln(text,pos);b=ln(text,pos+max(0,length-1));return f'{a}' if a==b else f'{a}-{b}'

# --- locate every generated body in the launched source ----------------------
# write_if_changed sites are COMPONENT bodies (datamod). Bare `cat >` sites are
# ENV bodies (envmod): config/registry files, several of them seed-once.
SITE=re.compile(r'^([ \t]*)(write_if_changed|cat[ \t]*>)[ \t]+(["\'])(.*?)\3[ \t]*<<-?[ \t]*(?:["\']([^"\']+)["\']|([^ \t\r\n]+))[ \t]*$')
lines=s.splitlines(True)
sites={}          # basename -> list of dicts
pos=0;i=0
while i<len(lines):
    m=SITE.match(lines[i].rstrip('\r\n'))
    if not m:
        pos+=len(lines[i]);i+=1;continue
    delim=m.group(5) or m.group(6)
    kind='data' if m.group(2).startswith('write_if_changed') else 'env'
    opener_start=pos;pos+=len(lines[i]);i+=1
    body_start=pos
    while i<len(lines) and lines[i].rstrip('\r\n').strip()!=delim:
        pos+=len(lines[i]);i+=1
    if i>=len(lines):
        print(f'ERROR\tN/A\tN/A\tunterminated heredoc for {m.group(4)}');raise SystemExit(30)
    body_end=pos
    pos+=len(lines[i]);i+=1
    # seed-once when the site is guarded by an existence test just above it
    guard=''.join(lines[max(0,len(s[:opener_start].splitlines())-2):]) if False else ''
    head=s[:opener_start].splitlines()[-3:]
    seed=any(re.search(r'if[ \t]*\[+[ \t]*!\s*-f|\[\[[ \t]*-f[^\]]*\]\][ \t]*\|\|',h) for h in head)
    sites.setdefault(os.path.basename(m.group(4).replace(chr(92),'/')),[]).append(
        dict(kind=kind,start=body_start,end=body_end,seed=seed,raw=m.group(4)))

# --- split the directive file into per-target sections -----------------------
parts=re.split(r'(?m)^@@[ \t]+AITECH_TARGET[ \t]+(\S+)[ \t]*$',d)
if len(parts)<3:
    print('ERROR\t1\tN/A\tno "@@ AITECH_TARGET <file>" section found; scoped directives require one');raise SystemExit(31)
sections=[(parts[k],parts[k+1]) for k in range(1,len(parts),2)]

RULES=[('replace','AITECH_REPLACE_BEGIN','AITECH_REPLACE_END',1),
       ('after','AITECH_INSERT_AFTER_BEGIN','AITECH_INSERT_AFTER_END',1),
       ('before','AITECH_INSERT_BEFORE_BEGIN','AITECH_INSERT_BEFORE_END',1),
       ('delete','AITECH_DELETE_BEGIN','AITECH_DELETE_END',0)]
MIG=re.compile(r'(?ms)^@@[ \t]+AITECH_MIGRATION_BEGIN[ \t]*\n(.*?)^@@[ \t]+AITECH_MIGRATION_END[ \t]*$')
MARKER='     # AITECH_ENVMOD_MIGRATIONS'

# --- manifest: what did AItech itself last write? ----------------------------
recorded={}
if manifest and os.path.isfile(manifest):
    for row in open(manifest,encoding='utf-8',errors='replace'):
        bits=row.rstrip('\n').split('\t')
        if len(bits)==2: recorded[os.path.basename(bits[1])]=(bits[0],bits[1])

def sha256(path):
    h=hashlib.sha256()
    with open(path,'rb') as fh:
        for chunk in iter(lambda: fh.read(65536), b""): h.update(chunk)
    return h.hexdigest()

applied=0;skipped=0;report=[]
for target,block in sections:
    cand=sites.get(target,[])
    cand=[c for c in cand if c['kind']==mode]
    if len(cand)!=1:
        want='component (write_if_changed)' if mode=='data' else 'environment (cat >)'
        print(f'ERROR\tN/A\tN/A\t{target}: expected exactly one {want} body, found {len(cand)}')
        raise SystemExit(32)
    site=cand[0]

    # SKIP RULE: never overwrite a file the user has made their own. If the
    # installed file no longer matches what AItech last wrote, the user edited it
    # by hand since initialization or the last update, so this target is left
    # exactly as they left it and the remaining targets still apply.
    rec=recorded.get(target)
    if rec:
        rec_hash,rec_path=rec
        if os.path.isfile(rec_path):
            try: live=sha256(rec_path)
            except OSError: live=None
            if live and live!=rec_hash:
                skipped+=1
                report.append(f'SKIP\t{target}\tuser-modified since last write; left untouched')
                continue

    body=s[site['start']:site['end']]
    newbody=body;count=0
    work=block
    for kind,beg,end,withreq in RULES:
        pat=re.compile(r'(?ms)^@@[ \t]+'+beg+r'[ \t]*\n(.*?)^@@[ \t]+'+end+r'[ \t]*$')
        while True:
            m=pat.search(work)
            if not m:break
            payload=m.group(1)
            if withreq:
                bits=re.split(r'(?m)^@@[ \t]+AITECH_WITH[ \t]*$',payload,maxsplit=1)
                if len(bits)!=2:
                    print(f'ERROR\tN/A\tN/A\t{target}: {beg} missing @@ AITECH_WITH');raise SystemExit(33)
                old,new=bits[0].rstrip('\n'),bits[1].lstrip('\n').rstrip('\n')
            else: old,new=payload.rstrip('\n'),''
            if not old:
                print(f'ERROR\tN/A\tN/A\t{target}: {beg} has an empty anchor');raise SystemExit(34)
            hits=[x.start() for x in re.finditer(re.escape(old),newbody)]
            if len(hits)!=1:
                where='NOT FOUND' if not hits else ','.join(rng(s,site['start']+h,len(old)) for h in hits[:20])
                print(f'ERROR\tN/A\t{where}\t{target}: anchor must occur exactly once inside this body; found {len(hits)}')
                raise SystemExit(35)
            if kind=='replace':newbody=newbody.replace(old,new,1)
            elif kind=='delete':newbody=newbody.replace(old,'',1)
            elif kind=='after':newbody=newbody.replace(old,old+'\n'+new,1)
            elif kind=='before':newbody=newbody.replace(old,new+'\n'+old,1)
            count+=1;work=work[:m.start()]+work[m.end():]
    if count==0:
        print(f'ERROR\tN/A\tN/A\t{target}: section contains no recognized AITECH_* directive blocks')
        raise SystemExit(36)

    mig=MIG.search(block)
    if site['seed'] and mode=='env' and not mig:
        print(f'ERROR\tN/A\tN/A\t{target}: seed-once body (written under an existence guard) '
              f'requires a paired @@ AITECH_MIGRATION block, or existing installs never receive this change')
        raise SystemExit(37)

    s=s[:site['start']]+newbody+s[site['end']:]
    delta=len(newbody)-len(body)
    for b in sites.values():
        for c in b:
            if c['start']>site['start']: c['start']+=delta;c['end']+=delta
    site['end']+=delta

    if mig and mode=='env':
        if MARKER not in s:
            print(f'ERROR\tN/A\tN/A\t{target}: AITECH_ENVMOD_MIGRATIONS marker not found in the launched source')
            raise SystemExit(38)
        blockmig=mig.group(1).rstrip('\n')
        at=s.index(MARKER)
        s=s[:at]+blockmig+'\n\n'+s[at:]
        report.append(f'MIGRATION\t{target}\tinserted above AITECH_ENVMOD_MIGRATIONS')
    applied+=1
    report.append(f'APPLIED\t{target}\t{count} directive(s) inside {site["raw"]}'
                  + ('  [seed-once + migration]' if site['seed'] else ''))

for r in report: print(r)
if applied==0:
    print(f'ERROR\tN/A\tN/A\tno targets applied ({skipped} skipped as user-modified)')
    raise SystemExit(39)
open(sp,'w',encoding='utf-8').write(s)
print(f'OK\t{applied}\t{skipped}')
PYSCOPED
)"
    rc=$?
    printf '%s\n' "$out" | while IFS=$'\t' read -r kind a b; do
        case "$kind" in
            APPLIED)   printf '  [~] %s: %s\n' "$a" "$b";;
            SKIP)      printf '  [!] %s: %s\n' "$a" "$b";;
            MIGRATION) printf '  [+] %s: migration %s\n' "$a" "$b";;
            OK)        printf '  [✓] %s target(s) applied, %s skipped as user-modified\n' "$a" "$b";;
        esac
    done
    if (( rc != 0 )); then
        local reason; reason="$(printf '%s\n' "$out" | awk -F'\t' '$1=="ERROR"{print $4; exit}')"
        local tgt;    tgt="$(printf '%s\n' "$out" | awk -F'\t' '$1=="ERROR"{print $3; exit}')"
        abort_diag "$directives" "$src_lines" "$AITECH_SCRIPT" "${tgt:-N/A}" "${reason:-Scoped $mode directive failed (parser exit $rc).}"
        return 1
    fi
    return 0
}

