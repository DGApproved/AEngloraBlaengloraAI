            "This is useful after major reclassification events or manual edits "
            "so the local importance ledger reflects actual file contents rather "
            "than only incremental event history. As a classroom metaphor, it is "
            "laying all the notes out again and reconsidering which ideas deserve "
            "attention when thinking about future responses. <|endoftext|>"
        ),
    ]
    return "\n".join(lines)

