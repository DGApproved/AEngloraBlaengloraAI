            update_gui_chat("SYS", "Orchestrator trash route -> WAKE recycle requested")

    # One computation = one user prompt processed through a chat engine's
    # terminal front end. The orchestrator only reads this clock; the engines
    # advance it. Age in computations is stable where dates are not.
    COMPUTATION_COUNTER_PATH = NOQ_DIR / "dgapi" / "system" / "computations.txt"

    def _computation_now():
        try:
            for line in COMPUTATION_COUNTER_PATH.read_text(encoding="utf-8", errors="ignore").splitlines():
                line = line.strip()
                if line and not line.startswith("#"):
                    return int(float(line.split()[0]))
        except Exception:
            pass
        return 0

    def orchestrator_age_in_computations(filename, key=None):
        ledger = load_local_weight_ledger()
        k = filename if key is None else f"{filename}::{key}"
        born = ledger.get("@born", {}).get(k)
        return None if born is None else max(0, _computation_now() - int(born))

    def orchestrator_computations_since_access(filename, key=None):
        ledger = load_local_weight_ledger()
        k = filename if key is None else f"{filename}::{key}"
        seen = ledger.get("@seen", {}).get(k)
        return None if seen is None else max(0, _computation_now() - int(seen))

    def load_local_weight_ledger():
        """
        Parse AItech's localized semantic token-importance ledger.
        Values are organizational weights per named memory file, not neural weights.
        """
        ledger = {}
        current = None

        if not MEMORY_WEIGHTS_PATH.exists():
            return ledger

        try:
            note_memory_io(
                "read",
                MEMORY_WEIGHTS_PATH,
                "localized semantic token-importance ledger",
                "expose per-memory-file importance to orchestrator and selected GGUF context"
            )
            with open(MEMORY_WEIGHTS_PATH, "r", encoding="utf-8", errors="ignore") as f:
                for raw in f:
                    line = raw.strip()
                    if not line or line.startswith("#"):
                        continue
                    if line.startswith("[") and line.endswith("]"):
                        current = line[1:-1]
                        ledger.setdefault(current, {})
                        continue
                    if current and "\t" in line:
                        word, value = line.split("\t", 1)
                        try:
                            ledger[current][word] = float(value)
                        except ValueError:
                            # State marker, not a weight. <computed> marks a
                            # sheared entry; preserve it so a save cannot drop it.
                            ledger[current][word] = value.strip()
        except Exception:
            return {}

        return ledger

    def canonical_memory_path(filename):
        virtual_names = {
            "active_context.txt", "persona.txt", "creatures.txt",
            "encyclopedia.txt", "religion.txt", "output_vocabulary.txt",
        }
        datas_names = {
            "decisions.txt", "facts.txt", "dictionary.txt", "definitions.txt",
            "thesaurus.txt", "almanac.txt", "errors.txt", "experimental.txt",
        }
        memory_names = {
            "amdream.txt", "images.txt", "audio.txt", "video.txt",
            "text_logs.txt", "weights.txt", "journal.txt",
        }
        if filename in virtual_names:
            return NOQ_DIR / "dgapi" / "virtual" / filename
        if filename in datas_names:
            return NOQ_DIR / "dgapi" / "datas" / filename
        if filename in memory_names:
            return NOQ_DIR / "data" / "memory" / filename
        return None

    def _weight_words(text):
        return re.findall(r"[A-Za-z0-9_'-]+", text.lower())

    def save_local_weight_ledger(ledger):
        tmp = str(MEMORY_WEIGHTS_PATH) + ".tmp"
        MEMORY_WEIGHTS_PATH.parent.mkdir(parents=True, exist_ok=True)
        with open(tmp, "w", encoding="utf-8") as f:
            f.write("# AItech localized semantic token-importance ledger\n")
            f.write("# Values are per named memory file, not neural-network weights.\n\n")
            for filename in sorted(ledger):
                f.write(f"[{filename}]\n")
                for word, value in sorted(
                    ledger[filename].items(),
                    key=lambda kv: (1, 0.0, kv[0]) if isinstance(kv[1], str) else (0, -float(kv[1]), kv[0])
                ):
                    if isinstance(value, str):
                        val = value          # state marker, e.g. <computed>
                    else:
                        val = str(int(value)) if float(value).is_integer() else f"{value:.4f}".rstrip("0").rstrip(".")
                    f.write(f"{word}\t{val}\n")
                f.write("\n")
        os.replace(tmp, MEMORY_WEIGHTS_PATH)

    def update_local_weight_ledger(path_or_name, content, multiplier=1.0, reason="orchestrator memory operation"):
        filename = os.path.basename(str(path_or_name))
        if filename == MEMORY_WEIGHTS_PATH.name:
            return
        words = _weight_words(content)
        if not words:
            return
        ledger = load_local_weight_ledger()
        section = ledger.setdefault(filename, {})
        for word in words:
            section[word] = section.get(word, 0.0) + float(multiplier)
        # Computation-based aging shares the ledger with token importance.
        # See the base engine for the section contract; the orchestrator writes
        # the same shapes so all three processes read one history.
        _now = _computation_now()
        _meta = ledger.setdefault("@computations", {})
        _meta["now"] = float(_now)
        _meta.setdefault("genesis", float(int(time.time())))
        _born = ledger.setdefault("@born", {})
        _seen = ledger.setdefault("@seen", {})
        _uses = ledger.setdefault("@uses", {})
        _dates = ledger.setdefault("@borndate", {})
        _modifies = float(multiplier) >= 1.0
        for _k in [filename] + [f"{filename}::{w}" for w in words]:
            if _k not in _born:
                _born[_k] = float(_now)
                if _k == filename:
                    _dates[_k] = float(int(time.time()))
            elif _modifies and _dates.get(_k) == "<computed>":
                # Regrow a sheared entry that a modifying computation touched.
                _dates[_k] = float(int(time.time()))
                _born[_k] = float(_now)
            _seen[_k] = float(_now)
            _uses[_k] = _uses.get(_k, 0.0) + 1.0
        save_local_weight_ledger(ledger)
        note_memory_io("store", MEMORY_WEIGHTS_PATH, f"token importance for {filename}", f"trace importance during {reason}")

