            applyScale(1.0f);
            refreshTemporalDisplay();
        }

        void applyScale(float newScale) {
            scale = Math.max(0.75f, newScale);
            int fontSize = Math.max(9, (int) (11 * scale));
            int width = Math.max(126, (int) (145 * scale));
            int height = Math.max(22, (int) (25 * scale));
            int lineWidth = Math.max(74, (int) (92 * scale));
            int lineHeight = Math.max(2, (int) (2 * scale));

            for (JLabel display : displays) {
                display.setFont(new Font("Monospaced", Font.BOLD, fontSize));
                display.setPreferredSize(new Dimension(width, height));
            }
            clockDeck.setPreferredSize(new Dimension(width, height));
            apertureToggle.setPreferredSize(new Dimension(lineWidth, lineHeight));
            revalidate();
            repaint();
        }

        private void cycleTemporalChannel() {
            visibleChannel = (visibleChannel + 1) % displays.length;
            clockCards.show(clockDeck, cardNames[visibleChannel]);
            refreshTemporalDisplay();
        }

        private void toggleVisibleTimer() {
            int i = visibleChannel;
            long now = System.nanoTime();

            if (timerRunning[i]) {
                timerAccumulatedNanos[i] += now - timerStartedNanos[i];
                timerRunning[i] = false;
            } else {
                timerStartedNanos[i] = now;
                timerRunning[i] = true;
            }
            refreshTemporalDisplay();
        }

        private long elapsedNanos(int channel) {
            long elapsed = timerAccumulatedNanos[channel];
            if (timerRunning[channel]) {
                elapsed += System.nanoTime() - timerStartedNanos[channel];
            }
            return Math.max(0L, elapsed);
        }

        private void refreshTemporalDisplay() {
            if (!SwingUtilities.isEventDispatchThread()) {
                SwingUtilities.invokeLater(this::refreshTemporalDisplay);
                return;
            }

            updateClockTexts();
            String text = showTimer
                    ? timerText(visibleChannel)
                    : clockText(visibleChannel);

            displays[visibleChannel].setText(text);
            displays[visibleChannel].setForeground(
                    timerRunning[visibleChannel]
                            ? MatrixConfig.GODDESS_GOLD
                            : MatrixConfig.TEXT_COLOR);
            clockCards.show(clockDeck, cardNames[visibleChannel]);
        }

        // Maintain all three clock labels every refresh even while two are hidden.
        private void updateClockTexts() {
            for (int i = 0; i < displays.length; i++) {
                displays[i].setText(showTimer && i == visibleChannel
                        ? timerText(i)
                        : clockText(i));
                displays[i].setForeground(timerRunning[i]
                        ? MatrixConfig.GODDESS_GOLD
                        : MatrixConfig.TEXT_COLOR);
            }
        }

        private String clockText(int channel) {
            java.util.Calendar cal = java.util.Calendar.getInstance();
            long hour24 = cal.get(java.util.Calendar.HOUR_OF_DAY);
            long minute = cal.get(java.util.Calendar.MINUTE);
            long second = cal.get(java.util.Calendar.SECOND);
            long milli = cal.get(java.util.Calendar.MILLISECOND);

            if (channel == 0) {
                long hour12 = hour24 % 12;
                if (hour12 == 0) hour12 = 12;
                return String.format("T1 %02d:%02d:%02d %s",
                        hour12, minute, second, hour24 >= 12 ? "PM" : "AM");
            }

            long stdMsec = hour24 * 3_600_000L
                    + minute * 60_000L
                    + second * 1_000L
                    + milli;
            long aengMsec = (stdMsec * AENG_SECONDS_DAY) / 86_400L;
            long aengSecTotal = aengMsec / 1000L;
            long aengHour = aengSecTotal / AENG_SECONDS_HOUR;
            long aengMinute = (aengSecTotal % AENG_SECONDS_HOUR) / AENG_SECONDS_MINUTE;
            long aengSecond = aengSecTotal % AENG_SECONDS_MINUTE;

            if (channel == 1) {
                long hybridHour = hour24 % 13;
                if (hybridHour == 0) hybridHour = 13;
                String sec = aengSecond >= 60
                        ? String.format("[%02d]", aengSecond)
                        : String.format("%02d", aengSecond);
                return String.format("T2 %02d:%02d:%s %s",
                        hybridHour, minute, sec, hour24 >= 13 ? "PM" : "AM");
            }

            long dispHour;
            boolean pm;
            if (aengHour == 0) {
                dispHour = 13;
                pm = false;
            } else if (aengHour < 13) {
                dispHour = aengHour;
                pm = false;
            } else if (aengHour == 13) {
                dispHour = 13;
                pm = true;
            } else {
                dispHour = aengHour - 13;
                pm = true;
            }

            return String.format("T3 %02d:%02d:%02d %s",
                    dispHour, aengMinute, aengSecond, pm ? "PM" : "AM");
        }

        private String timerText(int channel) {
            double elapsedMs = elapsedNanos(channel) / 1_000_000.0;
            double unitMs;
            long secondsPerMinute;
            long minutesPerHour;

            if (channel == 2) {
                // T3 measures duration directly in Aengloria 81/81 units.
                unitMs = AENG_MS_PER_SECOND;
                secondsPerMinute = 81L;
                minutesPerHour = 81L;
            } else if (channel == 1) {
                // T2 uses the same midpoint temporal metric exposed by the game's
                // HYBRID physics mode, but keeps a familiar 60/60 timer face.
                unitMs = HYBRID_MS_PER_SECOND;
                secondsPerMinute = 60L;
                minutesPerHour = 60L;
            } else {
                unitMs = 1000.0;
                secondsPerMinute = 60L;
                minutesPerHour = 60L;
            }

            long totalUnits = (long) Math.floor(elapsedMs / unitMs);
            long sec = totalUnits % secondsPerMinute;
            long totalMinutes = totalUnits / secondsPerMinute;
            long min = totalMinutes % minutesPerHour;
            long hour = totalMinutes / minutesPerHour;

            return String.format("T%d %02d:%02d:%02d%s",
                    channel + 1, hour, min, sec,
                    timerRunning[channel] ? " ▶" : " ■");
        }
    }

