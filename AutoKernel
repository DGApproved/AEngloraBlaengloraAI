    class PonderEngine(threading.Thread):
        def __init__(self):
            super().__init__(daemon=True)
            self.is_pondering  = False
            self.wake_mode     = False
            self.interest      = 0.5

        def run(self):
            while True:
                time.sleep(1)
                if is_ponder_paused:
                    continue
                active = self.wake_mode or current_mode in ["be", "ce", "auto"]
                idle   = time.time() - last_activity > (60.0 - self.interest * 30.0)
                if active or idle:
                    self.is_pondering = True
                    if current_mode == "wake: qwen":
                        self.generate_qwen_consult()
                    else:
                        # BE = BASIC ENGINE: bare training-shaped prompt.
                        # CE = COMPLETE / CHAT ENGINE: the same cycle assembled
                        # through the chat-compatibility context.
                        self.do_ponder(chat_compat=(current_mode == "ce"))
                    self.is_pondering = False
                    if active:
                        time.sleep(1.0)
                    else:
                        time.sleep(max(15.0, 60.0 - self.interest * 45.0))

        def do_ponder(self, chat_compat=False):
            # chat_compat=False is BE, the basic engine cycle exactly as it was.
            # chat_compat=True is CE, the same cycle with a chat-shaped prompt
            # built from the interpretation scaffold, input registers, cache
            # state and any dropped-source notebook the text touches. Every
            # piece is optional: if a context source is missing or fails, CE
            # degrades toward BE rather than stopping the loop.
            nonlocal session_history
            base    = last_prompt if last_prompt else "what is the nature of aengloria"
            mutated = list(base)
            if len(mutated) > 3:
                mutated[random.randint(0, len(mutated)-1)] = random.choice('abcdefghijklmnopqrstuvwxyz')
            mutated = "".join(mutated)
            chat_directive = ""
            if chat_compat:
                pieces = []
                for producer in (
                    lambda: build_interpretation_scaffold(base),
                    lambda: build_input_register_state(base),
                    lambda: source_notebook_context_for_prompt(base, max_chars=700),
                    lambda: get_aitech_self_source_reference(base, max_chars=700),
                ):
                    try:
                        piece = producer()
                    except Exception:
                        piece = ""
                    if piece:
                        pieces.append(str(piece).strip())
                if pieces:
                    chat_directive = "\n".join(pieces)[:1800] + "\n"
            model.eval()
            with torch.no_grad():
                b_in = encode_chat_generation_prompt(f"{chat_directive}User: {base}\nAssistant:", 15)
                b_out = model.generate(**b_in, max_new_tokens=15,
                                       pad_token_id=tokenizer.eos_token_id,
                                       do_sample=True, temperature=0.7)
                b_text = tokenizer.decode(b_out[0][b_in['input_ids'].shape[1]:],
                                          skip_special_tokens=True).strip()
                m_in = encode_chat_generation_prompt(f"{chat_directive}User: {mutated}\nAssistant:", 15)
                m_out = model.generate(**m_in, max_new_tokens=15,
                                       pad_token_id=tokenizer.eos_token_id,
                                       do_sample=True, temperature=0.7)
                m_text = tokenizer.decode(m_out[0][m_in['input_ids'].shape[1]:],
                                          skip_special_tokens=True).strip()
            self.interest = 1.0 - difflib.SequenceMatcher(None, b_text, m_text).ratio()
            sys.stdout.write(f"\r\033[K[amdream] {mutated[:20]} -> {m_text[:40]} "
                             f"[Interest:{self.interest:.2f}]\n")
            sys.stdout.flush()
            log = (f"[{time.strftime('%Y-%m-%dT%H:%M:%S')}] PONDER\n"
                   f"  Base: '{base}' -> '{b_text}'\n"
                   f"  Mutated: '{mutated}' -> '{m_text}'\n"
                   f"  Interest: {self.interest:.4f}\n\n")
            append_memory_file(AMDREAM_TXT, log, what="ponder cycle", why="amdream owns ponder history")
            update_gui_chat("SYS", f"Ponder interest={self.interest:.2f}")

        def generate_qwen_consult(self):
            nonlocal session_history
            model.eval()
            t_in = encode_chat_generation_prompt(
                "User: Generate a short abstract question.\nAssistant:", 30
            )
            with torch.no_grad():
                t_out = model.generate(**t_in, max_new_tokens=30,
                                       pad_token_id=tokenizer.eos_token_id,
                                       do_sample=True, temperature=0.85)
            thought = tokenizer.decode(t_out[0][t_in['input_ids'].shape[1]:],
                                       skip_special_tokens=True).strip()
            if not thought:
