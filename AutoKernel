def _tail_text(text, max_chars):
    if len(text) <= max_chars:
        return text
    return "[...OLDER CONTENT OMITTED...]\n" + text[-max_chars:]

def load_goddess_memory_context(total_budget=24000):
    """
    Load named semantic memory files into the prompt context.
    Mirrors the same function in chat_and_display, but with a smaller
    default budget since the GPT2 knowledge model has a 512-token context.
    """
    files = [
        {"path": ACTIVE_CONTEXT_TXT, "role": "ACTIVE_CONTEXT",   "priority": 100, "max_chars": 3000},
        {"path": os.path.join(VIRTUAL_DIR, "persona.txt"),        "role": "PERSONA",       "priority": 95,  "max_chars": 2000},
        {"path": DECISIONS_TXT,       "role": "DECISIONS",        "priority": 85,  "max_chars": 2000},
        {"path": FACTS_TXT,           "role": "FACTS",            "priority": 80,  "max_chars": 3000},
        {"path": os.path.join(VIRTUAL_DIR, "encyclopedia.txt"),   "role": "ENCYCLOPEDIA",  "priority": 75,  "max_chars": 4000},
        {"path": os.path.join(DATAS_DIR, "dictionary.txt"),       "role": "DICTIONARY",    "priority": 70,  "max_chars": 2000},
        {"path": DEFINITIONS_TXT,     "role": "DEFINITIONS_RAW",  "priority": 68,  "max_chars": 2000},
        {"path": ERRORS_TXT,          "role": "ERRORS",           "priority": 45,  "max_chars": 1500},
        {"path": CHAT_LOG,            "role": "JOURNAL",          "priority": 20,  "max_chars": 4000},
    ]
    sections = []
    remaining = total_budget
    manifest  = []
    for spec in sorted(files, key=lambda s: s["priority"], reverse=True):
        path = spec["path"]
        if remaining <= 0 or not os.path.exists(path):
            continue
        try:
            raw = open(path, encoding="utf-8", errors="ignore").read().strip()
        except OSError:
            continue
        if not raw:
            continue
        allowed  = min(spec["max_chars"], remaining)
        selected = _tail_text(raw, allowed)
        sections.append(
            f"\n[MEMORY role={spec['role']} file={os.path.basename(path)}]\n"
            f"{selected}\n[/MEMORY]\n"
        )
        remaining -= len(selected)
        manifest.append({"role": spec["role"], "loaded": True})
    try:
        with open(MEMORY_MANIFEST_JSON, "w", encoding="utf-8") as f:
            json.dump({"updated": time.strftime('%Y-%m-%dT%H:%M:%S'),
                       "budget": total_budget, "files": manifest}, f, indent=2)
    except OSError:
        pass
    return "".join(sections), manifest

