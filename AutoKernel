# The low-friction rule is intentional:
#   no meaningful provenance signal -> LEGACY_NORMAL -> preserve old behavior.
# A signal is evidence to interpret, not an accusation and not automatically a
# legal conclusion.  The same source identity can be revised when later evidence
# appears, while historical classifications remain append-only provenance events.
_NO_AI_PATTERNS = (
    "not intended for ai use", "not intended for ai training", "not for ai training",
    "do not train", "no machine learning", "no generative ai training",
    "ai training prohibited",
)
_COPYRIGHT_HINTS = ("copyright ", "©", "all rights reserved")
_POLICY_FILENAMES = ("copyright.interpret", "license.interpret", "media_rights.interpret")

# Recognition hints.  They establish a candidate/declared license state; the
# local interpretation policy decides whether that state is trainable.
_LICENSE_PATTERNS = (
    ("GPL-3.0", r"\b(?:GPL[- _]?3(?:\.0)?|GNU GENERAL PUBLIC LICENSE\s+Version\s+3)\b"),
    ("GPL-2.0", r"\b(?:GPL[- _]?2(?:\.0)?|GNU GENERAL PUBLIC LICENSE\s+Version\s+2)\b"),
    ("LGPL", r"\b(?:LGPL|GNU LESSER GENERAL PUBLIC LICENSE)\b"),
    ("AGPL", r"\b(?:AGPL|GNU AFFERO GENERAL PUBLIC LICENSE)\b"),
    ("MIT", r"\bMIT License\b|permission is hereby granted,\s*free of charge"),
    ("Apache-2.0", r"\bApache License,\s*Version\s*2\.0\b|\bApache-2\.0\b"),
    ("BSD", r"redistribution and use in source and binary forms"),
    ("CC0", r"\bCC0\b|Creative Commons Zero"),
    ("Public-Domain", r"\bpublic domain\b"),
)
_DEFAULT_TRAINABLE_LICENSES = {"MIT", "Apache-2.0", "BSD", "CC0", "Public-Domain"}

# Binary/container markers are deliberately conservative.  Seeing one means
# "protected-media evidence detected", not "we know the exact legal terms".
_PROTECTED_MEDIA_MARKERS = (
    b"pssh", b"drms", b"sinf", b"schm", b"widevine", b"playready",
    b"fairplay", b"protected content", b"content protection",
)

