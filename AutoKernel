materialize_source() {
    local source="$1" result status path b
    if ! is_remote_source "$source"; then
        [[ -f "$source" ]] || { abort_diag "$source" "N/A" "$AITECH_SCRIPT" "N/A" "Local update source does not exist or is not a regular file."; return 1; }
        printf '%s\n' "$source"; return 0
    fi
    echo "[+] Fetching update source: $source" >&2
    if [[ "$source" == http://* || "$source" == https://* ]]; then result="$(fetch_http "$source" 2>/dev/null)"; status=$?; else result="$(fetch_tcp "$source" 2>/dev/null)"; status=$?; fi
    if (( status!=0 )) || [[ "$result" != OK$'\t'* ]]; then
        abort_diag "$source" "REMOTE" "$STAGE_DIR" "N/A" "Remote fetch failed: ${result#*$'\t'}"; return 1
    fi
    path="${result#*$'\t'}"; b="$(basename "$path")"
    echo "[✓] Staged remote payload as: $b" >&2
    printf '%s\n' "$path"
}

