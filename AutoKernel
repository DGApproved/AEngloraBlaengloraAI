            try:
                chat_directive = build_chat_compat_context(base_str)
            except Exception:
                chat_directive = ""

        b_in = tokenizer(f"{schema_directive}{chat_directive}User: {base_str}\nAssistant:", return_tensors="pt").to(device)
        with torch.no_grad():
            b_out = model.generate(**b_in, max_new_tokens=max_toks, pad_token_id=tokenizer.eos_token_id, do_sample=True, temperature=0.7)
        b_text = tokenizer.decode(b_out[0][b_in['input_ids'].shape[1]:], skip_special_tokens=True).strip()
        
        m_in = tokenizer(f"{schema_directive}{chat_directive}User: {mutated_str}\nAssistant:", return_tensors="pt").to(device)
        with torch.no_grad():
            m_out = model.generate(**m_in, max_new_tokens=max_toks, pad_token_id=tokenizer.eos_token_id, do_sample=True, temperature=0.7)
        m_text = tokenizer.decode(m_out[0][m_in['input_ids'].shape[1]:], skip_special_tokens=True).strip()
        
        # Generative Dream Logging (Visual & Auditory)
        v_in = tokenizer("User: Generate a brief, conceptual description of the visual scene in your current dream.\nAssistant:", return_tensors="pt").to(device)
        with torch.no_grad():
