    def load_model_context(model_id):
        config = MODEL_CONFIGS.get(model_id, {})
        file_path = config.get("dir") / config.get("context_file")
        if file_path.is_file():
            try: return file_path.read_text(encoding="utf-8").strip()
            except: pass
        return ""

    def log_collaboration(model_id, task, result_summary):
        log_path = SHARED_DIR / "COLLABORATION_LOG.md"
        clean_name = MODEL_CONFIGS.get(model_id, {}).get("name", model_id)
        try:
            with open(log_path, "a", encoding="utf-8") as f:
                f.write(f"- **{clean_name}**: {task}\n  - *Action:* {result_summary}\n")
        except: pass

    def triage_task(prompt):
        if not active_cloud_models: return LOCAL_MODEL
        options = ", ".join(active_cloud_models.keys())
        triage_prompt = f"Evaluate: If easy (boilerplate/formatting), reply 'LOCAL'. If complex, reply with best fit from: {options}. Task: {prompt}"
        try:
            res = completion(model=LOCAL_MODEL, messages=[{"role": "user", "content": triage_prompt}], api_base=MODEL_CONFIGS[LOCAL_MODEL]["api_base"])
            decision = res.choices[0].message.content.strip().upper()
            for key, model_id in active_cloud_models.items():
                if key in decision: return model_id
            return LOCAL_MODEL
        except: return LOCAL_MODEL

