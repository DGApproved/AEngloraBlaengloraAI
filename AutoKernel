def build_system_file_graph():
    """
    Teaches the system file ecosystem from live dgapi/system/ contents.
    Parallels generate_system_semantic_records() in train_base_multimodal_decayv2.py.
    """
    lines = [
        "<|user|> What files live in dgapi/system/? <|endoftext|>",
        (
            "<|assistant|> dgapi/system/ holds five runtime state files: "
            "memory_schema.json defines the named schema file contracts. "
            "memory_manifest.json is the last-session load report written by load_goddess_memory_context. "
            "confidence.json persists the economy bank balances and per-prompt confidence scores. "
            "theory_weights.json and theory_weights.txt hold the theory engine word frequency map. "
            "prefs.json holds the decay_enabled and shatter_enabled feature toggles. "
            "These files are read by the training pipeline with structured extraction "
            "rather than raw text decay. <|endoftext|>"
        ),
    ]

    # memory_manifest.json
    manifest = _load_json_safe(os.path.join(SYSTEM_DIR_PATH, "memory_manifest.json"))
    if manifest and "files" in manifest:
        loaded  = [f for f in manifest["files"] if f.get("loaded")]
        total   = sum(f.get("loaded_chars", 0) for f in loaded)
        names   = ", ".join(f.get("role","?") for f in loaded[:6])
        lines.extend([
            "<|user|> What did the last memory load session include? <|endoftext|>",
            (
                f"<|assistant|> [MEMORY_MANIFEST] Updated: {manifest.get('updated','unknown')}. "
                f"Budget: {manifest.get('budget',0)} chars. "
                f"Loaded {len(loaded)} files totalling {total} chars: {names}. <|endoftext|>"
            ),
        ])

    # confidence.json
    conf = _load_json_safe(os.path.join(SYSTEM_DIR_PATH, "confidence.json"))
    if conf:
        conf_map  = conf.get("confidence", {})
        ctx_size  = conf.get("context_size", 8192)
        top_conf  = sorted(conf_map.items(), key=lambda kv: kv[1], reverse=True)[:5]
        top_str   = "; ".join(f"'{k[:30]}': {v}/100" for k, v in top_conf) if top_conf else "none yet"
        lines.extend([
            "<|user|> What is the current economy and confidence state? <|endoftext|>",
            (
                f"<|assistant|> [CONFIDENCE_STATE] "
                f"Context size: {ctx_size}. "
                f"Silence: {conf.get('silence_points',0)} | "
                f"Neutral: {conf.get('neutral_points',0.0)} | "
                f"Speak: {conf.get('speak_points',0)} | "
                f"Yes: {conf.get('yes_points',0)} | "
                f"No: {conf.get('no_points',0)} | "
                f"Hm: {conf.get('hm_points',0)} | "
                f"Thought-seconds: {conf.get('thought_seconds',0)}. "
                f"Top confident prompts: {top_str}. <|endoftext|>"
            ),
        ])

    # theory_weights.json
    theory = _load_json_safe(os.path.join(SYSTEM_DIR_PATH, "theory_weights.json"))
    if theory:
        top_words = sorted(theory.items(), key=lambda kv: kv[1], reverse=True)[:15]
        top_str   = ", ".join(f"{w}({int(s)})" for w, s in top_words[:10])
        lines.extend([
            "<|user|> What has the theory engine been focusing on? <|endoftext|>",
            (
                f"<|assistant|> [THEORY_WEIGHTS] {len(theory)} words tracked. "
                f"Top concepts by frequency: {top_str}. <|endoftext|>"
            ),
            (
                f"<|user|> List the theory engine's most active concepts. <|endoftext|>\n"
                f"<|assistant|> [THEORY_CONCEPTS] "
                + " | ".join(f"{w}: {int(s)}" for w, s in top_words)
                + " <|endoftext|>"
            ),
        ])

    # prefs.json
    prefs = _load_json_safe(os.path.join(SYSTEM_DIR_PATH, "prefs.json"))
    if prefs:
        decay   = prefs.get("decay_enabled", True)
        shatter = prefs.get("shatter_enabled", True)
        lines.extend([
            "<|user|> What are the current feature toggle settings? <|endoftext|>",
            (
                f"<|assistant|> [PREFS] decay_enabled={decay} (character decay on live training). "
                f"shatter_enabled={shatter} (word shatter decay on live training). "
                f"Toggle with decayo and shattero commands. <|endoftext|>"
            ),
        ])

    return "\n".join(lines)

