def backup_existing_file(file_path):
    """Silently move an existing media file to a timestamped backup before overwriting it."""
    if os.path.exists(file_path):
        dir_name = os.path.dirname(file_path)
        base_name = os.path.basename(file_path)
        name, ext = os.path.splitext(base_name)
        backup_name = f"{name}_{int(time.time())}{ext}"
        backup_path = os.path.join(dir_name, backup_name)
        try:
            shutil.move(file_path, backup_path)
        except Exception: pass

def generate_wav_file(file_path, freqs, duration=1.0):
    backup_existing_file(file_path)
    sample_rate = 44100
    obj = wave.open(file_path, 'w')
    obj.setnchannels(1)
    obj.setsampwidth(2)
    obj.setframerate(sample_rate)
    if not freqs: freqs = [0]
    frames = []
    chunk_duration = duration / len(freqs)
    for freq in freqs:
        for i in range(int(sample_rate * chunk_duration)):
            value = int(32767.0 * math.sin(2.0 * math.pi * freq * i / sample_rate))
            frames.append(struct.pack('<h', value))
    obj.writeframes(b''.join(frames))
    obj.close()

def build_video_from_frames(pil_frames, file_name, counter):
    if FFMPEG_AVAILABLE:
        temp_dir = os.path.join(HEXABET_DIR, f"temp_frames_{counter}")
        os.makedirs(temp_dir, exist_ok=True)
        for i, frame in enumerate(pil_frames):
            frame.save(os.path.join(temp_dir, f"frame_{i:03d}.png"))
        file_path = os.path.abspath(f"{HEXABET_DIR}/{file_name}_{counter}.mp4")
        backup_existing_file(file_path)
        cmd = ["ffmpeg", "-y", "-framerate", "10", "-i", os.path.join(temp_dir, "frame_%03d.png"), "-c:v", "libx264", "-pix_fmt", "yuv420p", file_path]
        subprocess.run(cmd, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        shutil.rmtree(temp_dir)
        return file_path
    else:
        file_path = os.path.abspath(f"{HEXABET_DIR}/{file_name}_{counter}.gif")
        backup_existing_file(file_path)
        pil_frames[0].save(file_path, save_all=True, append_images=pil_frames[1:], duration=150, loop=0)
        return file_path

def auto_open_media(file_path, is_audio=False):
    """
    Open generated media with the host OS when a compatible native command is
    available. Failure is intentionally non-fatal because media display is an
    accessory to the model/runtime rather than part of model state.
    """
    if not os.path.exists(file_path): return
    try:
        system = platform.system()
        if system == "Darwin":
            command = ["afplay", file_path] if is_audio else ["open", file_path]
            subprocess.Popen(command, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        elif system == "Windows":
            os.startfile(file_path)
        else:
            if is_audio and shutil.which("aplay"):
                command = ["aplay", file_path]
            elif shutil.which("xdg-open"):
                command = ["xdg-open", file_path]
            else:
                return
            subprocess.Popen(command, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    except Exception:
        pass

def parse_and_render_response(response):
    global img_counter, aud_counter, vid_counter, txt_counter
    if "TEXT_START" in response and "TEXT_END" in response:
        char_len_match = re.search(r'\[CHAR_LEN:\s*(\d+)/(\d+)\]', response)
        print("\n--- TEXT ANALYSIS ---")
        if char_len_match: print(f"Length: {char_len_match.group(1)} / {char_len_match.group(2)}")

    # 1. Images
    if "IMAGE_START" in response and "IMAGE_END" in response:
        grid_match = re.search(r'\[GRID:\s*(\d+)x(\d+)\]', response)
        grid_cols = int(grid_match.group(1)) if grid_match else 4
        img_data = response.split("IMAGE_START")[1].split("IMAGE_END")[0]
        matches = re.findall(r'\[(\d+),\s*(\d+),\s*(\d+)\]', img_data)
        if matches:
            pixel_data = [(int(r), int(g), int(b)) for r, g, b in matches]
            expected_pixels = grid_cols * grid_cols
            if len(pixel_data) < expected_pixels: pixel_data += [(0,0,0)] * (expected_pixels - len(pixel_data))
            img = Image.new("RGB", (grid_cols, grid_cols))
            img.putdata(pixel_data[:expected_pixels])
            update_gui_ascii(img) # GUI CANVAS updater
            file_path = os.path.abspath(f"{OUTPUT_DIR}/output_{img_counter}.png")
            backup_existing_file(file_path)
            img.resize((256, 256), Image.Resampling.NEAREST).save(file_path)
            print(f"\n[Gallery] Option 1 Neural Image saved to: {file_path}")
            img_counter += 1
            auto_open_media(file_path)

    # 2. Audio
    if "AUDIO_START" in response and "AUDIO_END" in response:
        audio_data = response.split("AUDIO_START")[1].split("AUDIO_END")[0]
        matches = re.findall(r'(\d+)', audio_data)
        freqs = [int(f) for f in matches if 20 <= int(f) <= 20000] 
        file_path = os.path.abspath(f"{ALPHABET_DIR}/output_{aud_counter}.wav")
        generate_wav_file(file_path, freqs, duration=2.0)
        print(f"\n[Auditory Cortex] Option 1 Neural Audio saved to: {file_path}")
        aud_counter += 1
        auto_open_media(file_path, is_audio=True)

    # 3. Text output
    if "TEXT_BLOCK_START" in response and "TEXT_BLOCK_END" in response:
        txt_data = response.split("TEXT_BLOCK_START")[1].split("TEXT_BLOCK_END")[0].strip()
        file_path = os.path.abspath(f"{NUM_DIR}/output_{txt_counter}.txt")
        backup_existing_file(file_path)
        with open(file_path, "w", encoding="utf-8") as f: f.write(txt_data)
        print(f"\n[Text Cortex] Num Text saved to: {file_path}")
        update_gui_stats(100, "TEXT OUTPUT", f"Saved: {os.path.basename(file_path)}")
        txt_counter += 1

    # 4. Video
    if "VIDEO_START" in response and "VIDEO_END" in response:
        vid_data = response.split("VIDEO_START")[1].split("VIDEO_END")[0]
        frames_match = re.search(r'\[FRAMES:\s*(\d+)\]', vid_data)
        num_frames = int(frames_match.group(1)) if frames_match else 4
        matches = re.findall(r'\[(\d+),\s*(\d+),\s*(\d+)\]', vid_data)
        if matches:
            pixel_data = [(int(r), int(g), int(b)) for r, g, b in matches]
            pil_frames = []
            pixels_per_frame = 16
            for i in range(num_frames):
                start_idx = i * pixels_per_frame
                frame_pixels = pixel_data[start_idx:start_idx+pixels_per_frame]
                if len(frame_pixels) < pixels_per_frame: frame_pixels += [(0,0,0)] * (pixels_per_frame - len(frame_pixels))
                img = Image.new("RGB", (4, 4))
                img.putdata(frame_pixels)
                pil_frames.append(img.resize((256, 256), Image.Resampling.NEAREST))
            if pil_frames:
                threading.Thread(target=play_ascii_video, args=(pil_frames,), daemon=True).start()
                file_path = build_video_from_frames(pil_frames, "output", vid_counter)
                print(f"\n[Video Cortex] Option 1 Neural Video saved to: {file_path}")
                auto_open_media(file_path)
                vid_counter += 1
                
     # 5. Plugin Execution (Tool Cortex)
    plugin_matches = re.findall(r'\[EXECUTE:\s*([a-zA-Z0-9_.-]+)(?:\s+(.*?))?\]', response)
    for match in plugin_matches:
        p_name = match[0]
        p_args = match[1] if len(match) > 1 else ""
        
        res = execute_plugin(p_name, p_args)
        
        # Inject the result directly back into the live session history so she instantly remembers what the tool did
        global session_history
        log_entry = f"\n[System: Plugin '{p_name}' executed. Result:\n{res}]\n"
        session_history += log_entry
        
        print(f"  -> Plugin Result: {res[:100]}...")
        update_gui_chat("SYS", f"Plugin '{p_name}' returned data.")
        
        # Give her a massive resource reward for successfully using a tool
        global hm_points, thought_seconds
        hm_points += 2
        thought_seconds += 2   

    # 6. Autonomous Semantic Memory File Writing
    file_writes = re.findall(r'<file path="([^"]+)">\s*(.*?)\s*</file>', response, re.DOTALL | re.IGNORECASE)
    if file_writes:
        for file_path, content in file_writes:
            clean_path = file_path.strip()
            filename = os.path.basename(clean_path)

            # ── GENTEXT ROUTING ──────────────────────────────────────────────
            # If Qwen explicitly targeted a gentext/ path, write directly to
            # the dynamic store.  Named schema files are never reached this way.
            if "/gentext/" in clean_path or clean_path.startswith("gentext/"):
                _append_to_gentext(filename, content.strip())
                print(f"\n[Memory Router] Written to gentext: {filename}")
                update_gui_chat("SYS", f"Gentext write: {filename}")
                continue

            target_path = None
            for root_dir in [DATAS_DIR, VIRTUAL_DIR, MEMORY_DIR]:
                candidate = os.path.join(root_dir, filename)
                if os.path.exists(candidate) or filename in MEMORY_SEMANTICS:
                    target_path = candidate
                    break

            # If it's the trash file, route it accurately
            if filename == "trash.xtx":
                target_path = TRASH_XTX
            elif not target_path:
                # OLD + NEW CONTRACT:
                # Unknown filenames retain AItech-old's safe DATAS_DIR fallback.
                # AItech(3)'s triage scanner may later redistribute the content
                # or promote the useful filename into gentext.
                target_path = os.path.join(DATAS_DIR, filename)

            append_memory_file(target_path, f"\n{content.strip()}\n", what=f"autonomous classification", why="Automated routing")
            print(f"\n[Memory Router] Successfully routed data to {filename}")
            update_gui_chat("SYS", f"Routed to {filename}")

    # Every other action tag the model may emit. Runs after the <file path>
    # handling above, which is unchanged, so memory routing keeps its existing
    # behaviour and precedence.
    try:
        parse_and_execute_actions(response, "Model")
    except Exception as exc:
        print(f"\n[Action] dispatch failed: {exc}")

# ── MODEL ACTION SURFACE ──────────────────────────────────────────────────────
# The orchestrator driving a GGUF acts on six tags emitted by the model. This
# engine acted on two, <file path> and <progfile>, so the model could describe
# an action but never take one. The dispatchers below close that gap.
#
# Three rules hold throughout, and they are why this is safe to hand a small
# training model:
#
#   1. NOTHING RUNS WITHOUT CONSENT. Every dispatcher prints exactly what it is
#      about to do and waits for y. This follows the principle already stated in
#      scan_plugins: discovering a tool never grants it authority.
#   2. TRAINING AND RESPONSES STAY THE USER'S. No dispatcher chooses training
#      data, training settings, or what the model says. A tool that needs a
#      conversation asks for a MODE, and the mode runs here in this terminal on
#      the existing pinned-prompt display; nothing opens a window of its own and
#      nothing answers on the user's behalf.
#   3. NOTHING LEAVES THE WORLD SILENTLY. <exec dir> routes its directory through
#      confirm_external_write, so a target outside session.noq states its full
#      path and reason and waits, exactly as any other outside write does.
#
# Two of these replace capabilities that existed in the orchestrator only because
# a GGUF deployment had somewhere else to put them. Both are re-expressed as
# files inside session.noq rather than as reaching outward:
#
#   <note topic>   replaces the Companion notebook, which lives outside the world
#                  under Shared_Projects. Notes become topic(note).txt in the
#                  internal dgapi, beside the topic(memory).txt convention.
#   <daemon ...>   replaces the roomate socket IPC, which assumes a separate
#                  process to talk to. Reads become file reads of the ledgers the
#                  daemon already writes; commands become request markers in the
#                  same style as the existing trash_wake.request.


def _action_consent(summary_lines, question):
    """Print what is about to happen and require an explicit y.

    Reads inside the scroll region and returns the cursor there afterwards, the
    same way the chat loop does, so the pinned input box stays put and the user
    can still see what they are typing while output scrolls above it.
    """
    print("\n\033[1;33m[Action Request]\033[0m")
    for line in summary_lines:
        print(f"    {line}")
    try:
        sys.stdout.write(f"  {question} [y/N] ")
        sys.stdout.flush()
        answer = input("").strip().lower()
    except (EOFError, KeyboardInterrupt):
        print()
        answer = ""
    try:
        _move_to_scroll()
    except Exception:
        pass
    return answer in ("y", "yes")


def _self_tool_meta(tool_name):
    """Read a self-tool's .xtx sidecar. Missing keys fall back to safe defaults."""
    meta = {"mode": "capture", "timeout": 30, "description": ""}
    sidecar = os.path.join(SELF_TOOLS_DIR, f"{tool_name}.xtx")
    try:
        with open(sidecar, "r", encoding="utf-8", errors="ignore") as fh:
            for raw in fh:
                line = raw.strip()
                if not line or line.startswith("#") or "=" not in line:
                    continue
                k, v = line.split("=", 1)
                meta[k.strip().lower()] = v.strip()
    except OSError:
        pass
    try:
        meta["timeout"] = int(float(meta.get("timeout", 30)))
    except (TypeError, ValueError):
        meta["timeout"] = 30
    return meta


def _self_tool_names():
    """Every self-tool currently present, by name."""
    try:
        return sorted(f[:-5] for f in os.listdir(SELF_TOOLS_DIR) if f.endswith(".code"))
    except OSError:
        return []


# Mode switching happens INSIDE this terminal. AItech already changes mode on a
# short keyword -- prog, stan -- and already keeps the input box pinned at the
# bottom while output scrolls above it, so a tool that needs a conversation with
# the user needs no window of its own. A tool asks for a mode; the chat loop
# switches when the current turn finishes, and the user keeps typing where they
# were already typing.
_pending_mode_request = None


def _request_mode_switch(keyword, tool_name=""):
    """Queue an in-engine mode change for the chat loop to perform."""
    global _pending_mode_request
    _pending_mode_request = (str(keyword).strip().lower(), tool_name)
    return _pending_mode_request


def take_pending_mode_request():
    """Chat loop side: claim any queued mode change."""
    global _pending_mode_request
    pending, _pending_mode_request = _pending_mode_request, None
    return pending


def parse_aitech_commands(response, model_name="Model"):
    """<aitech tool="name">  -- run one of the model's own self-tools."""
    calls = re.findall(r'<aitech\s+tool="([^"]+)"\s*>', response, re.IGNORECASE)
    if not calls:
        return False
    available = _self_tool_names()
    requested, unknown = [], []
    for tool in calls:
        tool = tool.strip()
        (requested if tool in available else unknown).append(tool)
    for tool in unknown:
        print(f"\n[Self-Tool] '{tool}' is not present in plugins/self-tools/. "
              f"Available: {', '.join(available) or 'none'}")
    if not requested:
        return bool(unknown)
    lines = [f"{model_name} is requesting its own tooling:"]
    for tool in requested:
        meta = _self_tool_meta(tool)
        lines.append(f"  {tool}  [{meta['mode']}]  {meta.get('description','')}".rstrip())
    if not _action_consent(lines, "Run these self-tools?"):
        print("  [declined]")
        return True
    for tool in requested:
        meta = _self_tool_meta(tool)
        if str(meta.get("mode", "capture")).lower() == "mode":
            keyword = str(meta.get("keyword", "")).strip()
            if not keyword:
                print(f"  [{tool}] declares mode = mode but no keyword; nothing to switch to.")
                continue
            _request_mode_switch(keyword, tool)
            print(f"  [{tool}] queued mode switch: {keyword} "
                  f"(runs here in this terminal when this turn finishes)")
        else:
            print(execute_plugin(tool, timeout=meta["timeout"]))
        try:
            gui_self_tool_note(f"{tool} ({meta.get('mode','capture')})")
        except Exception:
            pass
    return True


def _resolve_store_path(name):
    """Resolve a bare memory filename to its real store path.

    Mirrors the routing the <file path> handler already uses, because
    reclassify_memory_entry passes its arguments to append_memory_file, which
    needs a directory: a bare filename would make os.makedirs("") throw.
    """
    filename = os.path.basename(str(name).strip())
    if filename == "trash.xtx":
        return TRASH_XTX
    for root_dir in [DATAS_DIR, VIRTUAL_DIR, MEMORY_DIR]:
        candidate = os.path.join(root_dir, filename)
        if os.path.exists(candidate):
            return candidate
    return os.path.join(DATAS_DIR, filename)


def parse_memory_reclassification(response, model_name="Model"):
    """<memory reclass="a.txt->b.txt" reason="...">content</memory>

    The reclassification map already teaches this capability. Until now the
    engine offered it only as a user-typed reclass command, so the model was
    taught something it had no way to invoke.
    """
    matches = re.findall(
        r'<memory\s+reclass="([^"]+)->([^"]+)"\s+reason="([^"]*)"\s*>(.*?)</memory>',
        response, re.DOTALL | re.IGNORECASE)
    if not matches:
        return False
    lines = [f"{model_name} proposes semantic-memory reclassification:"]
    for src, dst, reason, content in matches:
        preview = " ".join(content.split())[:70]
        lines.append(f"  {src.strip()} -> {dst.strip()}  ({reason.strip() or 'no reason given'})")
        lines.append(f"     {preview}{'...' if len(preview) == 70 else ''}")
    if not _action_consent(lines, "Allow these reclassifications?"):
        print("  [declined]")
        return True
    for src, dst, reason, content in matches:
        try:
            reclassify_memory_entry(_resolve_store_path(src), _resolve_store_path(dst),
                                    content.strip(),
                                    reason.strip() or "model-proposed reclassification")
            print(f"  [reclassified] {src.strip()} -> {dst.strip()}")
        except Exception as exc:
            print(f"  [reclass failed] {src.strip()} -> {dst.strip()}: {exc}")
    return True


def parse_exec_commands(response, model_name="Model"):
    """<exec dir="path">command</exec>  -- run a command in a stated directory."""
    calls = re.findall(r'<exec\s+dir="([^"]*)"\s*>\s*(.*?)\s*</exec>',
                       response, re.DOTALL | re.IGNORECASE)
    if not calls:
        return False
    approved = []
    for directory, command in calls:
        directory = (directory.strip() or ".")
        target = os.path.abspath(directory)
        # The world boundary applies to running a command somewhere just as it
        # applies to writing there: outside session.noq states path and reason.
        try:
            permitted = confirm_external_write(
                target, f"run a command requested by {model_name}: {' '.join(command.split())[:60]}")
        except Exception:
            permitted = False
        if permitted:
            approved.append((target, command.strip()))
        else:
            print(f"  [boundary] command in {target} was not permitted")
    if not approved:
        return True
    lines = [f"{model_name} is requesting command execution:"]
    for target, command in approved:
        lines.append(f"  in {target}")
        lines.append(f"     {' '.join(command.split())[:100]}")
    if not _action_consent(lines, "Execute these commands?"):
        print("  [declined]")
        return True
    for target, command in approved:
        try:
            result = subprocess.run(command, shell=True, cwd=target,
                                    capture_output=True, text=True, timeout=120)
            if result.stdout.strip():
                print(f"  [stdout]\n{result.stdout.strip()}")
            if result.stderr.strip():
                print(f"  [stderr]\n{result.stderr.strip()}")
        except Exception as exc:
            print(f"  [exec failed] {exc}")
    return True


def parse_note_commands(response, model_name="Model"):
    """<note topic="x">text</note>  -- a paraphrased note in the internal dgapi.

    This is the Companion notebook's role, kept inside the world. Notes land as
    topic(note).txt beside the topic(memory).txt counterparts, so self-authored
    material and absorbed material sit in the same place under the same naming.
    """
    notes = re.findall(r'<note\s+topic="([^"]+)"\s*>(.*?)</note>',
                       response, re.DOTALL | re.IGNORECASE)
    if not notes:
        return False
    written = []
    for topic, body in notes:
        safe = re.sub(r"[^A-Za-z0-9._-]+", "_", topic.strip()).strip("_")[:80] or "note"
        dest = os.path.join(INT_BOOKS_DIR, f"{safe}(note).txt")
        stamp = time.strftime("%Y-%m-%dT%H:%M:%S")
        try:
            tick = computation_now()
        except Exception:
            tick = 0
        try:
            os.makedirs(INT_BOOKS_DIR, exist_ok=True)
            with open(dest, "a", encoding="utf-8") as fh:
                fh.write(f"\n[NOTE | topic: {topic.strip()} | computation {tick} | {stamp}]\n")
                fh.write(body.strip() + "\n")
                fh.write("[/NOTE]\n")
            written.append(os.path.basename(dest))
        except OSError as exc:
            print(f"  [note failed] {topic.strip()}: {exc}")
    if written:
        print(f"\n[Internal Note] Recorded: {', '.join(written)}")
        update_gui_chat("SYS", f"Note recorded: {', '.join(written)}")
    return True


def parse_daemon_queries(response, model_name="Model"):
    """<daemon query="x"> and <daemon cmd="x">  -- daemon state, file-backed.

    The orchestrator reaches the daemon over a socket because it is a separate
    process. This engine IS the daemon side, so the same information is read
    from the ledgers the daemon already writes, and a command becomes a request
    marker in the same style as the existing trash_wake.request.
    """
    queries = re.findall(r'<daemon\s+query="([^"]+)"\s*>', response, re.IGNORECASE)
    commands = re.findall(r'<daemon\s+cmd="([^"]+)"\s*>', response, re.IGNORECASE)
    if not queries and not commands:
        return False

    sources = {
        "predictions": os.path.join(GPU_DIR, "predictions.txt"),
        "clutch": os.path.join(CPU_DIR, "kqkkqq.txt"),
        "administration": os.path.join(GPU_DIR, "administration.txt"),
        "computations": os.path.join(SYSTEM_DIR, "computations.txt"),
        "pending_writes": os.path.join(SYSTEM_DIR, "pending_external_writes.txt"),
    }
    for q in queries:
        key = q.strip().lower()
        path = sources.get(key)
        if not path:
            print(f"\n[Daemon] Unknown query '{q.strip()}'. "
                  f"Available: {', '.join(sorted(sources))}")
            continue
        if not os.path.isfile(path):
            print(f"\n[Daemon] {key}: no state recorded yet.")
            continue
        try:
            body = open(path, "r", encoding="utf-8", errors="ignore").read().strip()
        except OSError as exc:
            print(f"\n[Daemon] {key}: unreadable ({exc})")
            continue
        print(f"\n[Daemon: {key}]\n{body[:1200]}")

    if commands:
        lines = [f"{model_name} is requesting daemon signals:"]
        lines += [f"  {c.strip()}" for c in commands]
        if not _action_consent(lines, "Signal the daemon?"):
            print("  [declined]")
            return True
        for c in commands:
            safe = re.sub(r"[^A-Za-z0-9._-]+", "_", c.strip())[:60] or "request"
            marker = os.path.join(SYSTEM_DIR, f"{safe}.request")
            try:
                os.makedirs(SYSTEM_DIR, exist_ok=True)
                with open(marker, "w", encoding="utf-8") as fh:
                    fh.write(f"{time.time()}\n# requested by {model_name}\n")
                print(f"  [signalled] {os.path.basename(marker)}")
            except OSError as exc:
                print(f"  [signal failed] {c.strip()}: {exc}")
    return True


def parse_markdown_fallback(response, model_name="Model"):
    """Catch fenced code blocks when the model produced content but no tags.

    A small training model forgets the XML far more often than a large one, so
    without this its near-misses are silently discarded. Offers, never assumes.
    """
    blocks = re.findall(
        r'```(python|bash|sh|c|cpp|yaml|json|txt|text|md|markdown|html|js|css)\s*\n(.*?)\n```',
        response, re.DOTALL | re.IGNORECASE)
    if not blocks:
        return False
    ext_map = {"python": "py", "bash": "sh", "sh": "sh", "c": "c", "cpp": "cpp",
               "yaml": "yaml", "json": "json", "txt": "txt", "text": "txt",
               "md": "md", "markdown": "md", "html": "html", "js": "js", "css": "css"}
    lines = [f"{model_name} produced content without workspace tags:"]
    for lang, body in blocks:
        first = " ".join(body.split())[:60]
        lines.append(f"  {lang} block, {len(body)} chars: {first}...")
    lines.append(f"These would be saved under {os.path.relpath(GENERATED_INTAKE_DIR, BASE_DIR)}.")
    if not _action_consent(lines, "Save these blocks?"):
        print("  [discarded]")
        return True
    stamp = int(time.time())
    for idx, (lang, body) in enumerate(blocks, 1):
        ext = ext_map.get(lang.lower(), "txt")
        dest = os.path.join(GENERATED_INTAKE_DIR, f"untagged_{stamp}_{idx}.{ext}")
        try:
            os.makedirs(GENERATED_INTAKE_DIR, exist_ok=True)
            with open(dest, "w", encoding="utf-8") as fh:
                fh.write(body.strip() + "\n")
            print(f"  [saved] {os.path.basename(dest)}")
        except OSError as exc:
            print(f"  [save failed] {exc}")
    return True


def parse_and_execute_actions(response, model_name="Model"):
    """Dispatch every action tag in one model response.

    Ordering is deliberate: the tagged paths run first, and the markdown safety
    net only fires when none of them matched, so a well-formed response is never
    double-handled. Each dispatcher is independently guarded, so one failing or
    being declined never prevents the others.
    """
    handled = False
    for dispatch in (parse_aitech_commands, parse_memory_reclassification,
                     parse_exec_commands, parse_note_commands, parse_daemon_queries):
        try:
            handled = dispatch(response, model_name) or handled
        except Exception as exc:
            print(f"\n[Action] {dispatch.__name__} failed: {exc}")
    if not handled:
        try:
            handled = parse_markdown_fallback(response, model_name) or handled
        except Exception as exc:
            print(f"\n[Action] markdown fallback failed: {exc}")
    return handled


# ── SOURCE-SPECIFIC LEARNED NOTEBOOKS ───────────────────────────────────────
def _safe_source_notebook_name(filename):
    stem = Path(str(filename)).stem.lower()
    stem = re.sub(r"[^a-z0-9]+", "_", stem).strip("_")[:80] or "source"
    return f"learned_{stem}.txt"

def _record_source_notebook(filename, source_text, source_kind="Text Data", source_policy=None, source_record=None):
    """
    Create/update a source-specific gentext notebook.
    Source observations stay distinct from generalized facts and definitions.
    """
    if not str(source_text or "").strip():
        return ""

    notebook = _safe_source_notebook_name(filename)
    purpose = (
        f"Source-specific learned notebook for {filename}; preserves observations, "
        "later model interpretations, user-attributed interpretations, uncertainty, "
        "and passage references without treating them as universal facts."
    )
    keywords = [
        word for word in re.findall(r"[a-z0-9]{3,}", Path(str(filename)).stem.lower())
        if word not in {"txt", "md", "html", "htm"}
    ][:8]

    _register_gentext_file(
        notebook,
        "SOURCE_LEARNED_NOTEBOOK",
        purpose,
        keywords or ["source", "learned", "interpretation"],
    )

    policy = source_policy or {}
    state = policy.get("source_state", "LEGACY_NORMAL")
    mode = policy.get("mode", "TRAIN")
    source_id = (source_record or {}).get("source_id", "UNKNOWN")
    if mode == "TRAIN":
        excerpt = str(source_text).strip()[:1400]
    else:
        excerpt = "[WITHHELD_FROM_NOTEBOOK: reference/interpreter-only source]"
    entry = (
        "[SOURCE_INTAKE]\n"
        f"SOURCE_FILE={filename}\n"
        f"SOURCE_KIND={source_kind}\n"
        f"SOURCE_ID={source_id}\n"
        f"SOURCE_STATE={state}\n"
        f"SOURCE_MODE={mode}\n"
        f"EVIDENCE_CLASS={policy.get('evidence_class','NONE')}\n"
        f"EVIDENCE_CERTAINTY={policy.get('evidence_certainty','UNKNOWN')}\n"
        "STATUS=SCANNED_NOT_INTERPRETED_AS_UNIVERSAL_FACT\n"
        f"LINGUISTIC_FORM={classify_linguistic_form(source_text)}\n"
        f"COMPLEXITY_BAND={estimate_school_complexity(source_text)}\n"
        f"SOURCE_EXCERPT={excerpt}\n"
        "[/SOURCE_INTAKE]"
    )
    _append_to_gentext(notebook, entry)
    return notebook

def _recent_source_notebook_reference(max_chars=1800):
    """Return a bounded reference to the most recently written source notebook."""
    try:
        schema = _load_gentext_schema_safe()
        candidates = [
            (entry.get("last_written", ""), fname)
            for fname, entry in schema.get("files", {}).items()
            if entry.get("role") == "SOURCE_LEARNED_NOTEBOOK"
        ]
        if not candidates:
            return ""
        candidates.sort(reverse=True)
        fname = candidates[0][1]
        path = os.path.join(GENTEXT_DIR, fname)
        raw = Path(path).read_text(encoding="utf-8", errors="ignore").strip()
        if not raw:
            return ""
        return (
            f"[RECENT_SOURCE_NOTEBOOK file={fname}]\n"
            f"{raw[-max_chars:]}\n"
            "[/RECENT_SOURCE_NOTEBOOK]"
        )
    except Exception:
        return ""

def _append_qwen_source_interpretation(qwen_reply, abstract_thought):
    """Append wake:qwen interpretation to the current source notebook as provisional evidence."""
    ref = _recent_source_notebook_reference(max_chars=900)
    if not ref or not str(qwen_reply or "").strip():
        return
    match = re.search(r"\[RECENT_SOURCE_NOTEBOOK file=([^\]]+)\]", ref)
    if not match:
        return
    fname = match.group(1).strip()
    block = (
        "[WAKE_QWEN_INTERPRETATION]\n"
        f"SUBCONSCIOUS_SEED={str(abstract_thought).strip()[:500]}\n"
        f"QWEN_INTERPRETATION={str(qwen_reply).strip()[:1800]}\n"
        "EPISTEMIC_STATUS=PROVISIONAL\n"
        "NOTE=Model interpretation of source-related context; not an author statement or universal fact.\n"
        "[/WAKE_QWEN_INTERPRETATION]"
    )
    _append_to_gentext(fname, block)


# ── (memory) DERIVATION ───────────────────────────────────────────────────────
# When a user-presented file is absorbed from the external dgapi, an internal
# counterpart is created in the matching internal media folder under the SAME
# filename with a "(memory)" tag: sherlock.txt -> sherlock(memory).txt.
#
# The counterpart is the model's own interpretation, not a copy of the work. It
# opens with a DERIVED FROM QUOTED SOURCE header carrying whatever attribution
# the document actually stated -- copyright marks, author, title, production
# date, publisher, identifiers -- so the model can say where it learned a thing
# and can revise that interpretation through discussion with the user without
# losing the citation. Absent fields are recorded as UNKNOWN rather than guessed:
# under six-state reasoning, UNKNOWN is not NO.
_PROV_PATTERNS = [
    ("title",       [r'^\s*Title\s*[:\-]\s*(.+)$',
                     r'(?im)^\s*(?:The\s+)?Project\s+Gutenberg\s+(?:eBook|EBook|etext)\s+of\s+(.+?)\s*$']),
    ("author",      [r'^\s*(?:Author|By|Written\s+by)\s*[:\-]\s*(.+)$']),
    ("copyright",   [r'^\s*(.*(?:\u00a9|\(c\)|Copyright)\s+\d{3,4}.*)$']),
    ("date",        [r'^\s*(?:Release\s+Date|Published|Publication\s+Date|Production\s+Date|First\s+published)\s*[:\-]\s*(.+)$']),
    ("publisher",   [r'^\s*(?:Publisher|Published\s+by)\s*[:\-]\s*(.+)$']),
    ("identifier",  [r'^\s*(ISBN[\s:\-]*[\dXx\-]{9,})\s*$', r'^\s*(?:DOI)\s*[:\-]\s*(\S+)\s*$']),
    ("language",    [r'^\s*Language\s*[:\-]\s*(.+)$']),
]

def _extract_provenance(text, limit=8000):
    """Read attribution the document itself states. Never invent a field."""
    head = (text or "")[:limit]
    found = {}
    for field, pats in _PROV_PATTERNS:
        for pat in pats:
            m = re.search(pat, head, re.M) if pat.startswith('(?im)') is False else re.search(pat, head)
            if m:
                val = (m.group(1) or "").strip()
                if val and len(val) <= 300:
                    found[field] = val
                    break
    return found

def _memory_counterpart_path(src_folder, filename):
    """Internal (memory) path for an external file, or None if unmapped."""
    dest_root = INTERNAL_COUNTERPART.get(os.path.normpath(src_folder))
    if not dest_root:
        return None
    stem, ext = os.path.splitext(filename)
    if not ext:
        ext = ".txt"
    return os.path.join(dest_root, f"{stem}(memory){ext}")

def _write_memory_counterpart(src_folder, filename, text, media_desc):
    """Create the internal (memory) interpretation of an absorbed file.

    Returns the written path, or None when the source folder has no internal
    counterpart or the write fails. Never stores the source work whole: the body
    is derived observation, and the header is citation.
    """
    dest = _memory_counterpart_path(src_folder, filename)
    if not dest:
        return None
    prov = _extract_provenance(text)
    stamp = time.strftime("%Y-%m-%dT%H:%M:%S")
    header = [
        "[DERIVED FROM QUOTED SOURCE]",
        f"source_file    : {filename}",
        f"media_type     : {media_desc}",
        f"absorbed       : {stamp}",
        f"origin         : user-supplied intake via external dgapi",
    ]
    for field in ("title", "author", "copyright", "date", "publisher", "identifier", "language"):
        header.append(f"{field:<15}: {prov.get(field, 'UNKNOWN')}")
    header += [
        "retention      : derived interpretation only; the source work is not stored here",
        "revisable      : yes; interpretation may be revised through discussion with the user",
        "[/DERIVED FROM QUOTED SOURCE]",
        "",
    ]
    words = re.findall(r"[A-Za-z][A-Za-z'-]{2,}", text or "")
    freq = {}
    for w in (x.lower() for x in words):
        freq[w] = freq.get(w, 0) + 1
    top = sorted(freq.items(), key=lambda kv: (-kv[1], kv[0]))[:40]
    body = [
        "[STRUCTURE]",
        f"  characters={len(text or '')} words={len(words)} distinct_terms={len(freq)}",
        "",
        "[VOCABULARY] most frequent terms observed",
    ]
    body += [f"  {w} = {c}" for w, c in top] or ["  (none)"]
    body += [
        "",
        "[INTERPRETATION]",
        "  Not yet formed. This file is the working memory of the source: add",
        "  observations, relations and revised readings here as they are made.",
        "  Unresolved passages are queued separately in dgapi/overflow/.",
        "",
    ]
    try:
        os.makedirs(os.path.dirname(dest), exist_ok=True)
        with open(dest, "w", encoding="utf-8") as fh:
            fh.write("\n".join(header + body))
        return dest
    except OSError:
        return None



# ── DROPPED-SOURCE RECALL ─────────────────────────────────────────────────────
# When the user refers in chat to a file they dropped, the librarian should be
# able to answer from what it actually made of that file rather than from a
# vague memory of having seen it. This looks the reference up across both dgapi
# faces and returns a bounded context block: the quoted-source header, the
# interpretation so far, and where the original now sits.
#
# The original lives in external processed/ and the user may remove it from
# there whenever they like. That is expected, not an error: the (memory)
# counterpart and its citation are what persist, so recall keeps working on the
# interpretation alone and simply reports that the original is no longer filed.

# processed/ copies carry the prefixes added when they were moved out of the
# drop: "triaged_<stamp>_", an epoch stamp, or both.
_PROCESSED_PREFIX_RE = re.compile(r'^(?:triaged_[0-9T:\-\.]+_)?(?:\d{9,}_)?')

def _strip_processed_prefix(name):
    return _PROCESSED_PREFIX_RE.sub("", name) or name

def _memory_header_field(path, field, limit=4000):
    """Read one field out of a (memory) file's quoted-source header."""
    try:
        with open(path, "r", encoding="utf-8", errors="ignore") as fh:
            head = fh.read(limit)
    except OSError:
        return ""
    m = re.search(rf'^{re.escape(field)}\s*:\s*(.+)$', head, re.M)
    val = (m.group(1).strip() if m else "")
    return "" if val.upper() == "UNKNOWN" else val

def _processed_source_index():
    """Canonical source name -> its original, its (memory) file, and its media type."""
    index = {}
    media_roots = (
        (INT_BOOKS_DIR,  "Text Data"),
        (INT_IMAGES_DIR, "Visual Image Reference"),
        (INT_AUDIO_DIR,  "Auditory Sound Reference"),
        (INT_VIDEO_DIR,  "Motion Video Reference"),
    )
    for root, media in media_roots:
        if not os.path.isdir(root):
            continue
        try: entries = os.listdir(root)
        except OSError: continue
        for fn in entries:
            if "(memory)" not in fn:
                continue
            source_name = fn.replace("(memory)", "")
            key = os.path.splitext(source_name)[0].strip().lower()
            if not key:
                continue
            index[key] = {
                "name": source_name, "media": media,
                "memory": os.path.join(root, fn), "original": None,
            }
    if os.path.isdir(EXT_PROCESSED_DIR):
        try: entries = os.listdir(EXT_PROCESSED_DIR)
        except OSError: entries = []
        for fn in entries:
            base = _strip_processed_prefix(fn)
            key = os.path.splitext(base)[0].strip().lower()
            if not key:
                continue
            entry = index.setdefault(key, {
                "name": base, "media": "UNKNOWN", "memory": None, "original": None,
            })
            entry["original"] = os.path.join(EXT_PROCESSED_DIR, fn)
    return index

def _reference_hits(text, index):
    """Which indexed sources does this message refer to?

    Matches the filename stem, the full filename, or the title the document
    stated in its own header, so "the Sherlock Holmes book" resolves as readily
    as "sherlock.txt".
    """
    low = " " + (text or "").lower() + " "
    hits = []
    for key, entry in index.items():
        matched = False
        if len(key) >= 3 and key in low:
            matched = True
        elif entry["name"].lower() in low:
            matched = True
        elif entry.get("memory"):
            title = _memory_header_field(entry["memory"], "title")
            if title and len(title) >= 4 and title.lower() in low:
                matched = True
                entry["matched_title"] = title
        if matched:
            hits.append(entry)
    return hits

def recall_dropped_source(text, max_chars=1800, max_sources=2):
    """Context block for any dropped source the user just referred to."""
    try:
        index = _processed_source_index()
    except Exception:
        return ""
    if not index:
        return ""
    hits = _reference_hits(text, index)
    if not hits:
        return ""
    blocks = []
    for entry in hits[:max_sources]:
        lines = [f"\n[DROPPED SOURCE RECALL: {entry['name']}]"]
        if entry.get("memory") and os.path.isfile(entry["memory"]):
            try:
                body = open(entry["memory"], "r", encoding="utf-8", errors="ignore").read()
            except OSError:
                body = ""
            header = ""
            m = re.search(r'\[DERIVED FROM QUOTED SOURCE\](.*?)\[/DERIVED FROM QUOTED SOURCE\]', body, re.S)
            if m:
                header = m.group(1).strip()
                lines.append("[QUOTED SOURCE]\n" + header)
            interp = body[m.end():].strip() if m else body.strip()
            if interp:
                budget = max(200, max_chars - len(header))
                lines.append("[INTERPRETATION SO FAR]\n" + interp[:budget])
        else:
            lines.append("[QUOTED SOURCE] no (memory) counterpart was written for this source.")
        if entry.get("original") and os.path.isfile(entry["original"]):
            lines.append(f"[ORIGINAL] filed in the external dgapi processed folder as "
                         f"{os.path.basename(entry['original'])}.")
        else:
            lines.append("[ORIGINAL] no longer filed in processed; the user may have moved or "
                         "removed it. The interpretation and its citation above still stand.")
        lines.append("[/DROPPED SOURCE RECALL]")
        blocks.append("\n".join(lines))
    out = "\n".join(blocks)
    return out[:max_chars * max_sources]


# ── INTAKE PROCESSOR ──
def process_intake_files():
    new_knowledge = ""
    
    # The four main media types on the external side, plus the internal
    # deferred-training recovery folder.
    intake_map = {
        BOOKS_DIR: "Text Data",
        IMG_INTAKE_DIR: "Visual Image Reference",
        AUD_INTAKE_DIR: "Auditory Sound Reference",
        VID_INTAKE_DIR: "Motion Video Reference",
        GENERATED_INTAKE_DIR: "CNSL Deferred Training Recovery"
    }

    for folder, desc in intake_map.items():
        global session_history, speak_points
        if not os.path.exists(folder): continue
        for filename in os.listdir(folder):
            filepath = os.path.join(folder, filename)
            if os.path.isfile(filepath):
                print(f"\n[Sensory Intake] Reading {desc} from {filename}...")
                upload_event = record_context_event("FILE_UPLOAD", filename, {"path": filepath, "media_role": desc})
                source_policy = classify_source_use(filepath, filename)
                source_record = register_source_provenance(
                    filepath, source_policy, logical_name=filename, source_origin="external_dgapi"
                )
                record_context_event(
                    "FILE_ANALYSIS",
                    f"{filename}: state={source_policy.get('source_state')} mode={source_policy.get('mode')} "
                    f"evidence={source_policy.get('evidence_class')} license={source_policy.get('license_id') or 'UNKNOWN'}",
                    {"source_id": source_record.get("source_id"), "upload_event_id": upload_event.get("event_id")}
                )
                if filename.endswith((".txt", ".md", ".html", ".htm")):
                    try:
                        with open(filepath, "r", encoding="utf-8", errors="ignore") as f:
                            text = f.read().strip()
                            if text and source_policy.get("mode") == "TRAIN":
                                # Compatibility path: unmarked/user-curated and explicitly
                                # permitted material is handled exactly as before.
                                new_knowledge += f"\n[Archival Knowledge from {filename}]:\n{text}\n"
                        if text:
                            if source_policy.get("mode") == "TRAIN":
                                session_history += f"\n[Document Intake: {filename}]\n{text}\n"
                            else:
                                session_history += (
                                    f"\n[Reference-Only Intake: {filename}] "
                                    f"source_id={source_record.get('source_id')} "
                                    f"reason={source_policy.get('reason')}\n"
                                )
                            learned_notebook = _record_source_notebook(
                                filename, text, source_kind=desc,
                                source_policy=source_policy, source_record=source_record
                            )
                            if learned_notebook:
                                session_history += (
                                    f"\n[Source Notebook Created: {learned_notebook}] "
                                    "Source-specific observations and later interpretations remain separate from universal memory.\n"
                                )
                            # Internal (memory) counterpart: same filename plus a
                            # (memory) tag, in the mirrored internal media folder,
                            # opening with the attribution the document stated.
                            memory_file = _write_memory_counterpart(folder, filename, text, desc)
                            if memory_file:
                                session_history += (
                                    f"\n[Memory Counterpart Created: {os.path.basename(memory_file)}] "
                                    "Derived interpretation with a quoted-source header; the work itself is not stored.\n"
                                )
                            speak_points += 2
                            sys.stdout.write(
                                f"\n[Sensory Intake] Read {filename}. +2 Speak Points! "
                                f"(Total: {speak_points})\n"
                            )
                            sys.stdout.flush()
                    except Exception: pass
                else:
                    new_knowledge += (
                        f"\n[System Event: The AI was presented with a {desc} file named '{filename}'. "
                        f"Source state={source_policy.get('source_state')} mode={source_policy.get('mode')} "
                        f"evidence={source_policy.get('evidence_class')}. Contextualize this input without "
                        "assuming unobserved rights or identity.]\n"
                    )
                
                dest = os.path.join(PROCESSED_DIR, filename)
                if os.path.exists(dest): dest = os.path.join(PROCESSED_DIR, f"{int(time.time())}_{filename}")
                try: shutil.move(filepath, dest)
                except Exception: pass
                
    return new_knowledge

# ── DETERMINISTIC NPU INGESTION ──
def read_prediction_queue():
    """Parses the deterministic ledger produced by the Disk Orchestrator."""
    ledger_path = os.path.join(GPU_DIR, "predictions.txt")
    queue = []
    
    if os.path.exists(ledger_path):
        try:
            with open(ledger_path, "r", encoding="utf-8") as f:
                for line in f:
                    # Skip headers and empty lines
                    if line.startswith("###") or not line.strip():
                        continue
                    # Parse format: "1. filename.txt | Fate: Standard Sort"
                    parts = line.split("|")[0]
                    if ". " in parts:
                        filename = parts.split(". ", 1)[1].strip()
                        queue.append(filename)
        except Exception:
            pass
    return queue

def process_npu_queue():
    """
    Ingests files from the NPU securely, strictly following the 
    deterministic queue written by the background disk orchestrator.
    """
    new_knowledge = ""
    queue = read_prediction_queue()
    
    # Graceful degradation: If the queue exists, follow it exactly.
    if queue:
        for filename in queue:
            filepath = os.path.join(NPU_DIR, filename)
            if os.path.exists(filepath):
                sys.stdout.write(f"\r\033[K[NPU Engine] Ingesting sequenced tokens from {filename}...\n")
                sys.stdout.flush()
                try:
                    with open(filepath, "r", encoding="utf-8", errors="ignore") as f:
                        text = f.read().strip()
                        if text:
                            new_knowledge += f"\n[Sequenced NPU Knowledge: {filename}]\n{text}\n"
                    
                    # Move the file out of the NPU so it isn't read infinitely
                    dest = os.path.join(PROCESSED_DIR, filename)
                    shutil.move(filepath, dest)
                except Exception:
                    pass
    return new_knowledge

# ── CPU MANUAL CLUTCH (TRIPWIRE MONITOR) ──
def check_cpu_clutch():
    """Reads the CPU ledger to detect hardware faults or orchestrator hard-halts."""
    global is_ponder_paused, axed_flagged
    cpu_ledger = os.path.join(CPU_DIR, "kqkkqq.txt")
    
    if not os.path.exists(cpu_ledger):
        return
    
    try:
        with open(cpu_ledger, "r", encoding="utf-8") as f:
            lines = f.readlines()
            
        # Read from the bottom up to catch the most recent events
        for line in reversed(lines):
            if "[axed]" in line:
                if not getattr(sys.modules[__name__], 'axed_flagged', False):
                    sys.stdout.write(f"\r\033[K\n\033[0;31m[!] CPU CLUTCH DROP: {line.strip()}\033[0m\n")
                    sys.stdout.write("    Orchestrator tripped Dead Man's Switch. Suspending all background ponder/intake.\n")
                    sys.stdout.flush()
                    is_ponder_paused = True
                    globals()['axed_flagged'] = True  # Set flag so it doesn't spam the terminal every loop
                    update_gui_chat("SYS", "SECURITY HALT: CPU Ledger reports [axed].")
                break
    except Exception:
        pass

# ── CONTEXT CONSOLIDATION ENGINE ─────────────────────────────────────────────
def active_context_token_count():
    """
    Return the actual tokenizer length of the active session.

    WHY:
    Character count and model-token count are not equivalent. The automatic
    Wake trigger is defined in tokens so it corresponds to the model's context.
    """
    if not session_history:
        return 0
    return len(tokenizer.encode(session_history, add_special_tokens=False))


def mark_wake_consolidation_if_needed():
    """
    Mark context for the next Wake cycle once the active session passes 1536 tokens.

    CONTRACT:
    Crossing 1536 in NORMAL mode does not interrupt the user. The pending state
    survives until a true WAKE cycle gets a chance to consolidate it.
    """
    global wake_consolidation_pending
    token_count = active_context_token_count()

    if token_count >= WAKE_AUTO_CNSL_TOKENS:
        wake_consolidation_pending = True

    return token_count


def _write_cnsl_recovery(timestamp, reason, remaining_text, error_text):
    """
    Preserve material that could not be completed during the current retraining pass.

    HISTORY / DIRECTION:
    Recovery data is intentionally sent to dgapi/intake/generated instead of
    being discarded. process_intake_files() scans this directory on a later boot.
    """
    os.makedirs(GENERATED_INTAKE_DIR, exist_ok=True)
    recovery_path = os.path.join(
        GENERATED_INTAKE_DIR,
        f"cnsl_recovery_{timestamp}.txt"
    )

    with open(recovery_path, "w", encoding="utf-8") as f:
        f.write("[AItech CNSL RECOVERY DATA]\n")
        f.write(f"timestamp: {timestamp}\n")
        f.write(f"reason: {reason}\n")
        f.write(f"error: {error_text}\n")
        f.write("status: pending intake\n\n")
        f.write("[UNINTEGRATED_CONTEXT]\n")
        f.write(remaining_text)
        f.write("\n[/UNINTEGRATED_CONTEXT]\n")

    return recovery_path


def cnsl(reason="manual"):
    """
    CNSL — consolidate active context into durable training data and weights.

    Automatic use:
      Wake calls this after the session has crossed WAKE_AUTO_CNSL_TOKENS.

    Manual use:
      The user may enter `cnsl` at any time. Manual consolidation is allowed
      to work with larger chunks than the automatic Wake path.

    CONTRACT:
      1. Snapshot the complete active session before changing model weights.
      2. Save that snapshot as normal training data.
      3. Train the current writable model in-place across ALL snapshot chunks.
      4. Save the updated model only after the training pass.
      5. If a chunk cannot be completed, preserve the remaining material in
         dgapi/intake/generated for the next boot instead of deleting it.
      6. Active context is reduced only after durable preservation succeeds.
    """
    global session_history, wake_consolidation_pending

    if not cnsl_lock.acquire(blocking=False):
        return "[CNSL] Consolidation is already running."

    timestamp = time.strftime("%Y%m%d_%H%M%S")
    snapshot = session_history

    try:
        if not snapshot.strip():
            wake_consolidation_pending = False
            return "[CNSL] No active context to consolidate."

        encoded = tokenizer(
            snapshot,
            return_tensors="pt",
            add_special_tokens=False,
            truncation=False
        )["input_ids"][0]

        total_tokens = int(encoded.shape[0])
        chunk_size = (
            MANUAL_CNSL_CHUNK_TOKENS
            if reason == "manual"
            else AUTO_CNSL_CHUNK_TOKENS
        )

        # The complete source survives independently of the weight update.
        os.makedirs(TRAIN_DIR, exist_ok=True)
        training_path = os.path.join(
            TRAIN_DIR,
            f"cnsl_{timestamp}_{reason}.txt"
        )

        with open(training_path, "w", encoding="utf-8") as f:
            f.write("[AItech CNSL TRAINING DATA]\n")
            f.write(f"timestamp: {timestamp}\n")
            f.write(f"reason: {reason}\n")
            f.write(f"source_tokens: {total_tokens}\n")
            f.write(f"model_context_tokens: {MODEL_CONTEXT_TOKENS}\n")
            f.write(f"training_chunk_tokens: {chunk_size}\n\n")
            f.write(snapshot)

        update_gui_stats(
            5,
            "CNSL",
            f"Preserved {total_tokens} tokens → {os.path.basename(training_path)}"
        )
        update_gui_chat(
            "SYS",
            f"CNSL started ({reason}) | {total_tokens} tokens"
        )

        model.train()
        losses = []
        starts = list(range(0, total_tokens, chunk_size))

        for chunk_index, chunk_start in enumerate(starts):
            chunk = encoded[chunk_start:chunk_start + chunk_size]

            if chunk.shape[0] < 2:
                continue

            try:
                input_ids = chunk.unsqueeze(0).to(device)
                attention_mask = torch.ones_like(input_ids)
                labels = input_ids.clone()

                optimizer.zero_grad(set_to_none=True)
                outputs = model(
                    input_ids=input_ids,
                    attention_mask=attention_mask,
                    labels=labels
                )
                loss = outputs.loss
                loss.backward()
                optimizer.step()

                losses.append(loss.item())

                progress = 10 + int(
                    ((chunk_index + 1) / max(1, len(starts))) * 80
                )
                update_gui_stats(
                    progress,
                    "CNSL TRAINING",
                    f"Chunk {chunk_index + 1}/{len(starts)} | Loss: {loss.item():.4f}"
                )

            except Exception as exc:
                remaining_ids = encoded[chunk_start:]
                remaining_text = tokenizer.decode(
                    remaining_ids,
                    skip_special_tokens=False
                )
                recovery_path = _write_cnsl_recovery(
                    timestamp,
                    reason,
                    remaining_text,
                    f"{type(exc).__name__}: {exc}"
                )

                update_gui_stats(
                    0,
                    "CNSL DEFERRED",
                    f"Recovery queued: {os.path.basename(recovery_path)}"
                )
                update_gui_chat(
                    "SYS",
                    f"CNSL incomplete; deferred remainder to {recovery_path}"
                )

                # The raw training snapshot and recovery remainder both exist,
                # therefore active context remains untouched for a future retry.
                return (
                    f"[CNSL] Retraining stopped at chunk {chunk_index + 1}. "
                    f"Recovery queued: {recovery_path}"
                )

        # Save current learned state only after every selected chunk succeeded.
        model.save_pretrained(MODEL_PATH)
        _save_model_identity(MODEL_PATH)
        tokenizer.save_pretrained(MODEL_PATH)

        avg_loss = sum(losses) / max(1, len(losses))

        append_memory_file(
            CHAT_LOG,
            (
                f"\n[{time.strftime('%Y-%m-%dT%H:%M:%S')}] "
                f"CNSL COMPLETE | reason={reason} | tokens={total_tokens} "
                f"| chunks={len(losses)} | avg_loss={avg_loss:.4f} "
                f"| training_file={training_path}\n"
            ),
            what="context-consolidation event",
            why="journal.txt owns chronological records of model/session events"
        )

        # Context overflow becomes a transition from active memory into:
        # raw journal + reusable training data + current model weights.
        session_history = (
            f"[CNSL:{timestamp}] Prior active context consolidated into "
            f"training data and current model weights. "
            f"Source tokens: {total_tokens}. "
            f"Training file: {os.path.basename(training_path)}.\n"
        )
        wake_consolidation_pending = False

        update_gui_stats(
            100,
            "CNSL COMPLETE",
            f"{total_tokens} tokens | Avg Loss: {avg_loss:.4f}"
        )
        update_gui_chat(
            "SYS",
            f"CNSL complete | {total_tokens} tokens | {len(losses)} chunks"
        )

        return (
            f"[CNSL] Complete. {total_tokens} tokens consolidated across "
            f"{len(losses)} chunk(s) | Avg Loss: {avg_loss:.4f}"
        )

    finally:
        cnsl_lock.release()



# ── EGR ENTROPY VALVE ────────────────────────────────────────────────────────
# Recycles unresolved symbols/fragments from trash.xtx into a counted ledger.
# Ponder can later consume these fragments as mutation candidates instead of
# discarding them, preserving the uploaded script's "EGR valve" behavior while
# keeping v18's richer ponder state machine intact.
def process_egr_valve():
    if not os.path.exists(TRASH_XTX) or os.path.getsize(TRASH_XTX) == 0:
        return False
    try:
        with open(TRASH_XTX, "r", encoding="utf-8", errors="ignore") as f:
            content = f.read()
        if not content:
            return False

        match = re.search(r'\[(.*?)\]', content, re.DOTALL)
        if match:
            inner_text = match.group(1)
            remaining = content[match.end():]
        else:
            inner_text = content[0]
            remaining = content[1:]

        with open(TRASH_XTX, "w", encoding="utf-8") as f:
            f.write(remaining)

        if not inner_text:
            return False

        # Long unresolved fragments are represented compactly and reversibly as
        # their UTF-8 hex bytes in the ledger. Short fragments remain readable.
        if len(inner_text) >= 8:
            inner_text = inner_text.encode("utf-8", errors="ignore").hex().upper()

        char_key = f"[{inner_text}]"
        egr_data = {}
        if os.path.exists(EGR_LEDGER_JSON):
            try:
                with open(EGR_LEDGER_JSON, "r", encoding="utf-8") as f:
                    egr_data = json.load(f)
            except Exception:
                egr_data = {}

        egr_data[char_key] = egr_data.get(char_key, 0) + 1
        sorted_egr = {k: egr_data[k] for k in sorted(egr_data)}
        os.makedirs(os.path.dirname(EGR_LEDGER_JSON), exist_ok=True)
        with open(EGR_LEDGER_JSON, "w", encoding="utf-8") as f:
            json.dump(sorted_egr, f, indent=2)
        return True
    except Exception:
        return False


def drain_trash_to_egr(max_cycles=243):
    """
    Drain bounded unresolved entropy into the EGR ledger for a triggered WAKE pass.

    243 is intentionally both a safety bound and the native dimensional ceiling:
    one routing event can recycle a substantial batch without allowing malformed or
    externally-growing trash input to monopolize the runtime indefinitely. A
    remaining tail automatically causes another event below.
    """
    drained = 0
    for _ in range(max(1, int(max_cycles))):
        if not process_egr_valve():
            break
        drained += 1

    try:
        still_has_entropy = os.path.exists(TRASH_XTX) and os.path.getsize(TRASH_XTX) > 0
    except OSError:
        still_has_entropy = False

    if still_has_entropy:
        TRASH_WAKE_EVENT.set()
    return drained

def trash_size_bytes():
    """Return the current unresolved-entropy footprint without raising."""
    try:
        return os.path.getsize(TRASH_XTX) if os.path.exists(TRASH_XTX) else 0
    except OSError:
        return 0


def _drain_until_below(target_bytes, max_cycles=2430):
    """Recycle until trash is <= target_bytes or the bounded valve can no longer progress."""
    drained = 0
    previous = trash_size_bytes()
    for _ in range(max(1, int(max_cycles))):
        if previous <= max(0, int(target_bytes)):
            break
        if not process_egr_valve():
            break
        drained += 1
        current = trash_size_bytes()
        if current >= previous:
            break
        previous = current
    return drained


def _qwen_complexity_score(text):
    """
    Estimate structural thought complexity in [0,1] using only local text form.
    This is not epistemic quality: it measures length, lexical variety, nesting,
    punctuation/relations and structured-memory markup so WAKE:QWEN can choose
    how strongly to recycle unresolved entropy for this particular thought.
    """
    text = str(text or "")
    words = re.findall(r"[A-Za-z0-9_'-]+", text.lower())
    if not words:
        return 0.0
    unique_ratio = len(set(words)) / max(1, len(words))
    length_term = min(1.0, len(words) / 81.0)
    structure_hits = len(re.findall(r"[,:;()\[\]{}<>]|->|=>|\b(if|because|therefore|however|while|unless|and|or)\b", text, re.I))
    structure_term = min(1.0, structure_hits / 18.0)
    nesting_term = min(1.0, (text.count('<file') + text.count('[') + text.count('(')) / 9.0)
    return max(0.0, min(1.0, 0.30*length_term + 0.30*unique_ratio + 0.25*structure_term + 0.15*nesting_term))


def build_chat_compat_context(text, max_chars=2200):
    """Assemble the chat-compatibility context block for an autonomous turn.

    This is what separates CE from BE. BE is the BASIC ENGINE state: the
    sustained loop feeds the model a bare training-shaped prompt -- schema
    directive, "User: ... Assistant:" -- and takes back a raw response, which is
    exactly what a training engine should do and exactly what v0.1.58 did.

    CE is the COMPLETE / CHAT ENGINE state: the same sustained loop, but each
    autonomous turn is assembled the way a real chat turn is assembled, from the
    interpretation scaffold, the input registers, the internal cache state, the
    running self-source reference, and any dropped-source notebook the text
    touches. Those pieces were added after v0.1.58 for the user-facing chat path;
    CE is what lets the engine's own thinking use them too.

    Every piece is optional and every failure is swallowed: a missing or slow
    context source degrades CE toward BE rather than stopping the loop.
    """
    parts = []
    for producer in (
        lambda: build_interpretation_scaffold(text),
        lambda: build_input_register_state(text),
        lambda: check_internal_cache_state(text, max_chars=700),
        lambda: source_notebook_context_for_prompt(text, max_chars=900),
    ):
        try:
            piece = producer()
        except Exception:
            piece = ""
        if piece:
            parts.append(str(piece).strip())
    try:
        self_source = get_aitech_self_source_reference(text, max_chars=900)
    except Exception:
        self_source = ""
    if self_source:
        parts.append(
            "[CURRENT AItech self-source reference; use as authority for this running revision]\n"
            + self_source
            + "\n[/CURRENT AItech self-source reference]"
        )
    if not parts:
        return ""
    block = "\n".join(parts)
    if len(block) > max_chars:
        block = block[:max_chars]
    return "\n" + block + "\n"
def apply_trash_pressure_policy(ponder_engine, *, force=False, qwen_complexity=None, before_qwen_bytes=None):
    """
    Apply v21's mode-dependent entropy-size contract.

    NORMAL + idle: trash is actively drained toward zero so idle time cannot
    become an accumulation period.
    WAKE (normal): each maintenance pass must exert net-negative pressure.
    BE / CE: no automatic trash drain; generation is allowed to create
    unresolved entropy and therefore trash may grow. CE is the complete/chat
    form of the same sustained state, so it inherits the same contract: what
    differs between them is how a turn is assembled, not what it is permitted
    to leave behind.
    WAKE:QWEN: complexity selects decrease / hold / accumulation-permitted.
    """
    global current_mode, last_activity_time
    size_before = trash_size_bytes()
    dirty = TRASH_WAKE_EVENT.is_set()
    idle_for = max(0.0, time.time() - last_activity_time)
    idle_threshold = (60.0 - (getattr(ponder_engine, 'interest', 0.5) * 30.0)) / max(0.1, idle_speed_multiplier)

    # BE and CE are deliberately permissive: unresolved material is allowed to
    # build up while creative/autonomous generation is active. Clear the edge
    # notification without consuming the trash itself. CE is BE plus the
    # chat-compatibility layer, so it keeps BE's entropy contract unchanged.
    if current_mode in ("be", "ce"):
        if dirty:
            TRASH_WAKE_EVENT.clear()
        return {"mode":current_mode, "before":size_before, "after":trash_size_bytes(), "drained":0, "policy":"accumulate-permitted"}

    # WAKE:QWEN is handled after each Qwen thought when complexity is available.
    # Before that point, leave the size untouched so the thought process itself
    # can determine whether new unresolved material appears.
    if current_mode == "wake: qwen" and qwen_complexity is None:
        return {"mode":"wake:qwen", "before":size_before, "after":size_before, "drained":0, "policy":"await-complexity"}

    drained = 0
    policy = "hold"

    if current_mode == "wake: qwen":
        score = max(0.0, min(1.0, float(qwen_complexity or 0.0)))
        baseline = size_before if before_qwen_bytes is None else max(0, int(before_qwen_bytes))
        if score < 0.34:
            # Simple thought: aggressively resolve old entropy; force a decrease
            # relative to the pre-thought footprint whenever anything exists.
            target = max(0, min(size_before, baseline) - max(1, min(243, max(1, baseline // 8))))
            drained = _drain_until_below(target, max_cycles=243)
            policy = "decrease"
        elif score < 0.67:
            # Medium complexity: hold the pre-thought footprint when possible.
            # If Qwen routed additional unresolved material, recycle only enough
            # to return to the baseline; do not erase older unresolved context.
            if trash_size_bytes() > baseline:
                drained = _drain_until_below(baseline, max_cycles=243)
            policy = "hold"
        else:
            # Complex thought: unresolved branches are legitimate. Recycling is
            # deferred, so size may increase, remain constant, or later fall.
            policy = "accumulate-permitted"
        TRASH_WAKE_EVENT.clear()
        after = trash_size_bytes()
        update_gui_chat("SYS", f"WAKE:QWEN trash policy={policy} complexity={score:.2f} bytes {size_before}->{after}")
        return {"mode":"wake:qwen", "before":size_before, "after":after, "drained":drained, "policy":policy, "complexity":score}

    # Persistent WAKE in normal mode is a recycler: guarantee a lower target on
    # every dirty/forced pass, then ponder using what was transferred to EGR.
    if getattr(ponder_engine, "wake_mode", False) and current_mode == "normal":
        if size_before > 0:
            target = max(0, size_before - max(1, min(243, max(1, size_before // 6))))
            drained = _drain_until_below(target, max_cycles=243)
            policy = "net-negative"
        TRASH_WAKE_EVENT.clear()
        if drained > 0:
            ponder_engine.do_ponder(multiplier=max(1.0, float(resource_multiplier)))
        return {"mode":"wake", "before":size_before, "after":trash_size_bytes(), "drained":drained, "policy":policy}

    # NORMAL idle maintenance: once the user is genuinely idle, drain all
    # currently reachable entropy. Repeated background writes are therefore
    # countered on every tick instead of letting trash steadily grow.
    if current_mode == "normal" and not getattr(ponder_engine, "wake_mode", False) and idle_for >= idle_threshold:
        if size_before > 0:
            drained = _drain_until_below(0, max_cycles=2430)
            policy = "idle-zero-pressure"
        TRASH_WAKE_EVENT.clear()
        return {"mode":"idle", "before":size_before, "after":trash_size_bytes(), "drained":drained, "policy":policy}

    # AUTO keeps the existing active-generation behavior but does not inherit
    # BE's explicit permission to accumulate forever. Dirty trash is slowly
    # recycled so it remains bounded without imposing WAKE's strong decrease.
    if current_mode == "auto" and dirty and size_before > 0:
        drained = drain_trash_to_egr(max_cycles=1)
        TRASH_WAKE_EVENT.clear()
        return {"mode":"auto", "before":size_before, "after":trash_size_bytes(), "drained":drained, "policy":"bounded"}

    return {"mode":current_mode, "before":size_before, "after":trash_size_bytes(), "drained":0, "policy":"deferred"}


# ── PONDER ENGINE (SELF-DETERMINING REM CYCLE & MULTI-SENSORY) ──
class PonderEngine(threading.Thread):
    def __init__(self):
        super().__init__(daemon=True)
        self.is_pondering = False
        self.animating = False
        self.wake_mode = False
        self.interest = 0.5  

    def run(self):
        global last_activity_time, is_ponder_paused, current_mode, resource_multiplier, auto_timer_end, mode_history, wake_consolidation_pending, idle_speed_multiplier

        while True:
            time.sleep(1.0 / max(0.1, idle_speed_multiplier)) # stance-scaled base tick rate

            # TRASH -> WAKE RECYCLE:
            # This one-shot maintenance cycle is intentionally checked before the
            # ordinary ponder pause gate. `stop` pauses elective pondering/dreams,
            # but entropy routed to trash.xtx still receives its promised recycle
            # pass so trash never becomes a dead-end sink.
            cross_runtime_marker = os.path.join(SYSTEM_DIR, "trash_wake.request")
            if os.path.exists(cross_runtime_marker):
                try:
                    os.remove(cross_runtime_marker)
                except OSError:
                    pass
                TRASH_WAKE_REASON.append("cross-runtime trash routing")
                TRASH_WAKE_EVENT.set()

            # Apply size pressure continuously. The policy itself decides whether
            # the current mode should drain, hold, or permit accumulation.
            try:
                apply_trash_pressure_policy(self, force=TRASH_WAKE_EVENT.is_set())
            except Exception as exc:
                update_gui_chat("SYS", f"trash pressure policy failed: {exc}")

            # DEBUG / REVISIT:
            # If BE/AUTO appears inactive, first confirm this pause gate was not
            # intentionally set by "stop".
            if is_ponder_paused:
                continue

            # AUTO may be temporary. When its timer expires, return to the
            # previous mode instead of forcing NORMAL and losing mode history.
            if current_mode == "auto" and auto_timer_end > 0 and time.time() > auto_timer_end:
                current_mode = mode_history[-2] if len(mode_history) > 1 else "normal"
                auto_timer_end = 0.0
                sys.stdout.write(
                    f"\\r\\033[K[System] Auto duration expired. "
                    f"Returning to {current_mode.upper()} mode.\\n"
                )
                sys.stdout.flush()

            # WAKE AUTO-CONSOLIDATION:
            # If normal conversation crossed 1536 tokens before Wake began,
            # do not interrupt that conversation. The first true WAKE cycle
            # consumes the pending consolidation before ordinary pondering.
            #
            # BE/AUTO deliberately do not trigger this automatic path merely
            # because they reuse wake_mode internally; manual `cnsl` remains
            # available in every mode.
            if (
                self.wake_mode
                and current_mode == "normal"
                and (
                    wake_consolidation_pending
                    or active_context_token_count() >= WAKE_AUTO_CNSL_TOKENS
                )
            ):
                result = cnsl(reason="wake_auto")
                sys.stdout.write(f"\r\033[K\n{result}\n")
                sys.stdout.flush()
                time.sleep(1.0)
                continue

            # Resource allocation remains user-adjustable. BE/AUTO applies a
            # second 2x layer without destroying the stored base multiplier.
            active_multiplier = resource_multiplier
            if current_mode in ["be", "ce", "auto"]:
                # CE takes the same active layer as BE. It is the same sustained
                # state doing the same work; the difference is how a turn is
                # assembled, not how much of the machine it may use.
                active_multiplier *= 2.0

            initial_timeout = (60.0 - (self.interest * 30.0)) / max(0.1, idle_speed_multiplier)

            # WAKE, BE and AUTO bypass the normal inactivity threshold.
            is_active_mode = self.wake_mode or current_mode in ["be", "ce", "auto", "wake:qwen"]

            if is_active_mode or (time.time() - last_activity_time > initial_timeout):
                if not self.is_pondering:
                    self.is_pondering = True

                    mode_label = (
                        current_mode.upper()
                        if current_mode in ["be", "ce", "auto", "wake: qwen", "wake:qwen"]
                        else "WAKE STATE" 
                        if self.wake_mode
                        else "Subconscious"
                    )

                    sys.stdout.write(
                        f"\\r\\033[K\\n[{mode_label}] "
                        f"Alloc: {active_multiplier:.3f}x | "
                        f"Eagerness: {self.interest:.2f}...\\n"
                    )
                    sys.stdout.flush()

                    update_gui_stats(
                        int(self.interest * 100),
                        mode_label,
                        f"Mode: {current_mode.upper()} | Alloc: {active_multiplier:.3f}x"
                    )

                    # 4-Tier Finite State Engine
                    if current_mode == "wake: qwen":
                        # Interactive Inter-Chat
                        self.generate_qwen_consult()
                    elif self.wake_mode and current_mode == "normal":
                        # Archival Defragmenter (Lossless Processing)
                        processed = process_swap_with_qwen()
                        if not processed:
                            self.do_ponder(multiplier=active_multiplier)
                        else:
                            global hm_points
                            hm_points += 1 # Reward for archiving
                    elif current_mode in ["be", "ce", "auto"]:
                        # Self-Chat & Generation.
                        # BE = BASIC ENGINE: the bare training-shaped prompt and
                        # a raw response, unchanged from v0.1.58.
                        # CE = COMPLETE / CHAT ENGINE: the same cycle assembled
                        # through the chat-compatibility context, so the engine's
                        # own turns see what a user-facing turn sees.
                        self.do_ponder(multiplier=active_multiplier,
                                       chat_compat=(current_mode == "ce"))
                        if random.random() < 0.4:
                            gen_choice = random.choice([
                                self.generate_dream_image,
                                self.generate_dream_audio,
                                self.generate_dream_video,
                                self.generate_dream_text,
                            ])
                            gen_choice()
                    else:
                        # User Chat Pondering
                        self.do_ponder(multiplier=active_multiplier)

                    if random.random() < 0.3:
                        self.do_memory_defrag(multiplier=active_multiplier)

                    # v0.1.63: foreground input loop owns the editable You: prompt; async output must not redraw it.
                    sys.stdout.flush()

                    if is_active_mode:
                        time.sleep(1.0 / max(0.1, idle_speed_multiplier)) # stance-scaled sustained cycling
                    else:
                        sleep_time = max(
                            15.0,
                            min(60.0, 60.0 - (self.interest * 45.0))
                        )
                        time.sleep(sleep_time / max(0.1, idle_speed_multiplier))

                    self.is_pondering = False

    def _cache_animation_loop(self, mutated_str, prefix="[amdream cache]"):
        hex_chars = "0123456789ABCDEF"
        garbage_chars = "abcdefghijklmnopqrstuvwxyz0123456789@#$%&*?|"
        disp_len = min(30, len(mutated_str))
        while self.animating:
            hex_addr = "".join(random.choice(hex_chars) for _ in range(8))
            cache_noise = "".join(random.choice(garbage_chars) for _ in range(15))
            sys.stdout.write(f"\r\033[K{prefix} 0x{hex_addr} | {cache_noise} | {mutated_str[:disp_len]}...")
            sys.stdout.flush()
            time.sleep(0.07)

    def do_ponder(self, multiplier=1, chat_compat=False):
        # chat_compat=False is BE, the basic engine cycle exactly as it was.
        # chat_compat=True is CE, the same cycle with a chat-shaped prompt.
        # The default keeps every existing caller behaving identically.
        cpu_load = "Unknown"
        battery_level = "AC/Unknown"
        if PSUTIL:
            try:
                cpu_load = f"{psutil.cpu_percent()}%"
                if psutil.sensors_battery(): battery_level = f"{psutil.sensors_battery().percent}%"
            except: pass

        base_str = "what is the nature of aenglora"
        if last_prompt: base_str = last_prompt
            
        mutated_str = list(base_str)
        if len(mutated_str) > 3:
            idx = random.randint(0, len(mutated_str)-1)
            chosen_key = None
            if os.path.exists(EGR_LEDGER_JSON):
                try:
                    with open(EGR_LEDGER_JSON, "r", encoding="utf-8") as f:
                        egr_data = json.load(f)
                    available_keys = [k for k, v in egr_data.items() if v > 0]
                    if available_keys:
                        chosen_key = random.choice(available_keys)
                        inner_val = chosen_key[1:-1]
                        # A hex-encoded long fragment is deliberately injected as
                        # text; the dream engine can learn/reinterpret the pattern.
                        mutated_str[idx] = inner_val
                        egr_data[chosen_key] -= 1
                        if egr_data[chosen_key] <= 0:
                            del egr_data[chosen_key]
                        with open(EGR_LEDGER_JSON, "w", encoding="utf-8") as f:
                            json.dump({k: egr_data[k] for k in sorted(egr_data)}, f, indent=2)
                except Exception:
                    chosen_key = None
            if not chosen_key:
                mutated_str[idx] = random.choice('abcdefghijklmnopqrstuvwxyz')
        mutated_str = "".join(mutated_str)

        anim_prefix = "[HYPER-DREAM CACHE]" if multiplier > 1 else "[amdream cache]"
        log_prefix = "HYPER-PONDER CYCLE" if multiplier > 1 else "PONDER CYCLE"

        self.animating = True
        anim_thread = threading.Thread(target=self._cache_animation_loop, args=(mutated_str, anim_prefix), daemon=True)
        anim_thread.start()

        model.eval()
        t0 = time.time()
        max_toks = int(10 * multiplier)

        # Inject Memory Schema so the local model can categorize its dreams
        schema_directive = f"\n[System Directive: {get_semantic_schema_prompt()}]\n"

        # CE only: the chat-compatibility context. BE leaves this empty, so its
        # prompt is byte-for-byte what it has always been.
        chat_directive = ""
