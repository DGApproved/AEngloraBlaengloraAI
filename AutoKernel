                    else:
                        ans = input("Save this code/text? (Type 'n' to skip, or type a filename like 'script.py'): ").strip()
                        if ans.lower() != 'n' and ans != '':
                            save_path = ROOT_DIR / "Local" / ans
                            save_path.parent.mkdir(parents=True, exist_ok=True)
                            save_path.write_text(code.strip() + "\n", encoding="utf-8")
