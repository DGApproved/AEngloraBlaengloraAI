        if self.mode != "a":
            raise PermissionError("DGA opened read-only; reopen with mode='a' to append")
        if kind not in {"text", "json", "binary"}:
            raise ValueError("kind must be text, json, or binary")

        if kind == "binary":
            raw = bytes(data)
            stored = base64.b64encode(raw).decode("ascii")
            encoding = "base64"
        elif kind == "json":
            stored = data
            raw = _json_line(data).encode("utf-8")
            encoding = "json"
        else:
            stored = str(data)
            raw = stored.encode("utf-8")
            encoding = "utf-8"

        digest = hashlib.sha256(raw).hexdigest()
        record_id = f"sha256:{digest[:24]}"
        record = {
            "type": "record", "id": record_id, "created": _now(),
            "name": str(name), "kind": kind,
            "mime": mime or ("application/json" if kind == "json" else
                             "application/octet-stream" if kind == "binary" else "text/plain"),
            "encoding": encoding, "sha256": digest, "bytes": len(raw),
            "provenance": provenance, "supersedes": supersedes,
            "metadata": metadata or {}, "data": stored,
        }
        with self.path.open("a", encoding="utf-8") as f:
            f.write(_json_line(record) + "\n")
        return record_id

    def get(self, record_id):
        for rec in self.records():
            if rec.get("id") == record_id:
                return rec
        return None

    def verify(self):
        checked = 0
        errors = []
        for rec in self.records():
            if rec.get("type") != "record":
                continue
            try:
                kind = rec.get("kind")
                if kind == "binary":
                    raw = base64.b64decode(rec.get("data", ""), validate=True)
                elif kind == "json":
                    raw = _json_line(rec.get("data")).encode("utf-8")
                else:
                    raw = str(rec.get("data", "")).encode("utf-8")
                got = hashlib.sha256(raw).hexdigest()
                if got != rec.get("sha256"):
                    errors.append(f"{rec.get('id','?')}: hash mismatch")
                checked += 1
            except Exception as exc:
                errors.append(f"{rec.get('id','?')}: {exc}")
        return checked, errors

def cmd_init(args):
    DGAFile(args.path, "w", seed=args.seed)
    print(args.path)

def cmd_add_text(args):
    dga = DGAFile(args.path, "a")
    rid = dga.append(name=args.name, kind="text", data=args.text,
                     mime=args.mime, provenance=args.provenance,
                     supersedes=args.supersedes)
    print(rid)

def cmd_add_file(args):
    p = Path(args.file)
    raw = p.read_bytes()
    try:
        text = raw.decode("utf-8")
        kind, data = "text", text
    except UnicodeDecodeError:
        kind, data = "binary", raw
    mime = args.mime or mimetypes.guess_type(p.name)[0]
    dga = DGAFile(args.path, "a")
    rid = dga.append(name=args.name or p.name, kind=kind, data=data,
                     mime=mime, provenance=args.provenance,
                     supersedes=args.supersedes,
                     metadata={"source_filename": p.name})
    print(rid)

def cmd_list(args):
    dga = DGAFile(args.path, "r")
    for rec in dga.records():
        if rec.get("type") == "record":
            print(f"{rec.get('id')}  {rec.get('kind'):6}  {rec.get('bytes',0):8}  {rec.get('name')}")

def cmd_get(args):
    dga = DGAFile(args.path, "r")
    rec = dga.get(args.id)
    if rec is None:
        raise SystemExit("record not found")
    if rec.get("kind") == "binary":
        data = base64.b64decode(rec["data"])
        if args.output:
            Path(args.output).write_bytes(data)
        else:
            print(base64.b64encode(data).decode("ascii"))
    elif rec.get("kind") == "json":
        print(json.dumps(rec.get("data"), ensure_ascii=False, indent=2))
    else:
        if args.output:
            Path(args.output).write_text(str(rec.get("data","")), encoding="utf-8")
        else:
            print(rec.get("data",""))

def cmd_verify(args):
    checked, errors = DGAFile(args.path, "r").verify()
    print(f"checked={checked} errors={len(errors)}")
    for err in errors:
        print(err)
    raise SystemExit(1 if errors else 0)

def main():
    ap = argparse.ArgumentParser(description="AItech DGApproved (.dga) evolving container")
    sub = ap.add_subparsers(dest="cmd", required=True)

    p = sub.add_parser("init"); p.add_argument("path"); p.add_argument("--seed"); p.set_defaults(func=cmd_init)
    p = sub.add_parser("add-text")
    p.add_argument("path"); p.add_argument("name"); p.add_argument("text")
    p.add_argument("--mime"); p.add_argument("--provenance"); p.add_argument("--supersedes")
    p.set_defaults(func=cmd_add_text)
    p = sub.add_parser("add-file")
    p.add_argument("path"); p.add_argument("file"); p.add_argument("--name")
    p.add_argument("--mime"); p.add_argument("--provenance"); p.add_argument("--supersedes")
    p.set_defaults(func=cmd_add_file)
    p = sub.add_parser("list"); p.add_argument("path"); p.set_defaults(func=cmd_list)
    p = sub.add_parser("get"); p.add_argument("path"); p.add_argument("id"); p.add_argument("--output"); p.set_defaults(func=cmd_get)
    p = sub.add_parser("verify"); p.add_argument("path"); p.set_defaults(func=cmd_verify)
    args = ap.parse_args()
