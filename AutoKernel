    def idle_background_daemon():
        global last_user_activity, idle_daemon_running, daemon_status
        global bg_tokens_total, manual_trigger, ui_paused, idle_cycle_count

        # Block until "go" is issued. The thread is always alive but only
        # processes ticks while idle_daemon_running is True.
        while True:
            if not idle_daemon_running:
                time.sleep(0.5)
                continue
            # ── inner cycle (mirrors original while idle_daemon_running loop) ──
            # Base heartbeat — scaled by metabolic stance multiplier
            time.sleep(3.0 / max(0.1, idle_speed_multiplier))
            # A trash route is maintenance-triggered rather than merely an idle
            # optimization. Handle it even if the ordinary daemon UI is paused.
            if trash_wake_requested.is_set():
                trash_wake_requested.clear()
                recycled = 0
                for _ in range(243):
                    if not process_egr_valve():
                        break
                    recycled += 1
                try:
                    if os.path.exists(TRASH_XTX) and os.path.getsize(TRASH_XTX) > 0:
                        trash_wake_requested.set()
                except OSError:
                    pass
                if recycled:
                    update_gui_chat("SYS", f"Orchestrator WAKE recycled {recycled} trash fragment(s)")
                    try:
                        orchestrator_ponder()
                    except Exception:
                        pass

            if daemon_status == "PAUSED" or ui_paused:
                continue

            # ── FAST EGR VALVE TICK (every cycle) ────────────────────────────
            # Drain one entropy token from trash.xtx into the EGR ledger.
            process_egr_valve()
            idle_cycle_count += 1

            # ── SLOW EGR VALVE TICK (every 3 cycles) ─────────────────────────
            if idle_cycle_count % 3 == 0:
                process_egr_valve()

            # ── COLLISION SCAN TICK (every 5 cycles) ──────────────────────────
            # Check shared write ledger for concurrent writes from both engines.
            # Qwen compares content: different topic → ok; same topic → resolve.
            if idle_cycle_count % 5 == 0:
                try:
                    scan_write_ledger_for_collisions()
                except Exception:
                    pass

            # ── SWAP ARCHIVIST TICK (every 6 cycles) ─────────────────────────
            # Losslessly archive the oldest swap.txt chunk into semantic stores.
            # Uses the orchestrator's Qwen access; does not need the local model.
            if idle_cycle_count % 6 == 0:
                try:
                    orchestrator_process_swap()
                except Exception:
                    pass

            # ── PONDER TICK (every 7 cycles) ─────────────────────────────────
            # Generate a base+mutated prompt pair, compute interest score, and
            # forward the ponder result to the chat engine via IPC.
            if idle_cycle_count % 7 == 0:
