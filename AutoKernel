# ── OPTIONAL HEADSET EMULATOR DAEMONS ────────────────────────────────────────
# Historical command naming requested by the project:
#   spkr -u / spkr -d  -> raise/lower BOTH STT/text input listeners (TCP + UDP)
#   mic  -u / mic  -d  -> raise/lower the HTTP model-output/TTS feed
# The names are intentionally preserved even though the transport direction may
# look inverse from conventional microphone/speaker terminology.
HEADSET_OUTPUT_LOCK = threading.Lock()
HEADSET_OUTPUT_STATE = {"sequence": 0, "text": "", "source": "boot", "timestamp": 0.0}
headset_input_daemon = None
headset_output_daemon = None


def publish_headset_output(text, source="model"):
    """Publish plain model text for a speech-synthesis/headset emulator."""
    clean = str(text or "").strip()
    if not clean:
        return
    with HEADSET_OUTPUT_LOCK:
        HEADSET_OUTPUT_STATE["sequence"] += 1
        HEADSET_OUTPUT_STATE["text"] = clean
        HEADSET_OUTPUT_STATE["source"] = str(source)
        HEADSET_OUTPUT_STATE["timestamp"] = time.time()


def _headset_infer_text(text, channel):
    """Convert STT text received from the emulator directly into model text."""
    global session_history
    clean = str(text or "").strip()
    if not clean or tokenizer is None or model is None:
        return ""
    inputs = tokenizer(f"User: {clean}\nAssistant:", return_tensors="pt").to(device)
    model.eval()
    with torch.no_grad():
        outputs = model.generate(
            **inputs,
            max_new_tokens=min(150, TRAINING_GENERATION_MAX_CFG),
            pad_token_id=tokenizer.eos_token_id,
            do_sample=True,
            temperature=0.75,
        )
    response = tokenizer.decode(
        outputs[0][inputs["input_ids"].shape[1]:], skip_special_tokens=True
    ).strip()
    if response:
        stamp = time.strftime("%Y-%m-%dT%H:%M:%S")
        interaction_log = f"\n[{stamp}] User ({channel}): {clean}\nAssistant: {response}\n"
        session_history += interaction_log
        mark_wake_consolidation_if_needed()
        append_memory_file(
            CHAT_LOG, interaction_log,
            what="headset emulator interaction",
            why="journal.txt owns chronological STT/TTS headset interactions",
        )
        update_gui_chat("HSET-IN", clean)
        update_gui_chat("HSET-OUT", response)
        publish_headset_output(response, source=channel)
        publish_vision_output(response, source=channel)
    return response


class HeadsetInputDaemon(threading.Thread):
    """One controllable daemon owning the emulator's TCP and UDP text inputs."""
    def __init__(self, tcp_host, tcp_port, udp_host, udp_port):
        super().__init__(daemon=True)
        self.tcp_host, self.tcp_port = tcp_host, tcp_port
        self.udp_host, self.udp_port = udp_host, udp_port
        self.stop_event = threading.Event()
        self.tcp_socket = None
        self.udp_socket = None

    def stop(self):
        self.stop_event.set()
        for sock in (self.tcp_socket, self.udp_socket):
            try:
                if sock:
                    sock.close()
            except Exception:
                pass

    def _handle_tcp_client(self, client):
        try:
            data = client.recv(65536).decode("utf-8", errors="ignore").strip()
            response = _headset_infer_text(data, "Headset Emulator TCP")
            if response:
                client.sendall(response.encode("utf-8"))
        except Exception:
            pass
        finally:
            try: client.close()
            except Exception: pass

    def run(self):
        try:
            self.tcp_socket = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
            self.tcp_socket.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)
            self.tcp_socket.bind((self.tcp_host, self.tcp_port))
            self.tcp_socket.listen(5)
            self.tcp_socket.setblocking(False)

            self.udp_socket = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)
            self.udp_socket.bind((self.udp_host, self.udp_port))
            self.udp_socket.setblocking(False)

            update_gui_chat(
                "SYS",
                f"Headset STT inputs UP: TCP {self.tcp_host}:{self.tcp_port} | UDP {self.udp_host}:{self.udp_port}",
            )
            while not self.stop_event.is_set():
                try:
                    ready, _, _ = select.select(
                        [self.tcp_socket, self.udp_socket], [], [], 0.5
                    )
                except (OSError, ValueError):
                    break
                for sock in ready:
                    if sock is self.tcp_socket:
                        try:
                            client, _ = self.tcp_socket.accept()
                            threading.Thread(
                                target=self._handle_tcp_client, args=(client,), daemon=True
                            ).start()
                        except OSError:
                            pass
                    elif sock is self.udp_socket:
                        try:
                            data, _ = self.udp_socket.recvfrom(65536)
                            decoded = data.decode("utf-8", errors="ignore").strip()
                            if decoded:
                                threading.Thread(
                                    target=_headset_infer_text,
                                    args=(decoded, "Headset Emulator UDP"), daemon=True,
                                ).start()
                        except OSError:
                            pass
        except Exception as exc:
            update_gui_chat("SYS", f"Headset STT input daemon failed: {exc}")
        finally:
            self.stop()


class HeadsetOutputHandler(BaseHTTPRequestHandler):
    def do_OPTIONS(self):
        self.send_response(200)
        self.send_header("Access-Control-Allow-Origin", "*")
        self.send_header("Access-Control-Allow-Methods", "GET, OPTIONS")
        self.end_headers()

    def do_GET(self):
        if self.path not in ("/", "/output", "/api/output"):
            self.send_response(404); self.end_headers(); return
        with HEADSET_OUTPUT_LOCK:
            payload = dict(HEADSET_OUTPUT_STATE)
        body = json.dumps(payload, ensure_ascii=False).encode("utf-8")
        self.send_response(200)
        self.send_header("Content-Type", "application/json; charset=utf-8")
        self.send_header("Access-Control-Allow-Origin", "*")
        self.send_header("Cache-Control", "no-store")
        self.send_header("Content-Length", str(len(body)))
        self.end_headers()
        self.wfile.write(body)

    def log_message(self, format, *args):
        pass


class HeadsetOutputDaemon(threading.Thread):
    """Controllable HTTP output feed for a text-to-speech headset emulator."""
    def __init__(self, host, port):
        super().__init__(daemon=True)
        self.host, self.port = host, port
        self.server = None

    def stop(self):
        server = self.server
        if server is not None:
            try: server.shutdown()
            except Exception: pass
            try: server.server_close()
            except Exception: pass

    def run(self):
        try:
            self.server = HTTPServer((self.host, self.port), HeadsetOutputHandler)
            update_gui_chat("SYS", f"Headset TTS output UP: HTTP {self.host}:{self.port}/output")
            self.server.serve_forever(poll_interval=0.5)
        except Exception as exc:
            update_gui_chat("SYS", f"Headset TTS output daemon failed: {exc}")
        finally:
            try:
                if self.server: self.server.server_close()
            except Exception: pass



