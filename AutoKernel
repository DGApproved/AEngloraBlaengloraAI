post_apply_diff() {
    local archive="$1" action_label="${2:-update}" before_tmp report rc added removed ans viewer
    [[ -f "$archive" ]] || {
        echo "[!] Post-apply diff unavailable: archive snapshot is missing: $archive" >&2
        return 0
    }
    before_tmp="${TMPDIR:-/tmp}/aitech_before_diff.$$.$RANDOM.sh"
    report="${archive%.txt}_applied.diff.txt"
    if ! extract_archived_script "$archive" "$before_tmp"; then
        rm -f "$before_tmp"
        echo "[!] Update applied, but post-apply diff could not extract the archived AItech source: $archive" >&2
        return 0
    fi
    diff -u --label "before:$(basename "$archive")" --label "after:$(basename "$AITECH_SCRIPT")" "$before_tmp" "$AITECH_SCRIPT" > "$report" 2>&1
    rc=$?
    rm -f "$before_tmp"
    case "$rc" in
        0)
            printf '# No textual differences detected after %s.\n' "$action_label" > "$report"
            echo "[=] Post-apply diff: no textual differences detected."
            ;;
        1)
            added="$(awk '/^\+\+\+ /{next} /^\+/{n++} END{print n+0}' "$report")"
            removed="$(awk '/^--- /{next} /^-/{n++} END{print n+0}' "$report")"
            echo "[Δ] Applied-change audit: +${added} / -${removed} lines"
            echo "[Δ] Unified diff saved: $report"
            printf 'Review applied changes with diff -u now? [Y/n] '
            read -r ans
            case "${ans:-Y}" in
                y|Y|yes|YES|Yes)
                    if command -v less >/dev/null 2>&1 && [[ -t 1 ]]; then
                        LESS='-R' less "$report"
                    else
                        cat "$report"
                    fi
                    ;;
                *) ;;
            esac
            ;;
        *)
            echo "[!] Update applied, but diff -u failed with exit status $rc." >&2
            echo "[!] Diff diagnostic file: $report" >&2
            ;;
    esac
    return 0
}

