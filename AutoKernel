        "Do not normalize the Java layout to conventional directory naming.",
        "comments/<project> is durable project context memory grouped by referenced file/artifact type; it stores snippets, rationale, relationships, removed-feature history, and restoration clues.",
        "When reconstructing or restoring a project feature, consult the active project comments before inventing the old implementation; comments preserve project-specific historical intent.",
    ]
    lines.append(f"programmer_prefs={PROGRAMMER_PREFS}")
    for language,layout in prefs.items():
        lines.append(
            f"prefs[{language}]: source=[{', '.join(layout.get('source',[]))}] "
            f"configure=[{', '.join(layout.get('configure',[]))}] "
            f"build=[{', '.join(layout.get('build',[]))}] "
            f"program=[{', '.join(layout.get('program',[]))}] "
            f"comments=[{', '.join(layout.get('comments',[]))}] "
            f"qwen prompt={layout.get('qwen prompt','')} "
            f"active projects={{{', '.join(layout.get('active projects',[]))}}}"
        )
    comment_budget=12000
    included=set()
    if active_programmer_project:
        lines.append("active_project="+str(active_programmer_project))
        ledger=_prog_load_token_ledger(active_programmer_project)
        lines.append(
            f"active_project_tokens={ledger.get('processed_tokens',0)} "
            f"token_events={ledger.get('events',0)} "
            f"project_valuation={ledger.get('valuation',{})}"
        )
        comment_context=_prog_read_comments(active_programmer_project,min(8000,comment_budget))
        if comment_context:
            lines.append("[active project comments: "+str(active_programmer_project)+"]"+comment_context)
            comment_budget-=min(len(comment_context),comment_budget)
            included.add(str(active_programmer_project))
    # Also expose bounded comments for projects explicitly marked active in programmer.prefs.
    for language,layout in prefs.items():
        for project in layout.get("active projects",[]):
            if comment_budget<=0: break
            project=_prog_safe_name(project)
            if project in included: continue
            comment_context=_prog_read_comments(project,min(4000,comment_budget))
            ledger=_prog_load_token_ledger(project)
            lines.append(
                f"registered_active_project_metrics[{language}/{project}]: "
                f"processed_tokens={ledger.get('processed_tokens',0)} valuation={ledger.get('valuation',{})}"
            )
            if comment_context:
                lines.append(f"[registered active project comments: {language}/{project}]"+comment_context)
                comment_budget-=min(len(comment_context),comment_budget)
                included.add(project)
        if comment_budget<=0: break
    if projects: lines.append("projects="+",".join(projects[:50]))
    return "\n".join(lines)

def _persist_standard_mode(enabled):
    value="1" if enabled else "0"
    try:
        body=Path(PROMPTS_TXT).read_text(encoding="utf-8", errors="ignore")
        if re.search(r"(?m)^STANDARD_MODE_ENABLED\s*=", body): body=re.sub(r"(?m)^STANDARD_MODE_ENABLED\s*=.*$", f"STANDARD_MODE_ENABLED = {value}", body, count=1)
        else: body=body.replace("[/config]", f"STANDARD_MODE_ENABLED = {value}\n[/config]", 1)
        Path(PROMPTS_TXT).write_text(body, encoding="utf-8"); PROMPT_CONFIG["STANDARD_MODE_ENABLED"]=value
    except OSError as exc: update_gui_chat("SYS", f"stan persistence failed: {exc}")


def _standard_program_key(name):
    return re.sub(r"[^a-z0-9]+", "", str(name or "").lower())

def _standard_required_programs():
    ordered=[STANDARD_IMAGE_PROGRAM_CFG,STANDARD_VIDEO_PROGRAM_CFG,STANDARD_AUDIO_PROGRAM_CFG,STANDARD_STT_PROGRAM_CFG,STANDARD_TTS_PROGRAM_CFG,STANDARD_MEDIA_PROGRAM_CFG]
    out=[]; seen=set()
    for name in ordered:
        name=str(name or "").strip(); key=_standard_program_key(name)
        if name and key and key not in seen: seen.add(key); out.append(name)
    return out

def _standard_installer_path():
    return os.path.join(DGAPI_DIR,"src","installer.sh")

def _run_standard_installer(*args):
    path=_standard_installer_path()
    if not os.path.isfile(path):
        return subprocess.CompletedProcess([path,*args],127,"","installer.sh is missing")
    try:
        return subprocess.run([path,*args],stdout=subprocess.PIPE,stderr=subprocess.PIPE,text=True,timeout=3600)
    except Exception as exc:
        return subprocess.CompletedProcess([path,*args],126,"",str(exc))

def _read_standard_dependency_states(programs):
    if not programs: return {}
    result=_run_standard_installer("--check",*programs); states={}
    for raw in str(result.stdout or "").splitlines():
        parts=raw.split("|",3)
        if len(parts)>=2:
            states[_standard_program_key(parts[0])]={"program":parts[0],"state":parts[1],"arguments":parts[2] if len(parts)>2 else "","detect":parts[3] if len(parts)>3 else ""}
    for name in programs:
        states.setdefault(_standard_program_key(name),{"program":name,"state":"unregistered","arguments":"","detect":""})
    return states

standard_disabled_programs=set()

def _stan_dependency_health(offer_install=True):
    global standard_disabled_programs
    programs=_standard_required_programs(); installer=_standard_installer_path()
    if not os.path.isfile(installer):
        standard_disabled_programs={_standard_program_key(x) for x in programs}
        print(f"[STANDARD/STAN] installer missing: {installer}")
        return False

    # A repeated `stan` intentionally clears previous error;<code> diagnostics
    # before a fresh scan. Failed retries will write a new error code.
    _run_standard_installer("--clear-errors")
    scan=_run_standard_installer("--scan")
    if scan.stdout:
        for line in scan.stdout.splitlines():
            if line.strip(): print(f"[installer scan] {line}")

    states=_read_standard_dependency_states(programs)
    missing=[v["program"] for v in states.values() if v["state"]!="t"]

    if missing and offer_install:
        print("[STANDARD/STAN] Missing configured programs: "+", ".join(missing))
        sys.stdout.write(TERM_USER_LIGHT_BROWN+"Auto-run installer for these STAN dependencies? (y/n): ")
        sys.stdout.flush()
        try: answer=input("").strip().lower()
        except (EOFError,KeyboardInterrupt): answer="n"
        finally: sys.stdout.write(TERM_RESET); sys.stdout.flush()

        if answer in ("y","yes"):
            result=_run_standard_installer("--ensure",*missing)
            if result.stdout: print(result.stdout.rstrip())
            if result.stderr: print(result.stderr.rstrip())
            _run_standard_installer("--scan")
            states=_read_standard_dependency_states(programs)
        else:
            print("[STANDARD/STAN] Installation declined; missing adapters remain disabled.")

    standard_disabled_programs={key for key,info in states.items() if info.get("state")!="t"}
    if standard_disabled_programs:
        names=[info["program"] for key,info in states.items() if key in standard_disabled_programs]
        print("[STANDARD/STAN] Disabled unavailable adapters: "+", ".join(names))
    else:
        print("[STANDARD/STAN] All configured external programs detected.")
    return not standard_disabled_programs

def _stan_program_available(name):
    return _standard_program_key(name) not in standard_disabled_programs

def _standard_output_directory():
    configured=str(STANDARD_OUTPUT_DIR_CFG or "session.noq/standard_outputs").strip(); path=configured if os.path.isabs(configured) else os.path.join(BASE_DIR, configured); os.makedirs(path, exist_ok=True); return path

def _run_standard_generator(modality, prompt):
    modality=str(modality or "").lower().strip(); prompt=str(prompt or "").strip()
    table={"image":(STANDARD_IMAGE_PROGRAM_CFG,STANDARD_IMAGE_COMMAND_CFG,STANDARD_IMAGE_MODEL_CFG,STANDARD_IMAGE_EXTENSION_CFG),"video":(STANDARD_VIDEO_PROGRAM_CFG,STANDARD_VIDEO_COMMAND_CFG,STANDARD_VIDEO_MODEL_CFG,STANDARD_VIDEO_EXTENSION_CFG),"audio":(STANDARD_AUDIO_PROGRAM_CFG,STANDARD_AUDIO_COMMAND_CFG,STANDARD_AUDIO_MODEL_CFG,STANDARD_AUDIO_EXTENSION_CFG)}
    if modality not in table or not prompt: return None
    program,command,model_path,extension=table[modality]
    if not _stan_program_available(program):
        update_gui_chat("SYS", f"stan {modality}: {program} disabled because installation was not confirmed")
        return None
    if not command: update_gui_chat("SYS", f"stan {modality}: {program} selected but command is blank"); return None
    ext=str(extension or {"image":".png","video":".mp4","audio":".wav"}[modality]).strip(); ext=ext if ext.startswith(".") else "."+ext; ext=re.sub(r"[^A-Za-z0-9._-]","",ext)
    out_path=os.path.join(_standard_output_directory(), f"{modality}_{int(time.time()*1000)}{ext}")
    run_cmd=str(command).replace("{output}", shlex.quote(out_path)).replace("{model}", shlex.quote(str(model_path or "")))
    try:
        result=subprocess.run(run_cmd,input=prompt.encode("utf-8"),stdout=subprocess.PIPE,stderr=subprocess.PIPE,shell=True,timeout=1800)
        if os.path.exists(out_path) and os.path.getsize(out_path)>0: return out_path
        raw=bytes(result.stdout or b""); decoded=raw.decode("utf-8",errors="ignore").strip()
        if decoded and os.path.exists(decoded): return os.path.abspath(decoded)
        if raw and result.returncode==0:
            Path(out_path).write_bytes(raw)
            if os.path.getsize(out_path)>0: return out_path
        update_gui_chat("SYS", f"stan {modality}: {program} returned no usable file (rc={result.returncode})")
    except Exception as exc: update_gui_chat("SYS", f"stan {modality} failed via {program}: {exc}")
    return None

def _detect_generation_request(text):
    low=str(text or "").lower()
    if not re.search(r"\b(generate|create|make|render|synthesize|produce)\b",low): return None
    if re.search(r"\b(image|picture|photo|artwork|illustration)\b",low): return "image"
    if re.search(r"\b(video|movie|animation|clip)\b",low): return "video"
    if re.search(r"\b(audio|sound|music|song|soundscape)\b",low): return "audio"
    return None

def maybe_route_media_generation(text):
    modality=_detect_generation_request(text)
    if not modality: return None
    if standard_mode_enabled:
        path=_run_standard_generator(modality,text)
        if path: return path
    if modality=="image":
        command=VISION_TEXT_TO_IMAGE_TCP_CMD_CFG or VISION_TEXT_TO_IMAGE_UDP_CMD_CFG
        payload=_run_text_to_image(command,text,channel="native image request") if command else b""
        if payload:
            out_path=os.path.join(_standard_output_directory(),f"image_native_{int(time.time()*1000)}.png")
            try: Path(out_path).write_bytes(payload); return out_path
            except OSError: return None
    return None

def _run_text_to_image(command, text, channel="vision output"):
    """Run an experimental model-text -> image-bytes translator."""
    cmd = str(command or "").strip()
    prompt = str(text or "").strip()
    if not cmd or not prompt:
        return b""
    output_path = None
    try:
        run_cmd = cmd
        if "{output}" in run_cmd:
            fd, output_path = tempfile.mkstemp(prefix="aitech_vision_out_", suffix=".png")
            os.close(fd)
            try: os.unlink(output_path)
            except OSError: pass
            run_cmd = run_cmd.replace("{output}", shlex.quote(output_path))
        result = subprocess.run(
            run_cmd, input=prompt.encode("utf-8"), stdout=subprocess.PIPE,
            stderr=subprocess.PIPE, shell=True, timeout=600,
        )
        if output_path and os.path.exists(output_path):
            with open(output_path, "rb") as f:
                return f.read()
        return bytes(result.stdout or b"")
    except Exception as exc:
        update_gui_chat("SYS", f"{channel} generation failed: {exc}")
        return b""
    finally:
        if output_path:
            try: os.unlink(output_path)
            except OSError: pass


def publish_vision_output(text, source="model"):
    """Regenerate optional TCP/UDP image output only while its daemon is UP."""
    clean = str(text or "").strip()
    if not clean:
        return
    daemon = globals().get("vision_output_daemon")
    if daemon is None or not daemon.is_alive():
        return
    tcp_img = _run_text_to_image(VISION_TEXT_TO_IMAGE_TCP_CMD_CFG, clean, "Vision TCP output")
    udp_img = _run_text_to_image(VISION_TEXT_TO_IMAGE_UDP_CMD_CFG, clean, "Vision UDP output")
    with VISION_OUTPUT_LOCK:
        VISION_OUTPUT_STATE["sequence"] += 1
        VISION_OUTPUT_STATE["text"] = clean
        VISION_OUTPUT_STATE["source"] = str(source)
        VISION_OUTPUT_STATE["timestamp"] = time.time()
        if tcp_img:
            VISION_OUTPUT_STATE["tcp_image"] = tcp_img
        if udp_img:
            VISION_OUTPUT_STATE["udp_image"] = udp_img


def _vision_infer_description(description, channel):
    """Feed an externally produced visual description directly to the model."""
    global session_history
    clean = str(description or "").strip()
    if not clean or tokenizer is None or model is None:
        return ""
    sensory_prompt = f"Visual sensory input ({channel}): {clean}"
    inputs = tokenizer(f"User: {sensory_prompt}\nAssistant:", return_tensors="pt").to(device)
    model.eval()
    with torch.no_grad():
        outputs = model.generate(
            **inputs, max_new_tokens=min(150, TRAINING_GENERATION_MAX_CFG),
            pad_token_id=tokenizer.eos_token_id, do_sample=True, temperature=0.75,
        )
    response = tokenizer.decode(
        outputs[0][inputs["input_ids"].shape[1]:], skip_special_tokens=True
    ).strip()
    if response:
        stamp = time.strftime("%Y-%m-%dT%H:%M:%S")
        interaction_log = f"\n[{stamp}] User ({channel}): {clean}\nAssistant: {response}\n"
        session_history += interaction_log
        mark_wake_consolidation_if_needed()
        append_memory_file(
            CHAT_LOG, interaction_log, what="experimental visual interaction",
            why="journal.txt owns chronological sensory interactions",
        )
        update_gui_chat("VISION-IN", clean)
        update_gui_chat("VISION-OUT", response)
        publish_headset_output(response, source=channel)
        publish_vision_output(response, source=channel)
    return response


class VisionInputDaemon(threading.Thread):
    """Dual experimental image input: left TCP + right UDP on configurable port 6666."""
    def __init__(self, tcp_host, tcp_port, udp_host, udp_port):
        super().__init__(daemon=True)
        self.tcp_host, self.tcp_port = tcp_host, tcp_port
        self.udp_host, self.udp_port = udp_host, udp_port
        self.stop_event = threading.Event()
        self.tcp_socket = None
        self.udp_socket = None

    def stop(self):
        self.stop_event.set()
        for sock in (self.tcp_socket, self.udp_socket):
            try:
                if sock: sock.close()
            except Exception: pass

    def _handle_tcp(self, client):
        try:
            chunks=[]
            while True:
                piece=client.recv(65536)
                if not piece: break
                chunks.append(piece)
            description = _run_binary_to_text(
                VISION_IMAGE_TO_TEXT_LEFT_CMD_CFG, b"".join(chunks),
                channel="Left Image", suffix=".image",
            )
            response = _vision_infer_description(description, "Left Image TCP") if description else ""
            if response: client.sendall(response.encode("utf-8"))
        except Exception: pass
        finally:
            try: client.close()
            except Exception: pass

    def run(self):
        try:
            self.tcp_socket = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
            self.tcp_socket.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)
            self.tcp_socket.bind((self.tcp_host, self.tcp_port))
            self.tcp_socket.listen(4); self.tcp_socket.setblocking(False)
            self.udp_socket = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)
            self.udp_socket.bind((self.udp_host, self.udp_port)); self.udp_socket.setblocking(False)
            update_gui_chat("SYS", f"EXPERIMENTAL vision inputs UP: TCP {self.tcp_host}:{self.tcp_port} | UDP {self.udp_host}:{self.udp_port}")
            while not self.stop_event.is_set():
                try: ready,_,_=select.select([self.tcp_socket,self.udp_socket],[],[],0.5)
                except (OSError, ValueError): break
                for sock in ready:
                    if sock is self.tcp_socket:
                        try:
                            client,_=self.tcp_socket.accept()
                            threading.Thread(target=self._handle_tcp,args=(client,),daemon=True).start()
                        except OSError: pass
                    else:
                        try:
                            raw,_=self.udp_socket.recvfrom(65507)
                            desc=_run_binary_to_text(VISION_IMAGE_TO_TEXT_RIGHT_CMD_CFG,raw,channel="Right Image",suffix=".image")
                            if desc:
                                threading.Thread(target=_vision_infer_description,args=(desc,"Right Image UDP"),daemon=True).start()
                        except OSError: pass
        except Exception as exc:
            update_gui_chat("SYS", f"EXPERIMENTAL vision input daemon failed: {exc}")
        finally: self.stop()


class VisionOutputDaemon(threading.Thread):
    """Experimental TCP/UDP image output server on configurable port 5555."""
    def __init__(self, tcp_host, tcp_port, udp_host, udp_port):
        super().__init__(daemon=True)
        self.tcp_host,self.tcp_port=tcp_host,tcp_port
        self.udp_host,self.udp_port=udp_host,udp_port
        self.stop_event=threading.Event(); self.tcp_socket=None; self.udp_socket=None

    def stop(self):
        self.stop_event.set()
        for sock in (self.tcp_socket,self.udp_socket):
            try:
                if sock: sock.close()
            except Exception: pass

    def _serve_tcp(self, client):
        try:
            with VISION_OUTPUT_LOCK: payload=bytes(VISION_OUTPUT_STATE.get("tcp_image",b""))
            # 8-byte ASCII hex length header followed by image bytes.
            client.sendall(f"{len(payload):08x}".encode("ascii")+payload)
        except Exception: pass
        finally:
            try: client.close()
            except Exception: pass

    def run(self):
        try:
            self.tcp_socket=socket.socket(socket.AF_INET,socket.SOCK_STREAM)
            self.tcp_socket.setsockopt(socket.SOL_SOCKET,socket.SO_REUSEADDR,1)
            self.tcp_socket.bind((self.tcp_host,self.tcp_port)); self.tcp_socket.listen(4); self.tcp_socket.setblocking(False)
            self.udp_socket=socket.socket(socket.AF_INET,socket.SOCK_DGRAM)
            self.udp_socket.bind((self.udp_host,self.udp_port)); self.udp_socket.setblocking(False)
            update_gui_chat("SYS",f"EXPERIMENTAL image outputs UP: TCP {self.tcp_host}:{self.tcp_port} | UDP {self.udp_host}:{self.udp_port}")
            while not self.stop_event.is_set():
                try: ready,_,_=select.select([self.tcp_socket,self.udp_socket],[],[],0.5)
                except (OSError,ValueError): break
                for sock in ready:
                    if sock is self.tcp_socket:
                        try:
                            client,_=self.tcp_socket.accept()
                            threading.Thread(target=self._serve_tcp,args=(client,),daemon=True).start()
                        except OSError: pass
                    else:
                        try:
                            _,addr=self.udp_socket.recvfrom(1024)
                            with VISION_OUTPUT_LOCK: payload=bytes(VISION_OUTPUT_STATE.get("udp_image",b""))
                            # UDP cannot reliably carry arbitrarily large images. Send a compact
                            # status marker when external conversion exceeds one safe datagram.
                            if len(payload) <= 60000:
                                self.udp_socket.sendto(payload,addr)
                            else:
                                self.udp_socket.sendto(b"AITECH_IMAGE_TOO_LARGE_USE_TCP",addr)
                        except OSError: pass
        except Exception as exc:
            update_gui_chat("SYS",f"EXPERIMENTAL vision output daemon failed: {exc}")
        finally: self.stop()


class VideoTranscriptionHandler(BaseHTTPRequestHandler):
    def do_OPTIONS(self):
        self.send_response(200); self.send_header("Access-Control-Allow-Origin","*")
        self.send_header("Access-Control-Allow-Methods","POST, OPTIONS")
        self.send_header("Access-Control-Allow-Headers","Content-Type"); self.end_headers()

    def do_POST(self):
        if self.path not in ("/", "/transcribe", "/api/v1/transcribe"):
            self.send_response(404); self.end_headers(); return
        try:
            length=int(self.headers.get("Content-Length","0")); raw=self.rfile.read(length)
            transcript=_run_binary_to_text(VISION_VIDEO_TO_TEXT_HTTP_CMD_CFG,raw,channel="Video HTTP",suffix=".video")
            response=_vision_infer_description(transcript,"Video HTTP") if transcript else ""
            body=json.dumps({"experimental":True,"transcript":transcript,"response":response},ensure_ascii=False).encode("utf-8")
            self.send_response(200); self.send_header("Content-Type","application/json; charset=utf-8")
            self.send_header("Access-Control-Allow-Origin","*"); self.send_header("Content-Length",str(len(body)))
            self.end_headers(); self.wfile.write(body)
        except Exception as exc:
            body=json.dumps({"experimental":True,"error":str(exc)}).encode("utf-8")
            self.send_response(500); self.send_header("Content-Type","application/json")
            self.send_header("Content-Length",str(len(body))); self.end_headers(); self.wfile.write(body)
    def log_message(self, format, *args): pass


class VideoTranscriptionDaemon(threading.Thread):
    def __init__(self,host,port):
        super().__init__(daemon=True); self.host,self.port=host,port; self.server=None
    def stop(self):
        if self.server:
            try: self.server.shutdown()
            except Exception: pass
            try: self.server.server_close()
            except Exception: pass
    def run(self):
        try:
            self.server=HTTPServer((self.host,self.port),VideoTranscriptionHandler)
            update_gui_chat("SYS",f"EXPERIMENTAL video transcription UP: HTTP {self.host}:{self.port}/transcribe")
            self.server.serve_forever(poll_interval=0.5)
        except Exception as exc:
            update_gui_chat("SYS",f"EXPERIMENTAL video daemon failed: {exc}")
        finally:
            try:
                if self.server: self.server.server_close()
            except Exception: pass


