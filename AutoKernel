    private String readSharedState(String name)
    {
        File dir = resolveSharedStateDirectory();
        File file = new File(dir, name + ".state");
        if (!file.isFile()) {
            return "No state published yet: " + file.getAbsolutePath() + "\n";
        }
        try {
            return Files.readString(file.toPath());
        } catch (IOException e) {
            return "Unable to read " + file.getAbsolutePath() + "\n" + e.getMessage() + "\n";
        }
    }

    private File resolveSharedStateDirectory()
    {
        String env = System.getenv("GODDESS_HOME");
        if (env != null && !env.trim().isEmpty()) {
            File candidate = new File(env, "session.noq/shared");
            if (candidate.isDirectory()) return candidate;
        }

        if (state.aiHomeDirectory != null) {
            File candidate = new File(state.aiHomeDirectory, "session.noq/shared");
            if (candidate.isDirectory()) return candidate;
        }

        return new File(state.aiHomeDirectory != null ? state.aiHomeDirectory : new File("."),
                "session.noq/shared");
    }

    private boolean isApiAlive()
    {
        Process p = state.apiProcessMap.get(state.currentSession);
        return p != null && p.isAlive();
    }

    private boolean isSessionProcessAlive()
    {
        SessionProcess sp = state.processMap.get(state.currentSession);
        return sp != null && sp.isAlive();
    }

    private String currentModeName()
    {
        int mode = state.sessionModes.getOrDefault(state.currentSession, 0);
        switch (mode) {
            case 1: return "EXEC";
            case 2: return "AI";
            case 3: return "SCRIPT";
            case 4: return "CLOUD";
            default: return "CHAT";
        }
    }

    private String pathOf(File f)
    {
        return f == null ? "[not set]" : f.getAbsolutePath();
    }

    /**
     * Per-component tab painting avoids global UIManager changes, so other Swing
     * components keep their existing look and feel.
     */
    private class MatrixTabbedPaneUI extends BasicTabbedPaneUI
    {
        @Override
        protected void installDefaults()
        {
            super.installDefaults();
            tabAreaInsets = new Insets(3, 4, 0, 4);
            selectedTabPadInsets = new Insets(1, 2, 1, 2);
            contentBorderInsets = new Insets(1, 1, 1, 1);
        }

        @Override
        protected void paintTabBackground(Graphics g, int tabPlacement, int tabIndex,
                                          int x, int y, int w, int h, boolean isSelected)
        {
            if (isDormantUpdateTab(tabIndex)) {
                g.setColor(MatrixConfig.BG_DARK);
            } else {
                g.setColor(isSelected ? MatrixConfig.GODDESS_PURPLE : MatrixConfig.KEY_BG);
            }
            g.fillRect(x, y, w, h);
