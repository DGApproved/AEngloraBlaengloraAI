        for f in sorted(paths["comments"].glob("*.comments.txt")):
            try: comments.append(f"\n--- {f.name} ---\n"+f.read_text(encoding="utf-8",errors="ignore")[:3000])
            except OSError: pass
        return f"""<AItechProgrammerProject>
PROJECT={project}
LANGUAGE={lang}
HOST_OS={meta.get('host_os',sys.platform)}
HOST_ARCH={meta.get('host_arch',(os.uname().machine if hasattr(os,'uname') else 'unknown'))}
TOOLCHAIN={meta.get('asm_toolchain','language default')}
SESSION_STATUS={_oc_prog_session(project).get('status')}
SOURCE={paths['source']}
CONFIGURE={paths['configure']}
BUILD={paths['build']}
