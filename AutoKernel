def _training_relpath(path):
    rel = os.path.relpath(os.path.realpath(path), TRAINING_TERRITORY_ROOT)
    if rel == ".":
        return ""
    return os.path.normpath(rel)


def _training_path_excluded(path):
    """True only for the explicit exclusion itself or descendants of a directory."""
    rel = _training_relpath(path)
    if rel.startswith(".." + os.sep) or rel == "..":
        return True
    for raw in TRAINING_EXCLUDED_PATHS:
        excluded = os.path.normpath(raw)
        if rel == excluded or rel.startswith(excluded + os.sep):
            return True
    return False



