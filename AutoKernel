def _read_text_bounded(path, max_bytes=4_000_000):
    try:
        with open(path, "rb") as f:
            raw = f.read(max_bytes)
        return raw.decode("utf-8", errors="replace")
    except OSError:
        return ""


def _comment_blocks(lines):
    out=[]; block=[]; start=None; in_c_block=False
    def flush(end_line):
        nonlocal block,start
        if block:
            joined=" ".join(x.strip() for x in block if x.strip())
            joined=re.sub(r"\s+"," ",joined).strip()
            if joined: out.append((start or end_line,end_line,joined[:700]))
        block=[]; start=None
    for no,raw in enumerate(lines,1):
        s=raw.strip(); item=None
        if in_c_block:
            item=re.sub(r"^\*+\s?","",s)
            if "*/" in item:
                item=item.split("*/",1)[0]; in_c_block=False
        elif s.startswith("/*"):
            in_c_block=True; item=s[2:]
            if "*/" in item:
                item=item.split("*/",1)[0]; in_c_block=False
        elif s.startswith("//"): item=s[2:]
        elif s.startswith("#") and not s.startswith("#!"): item=s[1:]
        if item is not None:
            if start is None: start=no
            block.append(item)
        else: flush(no-1)
    flush(len(lines))
    return out


def build_autokernel_structure_graph():
    path=os.environ.get("AUTOKERNEL_PATH","")
    if not path or not os.path.isfile(path):
        return "<|system|> AutoKernel self-structure map unavailable at generation time. <|endoftext|>"
    body=_read_text_bounded(path,16_000_000); lines=body.splitlines()
    shell_funcs=[]; python_funcs=[]; classes=[]; menu_cases=[]; generated=[]
    for no,line in enumerate(lines,1):
        m=re.match(r"^\s*([A-Za-z_][A-Za-z0-9_]*)\s*\(\)\s*\{",line)
        if m: shell_funcs.append((no,m.group(1)))
        m=re.match(r"^\s*def\s+([A-Za-z_][A-Za-z0-9_]*)\s*\(",line)
        if m: python_funcs.append((no,m.group(1)))
        m=re.match(r"^\s*(?:public\s+|private\s+|protected\s+)?(?:static\s+)?class\s+([A-Za-z_][A-Za-z0-9_]*)",line)
        if m: classes.append((no,m.group(1)))
        m=re.match(r"^\s*(\d+)\)\s*$",line)
        if m: menu_cases.append((no,m.group(1)))
        if "GENERATE:" in line or "ak40_seed_file" in line: generated.append((no,line.strip()[:240]))
    comments=_comment_blocks(lines)
    out=[
        "<|system|> AutoKernel native self-structure map. Native AutoKernel code/comments are SELF material and may directly form self-understanding; explicitly embedded third-party material keeps its own provenance. <|endoftext|>",
        _qa("What is AutoKernel's role in the self seed?","It is the evolving architectural/generative seed secondary to the chosen model seed. Its complete source is scanned for structure and comments are read as context clues."),
        _qa("How do changes to AutoKernel affect future models?","They change structural maps, project relationships and capability examples available to newly generated models, including GUI, Game, AI, build, install, update and mapping behavior."),
        f"SOURCE={path}",f"LINE_COUNT={len(lines)}",f"COMMENT_BLOCK_COUNT={len(comments)}","SHELL_FUNCTIONS:"
    ]
    out += [f"  line={n} name={x}" for n,x in shell_funcs]
    out += ["PYTHON_FUNCTIONS:"]+[f"  line={n} name={x}" for n,x in python_funcs]
    out += ["CLASS_DECLARATIONS:"]+[f"  line={n} name={x}" for n,x in classes]
    out += ["NUMERIC_MENU_CASES:"]+[f"  line={n} option={x}" for n,x in menu_cases]
    out += ["GENERATED_SOURCE_MARKERS:"]+[f"  line={n} marker={x}" for n,x in generated]
    out += ["COMMENT_CONTEXT_CLUES:"]+[f"  lines={a}-{b} clue={c}" for a,b,c in comments]
    return "\n".join(out)


def _discover_goddessmatrix_root():
    candidates=[]
    if os.environ.get("GODDESS_MATRIX_ROOT"): candidates.append(os.environ["GODDESS_MATRIX_ROOT"])
