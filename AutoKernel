    fi
    download_with_check "https://www.kernel.org/pub/linux/kernel/v6.x/linux-$VeRSioN.tar.xz" "linux-$VeRSioN.tar.xz"
    download_with_check "https://www.kernel.org/pub/linux/kernel/v6.x/linux-$VeRSioN.tar.sign" "linux-$VeRSioN.tar.sign"
    download_with_check "https://www.kernel.org/pub/linux/kernel/v6.x/patch-$VeRSioN.xz" "patch-$VeRSioN.xz"
}

step_2_unzip() {
    if [ -z "$VeRSioN" ]; then
        echo -n "Enter kernel version first: "
        read -r VeRSioN
    fi
    echo "Uncompressing..."
    unxz -v -k "linux-$VeRSioN.tar.xz"
    echo "Unarchiving..."
    tar xvf "linux-$VeRSioN.tar"
}

step_3_verify() {
    if [ -z "$VeRSioN" ]; then
        echo -n "type the kernel version desired ex: 6.7.9: "
        read -r VeRSioN
    fi
    echo "Checking Signature.xz:"
    gpg --verify "linux-$VeRSioN.tar.xz"
    echo "Paste or Type the Signature Key ID below and press enter:"
    read -r SiGNaTuRe
    echo "Checking Signature.sign:"
    gpg --verify "linux-$VeRSioN.tar.sign" "linux-$VeRSioN.tar"
    gpg --recv-keys "$SiGNaTuRe"
    gpg --verify "linux-$VeRSioN.tar.sign" 
}

step_4_patch() {
    if [ -z "$VeRSioN" ]; then
        echo -n "Enter Kernel Version to be Used: "
        read -r VeRSioN
    fi
    cd "linux-$VeRSioN" || exit
    echo "(0) Auto batch mode or (1) Test and sequence mode?"
    read -r typez
    if [ "$typez" = "0" ]; then
        if xzcat ../patch-$VeRSioN.xz | patch -p1 --dry-run --silent > Kernel/$VeRSioN-patch.test 2>&1; then
            echo "Dry run successfully attempted. Applying patch normally..."
            xzcat ../patch-$VeRSioN.xz | patch -p1
        else
            echo "Applying patch safely using batch mode..."
            xzcat ../patch-$VeRSioN.xz | patch -p1 --batch
        fi
    else
        echo "Testing patch files..."
        mv Kernel/$VeRSioN-patch.test Kernel/$VeRSioN-patch-old.test 2>/dev/null
        xzcat ../patch-$VeRSioN.xz > Kernel/temp_extracted.patch
        grep "^\+\+\+" Kernel/temp_extracted.patch | while read -r line; do
            filepath=$(echo "$line" | awk '{print $2}' | sed 's|^[ab]/||')
            if [ -n "$filepath" ]; then
                if patch -p1 --dry-run --silent --forward --fuzz=0 -p1 < Kernel/temp_extracted.patch >/dev/null 2>&1; then
                    echo "$filepath: y" >> Kernel/$VeRSioN-patch.test
                else
                    if patch -p1 --dry-run --silent --reverse --fuzz=0 -p1 < Kernel/temp_extracted.patch > /dev/null 2>&1; then
                        echo "$filepath: R" >> Kernel/$VeRSioN-patch.test
                    else
                        echo "$filepath: n" >> Kernel/$VeRSioN-patch.test
                    fi
                fi
            fi
        done
        cat Kernel/$VeRSioN-patch.test
        while IFS=': ' read -r file decision; do
            if [ "$decision" = "y" ]; then
                patch -p1 --forward < Kernel/temp_extracted.patch
            elif [ "$decision" = "R" ]; then
                patch -p1 --reverse --batch < Kernel/temp_extracted.patch
            fi
        done < Kernel/$VeRSioN-patch.test
        mv Kernel/temp_extracted.patch Kernel/temp_extracted-used.patch
    fi
    cd .. || exit
}

step_5_certs() {
    if [ -z "$VeRSioN" ]; then
        echo -n "Type the kernel version desired ex: 6.7.9: "
        read -r VeRSioN
    fi
    cd linux-$VeRSioN 2>/dev/null || cd Kernel/linux-$VeRSioN || exit
    echo "Do you have the path to your system's linux source certificates? (y/n)"
    read -r has_certs
    if [[ "$has_certs" == "y" || "$has_certs" == "Y" ]]; then
        apt install linux-source -y
        echo -n "Enter path to linux source certificates (ex: /usr/src/linux-source-$VeRSioN/debian/*):"
        echo -n "${DEV_KERNEL}/certificates/debian/): "
        read -r CeRTiFiCaTeS
        rsync -axHAX "$CeRTiFiCaTeS" debian
        mkdir -p ../certificates
        rsync -axHAX "$CeRTiFiCaTeS" ../certificates/debian
        mv debian debian-old
        mv debian-old/debian debian
        rm -r debian-old
    else
        echo "No certificates provided. Disabling trusted key requirements in kernel config..."
        scripts/config --disable SYSTEM_TRUSTED_KEYS
        scripts/config --disable SYSTEM_REVOCATION_KEYS
    fi
    cd .. || exit
}

