    def _oc_prog_generation_context(project,request):
        project=_oc_prog_safe(project); meta=_oc_prog_meta(project); lang=str(meta.get("language","")).lower()
        layout=_oc_prog_prefs().get(lang,{})
        paths=_oc_prog_paths(project)
