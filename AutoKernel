    private void buildUpdateSurface()
    {
        if (updateView != null && updatePane != null) return;

        updateView = new JTextArea();
        updateView.setEditable(false);
        updateView.setLineWrap(true);
        updateView.setWrapStyleWord(true);
        updateView.setBackground(Color.BLACK);
        updateView.setForeground(MatrixConfig.TEXT_COLOR);
        updateView.setCaretColor(MatrixConfig.GODDESS_GOLD);
        updateView.setFont(new Font("Monospaced", Font.PLAIN,
                Math.max(10, (int)(13 * currentScale))));
        updateView.setMargin(new Insets(8, 10, 8, 10));

        updatePane = new JScrollPane(updateView);
        updatePane.setBorder(new LineBorder(new Color(
                MatrixConfig.GODDESS_PURPLE.getRed(),
                MatrixConfig.GODDESS_PURPLE.getGreen(),
                MatrixConfig.GODDESS_PURPLE.getBlue(), 70), 1));
        updatePane.getViewport().setBackground(Color.BLACK);
        updatePane.getVerticalScrollBar().setUnitIncrement(14);
    }

    /**
     * Called by a left-click of [Update]. The tab already exists; this only
     * reveals its paint, selects it, and returns keyboard focus to the shared
     * typing buffer. modular.Update remains responsible for update-mode routing.
     */
    public void showUpdateTab()
    {
        if (!SwingUtilities.isEventDispatchThread()) {
            SwingUtilities.invokeLater(this::showUpdateTab);
            return;
        }
        if (historyTabs == null) return;

        buildUpdateSurface();
        updateTabRevealed = true;

        if (historyTabs.indexOfComponent(updatePane) >= 0) {
            historyTabs.setSelectedComponent(updatePane);
        }

        updateTabColors();
        historyTabs.revalidate();
        historyTabs.repaint();
        if (typingBuffer != null) typingBuffer.requestFocusInWindow();
    }

    /**
     * Hides UPDATE cosmetically but does not remove it from the tab registry.
     * Returning to CHAT preserves the historical close behavior while avoiding
     * the insert/remove race that previously competed with the 12-tab system.
     */
    public void hideUpdateTab()
    {
        if (!SwingUtilities.isEventDispatchThread()) {
            SwingUtilities.invokeLater(this::hideUpdateTab);
            return;
        }

        updateTabRevealed = false;
        if (historyTabs != null && historyTabs.getTabCount() > 0) {
            historyTabs.setSelectedIndex(0);
            updateTabColors();
            historyTabs.revalidate();
            historyTabs.repaint();
        }
        if (typingBuffer != null) typingBuffer.requestFocusInWindow();
    }

    public void clearUpdateView()
    {
        if (!SwingUtilities.isEventDispatchThread()) {
            SwingUtilities.invokeLater(this::clearUpdateView);
            return;
        }
        if (updateView != null) updateView.setText("");
    }

    public void appendUpdate(String text)
    {
        if (text == null) return;
        if (!SwingUtilities.isEventDispatchThread()) {
            SwingUtilities.invokeLater(() -> appendUpdate(text));
            return;
        }
        buildUpdateSurface();
        updateView.append(text);
        if (!text.endsWith("\n")) updateView.append("\n");
        updateView.setCaretPosition(updateView.getDocument().getLength());
    }

