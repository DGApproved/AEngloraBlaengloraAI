    def _oc_prog_resolve_source(project,filename):
        project=_oc_prog_safe(project); filename=str(filename or "").strip().strip("<>")
        if not filename: return None,None,"Filename is required."
        if Path(filename).is_absolute() or ".." in Path(filename).parts: return None,None,"Unsafe filename/path."
        matches=[]
        for stage in ("source","build"):
            root=_oc_prog_paths(project)[stage]
            target=(root/filename).resolve()
            try:
                root_resolved=root.resolve()
                if (target==root_resolved or root_resolved in target.parents) and target.is_file():
                    matches.append((stage,target))
            except Exception: pass
        if len(matches)==1: return matches[0][0],matches[0][1],None
        if len(matches)>1: return None,None,f"Filename {filename} is ambiguous across editable stages."
        return None,None,f"Project file not found: {filename}"

    def _oc_prog_names(filename):
        name=Path(str(filename or "").strip().strip("<>")).name
        return name,(Path(name).stem or name)

    def _oc_prog_compile_script(project,filename):
        _,stem=_oc_prog_names(filename)
        return _oc_prog_paths(project)["configure"]/(stem+".compile.sh")

    def _oc_prog_object(project,filename):
        _,stem=_oc_prog_names(filename); lang=str(_oc_prog_meta(project).get("language","")).lower()
        if lang=="java": return _oc_prog_paths(project)["source"]/(stem+".class")
        return _oc_prog_paths(project)["build"]/(stem+".o")

    def _oc_prog_binary(project,filename):
        name,stem=_oc_prog_names(filename); lang=str(_oc_prog_meta(project).get("language","")).lower()
        if lang=="java": return _oc_prog_paths(project)["program"]/(stem+".jar")
        if lang in ("bash","python"): return _oc_prog_paths(project)["program"]/name
        return _oc_prog_paths(project)["program"]/stem

    def _oc_prog_configure_file(project,filename):
        project=_oc_prog_safe(project)
        if not _oc_prog_open(project): return False,f"Project {project} is not running. Use prog resume {project}."
        stage,source,error=_oc_prog_resolve_source(project,filename)
        if error: return False,error
        meta=_oc_prog_meta(project); lang=str(meta.get("language","")).lower()
        obj=_oc_prog_object(project,filename); script=_oc_prog_compile_script(project,filename)
        if lang=="asm":
            host_os=str(meta.get("host_os",sys.platform)).lower(); host_arch=str(meta.get("host_arch","")).lower()
            if host_os=="darwin" and host_arch in ("arm64","aarch64"):
                command=f'clang -arch arm64 -c "{source}" -o "{obj}"'
            elif host_os=="darwin":
                command=f'nasm -f macho64 "{source}" -o "{obj}"'
            else:
                command=f'nasm -f elf64 "{source}" -o "{obj}"'
        elif lang=="c":
            command=f'cc -c "{source}" -o "{obj}"'
        elif lang=="java":
            command=f'javac -d "{_oc_prog_paths(project)["source"]}" "{source}"'
        elif lang in ("bash","python"):
            return False,f"{lang} is directly runnable and does not compile to an object file."
        else:
            return False,f"No deterministic compiler rule for language [{lang}]."
        content=(
            "#!/usr/bin/env bash\nset -e\n"
            f"# AItech v0.1.42 compile stage | project={project} | language={lang} | input={source.name}\n"
            f'mkdir -p "{_oc_prog_paths(project)["build"]}" "{_oc_prog_paths(project)["source"]}"\n'
            +command+"\n"+f'echo "{obj}"\n'
        )
        script.parent.mkdir(parents=True,exist_ok=True); script.write_text(content,encoding="utf-8")
        try: script.chmod(0o755)
        except OSError: pass
        _oc_prog_session_update(project,last_operation=f"configure {filename}",last_error="",progress=100,progress_label="CONFIGURE COMPLETE")
        _oc_prog_gui(project,100,"CONFIGURE COMPLETE",output=f"Generated compile script:\n{script.relative_to(CODE_ROOT)}\n{command}")
        return True,str(script.relative_to(CODE_ROOT))

    def _oc_prog_compile_file(project,filename):
        project=_oc_prog_safe(project); script=_oc_prog_compile_script(project,filename)
        if not script.is_file(): return False,f"No compile script for {filename}. Run configure<{filename}> first."
        _oc_prog_gui(project,10,"COMPILE START",output=f"$ {script}")
        try:
            result=subprocess.run([str(script)],cwd=str(script.parent),stdout=subprocess.PIPE,stderr=subprocess.PIPE,text=True,timeout=1800)
            output=((result.stdout or "")+("\n"+result.stderr if result.stderr else "")).strip() or f"exit={result.returncode}"
            if result.returncode!=0:
                _oc_prog_session_update(project,last_operation=f"compile {filename}",last_error=output,progress=100,progress_label="COMPILE FAILED")
                _oc_prog_gui(project,100,"COMPILE FAILED",output=output,error=output); return False,output
            _oc_prog_session_update(project,last_operation=f"compile {filename}",last_error="",progress=100,progress_label="COMPILE COMPLETE")
            _oc_prog_gui(project,100,"COMPILE COMPLETE",output=output); return True,output
        except Exception as exc:
            msg=str(exc); _oc_prog_gui(project,0,"COMPILE ERROR",output=msg,error=msg); return False,msg

    def _oc_prog_build_file(project,filename):
        project=_oc_prog_safe(project)
        if not _oc_prog_open(project): return False,f"Project {project} is not running. Use prog resume {project}."
        meta=_oc_prog_meta(project); lang=str(meta.get("language","")).lower(); obj=_oc_prog_object(project,filename); binary=_oc_prog_binary(project,filename)
        if lang=="java":
            class_dir=_oc_prog_paths(project)["source"]; classes=list(class_dir.glob("*.class"))
            if not classes: return False,f"No compiled .class files found. Run compile<{filename}> first."
            manifest=_oc_prog_paths(project)["configure"]/"MANIFEST.MF"; main_class=Path(filename).stem
            manifest.write_text(f"Main-Class: {main_class}\n",encoding="utf-8")
            cmd=["jar","cfm",str(binary),str(manifest),"-C",str(class_dir),"."]
        else:
            if not obj.is_file(): return False,f"Object file not found: {obj.relative_to(CODE_ROOT)}. Run compile<{filename}> first."
