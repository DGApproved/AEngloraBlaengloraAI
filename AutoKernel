apply_update_provenance() {
    local staged="$1" instruction="$2" out rc
    out="$(py - "$staged" "$instruction" <<'PYPROVENANCE'
import re,sys
from pathlib import Path
sp,dp=map(Path,sys.argv[1:])
s=sp.read_text(encoding='utf-8',errors='replace')
d=dp.read_text(encoding='utf-8',errors='replace')
mm=re.search(r'(?ms)^\[AITECH_UPDATE\]\s*(.*?)(?=^\[[A-Z_]+\]|\Z)',d)
cm=re.search(r'(?ms)^\[CHANGELOG\]\s*(.*?)^\[/CHANGELOG\]\s*$',d)
if not mm and not cm: raise SystemExit(0)
meta={}
if mm:
    for line in mm.group(1).splitlines():
        line=line.strip()
        if line and not line.startswith('#') and '=' in line:
            k,val=line.split('=',1);meta[k.strip().upper()]=val.strip()
v=meta.get('VERSION','');dev=meta.get('DEVNAME','');date=meta.get('DATE','');PREFERRED=32

def semantic_wrap(text):
    text=' '.join(text.strip().split())
    if not text:return []
    if len(text)<=PREFERRED+12 and text.endswith(('.','!','?')):return [text]
    words=text.split();lines=[];current=[]
    for word in words:
        candidate=' '.join(current+[word])
        if not current or len(candidate)<=PREFERRED:current.append(word)
        elif word.endswith(('.','!','?')) and len(candidate)<=PREFERRED+16:
            current.append(word);lines.append(' '.join(current));current=[]
        else:
            lines.append(' '.join(current));current=[word]
    if current:lines.append(' '.join(current))
    return lines

if v:
    s=re.sub(r'(?m)^# Current revision: .*$',f'# Current revision: {v}',s,count=1)
    s=re.sub(r'(?m)^AITECH_VERSION="[^"]*"$',f'AITECH_VERSION="{v}"',s,count=1)
    last=v.lstrip('v').split('.')[-1]
    if last.isdigit():s=re.sub(r'(?m)^AITECH_REVISION="[^"]*"$',f'AITECH_REVISION="{last}"',s,count=1)
if dev:
    s=re.sub(r'(?m)^# Development origin: .*$',f'# Development origin: {dev}',s,count=1)
    s=re.sub(r'(?m)^AITECH_DEVNAME="[^"]*"$',f'AITECH_DEVNAME="{dev}"',s,count=1)
if v and dev:
    fn=f'AItech(v.{v.lstrip("v")})-{dev}.sh'
    s=re.sub(r'(?m)^# Canonical revision filename: .*$',f'# Canonical revision filename: {fn}',s,count=1)
    s=re.sub(r'(?m)^AITECH_REVISION_FILENAME="[^"]*"$',f'AITECH_REVISION_FILENAME="{fn}"',s,count=1)

if cm:
    changes=[]
    for raw in cm.group(1).splitlines():
        item=raw.strip()
        if not item:continue
        if item.startswith(('- ','* ')):item=item[2:].strip()
        changes.append(item)
    if changes:
        label=v or 'UNVERSIONED'
        if dev:label+='-'+dev
        rendered=[];first=True
        for change in changes:
            for part in (semantic_wrap(change) or ['']):
                if first:
                    rendered.append(f'# {label}  {part}');first=False
                else:
                    rendered.append(f'#          {part}')
        if date:rendered.append(f'#          Date: {date}')
        # MERGED INSERTION POINT. The feature-index marker is the preferred
        # target and stays first: an entry placed there lands at the top of the
        # chronological index, in the house style, which is what this revision's
        # rewrite was for and it is kept. What was lost with it was the ability
        # to write provenance into a source that has no marker -- an older
        # revision, a fork, a component -- where the pass raised SystemExit and
        # took the whole staged transaction down with it, reporting a missing
        # marker rather than the change the user asked for. The pre-marker
        # behaviour is restored as the fallback: insert after the leading header
        # comment block, which every script has. Preferred first, never fatal.
        marker='# CHANGELOG / CURRENT FEATURE INDEX'
        pos=s.find(marker)
        end=s.find('\n',pos) if pos>=0 else -1
        if pos>=0 and end>=0:
            s=s[:end+1]+'\n'.join(rendered)+'\n'+s[end+1:]
        else:
            lines=s.splitlines(True);i=1 if lines and lines[0].startswith('#!') else 0
            while i<len(lines) and (lines[i].lstrip().startswith('#') or not lines[i].strip()):i+=1
            lines.insert(i,'#\n'+'\n'.join(rendered)+'\n#\n');s=''.join(lines)
            sys.stderr.write('[i] No feature-index marker; provenance written after the header block.\n')
sp.write_text(s,encoding='utf-8')
PYPROVENANCE
)" || {
        rc=$?
        abort_diag "$instruction" "ALL" "$staged" "HEADER" "Developer provenance metadata could not be applied (parser exit $rc)."
        [[ -n "$out" ]] && printf '%s\n' "$out" >&2
        return 1
    }
}

apply_components_and_patch() {
    local explicit="${1:-}" origin="${2:-local}" work archive f changed=0 src
    work="${AITECH_SCRIPT}.exupdate.$$.$RANDOM.tmp";cp "$AITECH_SCRIPT" "$work" || { abort_diag "$AITECH_SCRIPT" "ALL" "$work" "N/A" "Could not create transaction working copy.";return 1; }
    local -a consumed=()
    if [[ -n "$explicit" ]]; then
        src="$explicit"
        case "$(basename "$src")" in
            update.sh|update.txt) apply_directives "$src" "$work"|| { rm -f "$work";return 1;};apply_update_provenance "$work" "$src"|| { rm -f "$work";return 1;};consumed+=("$src");changed=1;;   # unscoped
            datamod.txt) apply_scoped data "$src" "$work"|| { rm -f "$work";return 1;};apply_update_provenance "$work" "$src"|| { rm -f "$work";return 1;};consumed+=("$src");changed=1;;          # component-scoped
            envmod.txt)  apply_scoped env  "$src" "$work"|| { rm -f "$work";return 1;};apply_update_provenance "$work" "$src"|| { rm -f "$work";return 1;};consumed+=("$src");changed=1;;          # environment-scoped
            AItech*.sh) rm -f "$work";abort_diag "$src" "$(file_lines "$src")" "$AITECH_SCRIPT" "ALL" "Complete AItech version supplied to component merge. Select/install it as a complete version instead.";return 1;;
            *) replace_cat_body "$src" "$work"|| { rm -f "$work";return 1;};consumed+=("$src");changed=1;;
        esac
    else
        while IFS= read -r f;do [[ -n "$f" ]]||continue;replace_cat_body "$f" "$work"|| { rm -f "$work";return 1;};consumed+=("$f");changed=1;done < <(scan_components)
        while IFS= read -r f;do [[ -n "$f" ]]||continue;apply_scoped data "$f" "$work"|| { rm -f "$work";return 1;};apply_update_provenance "$work" "$f"|| { rm -f "$work";return 1;};consumed+=("$f");changed=1;done < <(scan_datamods)      # scoped first: narrowest reach
        while IFS= read -r f;do [[ -n "$f" ]]||continue;apply_scoped env  "$f" "$work"|| { rm -f "$work";return 1;};apply_update_provenance "$work" "$f"|| { rm -f "$work";return 1;};consumed+=("$f");changed=1;done < <(scan_envmods)
        while IFS= read -r f;do [[ -n "$f" ]]||continue;apply_directives "$f" "$work"|| { rm -f "$work";return 1;};apply_update_provenance "$work" "$f"|| { rm -f "$work";return 1;};consumed+=("$f");changed=1;done < <(scan_update_scripts)   # unscoped last
    fi
    if ((!changed));then echo "[=] Nothing to update.";rm -f "$work";return 0;fi
    validate_script "$work" "${explicit:-update inbox}"|| { rm -f "$work";return 1; }
    archive="$(archive_current "component/update.sh merge from $origin")" || { rm -f "$work";abort_diag "${explicit:-update inbox}" "ALL" "$ARCHIVE_DIR" "N/A" "Could not archive the pre-change AItech source. Update refused.";return 1; }
    atomic_install "$work"||return 1
    echo "[✓] AItech updated atomically.";echo "[✓] Previous version archived: $archive"
    post_apply_diff "$archive" "component/update.sh merge"
    for f in "${consumed[@]}";do consume_file "$f" "$origin"||return 1;done
    if [[ -z "$explicit" ]]; then consume_changelog_if_present "$origin" || return 1; fi
}
install_full_version() {
    local src="$1" origin="${2:-local}" work archive
    if [[ ! -f "$src" ]]; then
        abort_diag "$src" "N/A" "$AITECH_SCRIPT" "ALL" "Selected complete version file is missing."
        return 1
    fi
    work="${AITECH_SCRIPT}.exupdate.$$.$RANDOM.tmp"
    if ! cp "$src" "$work"; then
        abort_diag "$src" "ALL" "$work" "N/A" "Could not stage selected version."
        return 1
    fi
    validate_script "$work" "$src" || { rm -f "$work"; return 1; }
    archive="$(archive_current "full-version replacement from $origin: $(basename "$src")")" || {
        rm -f "$work"
        abort_diag "$src" "ALL" "$ARCHIVE_DIR" "N/A" "Could not archive current AItech before replacement."
        return 1
    }
    atomic_install "$work" || return 1
    echo "[✓] Installed $(version_from_file "$AITECH_SCRIPT") from $(basename "$src")"
    echo "[✓] Previous version archived: $archive"
    post_apply_diff "$archive" "complete-version install"
