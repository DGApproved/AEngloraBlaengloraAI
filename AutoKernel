def _scan_knowledge_models(models_root=os.path.join(NOQ_DIR, "models")):
    """
    Scan the same checkpoint library as the Llama selector and label whether each
    checkpoint can be loaded by GPT2LMHeadModel.
    """
    found = []
    if not os.path.isdir(models_root):
        return found
    for entry in sorted(os.listdir(models_root)):
        full = os.path.join(models_root, entry)
        cfg_path = os.path.join(full, "config.json")
        if not os.path.isdir(full) or not os.path.isfile(cfg_path):
            continue
        info = {
            "path": full, "name": entry, "size_label": "?",
            "hidden_size": "?", "num_layers": "?",
            "compatibility": "UNKNOWN", "compat_reason": "config unreadable",
        }
        try:
            with open(cfg_path, "r", encoding="utf-8") as f:
                cfg = json.load(f)
            model_type = str(cfg.get("model_type", "") or "").lower()
            architectures = [str(x) for x in cfg.get("architectures", [])]
            compatible = model_type == "gpt2" or "GPT2LMHeadModel" in architectures
            info["compatibility"] = "COMPATIBLE" if compatible else "INCOMPATIBLE"
            info["compat_reason"] = (
                "GPT2LMHeadModel"
                if compatible
                else (model_type or (architectures[0] if architectures else "unknown architecture"))
            )
            h = int(cfg.get("n_embd", cfg.get("hidden_size", 0)) or 0)
            l = int(cfg.get("n_layer", cfg.get("num_hidden_layers", 0)) or 0)
            v = int(cfg.get("vocab_size", 50257) or 50257)
            info["hidden_size"] = h or "?"
            info["num_layers"] = l or "?"
            if h and l:
                # Approximate GPT-2 parameter count for selector display only.
                params = v*h + l*(12*h*h + 13*h) + v*h
                if params < 8_000_000:
                    info["size_label"] = f"{params/1e6:.1f}M"
                elif params < 1_000_000_000:
                    info["size_label"] = f"{params/1e6:.0f}M"
                else:
                    info["size_label"] = f"{params/1e9:.1f}B"
        except Exception as exc:
            info["compat_reason"] = type(exc).__name__
        found.append(info)
    return found


