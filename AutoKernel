def _read_gguf_meta(gguf_path):
    """
    Extract architecture and quantisation type from a GGUF file header
    without loading the full model. Returns a dict of metadata.
    """
    meta = {"arch": "unknown", "quant": "unknown", "params": "?", "context": "?"}
    if not GGUF_AVAILABLE:
        return meta
    try:
        reader = gguf.GGUFReader(gguf_path)
        for field in reader.fields.values():
            k = field.name
            if "architecture" in k:
                meta["arch"] = str(bytes(field.parts[-1]).decode("utf-8", errors="ignore")).strip("\x00")
            elif "file_type" in k:
                ft = int.from_bytes(bytes(field.parts[-1]), "little")
                meta["quant"] = {1:"f16", 2:"q4_0", 7:"q8_0", 15:"q4_k_m",
                                  17:"q5_k_m", 18:"q6_k"}.get(ft, f"type{ft}")
            elif "context_length" in k or "n_ctx_train" in k:
                meta["context"] = str(int.from_bytes(bytes(field.parts[-1]), "little"))
            elif "parameter_count" in k:
                raw = int.from_bytes(bytes(field.parts[-1]), "little")
                if raw > 1_000_000:
                    meta["params"] = f"{raw/1_000_000:.1f}M"
    except Exception:
        pass
    return meta

def _read_hf_meta(hf_dir):
    """Read architecture and parameter count from a HF config.json."""
    meta = {"arch": "unknown", "params": "?", "context": "?"}
    cfg_path = Path(hf_dir) / "config.json"
    try:
        with open(cfg_path, encoding="utf-8") as f:
            cfg = json.load(f)
        meta["arch"] = cfg.get("architectures", ["unknown"])[0] \
                          if "architectures" in cfg else cfg.get("model_type", "unknown")
        # Rough param count from config dimensions
        h  = cfg.get("hidden_size", cfg.get("n_embd", 0))
        L  = cfg.get("num_hidden_layers", cfg.get("n_layer", 0))
        V  = cfg.get("vocab_size", 0)
        if h and L:
            approx = (12 * h * h * L + V * h) / 1_000_000
            meta["params"] = f"~{approx:.0f}M"
        meta["context"] = str(cfg.get("max_position_embeddings",
                               cfg.get("n_positions", "?")))
    except Exception:
        pass
    return meta

