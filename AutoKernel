        "qwen_display_name": identity.get("display_name"),
        "qwen_revision": identity.get("revision"),
        "remote": remote,
        "response_sha256": hashlib.sha256(str(response_text).encode("utf-8", errors="ignore")).hexdigest(),
        "unrecognized_character_map": encoding,
    }
    _LAST_QWEN_PROVENANCE = event
    _append_jsonl(QWEN_EVENTS_PATH, event)
