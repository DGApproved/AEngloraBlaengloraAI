        generated_files = []

    # --- THE MARKDOWN SAFETY NET ---
        if not files_to_write and not commands_to_run:
            markdown_blocks = re.findall(r'```(python|bash|sh|c|cpp|yaml|json|txt|text|md|markdown|html|js|css)\n(.*?)\n```', output_text, re.DOTALL | re.IGNORECASE)
