def is_hex_dump(text):
    """Detect Goddess Matrix offset/hex/ASCII training-data dump files."""
    return text.lstrip().startswith("# Goddess Matrix Training Data")

def decode_hex_dump(text):
    """
    Decode the Goddess Matrix hex dump format back into readable text.
    Format: offset  hex-bytes  |ascii|
    Falls back to the original text if the structure is not a valid dump.
    """
    hex_bytes = []
    for line in text.splitlines():
        if line.startswith("#") or not line.strip():
            continue
        parts = line.split("  ")
        if len(parts) >= 2:
            hex_part = parts[1].split("|")[0].strip()
            for byte_str in hex_part.split():
                try:
                    hex_bytes.append(int(byte_str, 16))
                except ValueError:
                    continue
    if not hex_bytes:
        return text
    try:
        return bytes(hex_bytes).decode("utf-8", errors="ignore")
    except Exception:
        return text

