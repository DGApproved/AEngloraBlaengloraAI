            pb.directory(scriptDir);
            pb.start();

            setStatus("SYS_SCRIPT: LAUNCHED");

        } catch (Exception e) {
            setStatus("SYS_SCRIPT: FAIL");
        }
    }

    // ─────────────────────────────────────────────
    // STATUS HELPER
    // ─────────────────────────────────────────────
    private void setStatus(String msg) {
        if (state.statusLabel != null) {
            state.statusLabel.setText(msg);
        }
    }
