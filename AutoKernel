        if (world.voidImagesDirty && world.voidImagesDir != null)
        {
            loadVoidImages(world.voidImagesDir);
            world.voidImagesDirty = false;
        }

        // Advance aurora phase
        for (int i = 0; i < auroraPhase.length; i++) auroraPhase[i] += 0.015f;

