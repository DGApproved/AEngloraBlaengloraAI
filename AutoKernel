def iter_training_territory():
    """Yield (kind, absolute_path, relative_path) for every eligible boundary/item."""
    root = TRAINING_TERRITORY_ROOT
    if not os.path.isdir(root):
        return
    for current, dirnames, filenames in os.walk(root, topdown=True, followlinks=False):
        # Never traverse an excluded directory. Sorting makes snapshots stable.
        kept = []
        for dirname in sorted(dirnames):
            full = os.path.join(current, dirname)
            if not _training_path_excluded(full):
                kept.append(dirname)
        dirnames[:] = kept

        if os.path.realpath(current) != root and not _training_path_excluded(current):
            yield "folder", current, _training_relpath(current)

        for filename in sorted(filenames):
            full = os.path.join(current, filename)
            if not _training_path_excluded(full):
                yield "file", full, _training_relpath(full)


def generate_folder_boundary_record(path, relpath):
    """Represent directory structure even when no special folder meaning is mapped."""
    parent = os.path.dirname(relpath) or "."
    name = os.path.basename(relpath)
    suffix = Path(name).suffix.lower() or "<none>"
    return (
        "User: Interpret this training-territory folder boundary.\n"
        f"Assistant: [FOLDER_BOUNDARY] path=session.noq/{relpath} name={name} "
        f"suffix={suffix} parent=session.noq/{parent}. This establishes a structural "
        "boundary. Specialized meaning is defined only when map data supplies it."
    )


def generate_opaque_file_record(path, relpath):
    """Cover unsupported/binary objects structurally without pretending to decode them."""
    try:
        size = os.path.getsize(path)
        with open(path, "rb") as f:
            prefix = f.read(32).hex()
    except OSError as exc:
        size = -1
        prefix = f"unreadable:{type(exc).__name__}"
    suffix = Path(relpath).suffix.lower() or "<none>"
    parent = os.path.dirname(relpath) or "."
    return (
        "User: Interpret this training-territory file structurally.\n"
        f"Assistant: [FILE_OBJECT] path=session.noq/{relpath} extension={suffix} "
        f"bytes={size} parent=session.noq/{parent} prefix_hex={prefix}. "
        "The object is covered by the training map, but no unsupported binary "
        "decoder or specialized semantic meaning is invented from its extension alone."
    )

