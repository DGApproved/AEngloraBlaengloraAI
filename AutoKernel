                            f"{fname}: state={source_policy.get('source_state')} mode={source_policy.get('mode')} "
                            f"evidence={source_policy.get('evidence_class')}",
                            {"source_id": source_record.get("source_id")}
                        )
                    except Exception:
                        pass
                    shutil.move(fpath, dest)
                    append_memory_file(
                        DEFINITIONS_TXT,
                        f"\n[TRIAGE_RECORD]\ntimestamp: {stamp}\n"
                        f"source_file: {fname}\nstatus: MOVED_TO_PROCESSED\n[/TRIAGE_RECORD]\n",
                        what="triage provenance", why="definitions.txt is DEFINITIONS_RAW"
                    )
                except Exception:
                    pass

    # ── PLUGIN EXECUTION ─────────────────────────────────────────────────────
    TOOLS_DIR_CHAT       = os.path.join(NOQ_DIR, "data", "plugins", "tools")
    Instruments_DIR_CHAT = os.path.join(NOQ_DIR, "data", "plugins", "Instruments")
    # MERGED: the third plugin folder. The base engine gained self-tools in
    # v0.1.59 and this engine did not, so a tool the model could reach from one
    # side of the library was invisible from the other. All three folders hold
    # the same kind of thing -- a .code executable with an .xtx sidecar -- and
    # differ only in who the tool is for, so all three belong on the search path.
    SELF_TOOLS_DIR_CHAT  = os.path.join(NOQ_DIR, "data", "plugins", "self-tools")

    def execute_plugin(plugin_name, args="", timeout=30):
        target = f"{plugin_name}.code"
        for d in [TOOLS_DIR_CHAT, Instruments_DIR_CHAT, SELF_TOOLS_DIR_CHAT]:
            path = os.path.join(d, target)
            if os.path.exists(path):
                try:
                    os.chmod(path, 0o755)
                    cmd = [path] + (args.split() if args else [])
                    result = subprocess.run(cmd, capture_output=True, text=True, timeout=timeout)
                    return result.stdout.strip() or "[Executed with no output]"
                except Exception as e:
                    return f"[Plugin error: {e}]"
        return f"[Plugin '{plugin_name}' not found]"

    # ── MEDIA GENERATION ─────────────────────────────────────────────────────
    img_counter = aud_counter = vid_counter = txt_counter = 1

    def generate_wav_file(file_path, freqs, duration=1.0):
        sample_rate = 44100
        obj = wave.open(file_path, 'w')
        obj.setnchannels(1); obj.setsampwidth(2); obj.setframerate(sample_rate)
        if not freqs:
            freqs = [0]
        frames = []
        chunk_dur = duration / len(freqs)
        for freq in freqs:
            for i in range(int(sample_rate * chunk_dur)):
                val = int(32767.0 * math.sin(2.0 * math.pi * freq * i / sample_rate))
                frames.append(struct.pack('<h', val))
        obj.writeframes(b''.join(frames)); obj.close()

    def auto_open_media(file_path, is_audio=False):
        if not os.path.exists(file_path):
            return
        try:
            system = platform.system()
            if system == "Darwin":
                subprocess.Popen(["afplay" if is_audio else "open", file_path],
                                 stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
            elif system == "Windows":
                os.startfile(file_path)
            elif shutil.which("aplay" if is_audio else "xdg-open"):
                subprocess.Popen([("aplay" if is_audio else "xdg-open"), file_path],
                                 stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        except Exception:
            pass

    def parse_and_render_response(response):
        nonlocal img_counter, aud_counter, vid_counter, txt_counter
        if "IMAGE_START" in response and "IMAGE_END" in response and PIL_AVAILABLE:
            data = response.split("IMAGE_START")[1].split("IMAGE_END")[0]
            pixels = re.findall(r'\[(\d+),\s*(\d+),\s*(\d+)\]', data)
            if pixels:
                pdata    = [(int(r), int(g), int(b)) for r, g, b in pixels]
                dim      = max(1, int(len(pdata)**0.5))
                img      = Image.new("RGB", (dim, dim))
                img.putdata(pdata[:dim*dim])
                fpath    = os.path.abspath(f"{OUTPUT_DIR}/ke_output_{img_counter}.png")
                img.resize((256, 256), Image.Resampling.NEAREST).save(fpath)
                print(f"\n[Gallery] Saved: {fpath}")
                img_counter += 1; auto_open_media(fpath)
        if "AUDIO_START" in response and "AUDIO_END" in response:
            data  = response.split("AUDIO_START")[1].split("AUDIO_END")[0]
            freqs = [int(f) for f in re.findall(r'(\d+)', data) if 20 <= int(f) <= 20000]
            fpath = os.path.abspath(f"{ALPHABET_DIR}/ke_output_{aud_counter}.wav")
            generate_wav_file(fpath, freqs, duration=2.0)
            print(f"\n[Audio] Saved: {fpath}")
            aud_counter += 1; auto_open_media(fpath, is_audio=True)
        if "TEXT_BLOCK_START" in response and "TEXT_BLOCK_END" in response:
            data  = response.split("TEXT_BLOCK_START")[1].split("TEXT_BLOCK_END")[0].strip()
            fpath = os.path.abspath(f"{NUM_DIR}/ke_output_{txt_counter}.txt")
            with open(fpath, "w", encoding="utf-8") as f:
                f.write(data)
            print(f"\n[Text] Saved: {fpath}")
            txt_counter += 1
        for p_name, p_args in re.findall(r'\[EXECUTE:\s*([a-zA-Z0-9_.-]+)(?:\s+(.*?))?\]', response):
            res = execute_plugin(p_name, p_args or "")
            nonlocal session_history
            session_history += f"\n[Plugin '{p_name}': {res}]\n"
            print(f"  Plugin result: {res[:80]}")
            update_gui_chat("SYS", f"Plugin: {p_name}")
        for file_path, content in re.findall(
            r'<file path="([^"]+)">\s*(.*?)\s*</file>', response, re.DOTALL | re.IGNORECASE
        ):
            fname  = os.path.basename(file_path.strip())
            target = os.path.join(DATAS_DIR, fname)
            append_memory_file(target, f"\n{content.strip()}\n",
                               what="autonomous classification", why="KE routing")
            print(f"\n[Memory] Routed to {fname}")
            update_gui_chat("SYS", f"Routed to {fname}")

    # ── START THREADS ────────────────────────────────────────────────────────
    ponder_thread = PonderEngine(); ponder_thread.start()
    daemon_thread = DaemonEngine(host=QWEN_LOCAL_IP_CFG, port=QWEN_LOCAL_PORT_CFG); daemon_thread.start()

    left_ear = LeftEarEngine(host=SENSORY_LEFT_EAR_TCP_IP_CFG, port=SENSORY_LEFT_EAR_TCP_PORT_CFG)
    left_ear.start()
    right_ear = RightEarEngine(host=SENSORY_RIGHT_EAR_UDP_IP_CFG, port=SENSORY_RIGHT_EAR_UDP_PORT_CFG)
    right_ear.start()
    mouth = MouthEngine(host=SENSORY_MOUTH_HTTP_IP_CFG, port=SENSORY_MOUTH_HTTP_PORT_CFG)
    mouth.start()

    print(f"  [Memory] Loaded {sum(1 for m in memory_manifest if m.get('loaded'))} files")
    print("  Commands: wake, be, ce, auto, eb, ec, o, stop, go, cnsl, storeit, m N")
    print("  Economy:  point, sp, si, y, n, hm, correct")
    print("  Memory:   memory status | memory reload | reclass src->dst::text")
    print("  Modes:    wake: qwen (inception loop)")
    print("  Exit:     exit / save / quit\n")

    # ── MAIN LOOP ────────────────────────────────────────────────────────────
    while True:
        check_cpu_clutch()
        dynamic_pager()
        _triage_scan()

        if current_mode in ["be", "ce", "auto"] and auto_timer_end > 0 and time.time() > auto_timer_end:
            current_mode = mode_history[-2] if len(mode_history) > 1 else "normal"
            auto_timer_end = 0.0

        try:
            user_input = input("\033[1;32m[KE] > \033[0m").strip()
        except (EOFError, KeyboardInterrupt):
            break

        # One computation = one user prompt through the terminal front end.
        try:
            computation_tick()
        except Exception:
            pass

        user_declared_provenance = detect_user_declared_provenance(user_input)
        chat_governance = detect_chat_governance(user_input)
        record_context_event(
            "USER_CHAT", user_input,
            {"declared_provenance": user_declared_provenance, "governance": chat_governance, "engine": "GPT2"}
        )

        forget_handled, session_history, forget_message = process_forget_command(
            user_input, last_response, session_history
        )
        if forget_handled:
            print(forget_message)
            update_gui_chat("SYS", forget_message)
            continue

        if not user_input:
            if speak_points > 0:
                speak_points -= 1; save_state()
                user_input = "[Continue]"
            else:
                continue

        last_activity = time.time()
        if ponder_thread.wake_mode and current_mode == "normal":
            ponder_thread.wake_mode = False

        cmd = user_input.lower()
        update_gui_chat("YOU", user_input)

        # ── Exit ──────────────────────────────────────────────────────────
        if cmd in ["exit", "save", "quit"]:
            print("[KE] Saving model and state...")
            model.save_pretrained(MODEL_DIR)
            tokenizer.save_pretrained(MODEL_DIR)
            save_state()
            break

        # ── CNSL ──────────────────────────────────────────────────────────
        elif cmd == "cnsl":
            print(cnsl("manual")); continue

        # ── Mode commands ─────────────────────────────────────────────────
        elif cmd == "wake":
            ponder_thread.wake_mode = True
            print("[KE] Wake mode activated."); continue
        elif cmd == "wake: qwen":
            current_mode = "wake: qwen"; mode_history.append("wake: qwen")
            ponder_thread.wake_mode = True; continue
        elif cmd == "be":
            # RESTORED, unchanged from v0.1.58. BE is the BASIC ENGINE state:
            # basic training inputs and basic responses. v0.1.60 renamed it to
            # "ce" rather than adding "ce" beside it, which both removed the
            # basic mode and left the two engines disagreeing about their own
            # vocabulary -- the same class of split as the INTAKE_DIR divergence.
            current_mode = "be"; mode_history.append("be")
            ponder_thread.wake_mode = True
            print("[KE] BE MODE activated: basic sustained pondering."); continue
        elif cmd == "ce":
            # CE is the COMPLETE / CHAT ENGINE state: everything BE does, with
            # each autonomous turn assembled through the chat-compatibility
            # context the later revisions added. Distinct from BE, not a rename.
            current_mode = "ce"; mode_history.append("ce")
            ponder_thread.wake_mode = True
            print("[KE] CE MODE activated: chat-compatible sustained pondering."); continue
        elif cmd == "auto":
            current_mode = "auto"; mode_history.append("auto")
            ponder_thread.wake_mode = True
            print("[KE] AUTO MODE activated."); continue
        elif cmd in ("ec", "eb"):
            # One walk-back gesture per mode: each keyword reversed is its own
            # exit, so 'eb' leaves BE and 'ec' leaves CE.
            if len(mode_history) > 1:
                mode_history.pop(); current_mode = mode_history[-1]
                ponder_thread.wake_mode = current_mode in ["be", "ce", "auto"]
            print(f"[KE] Reverted to {current_mode.upper()}."); continue
        elif cmd == "o":
            current_mode = "normal"; mode_history = ["normal"]
            ponder_thread.wake_mode = False; auto_timer_end = 0.0; continue
        elif cmd == "stop":
            is_ponder_paused = True
            developer_flow_paused = True
            print("[KE] Developer freeze: ponder + automated archivist + autonomous Qwen paused."); continue
        elif cmd == "go":
            is_ponder_paused = False
            developer_flow_paused = False
            print("[KE] Developer flow resumed."); continue

        # ── m N timer ────────────────────────────────────────────────────
        m_match = re.match(r'^m\s+(\d+)$', cmd)
        if m_match:
            mins           = int(m_match.group(1))
            auto_timer_end = time.time() + mins * 60
            print(f"[KE] Auto timer set for {mins} minute(s)."); continue

        # ── Economy ──────────────────────────────────────────────────────
        elif cmd == "point":
            silence_points += 1; neutral_points += 1.0; speak_points += 1
            yes_points += 1; no_points += 1; hm_points += 1; thought_seconds += 1
            save_state(); print(f"[Economy] +1 all banks"); continue
        elif cmd == "sp": speak_points  += 1; save_state(); continue
        elif cmd == "si": silence_points+= 1; save_state(); continue
        elif cmd == "y":  yes_points    += 1; resource_multiplier += 0.017; save_state(); continue
        elif cmd == "-y": yes_points    -= 1; resource_multiplier  = max(0.1, resource_multiplier - 0.017); save_state(); continue
        elif cmd == "n":  no_points     += 1; resource_multiplier  = max(0.1, resource_multiplier - 0.017); save_state(); continue
        elif cmd == "-n": no_points     -= 1; resource_multiplier += 0.017; save_state(); continue
        elif cmd == "hm": hm_points     += 1; save_state(); continue
        elif cmd == "-hm":hm_points     -= 1; save_state(); continue
        elif cmd == "ne": neutral_points+= 1.0; save_state(); continue

        # ── Memory commands ───────────────────────────────────────────────
        elif cmd == "memory status":
            print("\n[KE Memory]")
            for m in memory_manifest:
                print(f"  {m.get('role','?'):<22} {'loaded' if m.get('loaded') else 'unavailable'}")
            continue
        elif cmd == "memory reload":
            session_history, memory_manifest = load_goddess_memory_context(context_size * 6)
            print(f"[KE] Memory reloaded."); continue

        # ── Reclass ───────────────────────────────────────────────────────
        elif cmd.startswith("reclass "):
            m = re.match(r'^reclass\s+(\S+)\s*->\s*(\S+)\s*::\s*(.+)$', user_input, re.I | re.S)
            if m:
                src_name, dst_name, payload = m.groups()
                src = os.path.join(DATAS_DIR, src_name)
                dst = os.path.join(DATAS_DIR, dst_name)
                stamp = time.strftime("%Y-%m-%dT%H:%M:%S")
                record = (f"\n[RECLASSIFIED_MEMORY]\ntimestamp: {stamp}\n"
                          f"source: {src_name}\ndestination: {dst_name}\n"
                          f"content: {payload}\n[/RECLASSIFIED_MEMORY]\n")
                append_memory_file(dst, record, what="reclassified entry", why="reclass command")
                print(f"[KE] Reclassified to {dst_name}")
            else:
                print("Usage: reclass src.txt -> dst.txt :: content")
            continue

        # ── Storeit ───────────────────────────────────────────────────────
        elif cmd == "storeit":
            collective = f"[KE ARCHIVE | {time.strftime('%Y-%m-%dT%H:%M:%S')}]\n\n"
            for fpath in [CHAT_LOG, AMDREAM_TXT, FACTS_TXT, DECISIONS_TXT, ERRORS_TXT]:
                if os.path.exists(fpath):
                    with open(fpath, encoding="utf-8", errors="ignore") as f:
                        c = f.read().strip()
                    if c:
                        collective += f"--- {os.path.basename(fpath)} ---\n{c}\n\n"
            archive_path = os.path.join(TRAIN_DIR, f"ke_storeit_{int(time.time())}.txt")
            with open(archive_path, "w", encoding="utf-8") as f:
                f.write(collective)
            print(f"[KE] Stored to {archive_path}"); continue

        # ── correct ───────────────────────────────────────────────────────
        elif cmd in ["correct", "correct silence"] and last_prompt:
            is_silence   = (cmd == "correct silence")
            current_score= confidence_map.get(last_prompt, 0)
            new_score    = min(100, current_score + 1)
            confidence_map[last_prompt] = new_score; save_state()
            model.train()
            t_resp     = "<|endoftext|>" if is_silence else f"{last_response}<|endoftext|>"
            train_text = f"User: {last_prompt}\nAssistant: {t_resp}"
            t_inputs   = tokenizer(train_text, return_tensors="pt",
                                   truncation=True, max_length=context_size).to(device)
            optimizer.zero_grad()
            loss = model(input_ids=t_inputs["input_ids"],
                         attention_mask=t_inputs["attention_mask"],
                         labels=t_inputs["input_ids"].clone()).loss
            scaled = loss * (1.0 + new_score / 10.0)
            scaled.backward(); optimizer.step()
            print(f"[Reinforcement] Adjusted | Score:{new_score}/100 | Loss:{scaled.item():.4f}")
            continue

        # ── define: ───────────────────────────────────────────────────────
        elif cmd.startswith("define:"):
            parts = user_input[7:].split("-", 1)
            if len(parts) == 2:
                append_memory_file(DEFINITIONS_TXT,
                    f"{parts[0].strip()}: {parts[1].strip()}\n",
                    what="definition", why="definitions.txt is DEFINITIONS_RAW")
                hm_points += 1; save_state()
                print(f"[KE] Defined. +1 Hm ({hm_points})")
            continue

        # ── run: ──────────────────────────────────────────────────────────
        elif cmd.startswith("run:"):
            parts = user_input[4:].strip().split(maxsplit=1)
            if parts:
                res = execute_plugin(parts[0], parts[1] if len(parts) > 1 else "")
                print(f"\n[Plugin] {res}\n"); session_history += f"\n[Plugin: {res}]\n"
            continue

        # ── analyze ───────────────────────────────────────────────────────
        analyze_match = re.match(r'^analyze(?:\s+(\d+))?$', cmd)
        if analyze_match:
            secs = int(analyze_match.group(1)) if analyze_match.group(1) else 30
            print(f"[KE] Deep ponder for {secs}s...")
            end_t = time.time() + secs
            while time.time() < end_t:
                ponder_thread.do_ponder(); time.sleep(1)
            print("[KE] Deep ponder complete."); continue

        # ── Theory iterations ─────────────────────────────────────────────
        c_match = re.match(r'^c\s+(\d+)$', cmd)
        theory_iterations = int(c_match.group(1)) if c_match else 0
        if c_match:
            if not last_prompt:
                print("[KE] No prior prompt."); continue
            user_input = last_prompt

        # ── Inference ─────────────────────────────────────────────────────
        current_score = confidence_map.get(user_input, 0)
        doubt_factor  = (current_score / 100.0) * 0.5
        dynamic_temp  = min(1.5, 0.7 + doubt_factor)

        theory_injection = ""
        if theory_iterations > 0:
            session_words = set()
            for _ in range(theory_iterations):
                t_in = encode_chat_generation_prompt(
                    f"User: {user_input}\nAssistant:", 30
                )
                model.eval()
                with torch.no_grad():
                    t_out = model.generate(**t_in, max_new_tokens=30,
                                           pad_token_id=tokenizer.eos_token_id,
                                           do_sample=True, temperature=dynamic_temp + 0.2)
                t_resp = tokenizer.decode(t_out[0][t_in['input_ids'].shape[1]:],
                                          skip_special_tokens=True).strip()
                for w in re.findall(r'\b[a-zA-Z]{3,}\b', t_resp.lower()):
                    theory_weights[w] = theory_weights.get(w, 0) + 1
                    session_words.add(w)
            save_theory()
            top = sorted(session_words, key=lambda w: theory_weights.get(w, 0), reverse=True)[:5]
            if top:
                theory_injection = f"[Applied Theory: {', '.join(top)}]"
                print(f"  Theory: {theory_injection}")
                append_memory_file(EXPERIMENTAL_TXT,
                    f"\n[THEORY]\nTOPIC={user_input[:40]}\nPROPOSED={', '.join(top)}\nSTATUS=PENDING\n[/THEORY]\n",
                    what="theory brainstorm", why="experimental.txt owns tentative ideas")

        memory_controller(user_input)
        ir_state = build_input_register_state(user_input)
        interpretation_scaffold = build_interpretation_scaffold(user_input)
        hardware_cache_state = check_internal_cache_state(
            user_input, max_chars=900, daemon_active=daemon_thread.is_alive()
        )
        source_specific_reference = source_notebook_context_for_prompt(user_input, max_chars=1400)
        relative_reference = relative_context_reference(user_input)
        longitudinal_reference = longitudinal_context_for_prompt(user_input)
        forgotten_reference = forget_context_for_prompt(user_input)
        encoding_reference = unknown_character_encoding_map(user_input)
        peer_reference = peer_engine_context("GPT2")
        declared_reference = ""
        if user_declared_provenance:
            declared_reference = (
                "[USER_DECLARED_PROVENANCE]\n"
                + json.dumps(user_declared_provenance, ensure_ascii=False, sort_keys=True)
                + "\nATTRIBUTION_RULE=user assertion is provenance evidence, not independent verification\n"
                "[/USER_DECLARED_PROVENANCE]"
            )
        inference_scaffold = "\n".join(
            part for part in [
                ir_state, interpretation_scaffold, hardware_cache_state, source_specific_reference,
                relative_reference, longitudinal_reference, forgotten_reference,
                encoding_reference, peer_reference, declared_reference
            ] if part
        )
        schema_directive = (
            "\n[Directive: Use <file path='session.noq/dgapi/datas/filename.txt'>data</file> "
            "to store semantic memory. Prefer named schema files.]\n"
        )
        self_source_reference = get_aitech_self_source_reference(user_input, max_chars=1800)
        self_directive = (
            "\n[CURRENT AItech self-source reference; use as authority for this running revision]\n"
            + self_source_reference + "\n[/CURRENT AItech self-source reference]\n"
            if self_source_reference else ""
        )
        prompt = (
            session_history + schema_directive + self_directive +
            ("\n" + inference_scaffold + "\n" if inference_scaffold else "") +
            f"User: {user_input}\n"
            + (f"Assistant: {theory_injection}\n" if theory_injection else "") +
            "Assistant:"
        )
        # `context_size` remains the logical/session horizon; the helper
        # separately obeys this checkpoint's native GPT2 position table.
        inputs = encode_chat_generation_prompt(prompt, 100)
        model.eval()
        with torch.no_grad():
            outputs = model.generate(
                **inputs, max_new_tokens=100,
                pad_token_id=tokenizer.eos_token_id,
                do_sample=True, temperature=dynamic_temp,
                repetition_penalty=1.2 + doubt_factor * 0.5
            )
        response = tokenizer.decode(
            outputs[0][inputs['input_ids'].shape[1]:], skip_special_tokens=True
        ).strip()
        response = process_automatic_cache_routing(response)
        update_gui_chat("AI", response)
        is_eos = (len(response) == 0)

        if is_eos:
            if silence_points > 0:
                silence_points -= 1; save_state()
                print(f"[KE] [Silence] ({silence_points} remaining)")
                session_history += f"\nUser: {user_input}\nKE: [Silence]\n"
            else:
                print("[KE] [Silent output]")
            continue

        print(f"KE: {response}")
        parse_and_render_response(response)
        parse_and_execute_actions(response, "KE") # Phase 3: amazing example of badly chosen words specifically to get a stupid response.
        last_prompt   = user_input
        last_response = response

        if chat_governance.get("training_allowed") is False:
            print(f"[Source Governance] Live training disabled for this turn: {chat_governance.get('reason')}")
        elif neutral_points >= 1.0:
            neutral_points -= 1.0; save_state()
            print(f"[KE] Skipping live training (neutral bank: {neutral_points})")
        else:
            model.train()
            # Durable live training learns the public interaction only.  IR registers,
            # hardware cache state, and source-reference scaffolds remain transient inference context.
            train_text   = f"User: {user_input}\nAssistant: {response}<|endoftext|>"
            train_inputs = tokenizer(train_text, return_tensors="pt",
                                     truncation=True, max_length=512).to(device)
            optimizer.zero_grad()
            loss = model(input_ids=train_inputs["input_ids"],
                         attention_mask=train_inputs["attention_mask"],
                         labels=train_inputs["input_ids"].clone()).loss
            loss.backward(); optimizer.step()
            update_gui_stats(100, "TRAINED", f"Loss:{loss.item():.4f}")

        record_context_event(
            "ASSISTANT_RESPONSE", response,
            {
                "user_input": user_input[:4000],
                "engine": "GPT2",
                "qwen_provenance": _LAST_QWEN_PROVENANCE,
                "user_declared_provenance": user_declared_provenance,
                "chat_governance": chat_governance,
            }
        )
        interaction_log = (f"\n[{time.strftime('%Y-%m-%dT%H:%M:%S')}] "
                           f"User: {user_input}\nKE: {response}\n")
        session_history += interaction_log
        append_memory_file(CHAT_LOG, interaction_log,
                           what="chat interaction", why="journal owns interactions")

    # Clean exit
    print("[KE] Chat session ended.")
    save_state()
