            float ly = world.sunPosition[1] - pPos[1];
            float lz = world.sunPosition[2] - pPos[2];
            float len = (float) Math.sqrt(lx*lx + ly*ly + lz*lz);
            if (len > 0.001f) { lightX = lx/len; lightY = ly/len; lightZ = lz/len; }
