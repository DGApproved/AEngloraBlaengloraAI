    private void updateTabColors()
    {
        if (historyTabs == null) return;
        int selected = historyTabs.getSelectedIndex();
        for (int i = 0; i < historyTabs.getTabCount(); i++) {
            boolean isUpdate = updatePane != null
                    && historyTabs.getComponentAt(i) == updatePane;

            // The thirteenth tab remains real and clickable while dormant, but
            // its colors blend into the surrounding tab area. MatrixTabbedPaneUI
            // also suppresses its title/border so it does not announce itself.
            if (isUpdate && !updateTabRevealed) {
                historyTabs.setBackgroundAt(i, MatrixConfig.BG_DARK);
                historyTabs.setForegroundAt(i, MatrixConfig.BG_DARK);
                continue;
            }

            boolean active = (i == selected);
            historyTabs.setBackgroundAt(i, active ? MatrixConfig.GODDESS_PURPLE : MatrixConfig.KEY_BG);
            historyTabs.setForegroundAt(i, active ? MatrixConfig.GODDESS_GOLD : MatrixConfig.TEXT_COLOR);
        }
        historyTabs.repaint();
    }

    private boolean isDormantUpdateTab(int tabIndex)
    {
        return historyTabs != null
                && updatePane != null
                && tabIndex >= 0
                && tabIndex < historyTabs.getTabCount()
                && historyTabs.getComponentAt(tabIndex) == updatePane
                && !updateTabRevealed;
    }

    private void refreshObservationViews()
    {
        if (historyTabs == null || observationViews.isEmpty()) return;

        // Keep the work light when CHAT is selected: shared files are still small, but
        // telemetry refresh must never interfere with the chat document/caret pipeline.
        setObservationText("manager", buildOverviewText());
        setObservationText("aitech", buildAItechText());
        setObservationText("build", readSharedState("build"));
        setObservationText("engine", buildGameText());
        setObservationText("kernel", readSharedState("kernel"));
        setObservationText("project", buildProjectText());
        setObservationText("system", buildSystemText());
        setObservationText("logs", readSharedState("logs"));
        setObservationText("perspective", buildPerspectiveText());
        setObservationText("relationships", readSharedState("relationships"));
        setObservationText("integration", buildIntegrationText());
    }

    private void setObservationText(String key, String text)
    {
        JTextArea area = observationViews.get(key);
        if (area == null) return;

        String normalized = text == null ? "" : text;
        if (!normalized.equals(area.getText())) {
            int oldCaret = area.getCaretPosition();
            area.setText(normalized);
            area.setCaretPosition(Math.min(oldCaret, area.getDocument().getLength()));
        }
    }

