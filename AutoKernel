                if generated_files:
                    print("\n=== Workspace Summary ===")
                    for f in generated_files: print(f"  ✓ Generated: {f}")
                return
        # -------------------------------

        if not files_to_write and not commands_to_run: return

        print(f"\n[!] {model_name} requested workspace actions:")
        for path, _ in files_to_write: print(f"  [WRITE]  -> {(ROOT_DIR / path).resolve()}")
        for exec_dir, cmd_block in commands_to_run:
            cmds = [c.strip() for c in strip_markdown_fences(cmd_block).split('\n') if c.strip() and not c.strip().startswith('#')]
            for cmd in cmds: print(f"  [EXEC]   -> (in {exec_dir}/) {cmd}")

        flush_input()
        choice = input("\nApprove actions? (y/n): ").strip().lower()
        if choice != 'y': return

        for path, content in files_to_write:
            full_path = (ROOT_DIR / path).resolve()
            if ROOT_DIR in full_path.parents:
                full_path.parent.mkdir(parents=True, exist_ok=True)
                with open(full_path, "w", encoding="utf-8") as f: f.write(strip_markdown_fences(content))
                print(f"    ✓ Wrote {full_path.name}")
                generated_files.append(str(full_path))

        for exec_dir, cmd_block in commands_to_run:
            full_dir = (ROOT_DIR / exec_dir).resolve()
            if ROOT_DIR in full_dir.parents or full_dir == ROOT_DIR:
                full_dir.mkdir(parents=True, exist_ok=True)
                cmds = [c.strip() for c in strip_markdown_fences(cmd_block).split('\n') if c.strip() and not c.strip().startswith('#')]
                for cmd in cmds:
                    print(f"    ➜ Running: {cmd}")
                    subprocess.run(cmd, shell=True, cwd=str(full_dir))
                    update_gui_chat("CLOUD", f"Executed: {cmd}")

        if generated_files:
            print("\n=== Workspace Summary ===")
            for f in generated_files: print(f"  ✓ Generated: {f}")

