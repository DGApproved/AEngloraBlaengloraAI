# ---------------------------------------------------------------------------
# CONTENT-AWARE GENERATED FILE WRITES
# ---------------------------------------------------------------------------
# Generated source/config files are staged to a temporary file and compared
# byte-for-byte with the existing destination before replacement. This avoids
# rewriting unchanged files, preserves mtimes for tools that watch for actual
# edits, and reduces unnecessary churn in source control and local worktrees.
#
# IMPORTANT PLATFORM POLICY:
# Keep this helper POSIX/Bash-3 friendly for macOS compatibility. Do not use
# that compatibility requirement to restrict Linux-only branches from adopting
# newer package-manager features or shell methods where those are beneficial.
write_if_changed() {
    local target="$1"
    local target_dir tmp
    target_dir="$(dirname "$target")"
    mkdir -p "$target_dir"
    tmp="${target}.aitech.$$.$RANDOM.tmp"

    cat > "$tmp" || { rm -f "$tmp"; return 1; }

    if [[ -f "$target" ]] && cmp -s "$tmp" "$target"; then
        rm -f "$tmp"
        record_managed "$target"                     # re-affirm baseline: still byte-identical to AItech's output
        printf '[=] Unchanged: %s\n' "$target"
        return 0
    fi

    # Preserve executable mode when replacing an existing executable file.
    local was_exec=0
    [[ -x "$target" ]] && was_exec=1
    mv "$tmp" "$target"
    (( was_exec )) && chmod +x "$target" 2>/dev/null || true
    record_managed "$target"                         # new baseline: this is AItech-authored content
    printf '[~] Updated: %s\n' "$target"
}

