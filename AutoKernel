# PIXEL / IMAGE DECAY (multimodal ingestion from train_base_multimodal_decayv2)
# =============================================================================

def generate_pixel_decay_records(img_path, filename, decay_unit, decay_value, is_percentage):
    """
    Reduce an image to an RGB pixel grid at decreasing resolutions and emit
    each step as a training record in the IMAGE_START/IMAGE_END format the
    chat engine and knowledge engine already recognise.

    Decay modes:
        single : one step at 16×16 (or smaller if the source is tiny)
        char/word/allc/allw : dimensional decay 16×16 → 15×15 → … → 1×1

    The category tag (TINY/SMALL/MEDIUM/LARGE) is derived from the original
    pixel count so the model can learn size-appropriate treatment.
    """
    if not PIL_AVAILABLE:
        return []
    records = []
    try:
        with Image.open(img_path) as img:
            img  = img.convert("RGB")
            orig_w, orig_h = img.size
            pixels = orig_w * orig_h
            if   pixels < 10_000:   category = f"TINY_{orig_w}x{orig_h}"
            elif pixels < 250_000:  category = f"SMALL_{orig_w}x{orig_h}"
            elif pixels < 1_000_000: category = f"MEDIUM_{orig_w}x{orig_h}"
            else:                   category = f"LARGE_{orig_w}x{orig_h}"
            start_dim = min(16, max(orig_w, orig_h))
            if decay_unit == "single":
                resized   = img.resize((start_dim, start_dim), Image.Resampling.LANCZOS)
                pix_list  = list(resized.getdata())
                pixel_str = " ".join(f"[{r},{g},{b}]" for r, g, b in pix_list)
                records.append(
                    f"User: Analyze {filename} grid {start_dim}x{start_dim}\n"
                    f"Assistant: [SRC_CAT: {category}] [GRID: {start_dim}x{start_dim}] "
                    f"IMAGE_START {pixel_str} IMAGE_END"
                )
                write_progress(5, f"INGESTED (image): {filename}")
            else:
                for dim in range(start_dim, 0, -1):
                    resized   = img.resize((dim, dim), Image.Resampling.LANCZOS)
                    pix_list  = list(resized.getdata())
                    pixel_str = " ".join(f"[{r},{g},{b}]" for r, g, b in pix_list)
                    records.append(
                        f"User: Analyze {filename} grid {dim}x{dim}\n"
                        f"Assistant: [SRC_CAT: {category}] [GRID: {dim}x{dim}] "
                        f"IMAGE_START {pixel_str} IMAGE_END"
                    )
                write_progress(5, f"INGESTED (image): {filename} ({len(records)} dim steps)")
            print(f"  Image '{filename}': {len(records)} step(s) [{category}]")
    except Exception as exc:
        print(f"  [!] Image '{filename}' skipped: {exc}")
    return records


