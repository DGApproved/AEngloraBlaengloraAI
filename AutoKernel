                            )
                            sys.stdout.flush()
                    auto_stop_timer = _th.Timer(mins * 60, _auto_stop)
                    auto_stop_timer.daemon = True
                    auto_stop_timer.start()
                    print(f"[+] Background daemon running for {mins} minute(s). Auto-stop scheduled.")

                elif cmd == "gemini": active_cloud_models["ARCHITECT"] = ARCHITECT_MODEL; print("[+] Gemini reloaded.")
