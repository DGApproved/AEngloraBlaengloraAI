    def dynamic_pager():
        nonlocal session_history, swap_token_counter
        tokens    = tokenizer.encode(session_history, add_special_tokens=False)
        ram_usage = len(tokens)
        if ram_usage > context_size:
            excess          = ram_usage - context_size
            paged_out       = tokens[:excess]
            retained        = tokens[excess:]
            session_history = tokenizer.decode(retained)
            with open(SWAP_FILE, "a", encoding="utf-8") as f:
                for tid in paged_out:
                    tok = tokenizer.decode([tid]).replace('\n', '↵').strip() or "[SPACE]"
                    f.write(f"[{tok}] ")
                    swap_token_counter += 1
                    if swap_token_counter >= 4:
                        f.write("\n"); swap_token_counter = 0

    def memory_controller(user_input_text):
        nonlocal session_history
        if not os.path.exists(SWAP_FILE):
            return
        tokens    = tokenizer.encode(session_history, add_special_tokens=False)
        free      = context_size - len(tokens)
        if free <= 20:
            return
        keywords = set(re.findall(r'\b[a-zA-Z]{5,}\b', user_input_text.lower()))
        if not keywords:
            return
        try:
            with open(SWAP_FILE, "r", encoding="utf-8") as f:
                swap_content = f.read()
            found = [k for k in keywords if k in swap_content.lower()]
            if not found:
                return
            swap_tokens = re.findall(r'\[(.*?)\]', swap_content)
            for i in range(len(swap_tokens) - 1, -1, -1):
                if any(k in swap_tokens[i].lower() for k in found):
                    pull   = swap_tokens[max(0, i-50):i+50]
                    remain = swap_tokens[:max(0, i-50)] + swap_tokens[i+50:]
                    recovered = "".join(t.replace('↵', '\n') for t in pull)
                    session_history = f"\n[PAGE FAULT: '{found[0]}']\n{recovered}\n" + session_history
                    with open(SWAP_FILE, "w", encoding="utf-8") as f:
                        cnt = 0
                        for t in remain:
                            f.write(f"[{t}] "); cnt += 1
                            if cnt >= 4: f.write("\n"); cnt = 0
                    break
        except Exception:
            pass

