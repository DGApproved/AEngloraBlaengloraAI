# ── TRIAGE HELPERS ───────────────────────────────────────────────────────

def _score_chunk_triage(chunk_lower, dest_file):
    """Score a lowercased chunk against a destination file's keyword list."""
    return sum(1 for kw in _DEST_KEYWORDS.get(dest_file, []) if kw in chunk_lower)

def _best_triage_dest(chunk):
    """
    Return the schema file path that best matches a chunk.
    Returns None if no keyword scores above zero (chunk goes to definitions.txt raw).
    Named schema files only — gentext files are never redistribution targets.
    """
    chunk_lower = chunk.lower()
    best_score, best_path = 0, None
    for spec in GODDESS_MEMORY_FILES:
        fname = os.path.basename(spec["path"])
        if fname in ("definitions.txt", "notes.xtx", "weights.txt"): continue
        score = _score_chunk_triage(chunk_lower, fname)
        if score > best_score:
            best_score, best_path = score, spec["path"]
    return best_path if best_score > 0 else None

def _chunk_for_triage(text, min_words=6, max_words=60):
    """
    Split text into semantic chunks for token-by-token redistribution.
    Cascade: paragraphs → lines → sentences → word-window fallback.
    """
    chunks = []
    paragraphs = [p.strip() for p in re.split(r"\n\n+", text) if p.strip()]
    if len(paragraphs) > 1:
        for para in paragraphs:
            if len(para.split()) >= min_words:    chunks.append(para)
            elif chunks:                           chunks[-1] += " " + para
            else:                                  chunks.append(para)
        return [c for c in chunks if c.strip()]
    lines = [ln.strip() for ln in text.splitlines() if ln.strip()]
    if len(lines) > 1:
        buf = []
        for ln in lines:
            buf.append(ln)
            if len(" ".join(buf).split()) >= min_words:
                chunks.append(" ".join(buf)); buf = []
        if buf: (chunks.__setitem__(-1, chunks[-1]+" "+" ".join(buf)) if chunks else chunks.append(" ".join(buf)))
        return [c for c in chunks if c.strip()]
    sentences = re.split(r"(?<=[.!?])\s+", text.strip())
    if len(sentences) > 1:
        buf = []
        for s in sentences:
            buf.append(s)
            if len(" ".join(buf).split()) >= min_words:
                chunks.append(" ".join(buf)); buf = []
        if buf: (chunks.__setitem__(-1, chunks[-1]+" "+" ".join(buf)) if chunks else chunks.append(" ".join(buf)))
        return [c for c in chunks if c.strip()]
    words = text.split()
    return [" ".join(words[i:i+max_words]) for i in range(0, len(words), max_words) if words[i:i+max_words]]

def _triage_append(path, text):
    """Append to any file, creating it if needed."""
    os.makedirs(os.path.dirname(path), exist_ok=True)
    with open(path, "a", encoding="utf-8") as f: f.write(text)

def _triage_move_to_processed(filepath, fname, stamp):
    """Move a triaged file to PROCESSED_DIR with a collision-safe name."""
    os.makedirs(PROCESSED_DIR, exist_ok=True)
    safe = stamp.replace(":", "-")
    dest = os.path.join(PROCESSED_DIR, f"triaged_{safe}_{fname}")
    if os.path.exists(dest):
        dest = os.path.join(PROCESSED_DIR, f"triaged_{safe}_{int(time.time())}_{fname}")
    try: shutil.move(filepath, dest)
    except Exception: pass

def _triage_unschema_file(filepath):
    """
    Redistribute a single unschema file into named schema stores.
    Records provenance in definitions.txt.  Moves original to processed/.
    """
    fname = os.path.basename(filepath)
    stamp = time.strftime("%Y-%m-%dT%H:%M:%S")
    try:
        raw = Path(filepath).read_text(encoding="utf-8", errors="ignore").strip()
    except Exception as exc:
        return {"file": fname, "error": str(exc)}
    chunks = _chunk_for_triage(raw) if raw else []
    routing = {}; unrouted = []
    for chunk in chunks:
        dest = _best_triage_dest(chunk)
        if dest is None:
            unrouted.append(chunk)
        else:
            dest_base = os.path.basename(dest)
            routing[dest_base] = routing.get(dest_base, 0) + 1
            _triage_append(dest, f"\n[TRIAGE_FROM: {fname} | {stamp}]\n{chunk}\n[/TRIAGE_FROM]\n")
    if unrouted:
        _triage_append(DEFINITIONS_TXT,
            f"\n[TRIAGE_RAW | source: {fname} | {stamp}]\n" + "\n".join(unrouted) + "\n[/TRIAGE_RAW]\n")
        routing["definitions.txt(unmatched)"] = len(unrouted)
    dest_summary = "; ".join(f"{k}: {v}" for k,v in routing.items()) or "none"
    _triage_append(DEFINITIONS_TXT,
        f"\n[TRIAGE_RECORD]\ntimestamp: {stamp}\nsource_file: {fname}\n"
        f"status: REDISTRIBUTED\ntotal_chunks: {len(chunks)}\nrouted_to: {dest_summary}\n"
        f"description: Invented file redistributed by keyword-scored triage.\n[/TRIAGE_RECORD]\n")
    _triage_move_to_processed(filepath, fname, stamp)
    return {"file": fname, "chunks": len(chunks), "routed": routing}

