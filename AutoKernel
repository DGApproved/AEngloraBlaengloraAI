def _parse_identity_report(report):
    fields = {}
    for line in str(report or "").splitlines():
        m = re.match(r"\s*(MODEL_NAME|MODEL_VERSION|MODEL_FAMILY|MODEL_REVISION)\s*=\s*(.*?)\s*$", line, re.I)
        if m:
            fields[m.group(1).upper()] = m.group(2).strip()
    joined = " ".join(fields.values()).strip().lower()
    anonymous = (not fields.get("MODEL_NAME")) or any(
        x in joined for x in ("anonymous", "unknown", "unspecified", "not sure", "cannot identify")
    )
    fields["IDENTITY_CLASS"] = "ANONYMOUS" if anonymous else (
        "PARTIAL" if not fields.get("MODEL_VERSION") and not fields.get("MODEL_REVISION") else "DECLARED"
    )
    return fields


def _probe_qwen_identity(daemon):
    """
    Ask a newly encountered backend how it identifies.  The answer is stored as
    SELF_REPORTED, never as stronger evidence than runtime metadata/hash.
    """
    prompt = (
        "AItech source-identity handshake. Reply with up to four plain lines and no prose:\\n"
        "MODEL_NAME=<name or ANONYMOUS>\\n"
        "MODEL_VERSION=<version or UNKNOWN>\\n"
        "MODEL_FAMILY=<family or UNKNOWN>\\n"
        "MODEL_REVISION=<revision/quantization/variant or UNKNOWN>"
    )
    try:
        if daemon.get("protocol") == "tcp-query":
            with socket.create_connection((daemon["host"], daemon["port"]), timeout=QWEN_HTTP_TIMEOUT_CFG) as sock:
                sock.sendall(("QUERY:" + prompt).encode("utf-8"))
                sock.settimeout(QWEN_HTTP_TIMEOUT_CFG)
                data = sock.recv(16384).decode("utf-8", errors="ignore")
                return data.strip()

        payload = json.loads(json.dumps(daemon.get("payload", {})))
        name = daemon.get("name")
        if name in ("KoboldCpp", "Ollama", "LM Studio"):
            payload["prompt"] = prompt
            if "max_length" in payload:
                payload["max_length"] = 96
            if "max_tokens" in payload:
                payload["max_tokens"] = 96
            if isinstance(payload.get("options"), dict):
                payload["options"]["num_predict"] = 96
        elif name == "SillyTavern":
            payload["messages"] = [{"role": "user", "content": prompt}]
            payload["max_tokens"] = 96
        req = urllib.request.Request(
            f"http://{daemon['host']}:{daemon['port']}{daemon['path']}",
            data=json.dumps(payload).encode("utf-8"),
            headers={"Content-Type": "application/json"},
        )
        with urllib.request.urlopen(req, timeout=QWEN_HTTP_TIMEOUT_CFG) as response:
            result = json.loads(response.read().decode("utf-8"))
        return daemon["extract"](result).replace("<|im_end|>", "").strip()
    except Exception:
        return ""


def ensure_qwen_source_identity(daemon, response_metadata=None):
    sources = _load_qwen_sources()
    table = sources.setdefault("sources", {})
    endpoint_id = _qwen_endpoint_key(daemon)
    existing = table.get(endpoint_id)
    now = time.strftime("%Y-%m-%dT%H:%M:%S")
    if existing:
        existing["last_seen"] = now
        table[endpoint_id] = existing
        _save_qwen_sources(sources)
        return existing

    report = _probe_qwen_identity(daemon)
    parsed = _parse_identity_report(report)
    content_hash = _qwen_local_model_hash()
    instance_id = (
        "gguf-sha256:" + content_hash
        if content_hash
        else endpoint_id
    )
    identity_class = parsed.get("IDENTITY_CLASS", "ANONYMOUS")
    collective = "ANONYMOUS_GGUF" if identity_class == "ANONYMOUS" else (
        parsed.get("MODEL_FAMILY") or parsed.get("MODEL_NAME") or "DECLARED_GGUF"
    )

    rec = {
        "source_id": endpoint_id,
        "model_instance_id": instance_id,
        "instance_id_basis": "GGUF_CONTENT_HASH" if content_hash else "ENDPOINT_CONTINUITY_KEY",
        "model_collective_id": collective,
        "identity_class": identity_class,
        "display_name": parsed.get("MODEL_NAME") or "ANONYMOUS",
        "version": parsed.get("MODEL_VERSION") or "UNKNOWN",
        "family": parsed.get("MODEL_FAMILY") or "UNKNOWN",
        "revision": parsed.get("MODEL_REVISION") or "UNKNOWN",
        "runtime_backend": daemon.get("name"),
        "runtime_host": daemon.get("host"),
        "runtime_port": daemon.get("port"),
        "runtime_configured_model": QWEN_MODEL_NAME_CFG,
        "self_report": report[:2000],
        "self_report_status": "SELF_REPORTED_BY_MODEL",
        "first_seen": now,
        "last_seen": now,
    }
    table[endpoint_id] = rec
    _save_qwen_sources(sources)
    _append_jsonl(QWEN_EVENTS_PATH, {"time": now, "event": "QWEN_SOURCE_FIRST_SEEN", **rec})
    return rec


def _extract_remote_model_provenance(text):
    """
    Qwen can preserve a second provenance hop when it consulted/relayed an
    online model.  The bridge prompt requests this envelope only when applicable.
    """
    pattern = re.compile(
        r"<AItechRemoteSource>\s*(.*?)\s*</AItechRemoteSource>", re.I | re.S
    )
    m = pattern.search(str(text or ""))
    if not m:
        return str(text or ""), {}
    fields = {}
    for line in m.group(1).splitlines():
        if "=" in line:
            k, v = line.split("=", 1)
            fields[k.strip().upper()] = v.strip()
    cleaned = pattern.sub("", str(text or "")).strip()
    return cleaned, {
        "origin_class": "QWEN_MEDIATED_ONLINE_LLM",
        "remote_provider": fields.get("REMOTE_PROVIDER", "UNKNOWN"),
        "remote_model": fields.get("REMOTE_MODEL", "UNKNOWN"),
        "remote_version": fields.get("REMOTE_VERSION", "UNKNOWN"),
        "remote_response_id": fields.get("REMOTE_RESPONSE_ID", "UNKNOWN"),
        "identity_confidence": "RELAY_DECLARED",
    }


