    def koboldcpp_generate(prompt, max_length=256, temperature=0.7):
        if not KOBOLDCPP_URL:
            raise RuntimeError("KoboldCpp daemon is not connected.")
        payload = json.dumps({
            "prompt": prompt,
            "max_context_length": 8192,
            "max_length": max_length,
            "temperature": temperature,
            "top_p": 0.9,
            "top_k": 100,
            "rep_pen": 1.1,
            "quiet": True,
        }).encode("utf-8")
        req = urllib.request.Request(
            KOBOLDCPP_URL + "/api/v1/generate",
            data=payload,
            headers={"Content-Type": "application/json"},
            method="POST",
        )
        with urllib.request.urlopen(req, timeout=600) as response:
            body = json.loads(response.read().decode("utf-8"))
        return body["results"][0]["text"]

    def semantic_memory_context_for_prompt(prompt, max_chars=18000):
        """
        Retrieve schema-guided memory context for orchestrator agents.

        This does not dump every memory file into the prompt. It uses prompt
        keywords, file semantics, and localized weights to surface relevant stores.
        """
        if not semantic_memory_enabled or not MEMORY_SEMANTICS:
            return ""

        keywords = [
            w.lower()
            for w in re.findall(r"\b[a-zA-Z0-9_-]{2,}\b", prompt)
        ]
        weight_ledger = load_local_weight_ledger()
        scored = []

        memory_root = NOQ_DIR / "data" / "memory"
        datas_root = NOQ_DIR / "dgapi" / "datas"
        virtual_root = NOQ_DIR / "dgapi" / "virtual"

        roots = [memory_root, datas_root, virtual_root]

        for filename, spec in MEMORY_SEMANTICS.items():
            candidate = None
            for root in roots:
                p = root / filename
                if p.exists():
                    candidate = p
                    break

            if candidate is None:
                continue

            haystack = (
                filename + " "
                + spec.get("role", "") + " "
                + spec.get("purpose", "") + " "
                + spec.get("accepts", "")
            ).lower()

            score = sum(2 for kw in keywords if kw in haystack)

            local_weights = weight_ledger.get(filename, {})
            score += sum(local_weights.get(kw, 0.0) for kw in keywords)

            if score > 0:
                scored.append((score, candidate, spec))

        scored.sort(key=lambda x: x[0], reverse=True)

        chunks = []
        used = 0

        for score, path, spec in scored:
            try:
                content = read_semantic_memory(
                    path,
                    what=f"{spec.get('role','memory')} context",
                    why=f"prompt relevance score={score:.2f}"
                ).strip()
            except Exception as e:
                # Explicit error logging instead of a silent drop
                print(f"[!] Warning: Failed to ingest {path.name} - {e}")
                continue

            if not content:
                continue

            block = (
                f"\n[SEMANTIC MEMORY: {path.name} | ROLE={spec.get('role','UNKNOWN')}]\n"
                f"PURPOSE={spec.get('purpose','')}\n"
                f"{content[:5000]}\n"
                f"[/SEMANTIC MEMORY]\n"
            )

            if used + len(block) > max_chars:
                break

            chunks.append(block)
            used += len(block)

        return "".join(chunks)

    def build_semantic_reclassification_note(source_name, destination_name, content, reason):
        """
        Build a provenance-preserving reclassification record. Orchestrator can
