#!/usr/bin/env python3.12
import os, json, argparse
from gguf import GGUFReader

def expand(gguf_path, out_dir):
    print(f"[*] Splicing {gguf_path} into {out_dir}/")
    os.makedirs(out_dir, exist_ok=True)
    tensors_dir = os.path.join(out_dir, "tensors")
    os.makedirs(tensors_dir, exist_ok=True)

    reader = GGUFReader(gguf_path)
    metadata = {}
    
    for field in reader.fields.values():
        val = field.parts[-1].tolist() if hasattr(field.parts[-1], 'tolist') else field.parts[-1]
        if isinstance(val, list) and len(val) > 0 and isinstance(val[0], bytes):
            val = [v.decode('utf-8', 'ignore') for v in val]
        elif isinstance(val, bytes):
            val = val.decode('utf-8', 'ignore')
        metadata[field.name] = val

    with open(os.path.join(out_dir, "metadata.json"), "w", encoding="utf-8") as f:
        json.dump(metadata, f, indent=4)

    tensor_infos = []
    with open(gguf_path, "rb") as f:
        for i, t in enumerate(reader.tensors):
            tensor_infos.append({
                "index": i, "name": t.name, "shape": list(t.shape), 
                "type": t.tensor_type.name, "offset": t.data_offset
            })
            f.seek(t.data_offset)
            data = f.read(t.n_bytes)
            safe_name = t.name.replace("/", "_")
            with open(os.path.join(tensors_dir, f"{i:04d}_{safe_name}.bin"), "wb") as tf:
                tf.write(data)

    with open(os.path.join(out_dir, "tensor_info.json"), "w", encoding="utf-8") as f:
        json.dump(tensor_infos, f, indent=4)
    print(f"[✓] Extracted metadata and {len(tensor_infos)} tensor blobs.")

if __name__ == "__main__":
    parser = argparse.ArgumentParser()
    parser.add_argument("file")
    args = parser.parse_args()
    expand(args.file, f"{os.path.splitext(args.file)[0]}.gguf")
EOF

