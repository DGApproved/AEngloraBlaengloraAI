    def strip_markdown_fences(content):
        content = re.sub(r'^```[a-zA-Z]*\n', '', content.strip())
        content = re.sub(r'\n```$', '', content)
        return content.strip() + "\n"

    def parse_companion_commands(output_text, model_name):
        ingests = re.findall(r'<companion ingest="([^"]+)">.*?</companion>', output_text, re.DOTALL | re.IGNORECASE)
        notes = re.findall(r'<companion note="([^"]+)">(.*?)</companion>', output_text, re.DOTALL | re.IGNORECASE)

        if not ingests and not notes: return False

        print(f"\n[!] {model_name} is autonomously modifying the Virtual Companion:")
        for path in ingests: print(f"  [INGEST] -> {path}")
        for topic, _ in notes: print(f"  [MEMORIZE] -> Topic: {topic}")

        flush_input()
        choice = input("\nAllow Companion modifications? (y/n): ").strip().lower()
        if choice != 'y': return True

        for path in ingests:
            status = ingest_file_to_companion(path)
            print(f"    {status}")
            append_transcript("System", f"Autonomous Ingest: {status}")

        for topic, content in notes:
            summary = strip_markdown_fences(content)
            with open(REF_MANUAL_PATH, "a", encoding="utf-8") as f:
                f.write(f"\n### Autonomous Note: {topic} | Author: {model_name}\n{summary}\n")
            print(f"    ✓ Wrote note '{topic}' directly to Reference Manual.")

        return True

    def parse_memory_reclassification(output_text, model_name):
        """
        Agent proposal syntax:
          <memory reclass="definitions.txt->almanac.txt" reason="...">content</memory>

        User approval remains required before files are modified.
        """
        matches = re.findall(
            r'<memory\s+reclass="([^"]+)->([^"]+)"\s+reason="([^"]+)">(.*?)</memory>',
            output_text,
            re.DOTALL | re.IGNORECASE
        )

        if not matches:
            return False

        print(f"\n[!] {model_name} proposed semantic-memory reclassification:")

        roots = [
            NOQ_DIR / "data" / "memory",
            NOQ_DIR / "dgapi" / "datas",
            NOQ_DIR / "dgapi" / "virtual",
        ]

        proposals = []

        for src_name, dst_name, reason, content in matches:
            src_name = src_name.strip()
            dst_name = dst_name.strip()
            content = content.strip()

            src_path = next((root / src_name for root in roots if (root / src_name).exists()), None)

            dst_path = None
            for root in roots:
                candidate = root / dst_name
                if candidate.exists():
                    dst_path = candidate
                    break

            if dst_path is None and dst_name in MEMORY_SEMANTICS:
                dst_path = canonical_memory_path(dst_name)

            if src_path is None or dst_path is None:
                print(f"  [SKIP] unresolved path: {src_name} -> {dst_name}")
                continue

            print(f"  {src_name} -> {dst_name} | {reason}")
            proposals.append((src_path, dst_path, reason, content))

        if not proposals:
            return True

        flush_input()
        choice = input("\nAllow these semantic-memory promotions/duplicates? (y/n): ").strip().lower()

        if choice != "y":
            return True

        for src_path, dst_path, reason, content in proposals:
            record = build_semantic_reclassification_note(
                src_path.name,
                dst_path.name,
                content,
                reason
            )

            append_semantic_memory(
                dst_path,
                "\n" + record,
                what=f"reclassified entry from {src_path.name}",
                why=reason
            )

            append_semantic_memory(
                src_path,
                (
                    "\n[RECLASSIFICATION_NOTE]\n"
                    f"timestamp: {time.strftime('%Y-%m-%dT%H:%M:%S')}\n"
                    f"destination: {dst_path.name}\n"
                    f"reason: {reason}\n"
                    f"content_reference: {content[:240]}\n"
                    "[/RECLASSIFICATION_NOTE]\n"
                ),
                what="reclassification provenance",
                why=f"preserve source history after promotion to {dst_path.name}"
            )

        return True


    def parse_aitech_commands(output_text, model_name):
        aitech_calls = re.findall(r'<aitech tool="([^"]+)">(.*?)</aitech>', output_text, re.DOTALL)
        if not aitech_calls: return False

        print(f"\n[!] {model_name} is accessing the AItech Peripheral Notebook:")
        tool_map = {"graph_data": "session.noq/dgapi/src/prepare_graph_data.py", "train_base": "session.noq/dgapi/src/train_base_multimodal_decayv2.py", "train_knowledge": "session.noq/dgapi/src/train_m_K_e.py"}
        commands_to_run = []
        for tool, _ in aitech_calls:
            tool = tool.strip()
            if tool in tool_map:
                print(f"  [PERIPHERAL] -> Capability: {tool}")
                commands_to_run.append(f"source venv/bin/activate && python3.12 {tool_map[tool]}")

        if not commands_to_run: return False

        flush_input()
        choice = input("\nAllow execution of these AItech tools? (y/n): ").strip().lower()
        if choice != 'y': return True

        for cmd in commands_to_run:
            try: subprocess.run(cmd, shell=True, cwd=str(AITECH_DIR))
            except Exception as e: print(f"[!] Error: {e}")
        return True

    def parse_roomate_queries(output_text, model_name):
        """Intercepts queries the agent made to the local AItech daemon."""
        queries = re.findall(r'<roomate query="([^"]+)">', output_text, re.IGNORECASE)
        cmds = re.findall(r'<roomate cmd="([^"]+)">', output_text, re.IGNORECASE)

        results = []
        if queries or cmds:
            print(f"\n[!] {model_name} is consulting the Local Roomate (AItech IPC)...")

            for q in queries:
                print(f" [QUERY] -> {q}")
                res = roomate_ipc(f"QUERY:{q}")
                print(f" [RESPONSE] <- {res[:100]}...")
                results.append("Roomate replied to query '{q}': {res}")

            for c in cmds:
                print(f" [CMD] -> {c}")
                res = roomate_ipc(f"CMD:{c}")
                print(f" [RESPONSE] <- {res}")
                results.append(f"Roomate replied to cmd '{c}': {res}")

        return "\n\n".join(results)

