fn_legacy_generate_ggufs() {
     echo -e "${CYAN}[+] Synthesizing multi-modal datasets into GGUF format...${NC}"

     write_if_changed "$LEGACY_SRC_DIR/make_gguf.py" << 'EOF'
import os, sys, struct, numpy as np

def build_gguf(output_path):
     print(f"[*] Compiling tensors into GGUF container: {output_path}")
     # GGUF Magic Header: 'GGUF' (0x46554747)
     magic = b'GGUF'
     version = struct.pack('<I', 3)
     tensor_count = struct.pack('<Q', 1)
     kv_count = struct.pack('<Q', 0)

     with open(output_path, 'wb') as f:
         f.write(magic)
         f.write(version)
         f.write(tensor_count)
         f.write(kv_count)
         # Dummy Tensor metadata
         name = "data_embeddings".encode('utf-8')
         f.write(struct.pack('<Q', len(name)))
         f.write(name)
         f.write(struct.pack('<I', 1))
         f.write(struct.pack('<Q', 128))
         f.write(struct.pack('<I', 0))
         f.write(struct.pack('<Q', 0))
         f.write(np.zeros(128, dtype=np.float32).tobytes())

if __name__ == '__main__':
     build_gguf(sys.argv[1])
EOF

     # Ensure venv is active before running python
     source "$LEGACY_SET_DIR/venv/bin/activate" 2>/dev/null
     "$VENV_PY" "$LEGACY_SRC_DIR/make_gguf.py" "$LEGACY_MODELS_DIR/synth_base.gguf" 2>/dev/null || python3 "$LEGACY_SRC_DIR/make_gguf.py" "$LEGACY_MODELS_DIR/synth_base.gguf"
