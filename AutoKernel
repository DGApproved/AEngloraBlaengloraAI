            "created":time.strftime("%Y-%m-%dT%H:%M:%S"),
            "host_os":host_os,"host_arch":host_arch,
        }
        if language=="asm":
            if host_os=="darwin" and host_arch in ("arm64","aarch64"):
                meta["artifacts"]={"source":"main.s","configure":"build.sh","build":"main.o","program":project}
                meta["asm_toolchain"]="clang arm64 assembler/linker"
                _oc_prog_write_if_missing(paths["source"]/"main.s",".text\n.globl _main\n.p2align 2\n_main:\n    mov w0, #0\n    ret\n")
            else:
                meta["artifacts"]={"source":"main.asm","configure":"build.sh","build":"main.o","program":project}
                meta["asm_toolchain"]="NASM + linker"
                _oc_prog_write_if_missing(paths["source"]/"main.asm","global _start\nsection .text\n_start:\n    mov rax, 60\n    xor rdi, rdi\n    syscall\n")
            _oc_prog_write_if_missing(paths["configure"]/"build.sh",_oc_prog_build_script(project,language),True)
        elif language=="c":
            meta["artifacts"]={"source":"main.c","configure":"build.sh","build":"main.o","program":project}
            _oc_prog_write_if_missing(paths["source"]/"main.c",'#include <stdio.h>\nint main(void){ puts("AItech programmer project"); return 0; }\n')
            _oc_prog_write_if_missing(paths["configure"]/"build.sh",_oc_prog_build_script(project,language),True)
        elif language=="java":
            meta["artifacts"]={"build":"Main.java","source":"Main.class","configure":"build.sh + dependencies.txt","program":project+".jar"}
            _oc_prog_write_if_missing(paths["build"]/"Main.java",'public class Main { public static void main(String[] args) { System.out.println("AItech programmer project"); } }\n')
            _oc_prog_write_if_missing(paths["configure"]/"dependencies.txt","Prerequisites: JDK with javac and jar on PATH.\n")
            _oc_prog_write_if_missing(paths["configure"]/"build.sh",_oc_prog_build_script(project,language),True)
        elif language=="bash":
            meta["artifacts"]={"program":project+".sh","configure":"dependencies.txt"}
            _oc_prog_write_if_missing(paths["program"]/(project+".sh"),'#!/usr/bin/env bash\necho "AItech programmer project"\n',True)
            _oc_prog_write_if_missing(paths["configure"]/"dependencies.txt","Bash directly runnable program.\n")
        elif language=="python":
            meta["artifacts"]={"program":project+".py","configure":"requirements.txt"}
            _oc_prog_write_if_missing(paths["program"]/(project+".py"),'#!/usr/bin/env python3\nprint("AItech programmer project")\n',True)
            _oc_prog_write_if_missing(paths["configure"]/"requirements.txt","")
        else:
            _oc_prog_write_if_missing(paths["configure"]/"README.txt",f"Language {language} is controlled by programmer.prefs. Define build/link steps for this project here.\n")
        _oc_prog_write_meta(project,meta)
        readme=paths["comments"]/"README.txt"
        _oc_prog_write_if_missing(readme,"Shared PROG context memory. Keep restoration/rationale/snippet notes here by referenced file type.\n")
        _oc_prog_record_tokens(project,1,"project_creation")
        _oc_prog_set_active(project,language,True)
        return True,paths

    def _oc_prog_session_path(project):
