def _tail_text(text, max_chars):
    """Keep the most recent material while preserving a truncation marker."""
    if len(text) <= max_chars:
        return text
    return "[...OLDER CONTENT OMITTED FROM ACTIVE CONTEXT...]\n" + text[-max_chars:]

def load_goddess_memory_context(total_budget=36000):
    """
    Load the writable GoddessMatrix memory layers in priority order.
    The files remain independent; this only creates a bounded prompt snapshot.
    Returns (combined_context, manifest).
    """
    sections = []
    manifest = []
    remaining = max(1000, int(total_budget))

    for spec in sorted(GODDESS_MEMORY_FILES, key=lambda s: s["priority"], reverse=True):
        path = spec["path"]
        if remaining <= 0 or not os.path.exists(path):
            continue
        try:
            sem = memory_semantics(path)
            raw = read_memory_file(
                path,
                what=f"{spec['role']} context",
                why=sem.get("purpose", f"load {spec['role']} into bounded active context"),
                refresh=False
            ).strip()
        except OSError as exc:
            manifest.append({"role": spec["role"], "path": path, "loaded": False, "error": str(exc)})
            continue
        if not raw:
            continue

        allowed = min(spec["max_chars"], remaining)
        selected = _tail_text(raw, allowed)
        sections.append(
            f"\n[GODDESS_MEMORY role={spec['role']} file={os.path.basename(path)}]\n"
            f"{selected}\n[/GODDESS_MEMORY]\n"
        )
        used = len(selected)
        remaining -= used
        manifest.append({
            "role": spec["role"], "path": path, "priority": spec["priority"],
            "source_chars": len(raw), "loaded_chars": used, "loaded": True,
        })

    try:
        with open(MEMORY_MANIFEST_JSON, "w", encoding="utf-8") as f:
            json.dump({"updated": time.strftime('%Y-%m-%dT%H:%M:%S'),
                       "budget": total_budget, "files": manifest}, f, indent=2)
    except OSError:
        pass

    # Append gentext dynamic store context AFTER named schema files.
    # Named files always load first and consume budget first; gentext
    # only fills remaining space so it never displaces established memory.
    gentext_ctx = _get_gentext_context_for_prompt(
        max_chars=min(6000, max(0, remaining))
    )

    # One refresh after the bounded memory scan prevents dozens of GUI rewrites
    # while still showing the most recently read semantic file.
    update_gui_stats(gui_progress_value, gui_progress_label, gui_system_message)
    return "".join(sections) + gentext_ctx, manifest

