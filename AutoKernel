    def roomate_ipc(command_str):
        """Sends a QUERY or CMD to the AItech interactive daemon on port 5678."""
        try:
            s = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
            s.settimeout(15.0)
            s.connect((QWEN_LOCAL_IP_CFG, QWEN_LOCAL_PORT_CFG))
            s.sendall(command_str.encode('utf-8'))
            response = s.recv(4096).decode('utf-8').strip()
            s.close()
            return response
        except ConnectionRefusedError:
            return f"ERR: Roomate daemon is offline or {QWEN_LOCAL_IP_CFG}:{QWEN_LOCAL_PORT_CFG} is unreachable."
        except socket.timeout:
            return "ERR: Roomate daemon timed out."
        except Exception as e:
            return f"ERR: Roomate IPC failed: {e}"

    # -------------------------------------------------------------------------
    # EGR VALVE (ENTROPY RECYCLING)
    # -------------------------------------------------------------------------
    # Exhaust Gas Recirculation: siphons the oldest bracketed group from
    # trash.xtx, records it losslessly in the EGR ledger (converting strings
    # >= 8 chars to HEX), and removes it from the entropy sink.
    # Mirrors the same function in chat_and_display_interactivev3.py so both
    # engines drain the shared trash.xtx file cooperatively.
    def process_egr_valve():
        if not os.path.exists(TRASH_XTX) or os.path.getsize(TRASH_XTX) == 0:
            return
        try:
            with open(TRASH_XTX, "r", encoding="utf-8", errors="ignore") as f:
                raw = f.read()
            if not raw:
                return

            import re as _re
            match = _re.search(r'\[(.*?)\]', raw, _re.DOTALL)
            if match:
                inner_text = match.group(1)
                remaining  = raw[match.end():]
            else:
                inner_text = raw[0]
                remaining  = raw[1:]

            with open(TRASH_XTX, "w", encoding="utf-8") as f:
                f.write(remaining)

            if not inner_text:
                return

            # Chemically reduce large chunks to hex
            if len(inner_text) >= 8:
                inner_text = inner_text.encode("utf-8", errors="ignore").hex().upper()

            char_key = f"[{inner_text}]"
            egr_data = {}
            if os.path.exists(EGR_LEDGER_JSON):
                try:
                    with open(EGR_LEDGER_JSON, "r", encoding="utf-8") as f:
                        egr_data = json.load(f)
                except Exception:
                    pass

            egr_data[char_key] = egr_data.get(char_key, 0) + 1
            sorted_egr = {k: egr_data[k] for k in sorted(egr_data.keys())}
            with open(EGR_LEDGER_JSON, "w", encoding="utf-8") as f:
                json.dump(sorted_egr, f, indent=2)
        except Exception:
            pass

    # -------------------------------------------------------------------------
    # SWAP ARCHIVIST HELPERS
    # -------------------------------------------------------------------------
    # These mirror peek_oldest_swap_chunk / commit_swap_removal from
    # chat_and_display so the orchestrator can process the same swap.txt pager
    # without the local PyTorch engine needing to be running simultaneously.
    def _peek_oldest_swap_chunk(lines_to_read=40):
        """Reads the oldest N lines from swap.txt without deleting them."""
        if not os.path.exists(SWAP_FILE):
            return None, None
        try:
            with open(SWAP_FILE, "r", encoding="utf-8") as f:
                lines = f.readlines()
            if not lines:
                return None, None
            chunk     = lines[:lines_to_read]
            remaining = lines[lines_to_read:]
            cleaned   = (
                "".join(chunk)
                .replace("[", "").replace("] ", "").replace("]\n", " ")
                .replace("\u21b5", "\n").strip()
            )
            return (cleaned if cleaned else None), remaining
        except Exception:
            return None, None

    def _commit_swap_removal(remaining_lines):
        """Physically removes processed lines from swap.txt."""
        try:
            with open(SWAP_FILE, "w", encoding="utf-8") as f:
                f.writelines(remaining_lines)
        except Exception:
            pass

    def orchestrator_process_swap():
        """
        Lossless swap archivist using the orchestrator's Qwen access.

        Reads the oldest chunk from swap.txt, sends it to Qwen (via KoboldCpp
        if connected, otherwise via LiteLLM), parses the returned <file> tags,
        writes to the correct session.noq semantic stores, then commits the
        removal from swap.txt.

        Mirrors process_swap_with_qwen() in chat_and_display without requiring
        the local PyTorch model to be running.
        """
        if developer_flow_paused:
            return False
        oldest_data, remaining_lines = _peek_oldest_swap_chunk()
        if not oldest_data:
            return False

        with ui_lock:
            sys.stdout.write("\r\033[K[Orchestrator Archivist] Processing oldest swap chunk losslessly...\n")
            sys.stdout.flush()

        schema_str = "\n".join([
            f"- {f}: {s.get('role')} (Accepts: {s.get('accepts')})"
            for f, s in MEMORY_SEMANTICS.items()
        ])
        archivist_header = _oprompt(
            "SEMANTIC_ARCHIVIST",
            "You are the Semantic Archivist. Losslessly convert raw swap memory into semantic text files. Preserve all information."
        )
        capability_reference = orchestrator_qwen_map_reference()
        prompt = (
            f"<|im_start|>system\n{archivist_header}\n"
            + (f"<AItechCapabilityReference>\n{capability_reference}\n</AItechCapabilityReference>\n" if capability_reference else "")
            + "Available stores:\n"
            f"{schema_str}\n"
            "- trash.xtx: UNRESOLVED ENTROPY — route uncategorizable noise here. "
            "NEVER DELETE DATA.\n"
            "Example: <file path=\"session.noq/dgapi/datas/facts.txt\">fact</file>\n"
            "Encapsulate 100%% of input into <file> tags. Lossless is mandatory."
            "<|im_end|>\n"
            f"<|im_start|>user\nAnalyze this raw swap data losslessly:\n{oldest_data}"
            "<|im_end|>\n<|im_start|>assistant\n"
        )

        try:
            if KOBOLDCPP_URL and not DIRECT_GGUF_MODE:
                qwen_reply = koboldcpp_generate(prompt, max_length=QWEN_ARCHIVIST_MAX_CFG)
            else:
                res = completion(
                    model=LOCAL_MODEL,
                    messages=[{"role": "user", "content": prompt}],
                    api_base=MODEL_CONFIGS[LOCAL_MODEL]["api_base"]
                )
                qwen_reply = res.choices[0].message.content.strip()
        except Exception as exc:
            update_gui_chat("SYS", f"Swap archivist error: {exc}")
            return False

        with ui_lock:
            sys.stdout.write("\r\033[K" + terminal_autonomous(f"[Archivist -> Memory] {qwen_reply[:120]}...") + "\n")
            sys.stdout.flush()

        # Parse <file> tags and route to semantic stores
        import re as _re
        file_writes = _re.findall(
            r'<file path="([^"]+)">\s*(.*?)\s*</file>',
            qwen_reply, _re.DOTALL | _re.IGNORECASE
        )
        for file_path, file_content in file_writes:
            filename = os.path.basename(file_path.strip())
            # Route to trash.xtx if that's the target
            if filename == "trash.xtx":
                target = TRASH_XTX
            else:
                # Try each semantic root
                roots = [
                    str(NOQ_DIR / "dgapi" / "datas"),
                    str(NOQ_DIR / "dgapi" / "virtual"),
                    MEMORY_DIR,
                ]
                target = None
                for root in roots:
                    candidate = os.path.join(root, filename)
                    if os.path.exists(candidate) or filename in MEMORY_SEMANTICS:
                        target = candidate
                        break
                if target is None:
                    target = str(NOQ_DIR / "dgapi" / "datas" / filename)

            try:
                append_semantic_memory(
                    target,
                    f"\n{file_content.strip()}\n",
                    what="lossless swap archival",
                    why="swap archivist redistributing paged-out context tokens"
                )
            except Exception:
                pass

        _commit_swap_removal(remaining_lines)
        update_gui_chat("SYS", "Swap chunk archived losslessly.")
        return True

    def orchestrator_ponder():
        """
        Orchestrator-native pondering cycle.

        Generates two outputs from a base and mutated prompt (mirroring the
        chat engine's do_ponder) using KoboldCpp if connected, otherwise
        LiteLLM.  Interest score is computed from output similarity and
        published to the pinned header.

        The orchestrator does not write to amdream.txt directly — it sends
        the ponder result back to the chat engine via roomate_ipc so the
        local model can absorb it into its session history.
        """
        global bg_tokens_total, daemon_status

        capability_reference = orchestrator_qwen_map_reference()
        map_hint = (
            "\nUse the supplied AItech capability maps when interpreting this thought.\n"
            + capability_reference
            if capability_reference else ""
        )
        base_str = "What is the nature of aengloria and unified memory?" + map_hint
        mutated_str = list(base_str)
        if len(mutated_str) > 3:
            idx = random.randint(0, len(mutated_str) - 1)
            mutated_str[idx] = random.choice("abcdefghijklmnopqrstuvwxyz")
        mutated_str = "".join(mutated_str)

        try:
            if KOBOLDCPP_URL and not DIRECT_GGUF_MODE:
                b_text = koboldcpp_generate(
                    f"User: {base_str}\nAssistant:", max_length=40
                )
                m_text = koboldcpp_generate(
                    f"User: {mutated_str}\nAssistant:", max_length=40
                )
            else:
                for prompt, attr in [(base_str, "b_text"), (mutated_str, "m_text")]:
                    res = completion(
                        model=LOCAL_MODEL,
                        messages=[{"role": "user", "content": prompt}],
                        api_base=MODEL_CONFIGS[LOCAL_MODEL]["api_base"]
                    )
                    if res.usage:
                        bg_tokens_total += res.usage.total_tokens
                    if attr == "b_text":
                        b_text = res.choices[0].message.content.strip()
                    else:
                        m_text = res.choices[0].message.content.strip()
        except Exception:
            return

        import difflib as _dl
        interest = 1.0 - _dl.SequenceMatcher(None, b_text, m_text).ratio()
        clean = m_text.replace("\n", " ")
        with ui_lock:
            sys.stdout.write(
                "\r\033[K" + terminal_autonomous(
                    f"[OrchestratorPonder] {mutated_str[:20]} -> {clean[:40]} "
                    f"[Interest: {interest:.2f}]"
                ) + "\n"
            )
            sys.stdout.flush()
        update_gui_chat("SYS", f"Ponder: interest={interest:.2f}")

        # Forward ponder result to the chat engine so it can absorb it
        try:
            roomate_ipc(
                f"QUERY:Orchestrator ponder result (interest={interest:.2f}): {m_text}"
            )
        except Exception:
            pass


