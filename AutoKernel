def inject_tokenizer_patches(tokenizer, model):
    gpu_chars = os.path.join(GPU_DIR, "characters.txt")
    if not os.path.exists(gpu_chars):
        return
    new_tokens = []
    try:
        with open(gpu_chars, "r", encoding="utf-8") as f:
            for line in f:
                if line.startswith("[") and "][" in line:
                    parts = line.strip("[]\n").split("][")
                    if len(parts) >= 3:
                        symbol = parts[1]
                        name_token = f"<{parts[2].upper()}>"
