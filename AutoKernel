#!/usr/bin/env bash
# AItech user tool: open an external terminal window.
#
# Usage:  openterm.code [command ...]
#   with a command   opens a terminal running it, held open afterwards
#   with no command  opens a plain shell in the AItech root
#
# Provided as a tool rather than as engine behaviour: AItech itself does not need
# a second window, since output scrolls above a pinned input box in the terminal
# already in use. A user who wants one asks for it, which is what this is.
cd "${AITECH_ROOT:-$PWD}" 2>/dev/null || true

if [ "$#" -gt 0 ]; then
    CMD="$*"
    HOLD="; echo; read -p 'Press Enter to close...'"
else
    CMD="${SHELL:-/bin/bash}"
    HOLD=""
fi

case "$(uname -s 2>/dev/null)" in
    Darwin)
   osascript -e "tell application \"Terminal\" to do script \"cd $(pwd) && $CMD\"" >/dev/null 2>&1 \
       && echo "[openterm] Opened Terminal." \
       || echo "[openterm] Could not open Terminal."
   ;;
    CYGWIN*|MINGW*|MSYS*)
   cmd /c start cmd /k "$CMD" >/dev/null 2>&1 \
       && echo "[openterm] Opened cmd." \
       || echo "[openterm] Could not open cmd."
   ;;
    *)
   TERM_BIN=""
   for c in x-terminal-emulator gnome-terminal konsole xfce4-terminal xterm; do
       command -v "$c" >/dev/null 2>&1 && { TERM_BIN="$c"; break; }
   done
   if [ -z "$TERM_BIN" ]; then
       echo "[openterm] No supported terminal emulator found."
       exit 1
   fi
   if [ "$TERM_BIN" = "gnome-terminal" ]; then
       "$TERM_BIN" -- bash -lc "$CMD$HOLD" >/dev/null 2>&1 &
   else
       "$TERM_BIN" -e bash -lc "$CMD$HOLD" >/dev/null 2>&1 &
   fi
   echo "[openterm] Opened $TERM_BIN."
   ;;
esac
EOF

