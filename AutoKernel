def _load_json_safe(path):
    """Load a JSON file, returning None on missing or corrupt."""
    if not os.path.exists(path):
        return None
    try:
        with open(path, "r", encoding="utf-8") as f:
            return json.load(f)
    except Exception:
        return None

def load_memory_semantics():
    data = _load_json_safe(MEMORY_SCHEMA_PATH)
    return data.get("files", {}) if data else {}

def load_gentext_semantics():
    data = _load_json_safe(GENTEXT_SCHEMA_PATH)
    return data.get("files", {}) if data else {}

