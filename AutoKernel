    def ingest_file_to_companion(file_path_str):
        clean_path = file_path_str.strip().strip("'\"")
        src = Path(clean_path).expanduser().resolve()
        if not src.exists(): return f"[!] File not found: {src}"

        category = "general"
        ext = src.suffix.lower()

        if ext in [".txt", ".md", ".sh", ".py", ".c", ".cpp", ".h"]:
            category = "code_and_text"
            extracted_text = src.read_text(encoding="utf-8", errors="ignore")
        elif ext == ".pdf":
            category = "documentation_manuals"
            if PYPDF_AVAILABLE:
                try:
                    reader = pypdf.PdfReader(str(src))
                    extracted_text = "\n".join([page.extract_text() or "" for page in reader.pages])
                except Exception as e: extracted_text = f"[PDF Error: {e}]"
            else: extracted_text = f"[PDF Detected. Install 'pypdf' for text extraction.]"
        elif ext in [".png", ".jpg", ".jpeg"]:
            category = "visual_media"
            extracted_text = f"[Image Detected: {src.name}]"
        else:
            category = "binary_assets"
            extracted_text = f"[Binary/Unrecognized Asset: {src.name}]"

        timestamp = int(time.time())

        # INTAKE POLICY — free use, not duplication. An absorbed source is read
        # for what it means, the way an author reads for inspiration without
        # reproducing the work. What is retained is DERIVED: a structural
        # digest, vocabulary, entities, and provenance sufficient to cite the
        # source without reprinting it. The source text itself is NOT kept as a
        # note and the original file is NOT copied into the companion tree.
        #
        # What could not be reduced to derived observations is routed to the
        # internal dgapi overflow store inside session.noq as an unresolved
        # work queue, to be reinterpreted on later processing loops and drained
        # as fragments resolve. Retention of raw material and of binary assets
        # is delegated to disk_orchestrator.py, the resident administrator,
        # which holds and sequences them under its own archive discipline.
        # See the generated intake_policy.txt and dgapi_duality.txt maps.
        digest = _derive_intake_observations(src, category, extracted_text)
        dest_note = NOTEBOOKS_DIR / f"{src.stem}_{timestamp}.derived.txt"
        dest_note.write_text(digest, encoding="utf-8")

        fragments = _queue_intake_overflow(src, category, extracted_text, timestamp)

        return (f"[✓] Absorbed '{src.name}' as derived observations. "
                f"{fragments} passage(s) queued to overflow for interpretation.")

    def _derive_intake_observations(src, category, extracted_text):
        """Structural and lexical observations only — never the source text."""
        text = extracted_text or ""
        words = re.findall(r"[A-Za-z][A-Za-z'-]{2,}", text)
        lowered = [w.lower() for w in words]
        stop = {
            "the","and","that","for","with","this","from","have","has","was","were",
            "are","not","but","they","their","them","its","his","her","she","him",
            "you","your","all","any","can","will","would","which","when","what",
            "there","been","one","two","out","who","how","into","than","then","also",
        }
        freq = {}
        for w in lowered:
            if w in stop:
                continue
            freq[w] = freq.get(w, 0) + 1
        vocabulary = sorted(freq.items(), key=lambda kv: (-kv[1], kv[0]))[:40]
        # Entity candidates: capitalised runs that are not sentence-initial only.
        entities = {}
        for m in re.finditer(r"\b([A-Z][a-z]{2,}(?:[ ]+[A-Z][a-z]{2,}){0,3})\b", text):
            name = m.group(1)
            if name.lower() in stop:
                continue
            entities[name] = entities.get(name, 0) + 1
        entity_list = sorted(entities.items(), key=lambda kv: (-kv[1], kv[0]))[:25]
        headings = re.findall(r"^\s{0,3}(?:#{1,6}\s+|\d+[.)]\s+)(.{3,80})$", text, re.M)[:25]

        lines_out = [
            f"--- DERIVED INTAKE OBSERVATIONS ---",
            f"SOURCE: {src.name}",
            f"CATEGORY: {category}",
            f"ABSORBED: {time.strftime('%Y-%m-%dT%H:%M:%S')}",
            f"PROVENANCE: user-supplied intake; free-use absorption; source not retained",
            "",
            f"[STRUCTURE] characters={len(text)} words={len(words)} "
            f"lines={text.count(chr(10)) + 1 if text else 0} "
            f"distinct_terms={len(freq)}",
            "",
            "[VOCABULARY] most frequent non-trivial terms and counts",
        ]
        lines_out += [f"  {w} = {c}" for w, c in vocabulary] or ["  (none)"]
        lines_out += ["", "[ENTITY CANDIDATES] UNCONFIRMED until corroborated"]
        lines_out += [f"  {n} = {c}" for n, c in entity_list] or ["  (none)"]
        lines_out += ["", "[STRUCTURAL MARKERS] headings or numbered sections observed"]
        lines_out += [f"  {h.strip()}" for h in headings] or ["  (none)"]
        lines_out += [
            "",
            "[STATUS] Derived observations only. The source work is not stored here.",
            "[STATUS] Unresolved passages are queued in session.noq/dgapi/overflow/.",
        ]
        return "\n".join(lines_out) + "\n"

    def _queue_intake_overflow(src, category, extracted_text, timestamp):
        """Queue unresolved passages inside the world for later interpretation.

        This is a work queue, not an archive: the orchestrator and the engines
        drain it as fragments are understood. It lives inside session.noq so the
        world boundary and the intake policy both hold.
        """
        text = (extracted_text or "").strip()
        if not text or category in ("visual_media", "binary_assets"):
            return 0
        try:
            overflow_dir = AITECH_ROOT / "session.noq" / "dgapi" / "overflow"
            overflow_dir.mkdir(parents=True, exist_ok=True)
        except Exception:
            return 0
        paragraphs = [p.strip() for p in re.split(r"\n\s*\n", text) if p.strip()]
        if not paragraphs:
            paragraphs = [text]
        target = overflow_dir / f"{src.stem}_{timestamp}.unresolved.txt"
        offset = 0
        rows = [
            f"--- UNRESOLVED INTAKE OVERFLOW ---",
            f"SOURCE: {src.name}",
            f"CATEGORY: {category}",
            f"STATUS: UNKNOWN — not yet understood; not fact; not memory",
            f"POLICY: drain as passages resolve; do not promote without interpretation",
            "",
        ]
        for idx, para in enumerate(paragraphs, 1):
            rows.append(f"[PASSAGE {idx} | offset {offset} | chars {len(para)}] UNRESOLVED")
            offset += len(para) + 2
        try:
            target.write_text("\n".join(rows) + "\n", encoding="utf-8")
        except Exception:
            return 0
        return len(paragraphs)

    def retrieve_companion_context(prompt_query, max_chars=2500):
        if not REF_MANUAL_PATH.exists(): return ""
        manual_content = REF_MANUAL_PATH.read_text(encoding="utf-8", errors="ignore")
        if len(manual_content) <= 300: return ""

        keywords = [w.lower() for w in re.findall(r'\b[a-zA-Z0-9_-]{4,}\b', prompt_query) if w.lower() not in ["look", "this", "what", "with", "from", "make"]]
        relevant_sections = []
        sections = manual_content.split("### ")
        for sec in sections[1:]:
            sec_lower = sec.lower()
            if any(kw in sec_lower for kw in keywords):
                relevant_sections.append("### " + sec.strip())

        if relevant_sections:
            combined = "\n\n".join(relevant_sections)
            return f"\n[COMPANION REFERENCE MANUAL KNOWLEDGE]\n{combined[:max_chars]}\n[/COMPANION REFERENCE MANUAL]\n"
        return ""

