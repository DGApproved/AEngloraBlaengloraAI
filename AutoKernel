def _prog_project_valuation(processed_tokens,events):
    """
    Attention-derived valuation signal, not a quality judgment.
    Log scaling prevents huge projects from dominating only because they are huge.
    """
    processed=max(0,int(processed_tokens or 0))
    events=max(0,int(events or 0))
    score=round(math.log10(processed+1)*10.0 + min(events,1000)*0.01,4)
    if processed<=0:
        meaning="no recorded model processing yet"
    elif processed<1000:
        meaning="lightly processed / early project context"
    elif processed<10000:
        meaning="established project context"
    elif processed<100000:
        meaning="deeply processed project context"
    else:
        meaning="very high accumulated model attention"
    return {"token_attention_score":score,"interpretation":meaning}

def _prog_record_tokens(project,token_count,activity="interaction",note=""):
    project=_prog_safe_name(project)
    try:
        token_count=max(0,int(token_count))
    except Exception:
        token_count=0
    if token_count<=0:
        return _prog_load_token_ledger(project)
    ledger=_prog_load_token_ledger(project)
    ledger["processed_tokens"]=int(ledger.get("processed_tokens",0))+token_count
    ledger["events"]=int(ledger.get("events",0))+1
    by=dict(ledger.get("by_activity") or {})
    by[activity]=int(by.get(activity,0))+token_count
    ledger["by_activity"]=by
    ledger["last_update"]=time.strftime("%Y-%m-%dT%H:%M:%S")
    ledger["valuation"]=_prog_project_valuation(ledger["processed_tokens"],ledger["events"])
    if note:
        ledger["last_note"]=str(note)[:500]
    path=_prog_token_ledger_path(project)
    os.makedirs(os.path.dirname(path),exist_ok=True)
    try:
        Path(path).write_text(json.dumps(ledger,indent=2)+"\n",encoding="utf-8")
    except OSError:
        pass
    # Mirror the current totals into project metadata in every stage.
    meta=_prog_read_metadata(project)
    if meta:
        meta["processed_tokens"]=ledger["processed_tokens"]
        meta["token_events"]=ledger["events"]
        meta["project_valuation"]=ledger["valuation"]
        _prog_write_metadata(project,meta)
    return ledger

def _prog_estimate_tokens(text):
    """Use the active tokenizer when available; otherwise fall back to a conservative text estimate."""
    value=str(text or "")
    if not value:
        return 0
    tok=globals().get("tokenizer")
    if tok is not None:
        try:
            return len(tok.encode(value,add_special_tokens=False))
        except Exception:
            pass
    # Approximate ~4 characters/token for ordinary source/prose if tokenizer is unavailable.
    return max(1,(len(value)+3)//4)

def _prog_record_text_tokens(project,text,activity="interaction",note=""):
    return _prog_record_tokens(project,_prog_estimate_tokens(text),activity,note)


