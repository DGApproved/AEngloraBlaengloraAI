#!/usr/bin/env python3
import argparse, base64, hashlib, json, mimetypes, os, time
from pathlib import Path

MAGIC = "DGA/1"
FORMAT_NAME = "DGApproved"
FORMAT_VERSION = 1

def _now():
    return time.strftime("%Y-%m-%dT%H:%M:%S%z")

def _json_line(obj):
    return json.dumps(obj, ensure_ascii=False, sort_keys=True, separators=(",", ":"))

class DGAFile:
    """Append-oriented DGApproved container.

    mode='r'  read-only: inspect/verify only
    mode='a'  append: existing container required
    mode='w'  create: refuses to overwrite an existing non-empty container
    """
    def __init__(self, path, mode="r", seed=None):
        self.path = Path(path)
        self.mode = mode
        if mode not in {"r", "a", "w"}:
            raise ValueError("DGA mode must be r, a, or w")
        if mode == "w":
            if self.path.exists() and self.path.stat().st_size:
                raise FileExistsError(f"Refusing to overwrite existing DGA: {self.path}")
            self.path.parent.mkdir(parents=True, exist_ok=True)
            header = {
                "type": "header", "format": FORMAT_NAME, "version": FORMAT_VERSION,
                "created": _now(), "seed": seed, "append_only": True,
            }
            self.path.write_text(MAGIC + "\n" + _json_line(header) + "\n", encoding="utf-8")
        self._validate_header()
        if mode == "a" and not self.path.exists():
            raise FileNotFoundError(self.path)

    def _validate_header(self):
        if not self.path.is_file():
            raise FileNotFoundError(self.path)
        with self.path.open("r", encoding="utf-8", errors="strict") as f:
            magic = f.readline().rstrip("\n")
            if magic != MAGIC:
                raise ValueError(f"Not a {MAGIC} container")
            header = json.loads(f.readline())
            if header.get("format") != FORMAT_NAME or int(header.get("version", 0)) != FORMAT_VERSION:
                raise ValueError("Unsupported DGA header")

    def records(self):
        with self.path.open("r", encoding="utf-8", errors="strict") as f:
            f.readline()
            f.readline()
            for line_no, raw in enumerate(f, 3):
                raw = raw.strip()
                if not raw:
                    continue
                obj = json.loads(raw)
                obj.setdefault("_line", line_no)
                yield obj

