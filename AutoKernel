def get_qwen_map_reference(max_chars=None):
    """Return a bounded, provenance-labelled digest of generated AItech map TXT files."""
    if not QWEN_MAP_CONTEXT_ENABLED_CFG:
        return ""
    budget = int(max_chars or QWEN_MAP_CONTEXT_MAX_CHARS_CFG)
    budget = max(1024, min(131072, budget))
    existing = []
    for label, path in QWEN_MAP_REFERENCE_FILES:
        try:
            if os.path.isfile(path) and os.path.getsize(path) > 0:
                existing.append((label, path))
        except OSError:
            continue
    if not existing:
        return (
            "[AItech generated map reference unavailable: run prepare_graph_data.py "
            "or regenerate session.noq/data before relying on capability-map context.]"
        )

    # Fair-share the budget so multimodal_sensory.txt cannot crowd out environment,
    # memory, IPC, or training maps (and vice versa).
    per_file = max(256, budget // max(1, len(existing)))
    chunks = []
    used = 0
    for label, path in existing:
        remaining = budget - used
        if remaining <= 0:
            break
        take = min(per_file, remaining)
        try:
            with open(path, "r", encoding="utf-8", errors="ignore") as f:
                content = f.read(take)
        except OSError:
            continue
        if not content:
            continue
        rel = os.path.relpath(path, SESSION_DIR)
        block = f"\n--- MAP: {label} | {rel} ---\n{content.strip()}\n"
        if len(block) > remaining:
            block = block[:remaining]
        chunks.append(block)
        used += len(block)

    if not chunks:
        return ""
    header = _prompt_header(
        "QWEN_CAPABILITY_MAP",
        "Use the following generated AItech map data as bounded operational reference. "
        "Preserve provenance and distinguish AItech-native theory from external fact."
    )
    return f"{header}\n{''.join(chunks)}"

