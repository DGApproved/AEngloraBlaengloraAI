            rows.append({"name": path.stem, "path": str(path), "target": meta.get("PLUGIN_TARGET", "LEGACY"), "class": meta.get("PLUGIN_CLASS", "LEGACY"), "bridge": meta.get("BRIDGE_EXPORT", "NO").upper() in ("YES", "TRUE", "1"), "bridge_name": meta.get("BRIDGE_NAME", path.stem)})
        return rows

    def orchestrator_execute_plugin(plugin_name, args="", timeout=30, bridge=False):
        """Execute an orchestrator-native plugin or an explicitly exported bridge capability."""
        for row in orchestrator_plugin_inventory():
            native = row["target"].upper() == "ORCHESTRATOR"
            exported = row["bridge"] and row["bridge_name"] == plugin_name
            if not ((native and row["name"] == plugin_name) or (bridge and exported)):
                continue
            try:
                os.chmod(row["path"], 0o755)
                env = os.environ.copy()
                env["AITECH_PLUGIN_CALLER"] = "ORCHESTRATOR"
                env["AITECH_PLUGIN_NATIVE_TARGET"] = row["target"]
                env["AITECH_PLUGIN_BRIDGE_CALL"] = "1" if bridge else "0"
                cmd = [row["path"]] + (args.split() if args else [])
                r = subprocess.run(cmd, capture_output=True, text=True, timeout=timeout, env=env)
                return (r.stdout.strip() or r.stderr.strip() or "[Executed with no output]")
            except Exception as e:
                return f"[Plugin error: {e}]"
        return f"[Plugin '{plugin_name}' is not native to orchestrator or explicitly bridge-exported]"

    def orchestrator_contributor_provenance():
        """Parse revision/devname feature provenance from the launched AItech header/changelog."""
        source,path=_oc_read_launcher_source()
        if not source:
            return []
        header=source[:30000]
        # Current revision origin from title/header.
        current_dev=""
        current_version=""
        mdev=re.search(r"(?mi)^#\s*Development origin:\s*(.+?)\s*$",header)
        mver=re.search(r"(?mi)^#\s*Current revision:\s*(v[0-9.]+)\s*$",header)
        if mdev: current_dev=mdev.group(1).strip()
        if mver: current_version=mver.group(1).strip()
        rows=[]
        # Changelog entries may optionally include an explicit -(devname).
        # If absent, current revision inherits current Development origin; historical
        # entries remain origin=unknown rather than fabricating attribution.
        for mm in re.finditer(
            r"(?m)^#\s*(v[0-9.]+)(?:\s*-\s*([A-Za-z0-9_.+-]+))?\s+(.+?)(?=\n#\s*(?:v[0-9.]+|Earlier\b|={3,})|\Z)",
            header,
            re.S
        ):
            version=mm.group(1).strip()
            explicit=(mm.group(2) or "").strip()
            desc=" ".join(x.strip(" #\t") for x in mm.group(3).splitlines()).strip()
            dev=explicit or (current_dev if version==current_version else "unknown")
            rows.append({"version":version,"devname":dev,"feature":desc})
        return rows

    def orchestrator_contributor_reference(query="", max_chars=7000):
        rows=orchestrator_contributor_provenance()
        if not rows:
            return "[AItech contributor provenance unavailable from current launcher.]"
        qwords=set(re.findall(r"[a-z0-9_+-]{3,}",str(query or "").lower()))
        scored=[]
        for row in rows:
            hay=(row["feature"]+" "+row["version"]+" "+row["devname"]).lower()
            score=sum(1 for w in qwords if w in hay)
            scored.append((score,row))
        scored.sort(key=lambda x:(x[0],x[1]["version"]),reverse=True)
        lines=[
            "[AItech contributor / feature provenance]",
            "Use only explicit devname attribution when available. origin=unknown means do not guess.",
            "This provenance may be used to recommend an assistance order when the user asks which LLM/developer should help.",
        ]
        for score,row in scored[:16]:
            lines.append(f"{row['version']} | origin={row['devname']} | relevance={score} | {row['feature']}")
        return "\n".join(lines)[:max_chars]

    def orchestrator_self_source_reference(query="", max_chars=16000):
        if not _oc_self_question(query):
            return ""
        source,path=_oc_read_launcher_source()
        identity=(
            "[AItech CURRENT runtime self-source]\n"
            f"version={AITECH_RUNNING_VERSION or 'unknown'}\n"
            f"development_origin={AITECH_RUNNING_DEVNAME or 'unknown'}\n"
            f"canonical_filename={AITECH_RUNNING_FILENAME or 'unknown'}\n"
            f"launched_from={path or 'unavailable'}\n"
            "Authority: this launched source outranks archived/training revisions for CURRENT functionality. "
            "Historical scripts are developmental ancestry/reference only.\n"
        )
        if not source:
            return identity+"[Launcher source unavailable for scanning.]"
        budget=max(1024,min(40000,int(max_chars)))
        header=source[:min(9000,budget//2)]
        words=[]
        for word in re.findall(r"[A-Za-z_][A-Za-z0-9_:+<>\-]{2,}",str(query or "").lower()):
            if word not in {"what","does","your","you","the","this","that","with","about","from","have","can","are","how","its"} and word not in words:
                words.append(word)
        low=source.lower(); windows=[]; seen=set()
        for word in words[:12]:
            pos=0; hits=0
            while hits<3:
                at=low.find(word,pos)
                if at<0: break
                a=max(0,at-700); b=min(len(source),at+700); key=(a//300,b//300)
                if key not in seen:
                    seen.add(key); windows.append(source[a:b])
                hits+=1; pos=at+len(word)
        result=identity+"\n--- current source header / feature index ---\n"+header
        if windows:
            result+="\n\n--- query-matched current-source windows ---\n"+"\n\n--- source window ---\n".join(windows)
        if any(x in str(query or "").lower() for x in ("contribut","who made","who added","who implemented","best help","assistance","which llm","ask for help")):
            result+="\n\n"+orchestrator_contributor_reference(query)
