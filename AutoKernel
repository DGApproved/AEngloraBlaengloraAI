def register_peer_engine(engine_name, specialization=None):
    """
    Activation order establishes default PRIMARY/SECONDARY orchestration only.
    Both peers expose the same shared contract; specialization advertises model
    strengths without removing any shared role from the other engine.
    """
    name = str(engine_name).upper()
    state = _load_engine_roles()
    peers = state.setdefault("peers", {})
    # Remove stale crashed processes before assigning order.
    for other in list(peers):
        if peers[other].get("active") and not _pid_alive(peers[other].get("pid")):
            peers[other]["active"] = False
    now = time.time()
    rec = peers.get(name, {})
    if not rec.get("active"):
        rec["activated_epoch"] = now
    rec.update({
        "active": True,
        "pid": os.getpid(),
        "protocol_version": AITECH_ENGINE_PROTOCOL_VERSION,
        "shared_capability_revision": AITECH_SHARED_CAPABILITY_REVISION,
        "capabilities": dict(_SHARED_ENGINE_CAPABILITIES),
        "specialization": specialization or {},
        "last_seen_epoch": now,
    })
    peers[name] = rec
    ordered = sorted(
        (n for n,r in peers.items() if r.get("active")),
        key=lambda n: float(peers[n].get("activated_epoch", now))
    )
    state["activation_order"] = ordered
    state["primary_engine"] = ordered[0] if ordered else None
    state["secondary_engine"] = ordered[1] if len(ordered) > 1 else None
    state.setdefault("role_assignment", {
        "semantic_intent": "PRIMARY",
        "lexical_selection": "PRIMARY",
        "secondary_review": "SECONDARY",
        "prosody_planning": "SECONDARY",
        "final_response": "PRIMARY",
    })
    state["updated_epoch"] = now
    _save_engine_roles(state)
    return state


def unregister_peer_engine(engine_name):
    state = _load_engine_roles()
    peers = state.setdefault("peers", {})
    name = str(engine_name).upper()
    if name in peers:
        peers[name]["active"] = False
        peers[name]["last_seen_epoch"] = time.time()
    ordered = sorted(
        (n for n,r in peers.items() if r.get("active") and _pid_alive(r.get("pid"))),
        key=lambda n: float(peers[n].get("activated_epoch", 0))
    )
    state["activation_order"] = ordered
    state["primary_engine"] = ordered[0] if ordered else None
    state["secondary_engine"] = ordered[1] if len(ordered) > 1 else None
    state["updated_epoch"] = time.time()
    _save_engine_roles(state)


def peer_engine_context(engine_name):
    state = register_peer_engine(engine_name)
    peers = state.get("peers", {})
    me = peers.get(str(engine_name).upper(), {})
    role = "PRIMARY" if state.get("primary_engine") == str(engine_name).upper() else (
        "SECONDARY" if state.get("secondary_engine") == str(engine_name).upper() else "ACTIVE_PEER"
    )
    return (
