#!/usr/bin/env bash
set -u

INSTALL_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
AIDEV_ROOT="$(dirname "$INSTALL_DIR")"
TARGET_DIR="$AIDEV_ROOT/KoboldCpp"
TARGET="$TARGET_DIR/koboldcpp"
PREFS="$AIDEV_ROOT/prefs.sh"

echo
echo "KoboldCpp"
echo "---------"
echo "KoboldCpp is an optional local inference backend."
echo "It loads the GGUF selected by AItech and exposes that model through"
echo "a local API for the orchestrator and, optionally, SillyTavern."
echo
echo "AItech can still use its alternate/direct behavior when this component"
echo "is intentionally disabled with KOBOLDCPP_PATH=no."
echo
echo "Install location:"
echo "  $TARGET"
echo

if [[ -x "$TARGET" ]]; then
    echo "[KoboldCpp] Already installed."
    exit 0
fi

read -r -p "Install KoboldCpp now? [y/N]: " answer
[[ "${answer,,}" == "y" ]] || {
    echo "[KoboldCpp] Installation skipped."
    exit 0
}

mkdir -p "$TARGET_DIR"

OS="$(uname -s)"
ARCH="$(uname -m)"
URL=""

if [[ "$OS" == "Linux" && "$ARCH" == "x86_64" ]]; then
    echo
    echo "Choose a Linux build:"
    echo "  1) Standard — CUDA/NVIDIA oriented"
    echo "  2) NoCUDA   — CPU/Vulkan friendly; useful for AMD/non-CUDA"
    echo "  3) OldPC    — older CPU/GPU compatibility"
    read -r -p "Select [1-3, default 2]: " build
    build="${build:-2}"
    case "$build" in
        1) URL="https://github.com/LostRuins/koboldcpp/releases/latest/download/koboldcpp-linux-x64" ;;
        3) URL="https://github.com/LostRuins/koboldcpp/releases/latest/download/koboldcpp-linux-x64-oldpc" ;;
        *) URL="https://github.com/LostRuins/koboldcpp/releases/latest/download/koboldcpp-linux-x64-nocuda" ;;
    esac
elif [[ "$OS" == "Darwin" && "$ARCH" == "arm64" ]]; then
    URL="https://github.com/LostRuins/koboldcpp/releases/latest/download/koboldcpp-mac-arm64"
else
    echo "[KoboldCpp] Automatic binary selection is not configured for:"
    echo "  OS=$OS ARCH=$ARCH"
    echo "Download a compatible KoboldCpp binary and place it at:"
    echo "  $TARGET"
    exit 0
fi

TMP="${TARGET}.part"

if command -v curl >/dev/null 2>&1; then
    curl -L --fail --progress-bar "$URL" -o "$TMP" || {
        rm -f "$TMP"
        echo "[KoboldCpp] Download failed."
        exit 1
    }
elif command -v wget >/dev/null 2>&1; then
    wget --show-progress -O "$TMP" "$URL" || {
        rm -f "$TMP"
        echo "[KoboldCpp] Download failed."
        exit 1
    }
else
    echo "[KoboldCpp] curl or wget is required."
    exit 1
fi

mv "$TMP" "$TARGET"
chmod +x "$TARGET"

if [[ -f "$PREFS" ]] && grep -q '^KOBOLDCPP_PATH=' "$PREFS"; then
    if sed --version >/dev/null 2>&1; then
        sed -i "s|^KOBOLDCPP_PATH=.*|KOBOLDCPP_PATH=$TARGET|" "$PREFS"
    else
        sed -i '' "s|^KOBOLDCPP_PATH=.*|KOBOLDCPP_PATH=$TARGET|" "$PREFS"
    fi
fi

echo
echo "[KoboldCpp] Installed successfully:"
echo "  $TARGET"
echo "Return to the launch menu and select a GGUF to use it."
INSTALLEOF
