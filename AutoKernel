def move_to_os_trash(target_path: Path) -> bool:
    target_path = target_path.resolve()
    try:
        import send2trash
        send2trash.send2trash(str(target_path))
        return True
    except ImportError:
        pass
    if sys.platform == "darwin":
        mac_trash = Path.home() / ".Trash"
        if mac_trash.exists():
            dest = mac_trash / target_path.name
            if dest.exists():
                dest = mac_trash / f"{target_path.name}_{int(time.time())}"
            shutil.move(str(target_path), str(dest))
            return True
    if sys.platform.startswith("linux"):
        try:
            subprocess.run(["gio", "trash", str(target_path)], check=True, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
            return True
        except (subprocess.SubprocessError, FileNotFoundError):
            pass
        xdg_trash = Path.home() / ".local/share/Trash/files"
        xdg_trash.mkdir(parents=True, exist_ok=True)
        dest = xdg_trash / target_path.name
        if dest.exists():
            dest = xdg_trash / f"{target_path.name}_{int(time.time())}"
        shutil.move(str(target_path), str(dest))
        return True
    return False

def get_session_files():
    valid_files = []
    if not SESSION_ROOT.exists():
        return valid_files
    exclude_dirs = {L3_CPU_DIR.resolve(), L2_NPU_DIR.resolve(), L1_GPU_DIR.resolve(), ARCHIVE_DIR.resolve()}
    for root, dirs, files in os.walk(SESSION_ROOT):
        root_path = Path(root).resolve()
        dirs[:] = [d for d in dirs if (root_path / d) not in exclude_dirs]
        for file in files:
            if file.endswith((".txt", ".xtx")):
                valid_files.append(Path(root) / file)
    return valid_files

def encode_archive_name(file_path: Path, root_dir: Path) -> str:
    rel_parent = file_path.relative_to(root_dir).parent
    safe_parent = str(rel_parent).replace(os.sep, "++").replace("/", "++")
    return f"{file_path.name}({safe_parent})"

def decode_archive_name(archived_filename: str):
    match = re.match(r"^(.*)\(([^()]+)\)$", archived_filename)
    if not match: return archived_filename, Path(".")
    orig_name, safe_parent = match.groups()
    if safe_parent == ".": return orig_name, Path(".")
    rel_parent = Path(safe_parent.replace("++", "/"))
    return orig_name, rel_parent

def archive_active_session(action_verb="Archiving"):
