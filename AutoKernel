    print(f"[playguitar.code] Translating {os.path.basename(input_path)} to native binary syntax...")
    
    try:
        with open(input_path, "rb") as f:
            raw_bytes = f.read()
    except Exception as e:
        print(f"[Error] Could not read audio file: {e}")
        sys.exit(1)

    # Deterministic transcription based on raw file bytes
    chunk_size = len(raw_bytes) // 8 if len(raw_bytes) > 8 else 1
    sequence = []
    
    # Generate up to 8 transitions based on the audio file's binary footprint
    for i in range(min(8, len(raw_bytes) // chunk_size)):
